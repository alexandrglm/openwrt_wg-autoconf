#!/bin/ash
# rel6 Pre-Install method

has_garbage=0

if ip link show 2>/dev/null | grep -qE '^ *[0-9]+: wg[a-zA-Z0-9_-]+'; then
    has_garbage=1
fi

if [ "$has_garbage" != "1" ] && find /etc/config -name "*.BACKUP_PRE_WIREGUARD" 2>/dev/null | grep -q .; then
    has_garbage=1
fi

if [ "$has_garbage" != "1" ] && grep -q "# wg-autoconf" /etc/config/network /etc/config/dhcp /etc/config/firewall 2>/dev/null; then
    has_garbage=1
fi

if [ "$has_garbage" != "1" ] && grep -q ".*_vpn_wg" /etc/iproute2/rt_tables 2>/dev/null; then
    has_garbage=1
fi

if [ "$has_garbage" = "1" ]; then
    
	echo "[wg-autoconf] Previous installation garbage detected. User action required!!!!" > /dev/kmsg
    
    if [ -t 0 ]; then
        
        echo ""
        echo -e "\033[1;33m[WARNING]\033[0m Previous wg-autoconf installation detected!"
        echo ""
        echo "Detected garbage:"
        ip link show 2>/dev/null | grep -qE '^ *[0-9]+: wg[a-zA-Z0-9_-]+' && echo " : WG Interfaces Active"
        find /etc/config -name "*.BACKUP_PRE_WIREGUARD" 2>/dev/null | grep -q . && echo " : Found backup files"
        grep -q "# wg-autoconf" /etc/config/network /etc/config/dhcp /etc/config/firewall 2>/dev/null && echo " : Config files in use"
        grep -q ".*_vpn_wg" /etc/iproute2/rt_tables 2>/dev/null && echo " : Garbage routing tables"
        echo ""
        echo -e "\033[1;31mRun BEFORE installation:\033[0m \033[1;32mwg-autoconf nuke\033[0m"
        echo ""
        
        read -p "Continue anyway? (y/N): " confirm
        case "$confirm" in
            y|Y|yes|YES)
                ;;
            *)
                exit 1
                ;;
        esac
    else
        
		echo ""
        echo "[WARNING] Previous wg-autoconf installation detected"
        echo "Run 'wg-autoconf nuke' after installation to clean up."
		echo ""
    fi
else
    echo "[wg-autoconf] Pre-install checks OK!" > /dev/kmsg
fi

exit 0