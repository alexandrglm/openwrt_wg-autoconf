#!/bin/ash
# rel5 post_install() lifecycle methods - CORREGIDO

mkdir -p /etc/wireguard/
touch /etc/wireguard/put_conf_files_here

chmod +x /etc/init.d/wg-autoconf_boot_cleanup
sleep 1
/etc/init.d/wg-autoconf_boot_cleanup enable

# ¡COMENTAR ESTA LÍNEA! No ejecutar start durante instalación
# /etc/init.d/wg-autoconf_boot_cleanup start

echo "wg-autoconf post-install completed successfully"
exit 0
