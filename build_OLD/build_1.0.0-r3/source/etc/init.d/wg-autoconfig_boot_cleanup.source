#!/bin/sh /etc/rc.common
START=93

start() {

    echo "[INIT.D/wg-autoconfig_boot_cleanup] START() " > /dev/kmesg
    /usr/bin/wg-autoconf nuke-all  2>/dev/null || {

        for iface in $(ip link show | grep -o "wg[0-9]*" | sort -u); do
            ip link delete "$iface" 2>/dev/null
        done

        uci show network 2>/dev/null | grep "network\.wg[^=]*=interface" | \
            cut -d. -f2 | cut -d= -f1 | while read -r iface; do
            uci delete "network.$iface" 2>/dev/null
            uci delete "network.${iface}_peer" 2>/dev/null
        done

        uci commit network 2>/dev/null

        echo "[INIT.D/wg-autoconfig_boot_cleanup] START() method FINISHED! " > /dev/kmesg
    }
}

stop() {

    echo "[INIT.D/wg-autoconfig_boot_cleanup] STOP() " > /dev/kmesg
    :
}

restart() {

    stop
    start
    echo "[INIT.D/wg-autoconfig_boot_cleanup] RESTART() " > /dev/kmesg
}

