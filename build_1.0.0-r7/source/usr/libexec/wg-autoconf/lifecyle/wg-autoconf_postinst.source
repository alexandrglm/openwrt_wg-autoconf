#!/bin/ash
# rel7 post_install() lifecycle methods
mkdir -p /etc/wireguard/
touch /etc/wireguard/put_conf_files_here
chmod +x /etc/init.d/wg-autoconf_boot_cleanup
sleep 1
/etc/init.d/wg-autoconf_boot_cleanup enable 2>/dev/null
# /etc/init.d/wg-autoconf_boot_cleanup start 2>/dev/null
echo "[wg-autoconf 1.0.0-r7] Succesfully installed!" > /dev/kmsg
exit 0
