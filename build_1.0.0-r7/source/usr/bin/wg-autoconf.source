# ██╗     ██╗███████╗████████╗
# ██║     ██║██╔════╝╚══██╔══╝
# ██║     ██║███████╗   ██║
# ██║     ██║╚════██║   ██║
# ███████╗██║███████║   ██║
# ╚══════╝╚═╝╚══════╝   ╚═╝
#
#####################################################################
# TODO: Make really useful both methods

# 1   LIST
list_configs() {

    local file_arg="$1"


    if [ -n "$file_arg" ]; then

        local conf_file="$WG_CONF_DIR/$file_arg.conf"

        if [ ! -f "$conf_file" ]; then
            error "Configuration file $file_arg not found!"
        fi
        
        log "Configuration file: $file_arg"
        echo ""
        echo -e "${BLUE}$(basename $conf_file)${NC}"
        ui_lines 50
        cat "$conf_file" | sed 's/^/   /'
        echo ""
        ui_lines 50
        return
    fi



    echo ""
    ui_lines 49 "${YELLOW}Configs found on${NC} $WG_CONF_DIR"
    echo ""

    local count=0
    local line=""
    local found=0

    for conf in "$WG_CONF_DIR"/*.conf; do

        [ -f "$conf" ] || continue

        found=1
        name=$(basename "$conf" .conf)

        if [ $count -eq 5 ]; then

            echo -e "${GREEN}$line${NC}"

            line="   $name"
            count=1

        else

            if [ $count -eq 0 ]; then

                line="   $name"

            else

                line="$line | $name"
            fi

            count=$((count + 1))
        fi
    done



    if [ $found -eq 0 ]; then

        warning "No configuration files found in $WG_CONF_DIR"

    else

        [ -n "$line" ] && echo -e "${GREEN}$line${NC}"

    fi

    echo ""
    ui_lines 50
}
#####################################################################
# 2.    LIST-FULL
list_configs_full() {

    ui_lines 49 "${YELLOW} Full Configs Inspection${NC}"
    echo ""

    local found=0

    for conf in "$WG_CONF_DIR"/*.conf; do
        [ -f "$conf" ] || continue
        found=1

        ui_lines 40 "${BLUE}$(basename $conf)${NC}"
        cat "$conf" | sed 's/^/   /'
        # echo ""
        # ui_lines 40
        echo ""
    done

    if [ $found -eq 0 ]; then
        warning "No configuration files found in $WG_CONF_DIR"
        ui_lines 50
    else
        ui_lines 50
    fi
}



