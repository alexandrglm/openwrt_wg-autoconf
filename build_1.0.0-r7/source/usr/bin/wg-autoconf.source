# 4.    WG .conf setup files funcs (get_conf_values, clean_wg_keys)
# 5.    Network/Parser funcs (process_allowed_ips, netmask_to_cidr, ip_to_network)


# DEBUG! rel5
# TODO:     Test colours/escapes in older devices, different shells, etc
# REASON:  Different ASNI colour interpretation for older shells
# POSSIBLE FIX?: Remove colours ... or try tput in openwrt or ... idk
RED='\033[1;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'
log() { echo -e "${BLUE}[wg-autoconf]${NC} $1"; }
error() { echo -e "${RED}[ERROR]${NC} $1"; exit 1; }
success() { echo -e "${GREEN}[OK]${NC} $1"; }
warning() { echo -e "${YELLOW}[WARNING]${NC} $1"; }

ui_lines() {

    length="$1"
    shift

    if [ -z "$1" ]; then
        printf '%*s\n' "$length" '' | tr ' ' '='
        return
    fi

    coloured_title="$*"



    # DEBUG! rel5
    # TODO:     TEst in different devices/shells
    # REASON:
    #   The '%b' format is a bash/ksh extension, not POSIX
    #   Older ash versions may prints literal "b" !
    #
    # POSSIBLE FIX?: echo -e or strip colors before length calculation using sed only
    clean_length=$(printf '%b' "$coloured_title" | sed 's/\x1b\[[0-9;]*m//g' | awk '{print length($0)}')

    base_length=$((clean_length + 5))
    padding=$((length - base_length))

    printf '==[ '
    printf '%b' "$coloured_title"
    printf ' ]'
    [ "$padding" -gt 0 ] && printf '%*s' "$padding" '' | tr ' ' '='
    printf '\n'
}
#####################################################################
# GET ALL WG INTERFACES FROM UCI
#####################################################################
get_all_wg_interfaces() {

    # 1. Get all
    # 2. Grep them for what we need (network fields DOT wg*)
    # 3. 1st cut:   -d. + 2nd field
    # 4. 2nd cut:   -d= + 1st subflied (Remove any =* including =)
    # 4. Sort all alphabetically, removing duplicates
    # 5. Satinised reponse d0ne! :D

    uci show network 2>/dev/null | grep "network\.wg[^=]*=interface" | cut -d. -f2 | cut -d= -f1 | sort -u
}
#####################################################################
# VALIDATE INTERFACE NAME
#####################################################################
validate_iface_name() {

    local iface="$1"

    if ! echo "$iface" | grep -q "^wg"; then
        error "Interface name must start with 'wg'"
    fi
}

#####################################################################
# CHECK IFACE ALREADY EXISTS
#####################################################################
iface_exists() {

    local iface="$1"

    uci get "network.$iface" >/dev/null 2>&1

}
#####################################################################
# CHECK ADDRESS ALREADY EXISTS IN ANY OTHER IFACE
#####################################################################
address_exists() {

    local address="$1"
    local exclude_iface="${2:-}"

    local existing_ifaces=$(get_all_wg_interfaces)

    for iface in $existing_ifaces; do

        [ "$iface" = "$exclude_iface" ] && continue

        local existing_addr=$(uci get "network.$iface.addresses" 2>/dev/null)
    
        if [ "$existing_addr" = "$address" ]; then
    
            echo "$iface"
            return 0
    
        fi
    
    done

    return 1
}

#####################################################################
# TAG HANDLER -> Get next available tag ID
#####################################################################
get_next_tag_id() {

    local file="$1"
    local tag="$2"

    # Getting the actual max TAG ID in use
    # 1.    Grep desired tagged line
    # 2.    Sed it by "*id [value]"
    # 3.    Sort it, cleaning
    # 4.    Tail the latest (the higher) in the list 
    local max_id=$(grep "# wg-autoconf $tag start id" "$file" 2>/dev/null | sed 's/.*id //g' | sort -n | tail -1)

    [ -z "$max_id" ] && max_id=0

    echo $((max_id + 1))
}
#####################################################################
# TAG HANDLER -> Remove tagged blocks from config files by ID
#####################################################################
remove_tagged_block() {

    local file="$1"
    local tag="$2"
    local tag_id="$3"
    
    debug_write "[REMOVE TAG] Starting: file=$file, tag=$tag, id=$tag_id"
    

    # 1- FILE EXIST??
    [ -f "$file" ] || {
    
        debug_write "[REMOVE TAG ERROR] File not found: $file"
        error "$file does not exist!"
        return 1
    
    }
    
    
    # 2. TAG EXISTS??
    if ! grep -q "# wg-autoconf $tag start id $tag_id" "$file" 2>/dev/null; then
    
        warning "Tag '$tag' with id $tag_id not found in $file. Skipping..."
        debug_write "[REMOVE TAG] Tag not found, skipping"
    
        return 0
    fi
    
    # 3. GET EXACT LINES TAG-STARTS / TAG-END
    local start_line=$(grep -n "# wg-autoconf $tag start id $tag_id" "$file" 2>/dev/null | cut -d: -f1)
    local end_line=$(grep -n "# wg-autoconf $tag end id $tag_id" "$file" 2>/dev/null | cut -d: -f1)
    
    # 3.1- TAG EXISTANCE VERIFICACIONT
    if [ -z "$start_line" ] || [ -z "$end_line" ]; then
        
        warning "Cannot find start/end lines for tag $tag id $tag_id"
        debug_write "[REMOVE TAG ERROR] Cannot find start/end lines: start=$start_line, end=$end_line"
        
        return 1
    
    fi
    
    # 3.2 TAMPERED TAG BLOCKS, START LINE DOES NOT MATCH END LINE
    if [ "$start_line" -ge "$end_line" ]; then
        
        warning "Invalid tag range: start=$start_line, end=$end_line"
        debug_write "[REMOVE TAG ERROR] Invalid range: start=$start_line >= end=$end_line"
        
        return 1
    fi
    
    # 3.3 ELSE IF OK
    debug_write "[REMOVE TAG] Found lines: start=$start_line, end=$end_line"
    

    # 4. ADD TAGS, ATOMIC OPERS
    local temp_file="${ATOMIC_PATHS}/$(basename "$file").${tag}.${tag_id}.atomic"
    debug_write "[REMOVE TAG] Using temp file: $temp_file"
    

    if ! head -n $((start_line - 1)) "$file" > "$temp_file" 2>/dev/null; then
    
        debug_write "[REMOVE TAG ERROR] head command failed"
        
        rm -f "$temp_file" 2>/dev/null
    
        return 1
    fi
    
    # 4.2   
    if [ ! -f "$temp_file" ]; then

        debug_write "[REMOVE TAG ERROR] Temp file not created after head"
    
        return 1
    fi
    
    # 4.3 COPY LINES BEFORE THE HIGHEST BLOCK
    if ! tail -n +$((end_line + 1)) "$file" >> "$temp_file" 2>/dev/null; then
        
        debug_write "[REMOVE TAG ERROR] tail command failed"
        
        rm -f "$temp_file" 2>/dev/null
        
        return 1
    fi
    
    # 4. VERIFY
    if [ ! -s "$temp_file" ]; then
        
        warning "Resulting file would be empty after removing '$tag' block"
        debug_write "[REMOVE TAG ERROR] Temp file empty or missing"
        
        rm -f "$temp_file" 2>/dev/null
        
        return 1
    fi
    
    # 5. CHMODs GET, THE MORE ATOMIC THE BETTER
    local orig_perm="644"
    
    if command -v stat >/dev/null 2>&1 && stat -c "%a" "$file" >/dev/null 2>&1; then
        
        orig_perm=$(stat -c "%a" "$file" 2>/dev/null || echo "644")
    
    else
        
        orig_perm=$(ls -l "$file" | awk '{print $1}' 2>/dev/null | grep -o '...$' | tr 'rwx-' '4210' 2>/dev/null || echo "644")
    fi
    
    debug_write "[REMOVE TAG] Original permissions: $orig_perm"
    

    # 6. REPLACE ORIG FILE WITH TEMP
    if ! mv "$temp_file" "$file" 2>/dev/null; then
        
        debug_write "[REMOVE TAG ERROR] mv failed: $temp_file -> $file"
        
        rm -f "$temp_file" 2>/dev/null
        
        error "Failed to remove block from $file"
        
        return 1
    fi
    
    # 6.1   CHMODs SET
    if ! chmod "$orig_perm" "$file" 2>/dev/null; then
        
        debug_write "[REMOVE TAG WARNING] Failed to restore permissions for $file"
    
    fi
    
    verbose success "Removed '$tag' block (id: $tag_id) from $file"
    debug_write "[REMOVE TAG] Successfully removed $tag block id $tag_id from $file"
    
    return 0
}


#####################################################################
# WG KEY HANDLER -> CLEANING
#####################################################################
clean_wg_key() {

    local key="$1"

    key=$(echo "$key" | sed 's/^[ \t]*//;s/[ \t]*$//')
    key=$(echo "$key" | tr -d '\r\n')
    [ "${key:0:1}" = "+" ] && key="${key:1}"

    local len=${#key}
    [ $len -eq 43 ] && key="${key}="

    echo "$key"
}
#####################################################################
# WG CONF HANDLER -> Extracting keys
#####################################################################
get_conf_value() {

    local key="$1"
    local file="$2"

    grep "^$key[ \t]*=" "$file" 2>/dev/null | head -1 | cut -d= -f2- | sed 's/^[ \t]*//;s/[ \t]*$//'
}

#####################################################################
# WG/OpenWRT Network ALLOWED IPS
#####################################################################
process_allowed_ips() {

    local ips="$1"

    ips=$(echo "$ips" | sed 's/^[ \t]*//;s/[ \t]*$//')

    echo "$ips" | tr ',' '\n' | sed 's/^[ \t]*//;s/[ \t]*$//' | grep -v '^$'
}

#####################################################################
# NETMASK TO CIDR converter
#####################################################################
netmask_to_cidr() {

    local mask="$1"

    case "$mask" in
        255.255.255.0)   echo 24 ;;
        255.255.255.128) echo 25 ;;
        255.255.255.192) echo 26 ;;
        255.255.255.224) echo 27 ;;
        255.255.255.240) echo 28 ;;
        255.255.255.248) echo 29 ;;
        255.255.255.252) echo 30 ;;
        255.255.0.0)     echo 16 ;;
        255.0.0.0)       echo 8 ;;
        *)               echo 24 ;;
    esac
}

#####################################################################
# IP to network address converter
#####################################################################
ip_to_network() {
    local ip="$1"
    local cidr="$2"

    # DEBUG! rel5
    # TODO:     Test in older devices, different shells, etc
    # REASON:
    #   Standard ash (BusyBox) has crappy array support....syntax may fail!
    #   ASH array syntax `array=(value1 value2)` is not portable for older ash versions
    # POSSIBLE FIX?: Poositional params...  or space-separated strings instead of arrays
    case "$cidr" in
        24)
            echo "${ip%.*}.0"
            ;;
        25|26|27|28|29)

            local octet=${ip##*.}
            local bits=$((32 - cidr))

            local step=1 i
            i=0

            while [ $i -lt $bits ]; do
                step=$((step * 2))
                i=$((i + 1))
            done

            step=$((256 / step))

            local net=$(( (octet / step) * step ))

            echo "${ip%.*}.$net"
            ;;
        16)
            echo "${ip%.*.*}.0"
            ;;
        8)
            echo "${ip%.*.*.*}.0"
            ;;
        *)
            echo "${ip%.*}.0"
            ;;
    esac
}

#####################################################################
# DNS HANDLER -> manual -> UCI COMMANDS || .conf files
#####################################################################
clean_dns_uci() {

    # SPACE SEPARATED for UCI COMMANDS
    local dns="$1"
    

    [ -z "$dns" ] && dns="1.1.1.1 1.0.0.1" && warning "DNS not valid/not found, using defaults (1.1.1.1  1.0.0.1)" && verbose log "Even using defaults, DNS will be tunneled in any case"
    
    # 1. Echo DNS Value
    # 2. Replace commas by spaces
    # 3/4. ParSED spaces, trim, etc
    dns=$(echo "$dns" | tr ',' ' ' | sed 's/\s\+/ /g' | sed 's/^ //;s/ $//')
    
    echo "$dns"
}

clean_dns_conf() {

    local dns="$1"

    # COMMA SEPARATED values for .conf files
    
    # Si está vacío, devolver defaults
    [ -z "$dns" ] && dns="1.1.1.1 1.0.0.1" && warning "DNS not valid/not found, using defaults (1.1.1.1  1.0.0.1)" && verbose log "Even using defaults, DNS will be tunneled in any case"
    
    # 1. Echo DNS Value
    # 2. Replace spaces by commas
    # 3/4. ParSED spaces, trim, etc
    dns=$(echo "$dns" | tr ' ' ',' | sed 's/,/, /g' | sed 's/, ,/,/g' | sed 's/^, //;s/, $//')
    
    # 5. Ensure again x, y format
    dns=$(echo "$dns" | sed 's/,/, /g')
    
    echo "$dns"
}

#####################################################################
# DNS HANDLER -> Validate DNS format
#####################################################################
validate_dns_format() {

    local dns="$1"
    local format="$2"
    
    [ -z "$dns" ] && return 0
    

    # 1. IF UCI DNS VALIDATION
    if [ "$format" = "uci" ]; then
        
        echo "$dns" | tr ' ' '\n' | while read -r server; do
           
            # 1. Empty? its ok
            [ -z "$server" ] && continue
           
            # IPv4/IPv6 VALIDs
            if ! echo "$server" | grep -qE '^([0-9]{1,3}\.){3}[0-9]{1,3}$' && \
               ! echo "$server" | grep -qE '^[a-fA-F0-9:]+(:[a-fA-F0-9:]+)*$'; then
                error "Invalid DNS server format: $server"
            fi
        
        done
    
    # 2. IF .conf DNS VALIDATION
    else
       
        # 2.1 COMMA-SEPARATED
        echo "$dns" | tr ',' '\n' | while read -r server; do
         
            server=$(echo "$server" | sed 's/^ //;s/ $//')
         
            # 2.2 Empty?? It's ok
            [ -z "$server" ] && continue
        
            # IPv4/IPv6 VALIDs
            if ! echo "$server" | grep -qE '^([0-9]{1,3}\.){3}[0-9]{1,3}$' && \
               ! echo "$server" | grep -qE '^[a-fA-F0-9:]+(:[a-fA-F0-9:]+)*$'; then
                error "Invalid DNS server format: $server"
            fi
       
        done
    
    fi
    
    return 0
}
#####################################################################
# CONF FILE PARSER ->  Extract and normalise DNS from .conf files
#####################################################################
get_dns_from_conf() {

    local conf_file="$1"
    
    # 1.  GET DNS VALUE FROM .CONF
    local dns_line=$(grep -i "^DNS[[:space:]]*=" "$conf_file" 2>/dev/null | head -1)
    
    if [ -n "$dns_line" ]; then

        # 1.1 TRIM SPACES, CLEAN, BEFORE "DNS ="
        local dns_value=$(echo "$dns_line" | cut -d= -f2- | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
        
        # 1.2 VALIDATE_DNS CALLBAJKC
        if validate_dns_format "$dns_value" "conf" 2>/dev/null; then
            
            echo "$dns_value"
            return 0
        
        else
            
            warning "Invalid DNS format in $conf_file, using defaults"
            debug_write "[MANUAL] Error while using DNS from $conf_file file!"
            debug_write "    $dns_value"
        
        fi
    
    fi
    
    # 2. DEFAULTS IF DNS NOT FOUNFD or FAILS
    echo "1.1.1.1, 1.0.0.1"
    debug_write "[MANUAL] DNS Value cannot be used. Using defaults (1.1.1.1  1.0.0.1)"
    return 1
}





