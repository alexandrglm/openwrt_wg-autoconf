#####################################################################
# WG-AUTOCONF ROUTES SHOW
#
# Displays WireGuard routing configuration including routing
# Tables, IP rules, and route entries for VPN traffic.
#
# Workflow:
#   1. Validate existence of routing tables configuration file
#   2. Display routes based on filtering criteria:
#       a. Filtered mode: Show routes for specific WireGuard interface
#       b. Unfiltered mode: Show all WireGuard routes
#   3. Handle empty state when no routes are configured
#
# Params:
#   $1: Optional WireGuard interface name filter
#       - If provided: Shows only routes associated with this interface
#       - If omitted or empty: Shows all WireGuard routes
#
# Output Format (Filtered Mode):
#   lan_interface_name:
#     Table: _vpn_wgX_lanY (ID: table_id)
#     Rule: <priority>: from <source> lookup <table_name>
#     Route: <destination> via <gateway> dev <interface>
#
# Output Format (Unfiltered Mode):
#   _vpn_wgX_lanY (ID: table_id):
#     Rule: <priority>: from <source> lookup <table_name>
#     Route: <destination> via <gateway> dev <interface>
#
# Table Naming Convention:
#   _vpn_<wg_interface>_<lan_interface>
#   Example: _vpn_wg0_lan - Routes LAN traffic through wg0 interface
#
# Data Sources:
#   - /etc/iproute2/rt_tables: Routing table names and IDs
#   - ip rule show: Routing policy rules
#   - ip route show table <name>: Route entries per table
#
# Error Handling:
#   - Validates existence of rt_tables configuration file
#   - Gracefully handles missing routing tables
#   - Provides clear "no routes" message when appropriate
#   - Silently handles non-existent table queries
#
# Filtering Logic:
#   Filtered mode extracts LAN interface name from table name:
#   table_name="_vpn_wg0_lan" -> lan_iface="lan"
#   This provides more user-friendly output for specific WG interfaces.
#
#####################################################################
show_routes() {

    local filter_wg_iface="$1"

    log "WireGuard routes:"
    echo ""

    
    # 1. VALIDATE ROUTING TABLES CONFIGURATION FILE
    # Check if routing tables configuration file exists
    if [ ! -f /etc/iproute2/rt_tables ]; then

        error "/etc/iproute2/rt_tables not found"

    fi

    
    # 2. DISPLAY ROUTES BASED ON FILTERING CRITERIA
    if [ -n "$filter_wg_iface" ]; then


        
        # 2a. FILTERED MODE: SHOW ROUTES FOR SPECIFIC IFACE
        log "Routes for $filter_wg_iface:"
        echo ""

        # Find all routing tables associated with the specified iface
        grep "_vpn_${filter_wg_iface}" /etc/iproute2/rt_tables 2>/dev/null | while read -r line; do

            # GET TABLES
            local table_id=$(echo "$line" | awk '{print $1}')
            local table_name=$(echo "$line" | awk '{print $2}')

            # EXTRACT LAN IFACE NAME FROM TABLE
            local lan_iface=$(echo "$table_name" | sed "s/_vpn_${filter_wg_iface}//g")

            # TABLE SECTION HEADER
            echo "$lan_iface:"
            echo "  Table: $table_name (ID: $table_id)"

            # SHOW RULES FOR THIS TABLE
            ip rule show | grep "lookup $table_name" | sed 's/^/  Rule: /'

            # SHOW ALL ROUTES
            ip route show table "$table_name" 2>/dev/null | while read -r route; do

                echo "  Route: $route"
            done || echo "  (no routes found)"

            echo ""
        done

    else
        
        # 2b. UNFILTERED MODE: SHOW ALL WIREGUARD ROUTES
        log "All routes:"
        echo ""

        # Find all VPN routing tables WITH "_vpn_" pattern
        grep "_vpn_" /etc/iproute2/rt_tables 2>/dev/null | while read -r line; do

            # GET TABLES
            local table_id=$(echo "$line" | awk '{print $1}')
            local table_name=$(echo "$line" | awk '{print $2}')

            # TABLE SECTION HEADER
            echo "$table_name (ID: $table_id):"

            # SHOW RULES FOR THIS TABLE
            ip rule show | grep "lookup $table_name" | sed 's/^/  Rule: /'

            # SHOW ALL ROUTES
            ip route show table "$table_name" 2>/dev/null | while read -r route; do

                echo "  Route: $route"

            done || echo "  (no routes)"

            echo ""
        done
    fi

    
    # 3. HANDLE EMPTY STATE WHEN NO ROUTES ARE CONFIGURED
    # CHECK PREOVIOUS VPN TABLES
    [ -z "$(grep '_vpn_' /etc/iproute2/rt_tables 2>/dev/null)" ] && warning "No WireGuard routes configured"
}


#####################################################################
# WG-AUTOCONF SET_LAN_ROUTES
#
# Configures policy-based routing for LAN through WireGuard interface.
# Updates state: ID_N_IS_RT_TABLES_IN_USE=1
#
# Workflow:
#   1. Validate both WG and LAN interfaces exist
#   2. Get interface IDs from state
#   3. Extract LAN IP and netmask
#   4. Create routing table entry
#   5. Add IP policy rules
#   6. Add IP routes
#   7. Add firewall forwarding rules (tagged)
#   8. Commit changes
#   9. Update state: ID_N_IS_RT_TABLES_IN_USE=1
#
# Params:
#   $1: WireGuard interface name (e.g., wg0)
#   $2: LAN interface name (e.g., lan, lan2)
#
# Return: 0 (success) / 1 (failure)
#
# Pre-conditions:
#   - WG interface must be ACTIVE (IS_ACTIVE=1)
#   - LAN interface must exist in UCI
#
#####################################################################
set_lan_routes() {

    local wg_iface="$1"
    local lan_iface="$2"

    # 1. VALIDATIONS
    [ -z "$wg_iface" ] && error "WireGuard interface name required!"
    [ -z "$lan_iface" ] && error "LAN interface name required!"
    
    # 1.1 IF WG_IFACE EXISTS
    if ! uci get "network.$wg_iface" >/dev/null 2>&1; then
        error "SRC: $wg_iface does not exist in network config!"
    fi
    
    # 1.2 IF DESIRED IFACE EXISTS
    if ! uci get "network.$lan_iface" >/dev/null 2>&1; then
        error "DEST:  $lan_iface does not exist in network config!"
    fi
    
    validate_iface_name "$wg_iface"

    # 2. STATES
    state_init
    local wg_id=$(state_get_id "$wg_iface" 2>/dev/null)
    local wg_id_found=$?

    # 3. GET INFO
    log "Setting up routes for $lan_iface through $wg_iface..."
    echo ""
    
    local lan_ip=""
    local lan_netmask=""
    
    # 3.1 GET IP
    lan_ip=$(uci get "network.$lan_iface.ipaddr" 2>/dev/null)
    
    if [ -z "$lan_ip" ]; then
        lan_ip=$(ip -4 addr show "$lan_iface" 2>/dev/null | grep inet | awk '{print $2}' | cut -d/ -f1 | head -1)
    fi
    
    if [ -z "$lan_ip" ]; then
        error "Could not determine IP address for $lan_iface!"
    fi

    # 3.2 NETMASK
    lan_netmask=$(uci get "network.$lan_iface.netmask" 2>/dev/null)
    
    if [ -z "$lan_netmask" ]; then
        local lan_cidr=$(ip -4 addr show "$lan_iface" 2>/dev/null | grep inet | awk '{print $2}' | cut -d/ -f2 | head -1)
        
        if [ -n "$lan_cidr" ]; then
            case "$lan_cidr" in
                24) lan_netmask="255.255.255.0" ;;
                23) lan_netmask="255.255.254.0" ;;
                22) lan_netmask="255.255.252.0" ;;
                16) lan_netmask="255.255.0.0" ;;
                8)  lan_netmask="255.0.0.0" ;;
                *)  lan_netmask="255.255.255.0" ;;
            esac
        fi
    fi
    
    local cidr=$(netmask_to_cidr "${lan_netmask:-255.255.255.0}")
    
    if [ -z "$lan_netmask" ]; then
        warning "Netmask not found for $lan_iface, assuming /$cidr"
    fi

    local subnet=""
    if [ "$cidr" = "24" ]; then
        subnet="${lan_ip%.*}.0/$cidr"
    elif [ "$cidr" = "16" ]; then
        subnet="${lan_ip%.*.*}.0.0/$cidr"
    elif [ "$cidr" = "8" ]; then
        subnet="${lan_ip%%.*}.0.0.0/$cidr"
    else
        subnet="$(ip_to_network "$lan_ip" "$cidr")/$cidr"
    fi
    
    verbose log "LAN subnet: $subnet"

    # 4. RT_TABLES
    local table_name="_vpn_${wg_iface}_${lan_iface}"

    # 5. /etc/iproute2/rt_tables
    if [ -f /etc/iproute2/rt_tables ]; then
        
        # 5.1 IF EXIST
        if ! grep -q "^[0-9]\+ $table_name$" /etc/iproute2/rt_tables 2>/dev/null; then
            
            # 5.1.1 GET ID
            local table_id=150
            while grep -q "^$table_id " /etc/iproute2/rt_tables 2>/dev/null && [ $table_id -lt 250 ]; do
                table_id=$((table_id + 1))
            done
            
            if [ $table_id -ge 250 ]; then
                error "Cannot find available routing table ID"
            fi
            
            # 5.1.2 ADD TABLE
            echo "$table_id $table_name" >> /etc/iproute2/rt_tables
            
        fi
    else
        warning "Routing tables file not found, attempting to create..."
        
        mkdir -p /etc/iproute2 2>/dev/null
        {
            echo "#"
            echo "# Reserved values"
            echo "#"
            echo "255     local"
            echo "254     main"
            echo "253     default"
            echo "0       unspec"
            echo "#"
            echo "# wg-autoconf tables"
            echo "#"
            echo "150     $table_name"
        } > /etc/iproute2/rt_tables 2>/dev/null
    fi

    # 6. DEL RULES
    ip rule del from "$subnet" lookup "$table_name" 2>/dev/null
    ip rule del from "$subnet" to "$subnet" lookup main 2>/dev/null
    ip route flush table "$table_name" 2>/dev/null

    # 7. ADD NEW RULES
    if ! ip rule add from "$subnet" lookup "$table_name" 2>/dev/null; then
        warning "Failed to add routing rule for $subnet"
    fi
    
    if ! ip rule add from "$subnet" to "$subnet" lookup main 2>/dev/null; then
        warning "Failed to add local rule"
    fi
    
    if ! ip route add "$subnet" dev "$lan_iface" table "$table_name" 2>/dev/null; then
        warning "Failed to add local route for $subnet"
    fi
    
    if ip link show "$wg_iface" >/dev/null 2>&1; then
        if ! ip route add default dev "$wg_iface" table "$table_name" 2>/dev/null; then
            warning "Failed to add default route via $wg_iface"
        fi
    else
        warning "$wg_iface is not active! Routes may not work until interface is up."
    fi
    
    # 8. FIREWALL RULES
    verbose log "Adding firewall forwarding rules..."
    
    # 8.1 FIND FIREWALL LINE FOR WG IFACE
    local fw_line=$(grep -n "option name[[:space:]]*'$wg_iface'" "$FIREWALL_CONF" 2>/dev/null | head -1 | cut -d: -f1)
    
    if [ -z "$fw_line" ]; then
        warning "Could not find firewall configuration for $wg_iface"
    else
        # 8.2 FIND TAG ID (search backwards from fw_line)
        local fw_tag_id=""
        local line_num=0
        
        while IFS= read -r line || [ -n "$line" ]; do
            line_num=$((line_num + 1))
            
            if [ $line_num -ge $fw_line ]; then
                break
            fi
            
            if echo "$line" | grep -q "# wg-autoconf firewall start id "; then
                fw_tag_id=$(echo "$line" | sed 's/.*id //g')
            fi
        done < "$FIREWALL_CONF"
        
        if [ -z "$fw_tag_id" ]; then
            warning "Firewall tag not found for $wg_iface"
        else
            # 8.3 FIND END TAG LINE
            local fw_end_line=$(grep -n "# wg-autoconf firewall end id $fw_tag_id" "$FIREWALL_CONF" 2>/dev/null | head -1 | cut -d: -f1)
            
            if [ -z "$fw_end_line" ]; then
                warning "Cannot find firewall block end for $wg_iface"
            else
                # 8.4 CHECK IF RULES ALREADY EXIST
                local rules_exist=0
                local in_block=0
                
                while IFS= read -r line || [ -n "$line" ]; do
                    if echo "$line" | grep -q "# wg-autoconf firewall start id $fw_tag_id"; then
                        in_block=1
                        continue
                    fi
                    
                    if echo "$line" | grep -q "# wg-autoconf firewall end id $fw_tag_id"; then
                        break
                    fi
                    
                    if [ $in_block -eq 1 ]; then
                        if echo "$line" | grep -q "config forwarding"; then
                            # Read the entire forwarding block
                            local forwarding_block="$line"
                            local has_src_lan=0
                            local has_dest_wg=0
                            local has_src_wg=0
                            local has_dest_lan=0
                            
                            # DEBUG! r7
                            # TODO: Even this works, while loops and pipes ... find a better way
                            while IFS= read -r subline || [ -n "$subline" ]; do
                                forwarding_block="${forwarding_block}
${subline}"
                                
                                if echo "$subline" | grep -q "option src '$lan_iface'"; then
                                    has_src_lan=1
                                fi
                                if echo "$subline" | grep -q "option dest '$wg_iface'"; then
                                    has_dest_wg=1
                                fi
                                if echo "$subline" | grep -q "option src '$wg_iface'"; then
                                    has_src_wg=1
                                fi
                                if echo "$subline" | grep -q "option dest '$lan_iface'"; then
                                    has_dest_lan=1
                                fi
                                
                                # Check if block ends
                                if [ -z "$subline" ] || echo "$subline" | grep -q "^[[:space:]]*config[[:space:]]"; then
                                    break
                                fi
                            done
                            
                            # Check if this is our exact forwarding rule
                            if [ $has_src_lan -eq 1 ] && [ $has_dest_wg -eq 1 ]; then
                                rules_exist=1
                                break
                            fi
                            if [ $has_src_wg -eq 1 ] && [ $has_dest_lan -eq 1 ]; then
                                rules_exist=1
                                break
                            fi
                        fi
                    fi
                done < "$FIREWALL_CONF"
                
                # 8.5 ADD RULES IF THEY DON'T EXIST
                if [ $rules_exist -eq 0 ]; then
                    
                    
                    # 8.5.1  Create backup
                    local fw_backup="${FIREWALL_CONF}.backup.$$"
                    cp "$FIREWALL_CONF" "$fw_backup" 2>/dev/null
                    
                    # 8.5.2 Insert rules before end tag
                    sed -i "${fw_end_line}i\\
\\
config forwarding\\
    option src '$lan_iface'\\
    option dest '$wg_iface'\\
\\
config forwarding\\
    option src '$wg_iface'\\
    option dest '$lan_iface'\\
" "$FIREWALL_CONF"
                    
                    # 8.5.3 Verify insertion
                    if grep -q "option src '$lan_iface'" "$FIREWALL_CONF" 2>/dev/null && \
                    
                        grep -q "option dest '$wg_iface'" "$FIREWALL_CONF" 2>/dev/null; then
                            verbose success "Firewall forwarding rules added"
                    
                    else
                        
                        # Restore backup on failure
                        mv "$fw_backup" "$FIREWALL_CONF" 2>/dev/null
                        warning "Failed to add firewall rules"
                    
                    fi
                    
                    rm -f "$fw_backup" 2>/dev/null
                else
                    
                    warning "Forwarding rules already exist for $lan_iface <--> $wg_iface"
                fi
            fi
        fi
    fi

    # 9. COMMITs
    uci commit firewall 2>/dev/null
    /etc/init.d/firewall reload 2>/dev/null
    




    # 10. UPDATE STATE
    if [ $wg_id_found -eq 0 ] && [ -n "$wg_id" ]; then
        state_write "ID_${wg_id}_IS_RT_TABLES_IN_USE" "1" 2>/dev/null
    fi

    # D0ne!
    verbose echo ""
    verbose log "Route configuration summary:"
    verbose echo "  Table: $table_name"
    verbose echo "  LAN Subnet: $subnet"
    verbose echo "  Via Interface: $wg_iface"
    verbose echo ""

    success "Routes configured successfully!"
    
    return 0
}



#####################################################################
# WG-AUTOCONF UNSET_LAN_ROUTES
#
# Removes policy-based routing for LAN through WireGuard interface.
# Updates state: ID_N_IS_RT_TABLES_IN_USE=0
#
# Workflow:
#   1. Validate both WG and LAN interfaces exist
#   2. Get interface IDs from state
#   3. Extract LAN IP and netmask
#   4. Remove IP policy rules
#   5. Flush routing table
#   6. Remove firewall forwarding rules (by tag)
#   7. Remove routing table entry from rt_tables
#   8. Commit changes
#   9. Update state: ID_N_IS_RT_TABLES_IN_USE=0
#
# Params:
#   $1: WireGuard interface name (e.g., wg0)
#   $2: LAN interface name (e.g., lan, lan2)
#
# Return: 0 (success) / 1 (failure)
#
# State Changes:
#   - Sets ID_N_IS_RT_TABLES_IN_USE=0
#   - Does NOT modify IS_ACTIVE flag
#
#####################################################################
unset_lan_routes() {

    local wg_iface="$1"
    local lan_iface="$2"

    [ -z "$wg_iface" ] && error "WireGuard interface name required!"
    [ -z "$lan_iface" ] && error "LAN interface name required!"

    state_init
    local wg_id=$(state_get_id "$wg_iface" 2>/dev/null)
    local wg_id_found=$?

    log "Removing routes for $lan_iface (via $wg_iface)..."
    echo ""

    local subnet=""
    local table_name="_vpn_${wg_iface}_${lan_iface}"
    


    # DETERMINE SUBNET (same logic as set_lan_routes)
    local lan_ip=""
    local lan_netmask=""
    
    lan_ip=$(uci get "network.$lan_iface.ipaddr" 2>/dev/null)
    lan_netmask=$(uci get "network.$lan_iface.netmask" 2>/dev/null)
    
    if [ -z "$lan_ip" ]; then
        lan_ip=$(ip -4 addr show "$lan_iface" 2>/dev/null | grep inet | awk '{print $2}' | cut -d/ -f1 | head -1)
    fi
    
    if [ -z "$lan_ip" ]; then
        error "Could not determine IP address for $lan_iface!"
    fi
    
    if [ -z "$lan_netmask" ]; then
        local lan_cidr=$(ip -4 addr show "$lan_iface" 2>/dev/null | grep inet | awk '{print $2}' | cut -d/ -f2 | head -1)
        
        if [ -n "$lan_cidr" ]; then
            case "$lan_cidr" in
                24) lan_netmask="255.255.255.0" ;;
                23) lan_netmask="255.255.254.0" ;;
                22) lan_netmask="255.255.252.0" ;;
                16) lan_netmask="255.255.0.0" ;;
                8)  lan_netmask="255.0.0.0" ;;
                *)  lan_netmask="255.255.255.0" ;;
            esac
        fi
    fi
    
    local cidr=$(netmask_to_cidr "${lan_netmask:-255.255.255.0}")
    
    if [ "$cidr" = "24" ]; then
        subnet="${lan_ip%.*}.0/$cidr"
    elif [ "$cidr" = "16" ]; then
        subnet="${lan_ip%.*.*}.0.0/$cidr"
    elif [ "$cidr" = "8" ]; then
        subnet="${lan_ip%%.*}.0.0.0/$cidr"
    else
        subnet="$(ip_to_network "$lan_ip" "$cidr")/$cidr"
    fi
    
    verbose log "Route table: $table_name"
    verbose log "Subnet: $subnet"


    # REMOVE IP RULES
    ip rule del from "$subnet" lookup "$table_name" 2>/dev/null
    ip rule del from "$subnet" to "$subnet" lookup main 2>/dev/null
    ip route flush table "$table_name" 2>/dev/null



    # REMOVE FIREWALL RULES
    verbose log "Removing firewall forwarding rules..."
    
    if [ -f "$FIREWALL_CONF" ]; then
        # FIND FIREWALL LINE FOR WG IFACE
        local fw_line=$(grep -n "option name[[:space:]]*'$wg_iface'" "$FIREWALL_CONF" 2>/dev/null | head -1 | cut -d: -f1)
        
        if [ -n "$fw_line" ]; then
            # FIND TAG ID (search backwards from fw_line)
            local fw_tag_id=""
            local line_num=0
            
            while IFS= read -r line || [ -n "$line" ]; do
                line_num=$((line_num + 1))
                
                if [ $line_num -ge $fw_line ]; then
                    break
                fi
                
                if echo "$line" | grep -q "# wg-autoconf firewall start id "; then
                    fw_tag_id=$(echo "$line" | sed 's/.*id //g')
                fi
            done < "$FIREWALL_CONF"
            
            if [ -n "$fw_tag_id" ]; then
                # FIND END TAG LINE
                local fw_end_line=$(grep -n "# wg-autoconf firewall end id $fw_tag_id" "$FIREWALL_CONF" 2>/dev/null | head -1 | cut -d: -f1)
                
                if [ -n "$fw_end_line" ]; then
                    # CREATE BACKUP AND PROCESS
                    local fw_backup="${FIREWALL_CONF}.backup.$$"
                    local fw_temp="${FIREWALL_CONF}.temp.$$"
                    
                    cp "$FIREWALL_CONF" "$fw_backup" 2>/dev/null
                    
                    local in_target_block=0
                    local in_forwarding_block=0
                    local current_forwarding_block=""
                    local skip_this_block=0
                    
                    while IFS= read -r line || [ -n "$line" ]; do
                        
                        # Track if we're in the target tagged block
                        if echo "$line" | grep -q "# wg-autoconf firewall start id $fw_tag_id"; then
                            in_target_block=1
                            echo "$line" >> "$fw_temp"
                            continue
                        fi
                        
                        if echo "$line" | grep -q "# wg-autoconf firewall end id $fw_tag_id"; then
                            in_target_block=0
                            echo "$line" >> "$fw_temp"
                            continue
                        fi
                        
                        # If not in target block, copy line as-is
                        if [ $in_target_block -eq 0 ]; then
                            echo "$line" >> "$fw_temp"
                            continue
                        fi
                        
                        # Inside target block, handle forwarding blocks
                        if echo "$line" | grep -q "^[[:space:]]*config[[:space:]]\+forwarding"; then
                            # End previous forwarding block if any
                            if [ $in_forwarding_block -eq 1 ]; then
                                if [ $skip_this_block -eq 0 ] && [ -n "$current_forwarding_block" ]; then
                                    echo "$current_forwarding_block" >> "$fw_temp"
                                fi
                            fi
                            
                            in_forwarding_block=1
                            skip_this_block=0
                            current_forwarding_block="$line"
                            continue
                        fi
                        
                        if [ $in_forwarding_block -eq 1 ]; then
                            current_forwarding_block="${current_forwarding_block}
${line}"
                            
                            # Check if this forwarding block matches our interfaces
                            if echo "$line" | grep -q "option[[:space:]]\+src[[:space:]]*'$lan_iface'" && \
                               echo "$line" | grep -q "option[[:space:]]\+dest[[:space:]]*'$wg_iface'"; then
                                skip_this_block=1
                            fi
                            
                            if echo "$line" | grep -q "option[[:space:]]\+src[[:space:]]*'$wg_iface'" && \
                               echo "$line" | grep -q "option[[:space:]]\+dest[[:space:]]*'$lan_iface'"; then
                                skip_this_block=1
                            fi
                            
                            # Detect end of forwarding block
                            if [ -z "$line" ] || echo "$line" | grep -q "^[[:space:]]*config[[:space:]]"; then
                                if [ $skip_this_block -eq 0 ] && [ -n "$current_forwarding_block" ]; then
                                    echo "$current_forwarding_block" >> "$fw_temp"
                                fi
                                
                                in_forwarding_block=0
                                skip_this_block=0
                                current_forwarding_block=""
                                
                                # Handle current line (might be start of another block)
                                if [ -n "$line" ]; then
                                    if echo "$line" | grep -q "^[[:space:]]*config[[:space:]]"; then
                                        if echo "$line" | grep -q "^[[:space:]]*config[[:space:]]\+forwarding"; then
                                            in_forwarding_block=1
                                            current_forwarding_block="$line"
                                        else
                                            echo "$line" >> "$fw_temp"
                                        fi
                                    else
                                        echo "$line" >> "$fw_temp"
                                    fi
                                fi
                                continue
                            fi
                        else
                            # Line not part of forwarding block
                            echo "$line" >> "$fw_temp"
                        fi
                    done < "$FIREWALL_CONF"
                    
                    # Handle last block if active
                    if [ $in_forwarding_block -eq 1 ] && [ $skip_this_block -eq 0 ] && [ -n "$current_forwarding_block" ]; then
                        echo "$current_forwarding_block" >> "$fw_temp"
                    fi
                    
                    # Replace file if different
                    if [ -f "$fw_temp" ] && [ -s "$fw_temp" ]; then
                        if ! diff -q "$FIREWALL_CONF" "$fw_temp" >/dev/null 2>&1; then
                            if mv "$fw_temp" "$FIREWALL_CONF" 2>/dev/null; then
                                verbose success "Firewall forwarding rules removed"
                            else
                                mv "$fw_backup" "$FIREWALL_CONF" 2>/dev/null
                                warning "Failed to update firewall configuration"
                            fi
                        else
                            rm -f "$fw_temp" 2>/dev/null
                        fi
                    fi
                    
                    rm -f "$fw_backup" 2>/dev/null
                fi
            fi
        fi
    fi



    # REMOVE FROM RT_TABLES
    if [ -f /etc/iproute2/rt_tables ]; then
        
        if grep -q "^[0-9]\+[[:space:]]\+$table_name$" /etc/iproute2/rt_tables 2>/dev/null; then
            local rt_backup="/etc/iproute2/rt_tables.backup.$$"
            local rt_temp="/etc/iproute2/rt_tables.temp.$$"
            
            cp /etc/iproute2/rt_tables "$rt_backup" 2>/dev/null
            
            grep -v "^[0-9]\+[[:space:]]\+$table_name$" /etc/iproute2/rt_tables > "$rt_temp" 2>/dev/null
            
            if [ -f "$rt_temp" ] && [ -s "$rt_temp" ]; then
                if ! diff -q /etc/iproute2/rt_tables "$rt_temp" >/dev/null 2>&1; then
                    if mv "$rt_temp" /etc/iproute2/rt_tables 2>/dev/null; then
                        verbose success "Table removed from rt_tables: $table_name"
                    else
                        mv "$rt_backup" /etc/iproute2/rt_tables 2>/dev/null
                    fi
                else
                    rm -f "$rt_temp" 2>/dev/null
                fi
            fi
            
            rm -f "$rt_backup" 2>/dev/null
        fi
    fi

    # COMMIT
    uci commit firewall 2>/dev/null
    /etc/init.d/firewall reload 2>/dev/null
    
    # UPDATE STATE
    if [ $wg_id_found -eq 0 ] && [ -n "$wg_id" ]; then
        state_write "ID_${wg_id}_IS_RT_TABLES_IN_USE" "0" 2>/dev/null
    fi

    # D0ne!
    echo ""
    success "$lan_iface routes (via $wg_iface) successfully removed!"
    
    return 0
}
