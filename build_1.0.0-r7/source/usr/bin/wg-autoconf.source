#####################################################################
# WG-AUTOCONF UPGRADE module
#
#   Safely upgrade the wg-autoconf package while avoiding file locking
#   conflicts by executing the upgrade from a temporary script.
#
#   - Provides safety warning about active connection interruption
#   - Two upgrade methods: local APK file or package repository
#   - Creates temporary executable script to release main binary
#   - Uses exec to replace current process, freeing the binary for update
#   - Validates APK file

#
# Workflow:
#   1. Display upgrade options menu (local file / repository)
#   2. For local file: validate path, existence, and .apk extension
#   3. Create temporary shell script in /tmp with upgrade commands
#   4. Make script executable and execute it via exec
#   5. exec replaces current process, freeing binary for overwrite
#   6. Script performs apk add operation and self-cleans
#
#
# File Management:
#   - Creates: /tmp/wg-autoconf-upgrading.sh (temporary, self-deleting)
#   - Updates: System package database and wg-autoconf binary
#
# Dependencies:
#   - apk package manager (Alpine Linux/OpenWrt)
#
# Usage Examples:
#   - wg-autoconf upgrade
#
#####################################################################
upgrade_tmp_script() {

    local script_path="$1"
    local apk_command="$2"
    local version="$3"

    debug_write "[UPGRADE] upgrade_tmp_script STARTED...."
    verbose log "Creating temporary upgrade script at: $script_path"

    # VERIFY tmp PATH
    if ! touch "$script_path" 2>/dev/null; then

        debug_write "[UPGRADE] Cannot create sh in /tmp. CHECK /tmp permissions ?"
        warning "Cannot create script in /tmp. Please provide an alternative path."

        local new_path=""

        while :; do

            printf "Enter path for upgrade script (E.g: /tmp/upgrade.sh): "
            read new_path

            if [ -z "$new_path" ]; then

                warnin "PATH cannot be empty!"
                continue
            fi


            local dir_path="${new_path%/*}"

            if [ ! -d "$dir_path" ]; then
                warning "Directory does not exist!: $dir_path"
                continue
            fi

            if [ ! -w "$dir_path" ]; then
                debug_write "[UPGRADE] Custom PATH exists BUT it is NOT writable. Check user/path permissions?"
                warning "Directory is not writable!: $dir_path"
                continue
            fi

            script_path="$new_path"
            verbose log "Using alternative script path: $script_path"
            break
        done
    fi

    echo '#!/bin/ash' > "$script_path"
    echo '' >> "$script_path"
    echo "# wg-autoconf $version UPDATER script" >> "$script_path"
    echo '' >> "$script_path"
    echo 'echo "Starting upgrade process..."' >> "$script_path"
    echo 'echo ""' >> "$script_path"
    echo '' >> "$script_path"
    echo "echo 'Launching : $apk_command'" >> "$script_path"
    echo 'echo ""' >> "$script_path"
    echo '' >> "$script_path"
    echo "$apk_command" >> "$script_path"
    echo '' >> "$script_path"
    echo 'echo ""' >> "$script_path"
    echo 'echo "Cleaning up temporary files..."' >> "$script_path"
    echo "rm -f $script_path" >> "$script_path"
    echo '' >> "$script_path"
    echo 'echo ""' >> "$script_path"
    echo 'echo "Upgrade completed!"' >> "$script_path"

    chmod 755 "$script_path"

    if [ -f "$script_path" ] && [ -x "$script_path" ]; then

        echo "$script_path"
        return 0

    else

        debug_write "[UPGRADE] Unexpected error executing uppgrade. PATH: $script_path. Check logread | tail -10 ? Check permissions?"
        verbose log "Failed to create executable script at: $script_path"
        return 1
    fi
}

upgrade_app() {

    local option
    local filepath
    local upgrade_script="/tmp/wg-autoconf-upgrading.sh"
    local apk_command=""

    echo ""
    ui_lines 50 "${GREEN}wg-autoconf${NC} ${RED}$VERSION${NC} ${YELLOW}UPGRADE Module${NC}"

    verbose log "This feature allows you to update wg-autoconf easily, either from a local .apk file or directly from source."
    verbose log "An executable will be created in /tmp to proceed with the installation, thereby releasing the main binary."
    verbose echo ""
    warning "Any active connection will be DROPPED during the update process!!!"

    echo ""
    echo -e "\e[1mPlease choose upgrade method:\e[0m"
    echo "  1) Using a local .apk file"
    echo "  2) From package sources"
    echo "  0) Exit"
    echo ""

    while :; do
        printf "Choose an option : "
        read option

        case "$option" in
            1|2)
                break
                ;;
            0|exit|EXIT|Exit)
                warning "Upgrade cancelled by the user!"
                exit 1
                ;;
            *)
                error "Invalid option!"
                ;;
        esac
    done

    echo ""

    case "$option" in
        1)
            while :; do
                debug_write "[UPGRADE] Custom local APK file mode selected ..."
                printf "Enter full PATH to local APK file (E.g., /tmp/file.apk): "
                read filepath

                if [ -z "$filepath" ]; then
                    warning "File path cannot be empty."
                    exit 1
                fi

                if ! [ -f "$filepath" ]; then
                    warning "File not found: $filepath"
                    exit 1
                fi

                if echo "$filepath" | grep "\.apk$" >/dev/null 2>&1; then
                    apk_command="apk add --force-overwrite \"$filepath\""
                    break

                else
                    debug_write "[UPGRADE ERROR] Custom APK file selected ERROR!. Check xxd $filepath, check proper apk file?"
                    echo "File does not appear to be an APK file. Please provide a .apk file."
                fi
            done
            ;;
        2)
            debug_write "[UPGRADE] Sources mode selected ..."
            apk_command="apk add --upgrade wg-autoconf"
            ;;
        *)
            debug_write "[UPGRADE ERROR] This option should not have been accessed! Tampered bin?"
            warning "Invalid option selected ($option). Aborting!"
            exit 1
            ;;
    esac

    local created_script

    created_script=$(upgrade_tmp_script "$upgrade_script" "$apk_command" "$VERSION")

    if [ $? -ne 0 ] || [ -z "$created_script" ]; then
        warning "Failed to create upgrade script!"
        exit 1
    fi

    upgrade_script="$created_script"

    echo ""
    log "Launching Upgrade module ..."
    verbose info "The current application will now terminate and the upgrade will begin."
    verbose info ""

    sleep 2

    # DEBUG! rel5
    # TODO:     Add sha expected sums for tmp script, and validation (or remove entire func)
    # REASON:
    #       Risky exec sh method may allowe tampered scripts, or contain errors
    # POSSIBLE FIX?:
    #       Add validation, by checking expexted sha sums
    #       Look for safer temp file paths (/dev/shm/ ?)
    #       Directly remove upgrade_app function!!!!
    exec sh "$upgrade_script"

    debug_write "[UPGRADE] Temporary update script FAILED! Check exec sh $upgrade_script availability, permissions, or changes on ASH"
    warning "Failed to launch upgrade script!"
    exit 1
}




