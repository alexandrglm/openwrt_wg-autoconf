#####################################################################
# CMD HEADER
#####################################################################
show_header() {

    echo ""
    echo -e "${GREEN}WireGuard Auto-Config${NC} - ${RED}$VERSION${NC}"
    echo ""
    echo -e "   ${BLUE}Usage:${NC} wg-autoconf ${YELLOW}COMMAND${NC} ${GREEN}<args>${NC}"
    echo -e "     ${YELLOW}'wg-autoconf --help' for full help${NC}"
    echo ""
}

#####################################################################
# SHOW HELP/UPSAGE
#####################################################################
show_usage() {
    
    # echo ""
    ui_lines 80 "${GREEN}WireGuard Auto-Config${NC} - ${RED}$VERSION${NC} HELP"
    echo ""

    echo -e "${GREEN}Configuration Management:${NC}"
    echo -e " ${YELLOW}list${NC}                             - List Available .conf files at /etc/wireguard"
    echo -e " ${YELLOW}list${NC} ${GREEN}<config file>${NC}               - Show configuration"
    echo -e " ${YELLOW}test${NC} ${GREEN}<config file>${NC}               - Test a .conf file"
    echo ""
    echo -e " ${YELLOW}setup${NC} ${GREEN}<config file>${NC}              - Setup from .conf (creates wg_<CONF_NAME>)"
    echo -e " ${YELLOW}manual${NC}                           - Create new advanced configuration from scratch"
    echo -e " ${YELLOW}manual${NC} ${GREEN}<config file>${NC}             - Advanced mode using existing .conf as base"
    echo ""

    echo -e "${BLUE}Interface Control:${NC}"
    echo -e " ${YELLOW}status${NC}                           - Show all WG interfaces"
    echo -e " ${YELLOW}status${NC} ${GREEN}<wg iface>${NC}                - Show specific WG interface"
    echo -e " ${YELLOW}up${NC} ${GREEN}<wg iface>${NC}                    - Enable WG interface"
    echo -e " ${YELLOW}down${NC} ${GREEN}<wg iface>${NC}                  - Disable WG interface"
    echo -e " ${YELLOW}remove${NC} ${GREEN}<wg iface>${NC}                - Delete WG interface (unsetup)"
    echo ""

    echo -e "${YELLOW}Routing & Traffic Control:${NC}"
    echo -e " ${YELLOW}routes show${NC}                      - Show all routes"
    echo -e " ${YELLOW}routes show${NC} ${GREEN}<wg iface>${NC}           - Show routes for WG interface"
    echo -e " ${YELLOW}routes set${NC} ${GREEN}<wg iface> <iface>${NC}    - Set routes: LAN -> WG"
    echo -e " ${YELLOW}routes unset${NC} ${GREEN}<wg iface> <iface>${NC}  - Unset routes: LAN -> WG"
    echo ""

    echo -e "\033[0;35mBackup/Recovery & Upgrade:\033[0m"
    echo -e " ${YELLOW}backups show${NC}                     - List available backups"
    echo -e " ${YELLOW}backups restore${NC} ${GREEN}<file>${NC}           - Restore backup files"
    echo ""
    echo -e " ${YELLOW}upgrade${NC}                          - Upgrade wg-autoconf safely"
    echo ""

    echo -e "${RED}Cleanup Operations:${NC}"
    echo -e " ${YELLOW}clean${NC}                            - Clean WG configs (interactive)"
    echo -e " ${YELLOW}clean${NC} ${GREEN}<wg iface>${NC}                 - Clean specific interface"
    echo -e " ${RED}nuke${NC}                             - ${RED}Force removal & cleanup ALL WG configs (no prompts)${NC}"

    echo ""
    echo -e "${GREEN}Verbosity Mode:${NC}"
    echo -e " ${YELLOW}--verbose / -v${NC}                   - Verbose mode for any command"

    echo ""
    echo -e "${GREEN}Debug Mode:${NC}"
    echo -e " ${YELLOW}debug on / off${NC}                   - Enable/Disable Debug logging functions"
    echo -e " ${YELLOW}debug clear${NC}                      - Clear latest/backuped logs"
    echo -e " ${YELLOW}debug show${NC}                       - Show latest debug log"
    echo -e " ${YELLOW}debug live${NC}                       - Tail debug log live"

    echo ""
    ui_lines 80 "${BLUE}Usage:${NC} wg-autoconf ${YELLOW}COMMAND${NC} ${GREEN}<args>${NC}"

    exit 1
}



