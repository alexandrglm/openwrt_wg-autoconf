#####################################################################
# WG-AUTOCONF UPGRADE module
#
#   Safely upgrade the wg-autoconf package while avoiding file locking
#   conflicts by executing the upgrade from a temporary script.
#
#   - Provides safety warning about active connection interruption
#   - Two upgrade methods: local APK file or package repository
#   - Creates temporary executable script to release main binary
#   - Uses exec to replace current process, freeing the binary for update
#   - Validates APK file

#
# Workflow:
#   1. Display upgrade options menu (local file / repository)
#   2. For local file: validate path, existence, and .apk extension
#   3. Create temporary shell script in /tmp with upgrade commands
#   4. Make script executable and execute it via exec
#   5. exec replaces current process, freeing binary for overwrite
#   6. Script performs apk add operation and self-cleans
#
#
# File Management:
#   - Creates: /tmp/wg-autoconf-upgrading.sh (temporary, self-deleting)
#   - Updates: System package database and wg-autoconf binary
#
# Dependencies:
#   - apk package manager (Alpine Linux/OpenWrt)
#
# Usage Examples:
#   - wg-autoconf upgrade
#
#####################################################################
upgrade_avoid_garbage() {
    
    debug_write "[UPGRADE GARBAGE] Checking for upgrade garbage..."

    # Hipotheticaly ... init not needed here    
    # state_init 2>/dev/null || {
    #     debug_write "[UPGRADE_GARBAGE] State file not found, assuming clean state"
    #     return 0
    # }
    
    local prev_upgrade=$(state_read "IS_PREV_TO_UPGRADE" 2>/dev/null)
    debug_write "[UPGRADE_GARBAGE] IS_PREV_TO_UPGRADE value: '$prev_upgrade'"
    
    # STATES PRECHECKS
    if [ -z "$prev_upgrade" ]; then
        
        debug_write "[UPGRADE GARBAGE] State file not found! Check setup/manual errors!"
        warning "Something went wrong! 'wg-autoconf nuke' is recommended at this point"

        exit 1
    fi
    
    if [ "$prev_upgrade" = "0" ]; then
        
        debug_write "[UPGRADE GARBAGE] Clean state detected! Continue setup OK!"
        return 0
    fi
    
    # if IS_PREV_TO_UPGRADE = 1
    if [ "$prev_upgrade" = "1" ]; then
        
        echo ""
        ui_lines 79 "${RED}WARNING: POTENTIAL UPGRADE GARBAGE DETECTED ${NC}"
        echo ""
        
        warning "A previous upgrade attempt was interrupted or failed!"
        echo ""
        
        echo -e "${YELLOW}Possible issues:${NC}"
        echo "  - WireGuard interfaces may be in inconsistent state"
        echo "  - Configuration files may be partially modified"
        echo "  - Active VPN connections might be unstable"
        echo ""
        
        echo -e "${GREEN}Recommended action:${NC}"
        echo "  Run: ${YELLOW}wg-autoconf nuke${NC}"
        echo ""
        echo "This will:"
        echo "  - Clean all WireGuard interfaces"
        echo "  - Restore original configuration files from backups"
        echo "  - Reset wg-autoconf internal state"
        echo ""
        
        echo -e "${YELLOW}After cleanup, you can:${NC}"
        echo "  - Re-setup your VPN connections"
        echo "  - Retry the upgrade if needed"
        echo ""
        
        ui_lines 79 "${RED}MANUAL INTERVENTION REQUIRED${NC}"
        echo ""
        
        read -p "Run 'wg-autoconf nuke' now? (y/N): " confirm
        case "$confirm" in
            y|Y|yes|YES|Yes|okidoki|OKIDOKI|Okidoki|OkiDoki)
                log "Running nuke to clean up upgrade garbage..."
                cleanup "nuke" "" ""
                ;;
            *)
                error "Cannot continue with potential upgrade garbage"
                warning "Run 'wg-autoconf nuke' first, or perform a full deinstall/reinstall"
                ;;
        esac
    fi
    
    

    success "Upgrade misfunction is fixed!"
    state_write "IS_PREV_TO_UPGRADE" "0" 2>/dev/null
    debug_write "[UPGRADE_GARBAGE] Reset IS_PREV_TO_UPGRADE to 0"
    
    return 0
}

upgrade_tmp_script() {

    local script_path="$1"
    local apk_command="$2"
    local version="$3"

    # 0)    UNCONDITIONAL PRECHECKS
    upgrade_avoid_garbage

    debug_write "[UPGRADE] upgrade_tmp_script STARTED...."
    
    # MOVER verbose log AQUÍ, antes de empezar a escribir el script
    verbose log "Creating temporary upgrade script at: $script_path"

    # VERIFY tmp PATH
    if ! touch "$script_path" 2>/dev/null; then

        debug_write "[UPGRADE] Cannot create sh in /tmp. CHECK /tmp permissions ?"
        warning "Cannot create script in /tmp. Please provide an alternative path."

        local new_path=""

        while :; do

            printf "Enter path for upgrade script (E.g: /tmp/upgrade.sh): "
            read new_path

            if [ -z "$new_path" ]; then

                warning "PATH cannot be empty!"
                continue
            fi


            local dir_path="${new_path%/*}"

            if [ ! -d "$dir_path" ]; then
                warning "Directory does not exist!: $dir_path"
                continue
            fi

            if [ ! -w "$dir_path" ]; then
                debug_write "[UPGRADE] Custom PATH exists BUT it is NOT writable. Check user/path permissions?"
                warning "Directory is not writable!: $dir_path"
                continue
            fi

            script_path="$new_path"
            verbose log "Using alternative script path: $script_path"
            break
        done
    fi

    # DEBUG! r7
    # TODO:     idk
    # I'm operating on the assumption here that the provided APK is valid
    # and the installation is going through without a hitch...
    #
    # An inspection method—using xxd would be perfect...
    # but it requires the NOT CORE xxd as dependence
    #
    # For the future... remove the entire upgrade option
    # Intentions are good, but a straightforward set of:
    #   - upgrade()
    #   - pre_upgrade()
    #   - post_upgrade() 
    # .... would be better to check and notice the user
    # whether there are any active wg iface is running
    # before upgrade/reinstall/uninstalling th app


    {
        echo "#!/bin/ash"
        echo "# wg-autoconf $version Updater Script"
        echo ''
        echo "STATE_FILE_UPGRADE='$STATE_FILE'"
        echo "DEBUG_LOG_UPGRADE='$DEBUG_LOG'"
        echo ''
        echo 'echo -e "\033[0;32mwg-autoconf\033[0m \033[1;31m'"$version"'\033[0m \033[1;33mUpdater Module\033[0m"'
        echo ''
        echo 'echo -e "\033[0;32mStarting upgrade process...\033[0m"'
        echo 'echo ""'
        echo ''
        echo 'echo -e "\033[0;33mLaunching:\033[0m \033[1m'"$apk_command"'\033[0m"'
        echo 'echo ""'
        echo ''
        echo "$apk_command"
        echo 'upgrade_exit=$?'
        echo ''
        echo 'if [ $upgrade_exit -eq 0 ]; then'
        echo ''
        echo '    if [ -f "$STATE_FILE_UPGRADE" ]; then'
        echo ''
        echo '        sed -i "s/^IS_PREV_TO_UPGRADE=.*/IS_PREV_TO_UPGRADE=0/" "$STATE_FILE_UPGRADE"'
        echo '        if grep -q "^IS_UPGRADED=" "$STATE_FILE_UPGRADE" 2>/dev/null; then'
        echo '            sed -i "s/^IS_UPGRADED=.*/IS_UPGRADED=1/" "$STATE_FILE_UPGRADE"'
        echo '        else'
        echo '            echo "IS_UPGRADED=1" >> "$STATE_FILE_UPGRADE"'
        echo '        fi'
        echo '    fi'
        echo ''
        echo '    if [ -f "$DEBUG_LOG_UPGRADE" ]; then'
        echo '        echo "[$(date "+%Y-%m-%d %H:%M:%S")] [UPGRADE External Module] Upgrade completed successfully" >> "$DEBUG_LOG_UPGRADE"'
        echo '    fi'
        echo ''
        echo '    echo ""'
        echo '    echo -e "\033[0;33mCleaning up temporary files...\033[0m"'
        echo "    rm -f $script_path"
        echo '    echo ""'
        echo '    echo -e "\033[0;32mUpgrade completed!\033[0m"'
        echo '    exit 0'
        echo ''
        echo 'else'
        echo '    if [ -f "$DEBUG_LOG_UPGRADE" ]; then'
        echo '        echo "[$(date "+%Y-%m-%d %H:%M:%S")] [UPGRADE Module] Upgrade failed with exit code: $upgrade_exit" >> "$DEBUG_LOG_UPGRADE"'
        echo '    fi'
        echo '    echo ""'
        echo '    echo -e "\033[0;33mCleaning up temporary files...\033[0m"'
        echo "    rm -f $script_path"
        echo '    echo ""'
        echo '    echo -e "\033[1;31mUpgrade failed with exit code: $upgrade_exit\033[0m"'
        echo '    exit $upgrade_exit'
        echo 'fi'
    } > "$script_path" 2>/dev/null

    chmod 755 "$script_path"

    if [ -f "$script_path" ] && [ -x "$script_path" ]; then

        echo "$script_path"
        return 0

    else

        debug_write "[UPGRADE] Unexpected error executing uppgrade. PATH: $script_path. Check logread | tail -10 ? Check permissions?"
        verbose log "Failed to create executable script at: $script_path"
        return 1
    fi
}

upgrade_app() {

    local option
    local filepath
    local upgrade_script="/tmp/wg-autoconf-upgrading.sh"
    local apk_command=""

    echo ""
    ui_lines 50 "${GREEN}wg-autoconf${NC} ${RED}$VERSION${NC} ${YELLOW}UPGRADE Module${NC}"

    verbose log "This feature allows you to update wg-autoconf easily, either from a local .apk file or directly from source."
    verbose log "An executable will be created in /tmp to proceed with the installation, thereby releasing the main binary."
    verbose echo ""
    warning "Any active connection will be DROPPED during the update process!!!"

    echo ""
    echo -e "\e[1mPlease choose upgrade method:\e[0m"
    echo "  1) Using a local .apk file"
    echo "  2) From package sources"
    echo "  0) Exit"
    echo ""

    while :; do
        printf "Choose an option : "
        read option

        case "$option" in
            1|2)
                break
                ;;
            0|exit|EXIT|Exit)
                warning "Upgrade cancelled by the user!"
                exit 1
                ;;
            *)
                error "Invalid option!"
                ;;
        esac
    done

    echo ""

    case "$option" in
        1)
            while :; do
                debug_write "[UPGRADE] Custom local APK file mode selected ..."
                printf "Enter full PATH to local APK file (E.g., /tmp/file.apk): "
                read filepath

                if [ -z "$filepath" ]; then
                    warning "File path cannot be empty."
                    exit 1
                fi

                if ! [ -f "$filepath" ]; then
                    warning "File not found: $filepath"
                    exit 1
                fi

                if echo "$filepath" | grep "\.apk$" >/dev/null 2>&1; then
                    apk_command="apk add --force-overwrite --allow-untrusted \"$filepath\""
                    break

                else
                    debug_write "[UPGRADE ERROR] Custom APK file selected ERROR!. Check xxd $filepath, check proper apk file?"
                    echo "File does not appear to be an APK file. Please provide a .apk file."
                fi
            done
            ;;
        2)
            debug_write "[UPGRADE] Sources mode selected ..."
            apk_command="apk add --upgrade wg-autoconf"
            ;;
        *)
            debug_write "[UPGRADE ERROR] This option should not have been accessed! Tampered bin?"
            warning "Invalid option selected ($option). Aborting!"
            exit 1
            ;;
    esac

    local created_script

    created_script=$(upgrade_tmp_script "$upgrade_script" "$apk_command" "$VERSION")

    if [ $? -ne 0 ] || [ -z "$created_script" ]; then
        warning "Failed to create upgrade script!"
        exit 1
    fi

    upgrade_script="$created_script"

    # STATES IS_PREV_TO_UPGRADE
    state_write "IS_PREV_TO_UPGRADE" "1" 2>/dev/null
    debug_write "[UPGRADE] Set IS_PREV_TO_UPGRADE=1"

    # echo ""
    log "Launching Upgrade module ..."
    verbose log "The current application will now terminate and the upgrade will begin."
    verbose log ""

    sleep 2

    # DEBUG! rel5
    # TODO:     Add sha expected sums for tmp script, and validation (or remove entire func)
    # REASON:
    #       Risky exec sh method may allowe tampered scripts, or contain errors
    # POSSIBLE FIX?:
    #       Add validation, by checking expexted sha sums
    #       Look for safer temp file paths (/dev/shm/ ?)
    #       Directly remove upgrade_app function!!!!
    exec sh "$upgrade_script"


    debug_write "[UPGRADE] Temporary update script FAILED! Check exec sh $upgrade_script availability, permissions, or changes on ASH"
    warning "Failed to launch upgrade script!"
    exit 1
}




