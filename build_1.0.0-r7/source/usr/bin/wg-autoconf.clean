VERSION="v1.0.0-r7-DEBUG"
STATE_FILE="/usr/libexec/wg-autoconf/states"
STATE_DIR="/usr/libexec/wg-autoconf"
WG_CONF_DIR="/etc/wireguard"
NETWORK_CONF="/etc/config/network"
DHCP_CONF="/etc/config/dhcp"
FIREWALL_CONF="/etc/config/firewall"
BACKUP_PATHS="$NETWORK_CONF $DHCP_CONF $FIREWALL_CONF"
ATOMIC_PATHS="/usr/libexec/wg-autoconf/atomics"
DEBUG_PATH="/usr/libexec/wg-autoconf/debug"
DEBUG_LOG="$DEBUG_PATH/wg-autoconf.log"
DEBUG_LOG_MAX_SIZE=512
DEBUG_IS_ACTIVE=0
ADVANCED_MODE=0
CONF_NAME=""
VERBOSE=0
RED='\033[1;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'
log() { echo -e "${BLUE}[wg-autoconf]${NC} $1"; }
error() { echo -e "${RED}[ERROR]${NC} $1"; exit 1; }
success() { echo -e "${GREEN}[OK]${NC} $1"; }
warning() { echo -e "${YELLOW}[WARNING]${NC} $1"; }
ui_lines() {
    length="$1"
    shift
    if [ -z "$1" ]; then
        printf '%*s\n' "$length" '' | tr ' ' '='
        return
    fi
    coloured_title="$*"
    clean_length=$(printf '%b' "$coloured_title" | sed 's/\x1b\[[0-9;]*m//g' | awk '{print length($0)}')
    base_length=$((clean_length + 5))
    padding=$((length - base_length))
    printf '==[ '
    printf '%b' "$coloured_title"
    printf ' ]'
    [ "$padding" -gt 0 ] && printf '%*s' "$padding" '' | tr ' ' '='
    printf '\n'
}
get_all_wg_interfaces() {
    uci show network 2>/dev/null | grep "network\.wg[^=]*=interface" | cut -d. -f2 | cut -d= -f1 | sort -u
}
validate_iface_name() {
    local iface="$1"
    if ! echo "$iface" | grep -q "^wg"; then
        error "Interface name must start with 'wg'"
    fi
}
iface_exists() {
    local iface="$1"
    uci get "network.$iface" >/dev/null 2>&1
}
address_exists() {
    local address="$1"
    local exclude_iface="${2:-}"
    local existing_ifaces=$(get_all_wg_interfaces)
    for iface in $existing_ifaces; do
        [ "$iface" = "$exclude_iface" ] && continue
        local existing_addr=$(uci get "network.$iface.addresses" 2>/dev/null)
        if [ "$existing_addr" = "$address" ]; then
            echo "$iface"
            return 0
        fi
    done
    return 1
}
get_next_tag_id() {
    local file="$1"
    local tag="$2"
    local max_id=$(grep "# wg-autoconf $tag start id" "$file" 2>/dev/null | sed 's/.*id //g' | sort -n | tail -1)
    [ -z "$max_id" ] && max_id=0
    echo $((max_id + 1))
}
remove_tagged_block() {
    local file="$1"
    local tag="$2"
    local tag_id="$3"
    debug_write "[REMOVE TAG] Starting: file=$file, tag=$tag, id=$tag_id"
    [ -f "$file" ] || {
        debug_write "[REMOVE TAG ERROR] File not found: $file"
        error "$file does not exist!"
        return 1
    }
    if ! grep -q "# wg-autoconf $tag start id $tag_id" "$file" 2>/dev/null; then
        warning "Tag '$tag' with id $tag_id not found in $file. Skipping..."
        debug_write "[REMOVE TAG] Tag not found, skipping"
        return 0
    fi
    local start_line=$(grep -n "# wg-autoconf $tag start id $tag_id" "$file" 2>/dev/null | cut -d: -f1)
    local end_line=$(grep -n "# wg-autoconf $tag end id $tag_id" "$file" 2>/dev/null | cut -d: -f1)
    if [ -z "$start_line" ] || [ -z "$end_line" ]; then
        warning "Cannot find start/end lines for tag $tag id $tag_id"
        debug_write "[REMOVE TAG ERROR] Cannot find start/end lines: start=$start_line, end=$end_line"
        return 1
    fi
    if [ "$start_line" -ge "$end_line" ]; then
        warning "Invalid tag range: start=$start_line, end=$end_line"
        debug_write "[REMOVE TAG ERROR] Invalid range: start=$start_line >= end=$end_line"
        return 1
    fi
    debug_write "[REMOVE TAG] Found lines: start=$start_line, end=$end_line"
    local temp_file="${ATOMIC_PATHS}/$(basename "$file").${tag}.${tag_id}.atomic"
    debug_write "[REMOVE TAG] Using temp file: $temp_file"
    if ! head -n $((start_line - 1)) "$file" > "$temp_file" 2>/dev/null; then
        debug_write "[REMOVE TAG ERROR] head command failed"
        rm -f "$temp_file" 2>/dev/null
        return 1
    fi
    if [ ! -f "$temp_file" ]; then
        debug_write "[REMOVE TAG ERROR] Temp file not created after head"
        return 1
    fi
    if ! tail -n +$((end_line + 1)) "$file" >> "$temp_file" 2>/dev/null; then
        debug_write "[REMOVE TAG ERROR] tail command failed"
        rm -f "$temp_file" 2>/dev/null
        return 1
    fi
    if [ ! -s "$temp_file" ]; then
        warning "Resulting file would be empty after removing '$tag' block"
        debug_write "[REMOVE TAG ERROR] Temp file empty or missing"
        rm -f "$temp_file" 2>/dev/null
        return 1
    fi
    local orig_perm="644"
    if command -v stat >/dev/null 2>&1 && stat -c "%a" "$file" >/dev/null 2>&1; then
        orig_perm=$(stat -c "%a" "$file" 2>/dev/null || echo "644")
    else
        orig_perm=$(ls -l "$file" | awk '{print $1}' 2>/dev/null | grep -o '...$' | tr 'rwx-' '4210' 2>/dev/null || echo "644")
    fi
    debug_write "[REMOVE TAG] Original permissions: $orig_perm"
    if ! mv "$temp_file" "$file" 2>/dev/null; then
        debug_write "[REMOVE TAG ERROR] mv failed: $temp_file -> $file"
        rm -f "$temp_file" 2>/dev/null
        error "Failed to remove block from $file"
        return 1
    fi
    if ! chmod "$orig_perm" "$file" 2>/dev/null; then
        debug_write "[REMOVE TAG WARNING] Failed to restore permissions for $file"
    fi
    verbose success "Removed '$tag' block (id: $tag_id) from $file"
    debug_write "[REMOVE TAG] Successfully removed $tag block id $tag_id from $file"
    return 0
}
clean_wg_key() {
    local key="$1"
    key=$(echo "$key" | sed 's/^[ \t]*//;s/[ \t]*$//')
    key=$(echo "$key" | tr -d '\r\n')
    [ "${key:0:1}" = "+" ] && key="${key:1}"
    local len=${#key}
    [ $len -eq 43 ] && key="${key}="
    echo "$key"
}
get_conf_value() {
    local key="$1"
    local file="$2"
    grep "^$key[ \t]*=" "$file" 2>/dev/null | head -1 | cut -d= -f2- | sed 's/^[ \t]*//;s/[ \t]*$//'
}
process_allowed_ips() {
    local ips="$1"
    ips=$(echo "$ips" | sed 's/^[ \t]*//;s/[ \t]*$//')
    echo "$ips" | tr ',' '\n' | sed 's/^[ \t]*//;s/[ \t]*$//' | grep -v '^$'
}
netmask_to_cidr() {
    local mask="$1"
    case "$mask" in
        255.255.255.0)   echo 24 ;;
        255.255.255.128) echo 25 ;;
        255.255.255.192) echo 26 ;;
        255.255.255.224) echo 27 ;;
        255.255.255.240) echo 28 ;;
        255.255.255.248) echo 29 ;;
        255.255.255.252) echo 30 ;;
        255.255.0.0)     echo 16 ;;
        255.0.0.0)       echo 8 ;;
        *)               echo 24 ;;
    esac
}
ip_to_network() {
    local ip="$1"
    local cidr="$2"
    case "$cidr" in
        24)
            echo "${ip%.*}.0"
            ;;
        25|26|27|28|29)
            local octet=${ip##*.}
            local bits=$((32 - cidr))
            local step=1 i
            i=0
            while [ $i -lt $bits ]; do
                step=$((step * 2))
                i=$((i + 1))
            done
            step=$((256 / step))
            local net=$(( (octet / step) * step ))
            echo "${ip%.*}.$net"
            ;;
        16)
            echo "${ip%.*.*}.0"
            ;;
        8)
            echo "${ip%.*.*.*}.0"
            ;;
        *)
            echo "${ip%.*}.0"
            ;;
    esac
}
clean_dns_uci() {
    local dns="$1"
    [ -z "$dns" ] && dns="1.1.1.1 1.0.0.1"
    dns=$(echo "$dns" | tr ',' ' ' | sed 's/\s\+/ /g' | sed 's/^ //;s/ $//')
    echo "$dns"
}
clean_dns_conf() {
    local dns="$1"
    [ -z "$dns" ] && dns="1.1.1.1, 1.0.0.1"
    dns=$(echo "$dns" | tr ' ' ',' | sed 's/,/, /g' | sed 's/, ,/,/g' | sed 's/^, //;s/, $//')
    dns=$(echo "$dns" | sed 's/,/, /g')
    echo "$dns"
}
validate_dns_format() {
    local dns="$1"
    local format="$2"  # "uci" o "conf"
    [ -z "$dns" ] && return 0  # Vacío es válido (usará defaults)
    if [ "$format" = "uci" ]; then
        echo "$dns" | tr ' ' '\n' | while read -r server; do
            [ -z "$server" ] && continue
            if ! echo "$server" | grep -qE '^([0-9]{1,3}\.){3}[0-9]{1,3}$' && \
               ! echo "$server" | grep -qE '^[a-fA-F0-9:]+(:[a-fA-F0-9:]+)*$'; then
                error "Invalid DNS server format: $server"
            fi
        done
    else
        echo "$dns" | tr ',' '\n' | while read -r server; do
            server=$(echo "$server" | sed 's/^ //;s/ $//')
            [ -z "$server" ] && continue
            if ! echo "$server" | grep -qE '^([0-9]{1,3}\.){3}[0-9]{1,3}$' && \
               ! echo "$server" | grep -qE '^[a-fA-F0-9:]+(:[a-fA-F0-9:]+)*$'; then
                error "Invalid DNS server format: $server"
            fi
        done
    fi
    return 0
}
get_dns_from_conf() {
    local conf_file="$1"
    local dns_line=$(grep -i "^DNS[[:space:]]*=" "$conf_file" 2>/dev/null | head -1)
    if [ -n "$dns_line" ]; then
        local dns_value=$(echo "$dns_line" | cut -d= -f2- | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
        if validate_dns_format "$dns_value" "conf" 2>/dev/null; then
            echo "$dns_value"
            return 0
        else
            warning "Invalid DNS format in $conf_file, using defaults"
        fi
    fi
    echo "1.1.1.1, 1.0.0.1"
    return 1
}
verbose() {
    if [ "$VERBOSE" = "1" ]; then
        "$@"
    fi
}
show_header() {
    echo ""
    echo -e "${GREEN}WireGuard Auto-Config${NC} for OpenWrt ${RED}$VERSION${NC}"
    echo ""
    echo "   Usage: wg-autoconf COMMAND [args]"
    echo -e "   ${YELLOW}'wg-autoconf --help' for full help${NC}"
    echo ""
}
show_usage() {
    echo ""
    ui_lines 80 "${GREEN}WireGuard Auto-Config${NC} for OpenWrt ${RED}$VERSION${NC}"
    echo ""
    echo -e "${BLUE}Usage:${NC} wg-autoconf <cmd> [args]"
    echo ""
    echo -e "${GREEN}Configuration Management:${NC}"
    echo -e "  ${YELLOW}list${NC}                           - List all .conf files"
    echo -e "  ${YELLOW}list${NC} <conf name>               - Show configuration"
    echo -e "  ${YELLOW}test${NC} <CONF_NAME>               - Test .conf file"
    echo -e "  ${YELLOW}setup${NC} <CONF_NAME>              - Setup from .conf (creates wg-<CONF_NAME>)"
    echo -e "  ${YELLOW}setup --advanced${NC}               - Interactive setup (manual naming)"
    echo -e "  ${YELLOW}setup --advanced [conf]${NC}        - Advanced with .conf defaults"
    echo ""
    echo -e "${BLUE}Interface Control:${NC}"
    echo -e "  ${YELLOW}status${NC}                         - Show all WG interfaces"
    echo -e "  ${YELLOW}status${NC} <wg_iface>              - Show specific WG interface"
    echo -e "  ${YELLOW}up${NC} <wg_iface>                  - Enable WG interface"
    echo -e "  ${YELLOW}down${NC} <wg_iface>                - Disable WG interface"
    echo -e "  ${YELLOW}remove${NC} <wg_iface>              - Delete WG interface (unsetup)"
    echo ""
    echo -e "${YELLOW}Routing & Traffic Control:${NC}"
    echo -e "  ${YELLOW}routes show${NC}                    - Show all routes"
    echo -e "  ${YELLOW}routes show${NC} <wg_iface>         - Show routes for WG interface"
    echo -e "  ${YELLOW}routes set${NC} <wg_iface> <lan>    - Set routes: LAN -> WG"
    echo -e "  ${YELLOW}routes unset${NC} <wg_iface> <lan>  - Unset routes: LAN -> WG"
    echo ""
    echo -e "\033[0;35mBackup/Recovery & Upgrade:\033[0m"
    echo -e "  ${YELLOW}backups show${NC}                   - List available backups"
    echo -e "  ${YELLOW}backups restore${NC} [name]         - Restore backup files"
    echo ""
    echo -e "  ${YELLOW}upgrade${NC} [name]                  - Upgrade wg-autoconf safely"
    echo ""
    echo -e "${RED}Cleanup Operations:${NC}"
    echo -e "  ${YELLOW}clean${NC}                          - Clean WG configs (interactive)"
    echo -e "  ${YELLOW}clean${NC} <wg_iface>               - Clean specific interface"
    echo -e "  ${RED}nuke${NC}                           - ${RED}Remove ALL WG configs (no prompts)${NC}"
    echo""
    echo -e "${GREEN}Available arguments:${NC}"
    echo ""
    echo -e "  ${YELLOW}--verbose / -v${NC}                 - Verbose mode for any command"
    echo ""
    echo -e "${GREEN}Examples:${NC}"
    echo -e "  ${YELLOW}wg-autoconf setup us21${NC} / ${YELLOW}wg-autoconf setup --advanced${NC}"
    echo -e "  ${YELLOW}wg-autoconf up wg-us21${NC} / ${YELLOW}wg-autoconf down wg-us21${NC}"
    echo -e "  ${YELLOW}wg-autoconf routes set${NC} wg-us21 lan4"
    echo -e "  ${YELLOW}wg-autoconf routes unset${NC} wg-us21 lan4"
    echo -e "  ${YELLOW}wg-autoconf remove wg-us21${NC}"
    echo -e "  ${YELLOW}wg-autoconf clean${NC} / ${YELLOW}wg-autoconf clean wg-us21${NC}"
    echo -e "  ${RED}wg-autoconf nuke${NC}"
    ui_lines 80
    verbose ui_lines 50 " VERBOSE MODE ON TEST"
    exit 1
}
list_configs() {
    local file_arg="$1"
    if [ -n "$file_arg" ]; then
        local conf_file="$WG_CONF_DIR/$file_arg.conf"
        if [ ! -f "$conf_file" ]; then
            error "Configuration file $file_arg not found!"
        fi
        log "Configuration file: $file_arg"
        echo ""
        echo -e "${BLUE}$(basename $conf_file)${NC}"
        ui_lines 50
        cat "$conf_file" | sed 's/^/   /'
        echo ""
        ui_lines 50
        return
    fi
    echo ""
    log ".conf files on $WG_CONF_DIR:"
    ui_lines 50
    local count=0
    local line=""
    local found=0
    for conf in "$WG_CONF_DIR"/*.conf; do
        [ -f "$conf" ] || continue
        found=1
        name=$(basename "$conf" .conf)
        if [ $count -eq 5 ]; then
            echo -e "${GREEN}$line${NC}"
            line="   $name"
            count=1
        else
            if [ $count -eq 0 ]; then
                line="   $name"
            else
                line="$line | $name"
            fi
            count=$((count + 1))
        fi
    done
    if [ $found -eq 0 ]; then
        warning "No configuration files found in $WG_CONF_DIR"
    else
        [ -n "$line" ] && echo -e "${GREEN}$line${NC}"
    fi
    ui_lines 50
}
list_configs_full() {
    log ".conf files (FULL):"
    echo ""
    ui_lines 50
    local found=0
    for conf in "$WG_CONF_DIR"/*.conf; do
        [ -f "$conf" ] || continue
        found=1
        echo -e "${BLUE}$(basename $conf)${NC}"
        ui_lines 40
        cat "$conf" | sed 's/^/   /'
        echo ""
        ui_lines 40
        echo ""
    done
    if [ $found -eq 0 ]; then
        warning "No configuration files found in $WG_CONF_DIR"
        ui_lines 50
    else
        ui_lines 50
    fi
}
test_config() {
    local CONF_NAME="$1"
    local conf_file="$WG_CONF_DIR/$CONF_NAME.conf"
    [ -f "$conf_file" ] || error "[ERROR] $conf_file does not exist!"
    log "Testing $CONF_NAME.conf..."
    private_key_raw=$(get_conf_value "PrivateKey" "$conf_file")
    public_key_raw=$(get_conf_value "PublicKey" "$conf_file")
    [ -z "$private_key_raw" ] && error "PrivateKey NOT FOUND!"
    [ -z "$public_key_raw" ] && error "PublicKey NOT FOUND!"
    private_key_clean=$(clean_wg_key "$private_key_raw")
    public_key_clean=$(clean_wg_key "$public_key_raw")
    echo ""
    ui_lines 80 "Key Validation"
    echo "Private Key: $private_key_clean"
    echo "Public Key: $public_key_clean"
    echo ""
    echo "Testing wg keys ..."
    echo ""
    if echo "$private_key_clean" | wg pubkey >/dev/null 2>&1; then
        success "VALID PrivateKey!"
    else
        error "Private key IS NOT VALID!!!"
    fi
    if echo "$public_key_clean" | wg pubkey >/dev/null 2>&1; then
        success "VALID PublicKey!"
    else
        warning "Public key IS NOT VALID!!!"
    fi
    ui_lines 80
}
setup_network_config() {
    local iface_name="$1"
    local private_key="$2"
    local address="$3"
    local public_key="$4"
    local endpoint_host="$5"
    local endpoint_port="$6"
    local allowed_ips="$7"
    local dns="$8"
    local dns_uci=$(clean_dns_uci "$dns")
    validate_dns_format "$dns_uci" "uci"
    verbose log "Setting up NETWORK config for $iface_name..."
    debug_write "[SETUP NETWORK] Starting config for $iface_name"
    if uci get "network.$iface_name" >/dev/null 2>&1; then
        warning "Interface $iface_name already exists in network config"
        debug_write "[SETUP NETWORK] Interface already exists: $iface_name"
        return 0
    fi
    local tag_id=$(get_next_tag_id "$NETWORK_CONF" "network")
    debug_write "[SETUP NETWORK] Using tag id: $tag_id"
    if grep -q "# wg-autoconf network start id $tag_id" "$NETWORK_CONF" 2>/dev/null; then
        warning "NETWORK tag with id $tag_id already exists. Skipping..."
        debug_write "[SETUP NETWORK ERROR] Tag id $tag_id already exists"
        return 0
    fi
    local allowed_ips_list=$(echo "$allowed_ips" | tr ' ' '\n' | sed 's/^[ \t]*//;s/[ \t]*$//' | grep -v '^$')
    local new_content="
# wg-autoconf network start id $tag_id
config interface '$iface_name'
    option proto 'wireguard'
    option private_key '$private_key'
    option addresses '$address'
    option dns '$dns_uci'
config wireguard_$iface_name '${iface_name}_peer'
    option public_key '$public_key'
    option endpoint_host '$endpoint_host'
    option endpoint_port '$endpoint_port'
    option route_allowed_ips '0'
    option persistent_keepalive '25'
"
    echo "$allowed_ips_list" | while read -r ip; do
        new_content="${new_content}    list allowed_ips '$ip'
"
    done
    new_content="${new_content}# wg-autoconf network end id $tag_id
"
    local atomic_temp="${ATOMIC_PATHS}/network.atomic"
    debug_write "[SETUP NETWORK] Using atomic temp: $atomic_temp"
    if ! cp "$NETWORK_CONF" "$atomic_temp" 2>/dev/null; then
        error "Cannot copy network config for atomic operation"
        return 1
    fi
    echo "$new_content" >> "$atomic_temp" 2>/dev/null
    if ! mv "$atomic_temp" "$NETWORK_CONF" 2>/dev/null; then
        error "Atomic replacement of network config failed"
        rm -f "$atomic_temp" 2>/dev/null
        return 1
    fi
    debug_write "[SETUP NETWORK] Committing UCI network config"
    if ! uci commit network 2>/dev/null; then
        warning "Failed to commit network configuration"
        debug_write "[SETUP NETWORK ERROR] uci commit network failed"
        return 1
    fi
    verbose success "Added NETWORK config for $iface_name (id: $tag_id)"
    debug_write "[SETUP NETWORK] Successfully added $iface_name with tag id $tag_id"
    return 0
}
setup_dhcp_config() {
    local iface_name="$1"
    verbose log "Setting up DHCP config for $iface_name..."
    debug_write "[SETUP DHCP] Starting config for $iface_name"
    if uci get "dhcp.$iface_name" >/dev/null 2>&1; then
        warning "DHCP config for $iface_name already exists"
        debug_write "[SETUP DHCP] Config already exists: $iface_name"
        return 0
    fi
    local tag_id=$(get_next_tag_id "$DHCP_CONF" "dhcp")
    debug_write "[SETUP DHCP] Using tag id: $tag_id"
    if grep -q "# wg-autoconf dhcp start id $tag_id" "$DHCP_CONF" 2>/dev/null; then
        warning "DHCP tag with id $tag_id already exists. Skipping..."
        debug_write "[SETUP DHCP ERROR] Tag id $tag_id already exists"
        return 0
    fi
    local new_content="
# wg-autoconf dhcp start id $tag_id
config dhcp '$iface_name'
    option interface '$iface_name'
    option ignore '1'
# wg-autoconf dhcp end id $tag_id
"
    local atomic_temp="${ATOMIC_PATHS}/dhcp.atomic"
    debug_write "[SETUP DHCP] Using atomic temp: $atomic_temp"
    if ! cp "$DHCP_CONF" "$atomic_temp" 2>/dev/null; then
        error "Cannot copy DHCP config for atomic operation"
        return 1
    fi
    echo "$new_content" >> "$atomic_temp" 2>/dev/null
    if ! mv "$atomic_temp" "$DHCP_CONF" 2>/dev/null; then
        error "Atomic replacement of DHCP config failed"
        rm -f "$atomic_temp" 2>/dev/null
        return 1
    fi
    debug_write "[SETUP DHCP] Committing UCI DHCP config"
    if ! uci commit dhcp 2>/dev/null; then
        warning "Failed to commit DHCP configuration"
        debug_write "[SETUP DHCP ERROR] uci commit dhcp failed"
        return 1
    fi
    verbose success "Added DHCP config for $iface_name (id: $tag_id)"
    debug_write "[SETUP DHCP] Successfully added $iface_name with tag id $tag_id"
    return 0
}
setup_firewall_config() {
    local iface_name="$1"
    local endpoint_port="$2"
    verbose log "Setting up Firewall config for $iface_name..."
    debug_write "[SETUP FIREWALL] Starting config for $iface_name (port: $endpoint_port)"
    if uci get "firewall.$iface_name" >/dev/null 2>&1; then
        warning "Firewall zone for $iface_name already exists"
        debug_write "[SETUP FIREWALL] Zone already exists: $iface_name"
        return 0
    fi
    local tag_id=$(get_next_tag_id "$FIREWALL_CONF" "firewall")
    debug_write "[SETUP FIREWALL] Using tag id: $tag_id"
    if grep -q "# wg-autoconf firewall start id $tag_id" "$FIREWALL_CONF" 2>/dev/null; then
        warning "Firewall tag with id $tag_id already exists. Skipping..."
        debug_write "[SETUP FIREWALL ERROR] Tag id $tag_id already exists"
        return 0
    fi
    local new_content="
# wg-autoconf firewall start id $tag_id
config zone
    option name '$iface_name'
    option input 'ACCEPT'
    option output 'ACCEPT'
    option forward 'ACCEPT'
    option masq '1'
    option mtu_fix '1'
    list network '$iface_name'
config rule
    option name 'Allow-WireGuard-$iface_name'
    option src 'wan'
    option dest_port '$endpoint_port'
    option proto 'udp'
    option target 'ACCEPT'
config forwarding
    option src '$iface_name'
    option dest 'wan'
# wg-autoconf firewall end id $tag_id
"
    local atomic_temp="${ATOMIC_PATHS}/firewall.atomic"
    debug_write "[SETUP FIREWALL] Using atomic temp: $atomic_temp"
    if ! cp "$FIREWALL_CONF" "$atomic_temp" 2>/dev/null; then
        error "Cannot copy firewall config for atomic operation"
        return 1
    fi
    echo "$new_content" >> "$atomic_temp" 2>/dev/null
    if ! mv "$atomic_temp" "$FIREWALL_CONF" 2>/dev/null; then
        error "Atomic replacement of firewall config failed"
        rm -f "$atomic_temp" 2>/dev/null
        return 1
    fi
    debug_write "[SETUP FIREWALL] Committing UCI firewall config"
    if ! uci commit firewall 2>/dev/null; then
        warning "Failed to commit firewall configuration"
        debug_write "[SETUP FIREWALL ERROR] uci commit firewall failed"
        return 1
    fi
    debug_write "[SETUP FIREWALL] Reloading firewall service"
    if ! /etc/init.d/firewall reload 2>/dev/null; then
        warning "Failed to reload firewall (configuration may still work)"
        debug_write "[SETUP FIREWALL WARNING] Firewall reload failed"
    else
        debug_write "[SETUP FIREWALL] Firewall reloaded successfully"
    fi
    verbose success "Added Firewall config for $iface_name (id: $tag_id, port: $endpoint_port)"
    debug_write "[SETUP FIREWALL] Successfully added $iface_name with tag id $tag_id"
    return 0
}
setup_wireguard() {
    local conf_name="$1"
    local mode="$2"
    local conf_file=""
    local is_manual=0
    [ "$mode" = "manual" ] && is_manual=1
    if [ -n "$conf_name" ]; then
        conf_file="$WG_CONF_DIR/$conf_name.conf"
        if [ ! -f "$conf_file" ]; then
            if [ $is_manual -eq 0 ]; then
                error "$conf_file is missing!!!"
            else
                warning "Configuration file not found: $conf_file"
                conf_file=""
            fi
        else
            if [ $is_manual -eq 1 ]; then
                log "Loading defaults from $conf_name.conf..."
            fi
        fi
    fi
    state_init
    if ! state_check_first_exec; then
        log "Checking previous WireGuard configuration..."
        local active_ifaces=$(get_all_wg_interfaces)
        local has_tags=$(grep -c "# wg-autoconf" "$NETWORK_CONF" "$DHCP_CONF" "$FIREWALL_CONF" 2>/dev/null | grep -v ":0$" | wc -l)
        local has_tables=$(grep -c "_vpn_" /etc/iproute2/rt_tables 2>/dev/null || echo 0)
        if [ -n "$active_ifaces" ] || [ "$has_tags" -gt 0 ] || [ "$has_tables" -gt 0 ]; then
            warning "Found previous configuration (ifaces: $active_ifaces, tags: $has_tags, tables: $has_tables)"
            log "Run 'wg-autoconf nuke' to clean before setup, or continue at your own risk"
            read -p "Continue anyway? (y/N): " response
            case "$response" in
                y|Y|yes|YES|Yes) ;;
                *) error "Setup cancelled" ;;
            esac
        else
            state_write "IS_FIRST_EXEC" "1"
            debug_write "[SETUP] No config found, IS_FIRST_EXEC reset to 1"
        fi
    fi
    local iface_name=""
    local private_key=""
    local public_key=""
    local address=""
    local endpoint_host=""
    local endpoint_port=""
    local allowed_ips=""
    local dns=""
    if [ $is_manual -eq 0 ]; then
        log "Setting up wg from $conf_name.conf..."
        echo ""
        private_key=$(get_conf_value "PrivateKey" "$conf_file")
        public_key=$(get_conf_value "PublicKey" "$conf_file")
        address=$(get_conf_value "Address" "$conf_file")
        endpoint=$(get_conf_value "Endpoint" "$conf_file")
        allowed_ips_raw=$(get_conf_value "AllowedIPs" "$conf_file")
        dns=$(get_dns_from_conf "$conf_file")
        debug_write "[SETUP AUTO] DNS from conf: $dns"
        [ -z "$private_key" ] && error "Missing PrivateKey"
        [ -z "$public_key" ] && error "Missing PublicKey"
        [ -z "$address" ] && error "Missing Address"
        private_key=$(clean_wg_key "$private_key")
        public_key=$(clean_wg_key "$public_key")
        endpoint_host=$(echo "$endpoint" | cut -d: -f1)
        endpoint_port=$(echo "$endpoint" | cut -d: -f2)
        [ -z "$endpoint_port" ] && endpoint_port="51820"
        if [ -n "$allowed_ips_raw" ]; then
            allowed_ips=$(process_allowed_ips "$allowed_ips_raw" | tr '\n' ' ')
        else
            allowed_ips="0.0.0.0/0"
        fi
        [ -z "$dns" ] && dns="1.1.1.1 1.0.0.1"
        iface_name="wg_$conf_name"
        local collision=$(address_exists "$address")
        if [ -n "$collision" ]; then
            error "Address $address already in use by $collision!"
            debug_write "[SETUP AUTO] IP collision: $address for $iface_name"
        fi
    else
        log "Starting MANUAL setup (interactive configuration)..."
        echo ""
        ui_lines 80
        echo "1. WIREGUARD INTERFACE NAME (must start with 'wg')"
        default_iface="wg0"
        while true; do
            read -p "Enter interface name (default: $default_iface): " iface_input
            [ -z "$iface_input" ] && iface_input="$default_iface"
            if ! echo "$iface_input" | grep -q "^wg"; then
                warning "Interface '$iface_input' must start with 'wg'"
                continue
            fi
            if iface_exists "$iface_input"; then
                warning "Interface $iface_input already exists!"
                debug_write "[SETUP MANUAL] Attempt to overwrite $iface_input"
                read -p "Try another name? (y/N): " retry
                case "$retry" in
                    y|Y) continue ;;
                    *) error "Interface name already in use!" ;;
                esac
            fi
            iface_name="$iface_input"
            break
        done
        echo ""
        ui_lines 50
        echo "2. WIREGUARD KEYS"
        default_privkey=""
        if [ -n "$conf_file" ] && [ -f "$conf_file" ]; then
            default_privkey=$(get_conf_value "PrivateKey" "$conf_file")
        fi
        if [ -n "$default_privkey" ]; then
            echo "   [From $conf_name.conf: $(echo $default_privkey | cut -c1-10)...]"
            read -p "Enter PRIVATE key (press Enter to use default): " private_key_raw
            [ -z "$private_key_raw" ] && private_key_raw="$default_privkey"
        else
            read -p "Enter PRIVATE key: " private_key_raw
        fi
        [ -z "$private_key_raw" ] && error "Private key is required!"
        private_key=$(clean_wg_key "$private_key_raw")
        default_pubkey=""
        if [ -n "$conf_file" ] && [ -f "$conf_file" ]; then
            default_pubkey=$(get_conf_value "PublicKey" "$conf_file")
        fi
        if [ -n "$default_pubkey" ]; then
            echo "   [From $conf_name.conf: $(echo $default_pubkey | cut -c1-10)...]"
            read -p "Enter PUBLIC key (press Enter to use default): " public_key_raw
            [ -z "$public_key_raw" ] && public_key_raw="$default_pubkey"
        else
            read -p "Enter PUBLIC key: " public_key_raw
        fi
        [ -z "$public_key_raw" ] && error "Public key is required!"
        public_key=$(clean_wg_key "$public_key_raw")
        echo ""
        ui_lines 50
        echo "3. LOCAL ADDRESS"
        default_address=""
        if [ -n "$conf_file" ] && [ -f "$conf_file" ]; then
            default_address=$(get_conf_value "Address" "$conf_file")
        fi
        while true; do
            if [ -n "$default_address" ]; then
                read -p "Enter local IP address (default: $default_address): " address_input
                [ -z "$address_input" ] && address_input="$default_address"
            else
                read -p "Enter local IP address (e.g., 10.2.0.2/32): " address_input
            fi
            [ -z "$address_input" ] && error "Address is required!"
            local collision=$(address_exists "$address_input")
            if [ -n "$collision" ]; then
                warning "Address $address_input already in use by $collision!"
                debug_write "[SETUP MANUAL] IP collision: $address_input"
                read -p "Try another address? (y/N): " retry
                case "$retry" in
                    y|Y) continue ;;
                    *) error "Address already in use!" ;;
                esac
            fi
            address="$address_input"
            break
        done
        echo ""
        ui_lines 50
        echo "4. ENDPOINT"
        default_endpoint=""
        if [ -n "$conf_file" ] && [ -f "$conf_file" ]; then
            default_endpoint=$(get_conf_value "Endpoint" "$conf_file")
        fi
        default_endpoint_host=""
        default_endpoint_port=""
        if [ -n "$default_endpoint" ]; then
            default_endpoint_host=$(echo "$default_endpoint" | cut -d: -f1)
            default_endpoint_port=$(echo "$default_endpoint" | cut -d: -f2)
        fi
        if [ -n "$default_endpoint_host" ]; then
            read -p "Enter endpoint host (default: $default_endpoint_host): " endpoint_host_input
            [ -z "$endpoint_host_input" ] && endpoint_host_input="$default_endpoint_host"
        else
            read -p "Enter endpoint host (IP or domain): " endpoint_host_input
        fi
        [ -z "$endpoint_host_input" ] && error "Endpoint host is required!"
        endpoint_host="$endpoint_host_input"
        if [ -n "$default_endpoint_port" ]; then
            read -p "Enter endpoint port (default: $default_endpoint_port): " endpoint_port_input
            [ -z "$endpoint_port_input" ] && endpoint_port_input="$default_endpoint_port"
        else
            read -p "Enter endpoint port (default: 51820): " endpoint_port_input
        fi
        [ -z "$endpoint_port_input" ] && endpoint_port_input="51820"
        endpoint_port="$endpoint_port_input"
        echo ""
        ui_lines 50
        echo "5. ALLOWED IPs"
        echo "   (use space-separated values, e.g.: 0.0.0.0/0 ::/0)"
        default_allowed_ips=""
        if [ -n "$conf_file" ] && [ -f "$conf_file" ]; then
            default_allowed_ips=$(get_conf_value "AllowedIPs" "$conf_file")
        fi
        if [ -n "$default_allowed_ips" ]; then
            read -p "Enter allowed IPs (default: $default_allowed_ips): " allowed_ips_input
            [ -z "$allowed_ips_input" ] && allowed_ips_input="$default_allowed_ips"
        else
            read -p "Enter allowed IPs: " allowed_ips_input
        fi
        [ -z "$allowed_ips_input" ] && allowed_ips_input="0.0.0.0/0"
        allowed_ips="$allowed_ips_input"
        echo ""
        ui_lines 50
        echo "6. DNS SERVERS"
        echo "   (use COMMA-SEPARATED values, e.g.: 1.1.1.1, 1.0.0.1, 2606:4700:4700::1111)"
        read -p "Enter DNS servers (default: 1.1.1.1, 1.0.0.1): " dns_input
        [ -z "$dns_input" ] && dns_input="1.1.1.1, 1.0.0.1"
        dns="$dns_input"
        echo ""
        ui_lines 50
        echo "7. SAVE WIREGUARD CONFIGURATION FILE"
        read -p "Save config as .conf file in $WG_CONF_DIR? (y/N): " save_conf
        case "$save_conf" in
            y|Y|yes|YES|Yes)
                read -p "Enter config filename (without .conf extension): " conf_filename
                [ -z "$conf_filename" ] && conf_filename="manual-$(date +%s)"
                save_wireguard_conf "$conf_filename" "$private_key" "$public_key" \
                                    "$address" "$endpoint_host" "$endpoint_port" \
                                    "$allowed_ips" "$dns"
                ;;
            *)
                log "Config NOT saved to file"
                ;;
        esac
        echo ""
        ui_lines 50 "CONFIG SUMMARY"
        echo "Interface:           $iface_name"
        echo "Private Key:         $(echo $private_key | cut -c1-10)..."
        echo "Public Key:          $(echo $public_key | cut -c1-10)..."
        echo "Local IP:            $address"
        echo "Endpoint:            $endpoint_host:$endpoint_port"
        echo "Allowed IPs:         $allowed_ips"
        echo "DNS:                 $dns"
        ui_lines 50
        echo ""
        read -p "Confirm setup? (y/N): " response
        case "$response" in
            y|Y|yes|YES|Yes)
                ;;
            *)
                log "Setup cancelled!"
                return 1
                ;;
        esac
    fi
    if iface_exists "$iface_name"; then
        warning "$iface_name already exists!"
        debug_write "[SETUP] Attempt to overwrite for $iface_name"
        log "WG-AUTOCONF setup CANCELLED!"
        exit 0
    fi
    backup_config_file "$NETWORK_CONF"
    backup_config_file "$DHCP_CONF"
    backup_config_file "$FIREWALL_CONF"
    setup_network_config "$iface_name" "$private_key" "$address" \
                         "$public_key" "$endpoint_host" "$endpoint_port" \
                         "$allowed_ips" "$dns"
    setup_dhcp_config "$iface_name"
    setup_firewall_config "$iface_name" "$endpoint_port"
    uci commit network
    uci commit dhcp
    uci commit firewall
    configure_dns_ipv6_filter
    local iface_id=$(state_add_iface "$iface_name")
    if [ $? -eq 0 ]; then
        state_write "ID_${iface_id}_IS_CREATED" "1"
        state_write "IS_FIRST_EXEC" "0"
        debug_write "[SETUP] State updated: ID_${iface_id}_IS_CREATED=1, IS_FIRST_EXEC=0"
    else
        warning "Failed to add interface to state file"
    fi
    verbose echo ""
    verbose success "D0ne!"
    echo ""
    ui_lines 65 "${GREEN}WireGuard CONFIG${NC}"
    echo -e "${BLUE}Interface:${NC}           ${YELLOW}$iface_name${NC}"
    echo -e "${BLUE}Local IP:${NC}            ${YELLOW}$address${NC}"
    echo -e "${BLUE}Endpoint:${NC}            ${YELLOW}${endpoint_host:-N/A}:${endpoint_port:-N/A}${NC}"
    echo -e "${BLUE}DNS:${NC}                 ${YELLOW}${dns}${NC}"
    ui_lines 65 "${GREEN}FINISH SETUP${NC}"
    echo -e "${GREEN}1.${NC} ${BLUE}ENABLE WG:${NC}         ${YELLOW}wg-autoconf up $iface_name${NC}"
    echo -e "${GREEN}2.${NC} ${BLUE}VERIFY:${NC}            ${YELLOW}wg show $iface_name${NC}"
    echo -e "${GREEN}3.${NC} ${BLUE}TEST WG:${NC}           ${YELLOW}ping -I $iface_name 8.8.8.8${NC}"
    echo -e "${GREEN}4.${NC} ${BLUE}ROUTE LANs:${NC}        ${YELLOW}wg-autoconf routes set $iface_name <lan_iface>${NC}"
    echo ""
    ui_lines 65
}
setup_network_config() {
    local iface_name="$1"
    local private_key="$2"
    local address="$3"
    local public_key="$4"
    local endpoint_host="$5"
    local endpoint_port="$6"
    local allowed_ips="$7"
    local dns="$8"
    verbose log "Setting up NETWORK config for $iface_name..."
    local tag_id=$(get_next_tag_id "$NETWORK_CONF" "network")
    if grep -q "# wg-autoconf network start id $tag_id" "$NETWORK_CONF" 2>/dev/null; then
        warning "NETWORK tag with id $tag_id already exists. Skipping..."
        debug_write "[ERROR setup] Attempt to overwrite $tag_id for $iface_name"
        return 0
    fi
    local allowed_ips_list=$(echo "$allowed_ips" | tr ' ' '\n' | sed 's/^[ \t]*//;s/[ \t]*$//' | grep -v '^$')
    cat >> "$NETWORK_CONF" << EOF
# wg-autoconf network start id $tag_id
config interface '$iface_name'
    option proto 'wireguard'
    option private_key '$private_key'
    option addresses '$address'
    option dns '$dns'
config wireguard_$iface_name '${iface_name}_peer'
    option public_key '$public_key'
    option endpoint_host '$endpoint_host'
    option endpoint_port '$endpoint_port'
    option route_allowed_ips '0'
    option persistent_keepalive '25'
EOF
    echo "$allowed_ips_list" | while read -r ip; do
        echo "    list allowed_ips '$ip'" >> "$NETWORK_CONF"
    done
    cat >> "$NETWORK_CONF" << EOF
# wg-autoconf network end id $tag_id
EOF
    verbose success "Added NETWORK config for $iface_name (id: $tag_id)"
}
setup_dhcp_config() {
    local iface_name="$1"
    verbose log "Setting up DHCP config for $iface_name..."
    local tag_id=$(get_next_tag_id "$DHCP_CONF" "dhcp")
    if grep -q "# wg-autoconf dhcp start id $tag_id" "$DHCP_CONF" 2>/dev/null; then
        warning "DHCP tag with id $tag_id already exists. Skipping..."
        debug_write "[ERROR setup] Attempt to overwrite $tag_id for $iface_name"
        return 0
    fi
    cat >> "$DHCP_CONF" << EOF
# wg-autoconf dhcp start id $tag_id
config dhcp '$iface_name'
    option interface '$iface_name'
    option ignore '1'
# wg-autoconf dhcp end id $tag_id
EOF
    verbose success "Added DHCP config for $iface_name (id: $tag_id)"
}
setup_firewall_config() {
    local iface_name="$1"
    local endpoint_port="$2"
    verbose log "Setting up Firewall config for $iface_name..."
    local tag_id=$(get_next_tag_id "$FIREWALL_CONF" "firewall")
    if grep -q "# wg-autoconf firewall start id $tag_id" "$FIREWALL_CONF" 2>/dev/null; then
        warning "Firewall tag with id $tag_id already exists. Skipping..."
        debug_write "[ERROR setup] Attempt to overwrite $tag_id for $iface_name"
        return 0
    fi
    cat >> "$FIREWALL_CONF" << EOF
# wg-autoconf firewall start id $tag_id
config zone
    option name '$iface_name'
    option input 'ACCEPT'
    option output 'ACCEPT'
    option forward 'ACCEPT'
    option masq '1'
    option mtu_fix '1'
    list network '$iface_name'
config rule
    option name 'Allow-WireGuard-$iface_name'
    option src 'wan'
    option dest_port '$endpoint_port'
    option proto 'udp'
    option target 'ACCEPT'
config forwarding
    option src '$iface_name'
    option dest 'wan'
# wg-autoconf firewall end id $tag_id
EOF
    /etc/init.d/firewall reload 2>/dev/null
    verbose success "Added Firewall config for $iface_name (id: $tag_id, port: $endpoint_port)"
}
setup_peers() {
    local iface="$1"
    local conf_file="$2"
    local tag_id="$3"
    return 0
}
save_wireguard_conf() {
    local conf_filename="$1"
    local private_key="$2"
    local public_key="$3"
    local address="$4"
    local endpoint_host="$5"
    local endpoint_port="$6"
    local allowed_ips="$7"
    local dns="$8"
    local dns_conf=$(clean_dns_conf "$dns" )
    validate_dns_format "$dns_conf" "conf"
    local conf_file="$WG_CONF_DIR/$conf_filename.conf"
    if [ -f "$conf_file" ]; then
        warning "Config file already exists: $conf_file"
        read -p "Overwrite? (y/N): " response
        case "$response" in
            y|Y|yes|YES|Yes) ;;
            *) log "Config NOT saved"; return 1 ;;
        esac
    fi
    cat > "$conf_file" << EOF
[Interface]
PrivateKey = $private_key
Address = $address
DNS = $dns_conf
[Peer]
PublicKey = $public_key
AllowedIPs = $allowed_ips
Endpoint = $endpoint_host:$endpoint_port
EOF
    success "Config saved to: $conf_file"
    log "You can now use: wg-autoconf setup $conf_filename"
}
configure_dns_ipv6_filter() {
    if uci get dhcp.@dnsmasq[0] >/dev/null 2>&1; then
        current_filter=$(uci get dhcp.@dnsmasq[0].filter_aaaa 2>/dev/null || echo "0")
        if [ "$current_filter" != "1" ]; then
            log "Setting up dnsmasq filtering-IPv6-AAAA records ..."
            uci set dhcp.@dnsmasq[0].filter_aaaa='1'
            uci commit dhcp
            if /etc/init.d/dnsmasq restart >/dev/null 2>&1; then
                success "DNS configured: Filtering IPv6"
            else
                warning "Could not restart dnsmasq (may be OK)"
            fi
        fi
    else
        warning "dnsmasq NOT FOUND! Please verify requirements!"
    fi
}
activate_interface() {
    local iface="$1"
    [ -z "$iface" ] && error "Interface name required!"
    debug_write "[UP] Activating interface: $iface"
    uci get "network.$iface" >/dev/null 2>&1 || error "$iface DOES NOT exist"
    validate_iface_name "$iface"
    state_init
    local iface_id=$(state_get_id "$iface")
    if [ $? -ne 0 ]; then
        debug_write "[UP] Interface ID not found, adding to state"
        iface_id=$(state_add_iface "$iface")
        if [ $? -ne 0 ] || [ -z "$iface_id" ]; then
            warning "Failed to add interface to state, continuing without state tracking"
            iface_id=""
        else
            debug_write "[UP] Added interface to state with ID: $iface_id"
        fi
    fi
    verbose log "Enabling $iface..."
    debug_write "[UP] Running ifup $iface"
    if ifup "$iface" >/dev/null 2>&1; then
        debug_write "[UP] ifup succeeded, waiting for interface..."
        local timeout=10  # 10 intentos * 1s del sleep = 10s
        local count=0
        while [ $count -lt $timeout ]; do
            if ip link show "$iface" >/dev/null 2>&1; then
                debug_write "[UP] Interface appeared after ${count} attempts"
                break
            fi
            sleep 1
            count=$((count + 1))
        done
        if [ $count -ge $timeout ]; then
            debug_write "[UP WARNING] Interface $iface did not appear after timeout"
        fi
        if [ -n "$iface_id" ]; then
            if state_write "ID_${iface_id}_IS_ACTIVE" "1"; then
                debug_write "[UP] State updated: ID_${iface_id}_IS_ACTIVE=1"
            else
                warning "Failed to update state for $iface"
                debug_write "[UP WARNING] state_write failed for ID_${iface_id}_IS_ACTIVE"
            fi
        fi
        success "$iface enabled!"
        debug_write "[UP] Interface $iface successfully enabled"
        if [ "$VERBOSE" = "1" ]; then
            echo ""
            echo "$iface Info:"
            wg show "$iface" 2>/dev/null || echo "  (WireGuard info not available)"
        fi
        echo ""
        echo -e "${YELLOW}Now you can set up routes if needed!${NC}"
    else
        debug_write "[UP ERROR] ifup $iface failed"
        if debug_is_active; then
            debug_write "[UP DEBUG] Checking interface status:"
            debug wg show "$iface"
            debug ip link show "$iface"
            debug logread | tail -10
        fi
        error "Errors found enabling $iface. Check logread"
    fi
    return 0
}
deactivate_interface() {
    local iface="$1"
    [ -z "$iface" ] && error "Interface name required"
    debug_write "[DOWN] Deactivating interface: $iface"
    uci get "network.$iface" >/dev/null 2>&1 || error "$iface DOES NOT exist"
    validate_iface_name "$iface"
    state_init
    local iface_id=$(state_get_id "$iface")
    if [ $? -ne 0 ]; then
        debug_write "[DOWN] Interface ID not found in state for $iface"
        iface_id=""
    else
        debug_write "[DOWN] Found interface ID: $iface_id"
    fi
    log "Disabling $iface..."
    debug_write "[DOWN] Running ifdown $iface"
    if ifdown "$iface" >/dev/null 2>&1; then
        debug_write "[DOWN] ifdown succeeded"
        if [ -n "$iface_id" ]; then
            if state_write "ID_${iface_id}_IS_ACTIVE" "0"; then
                debug_write "[DOWN] State updated: ID_${iface_id}_IS_ACTIVE=0"
            else
                warning "Failed to update state for $iface"
                debug_write "[DOWN WARNING] state_write failed for ID_${iface_id}_IS_ACTIVE"
            fi
        fi
        success "$iface disabled!"
        debug_write "[DOWN] Interface $iface successfully disabled"
    else
        debug_write "[DOWN ERROR] ifdown $iface failed"
        if debug_is_active; then
            debug_write "[DOWN DEBUG] Checking why ifdown failed:"
            debug ip link show "$iface"
            debug logread | tail -20
        fi
        error "$iface was NOT disabled! Check logs!"
    fi
    return 0
}
remove_wireguard() {
    local iface="$1"
    local silent="${2:-no}"
    debug_write "[REMOVE] Starting removal of $iface"
    validate_iface_name "$iface"
    if ! uci get "network.$iface" >/dev/null 2>&1; then
        debug_write "[REMOVE] Interface $iface not found in UCI"
        state_init
        local iface_id=$(state_get_id "$iface")
        if [ -n "$iface_id" ]; then
            state_remove_iface "$iface_id"
            debug_write "[REMOVE] Cleaned state for non-existent interface: $iface"
        fi
        [ "$silent" != "silent" ] && success "$iface removed (was not in UCI)"
        return 0
    fi
    [ "$silent" != "silent" ] && log "Removing $iface..."
    debug_write "[REMOVE] Deactivating interface: $iface"
    ifdown "$iface" 2>/dev/null
    if [ $? -ne 0 ]; then
        debug_write "[REMOVE WARNING] ifdown $iface failed (may already be down)"
    fi
    state_init
    local iface_id=$(state_get_id "$iface")
    if [ $? -ne 0 ]; then
        debug_write "[REMOVE] Interface ID not found in state for $iface"
        iface_id=""
    fi
    debug_write "[REMOVE] Finding and removing configuration tags"
    local net_line=$(grep -n "config interface '$iface'" "$NETWORK_CONF" 2>/dev/null | cut -d: -f1)
    local network_tag_id=""
    if [ -n "$net_line" ]; then
        network_tag_id=$(sed -n "1,${net_line}p" "$NETWORK_CONF" | grep "# wg-autoconf network start id" | tail -1 | sed 's/.*id //g')
        if [ -n "$network_tag_id" ] && tail -n "+${net_line}" "$NETWORK_CONF" | grep -q "# wg-autoconf network end id $network_tag_id"; then
            debug_write "[REMOVE] Found valid network tag id: $network_tag_id for $iface"
            remove_tagged_block "$NETWORK_CONF" "network" "$network_tag_id"
        else
            debug_write "[REMOVE WARNING] Invalid or missing network tag for $iface"
        fi
    fi
    local dhcp_line=$(grep -n "config dhcp '$iface'" "$DHCP_CONF" 2>/dev/null | cut -d: -f1)
    local dhcp_tag_id=""
    if [ -n "$dhcp_line" ]; then
        dhcp_tag_id=$(sed -n "1,${dhcp_line}p" "$DHCP_CONF" | grep "# wg-autoconf dhcp start id" | tail -1 | sed 's/.*id //g')
        if [ -n "$dhcp_tag_id" ] && tail -n "+${dhcp_line}" "$DHCP_CONF" | grep -q "# wg-autoconf dhcp end id $dhcp_tag_id"; then
            debug_write "[REMOVE] Found valid DHCP tag id: $dhcp_tag_id for $iface"
            remove_tagged_block "$DHCP_CONF" "dhcp" "$dhcp_tag_id"
        else
            debug_write "[REMOVE WARNING] Invalid or missing DHCP tag for $iface"
        fi
    fi
    local fw_line=$(grep -n "option name '$iface'" "$FIREWALL_CONF" 2>/dev/null | head -1 | cut -d: -f1)
    local firewall_tag_id=""
    if [ -n "$fw_line" ]; then
        firewall_tag_id=$(sed -n "1,${fw_line}p" "$FIREWALL_CONF" | grep "# wg-autoconf firewall start id" | tail -1 | sed 's/.*id //g')
        if [ -n "$firewall_tag_id" ] && tail -n "+${fw_line}" "$FIREWALL_CONF" | grep -q "# wg-autoconf firewall end id $firewall_tag_id"; then
            debug_write "[REMOVE] Found valid firewall tag id: $firewall_tag_id for $iface"
            remove_tagged_block "$FIREWALL_CONF" "firewall" "$firewall_tag_id"
        else
            debug_write "[REMOVE WARNING] Invalid or missing firewall tag for $iface"
        fi
    fi
    debug_write "[REMOVE] Committing UCI changes"
    uci commit network 2>/dev/null && debug_write "[REMOVE] network committed"
    uci commit dhcp 2>/dev/null && debug_write "[REMOVE] dhcp committed"
    uci commit firewall 2>/dev/null && debug_write "[REMOVE] firewall committed"
    debug_write "[REMOVE] Restoring backups using unified restore_backups() function"
    local restore_silent=""
    [ "$silent" = "silent" ] && restore_silent="silent"
    local restore_result=0
    if restore_backups "" "$restore_silent"; then
        debug_write "[REMOVE] Backups restored successfully using restore_backups()"
        [ "$silent" != "silent" ] && success "Configuration files restored from backup"
        restore_result=1
    else
        debug_write "[REMOVE WARNING] Backup restoration had issues or no backups to restore"
        if [ "$silent" != "silent" ]; then
            warning "No valid backups found or restoration had issues"
            warning "Original configuration files may have been modified"
        fi
        restore_result=0
    fi
    if [ $restore_result -eq 1 ]; then
        debug_write "[REMOVE] Final UCI commit after backup restoration"
        uci commit network 2>/dev/null
        uci commit dhcp 2>/dev/null
        uci commit firewall 2>/dev/null
        /etc/init.d/firewall reload 2>/dev/null && debug_write "[REMOVE] Firewall reloaded"
    fi
    debug_write "[REMOVE] Cleaning up restored backup files"
    local removed_backups=0
    local kept_backups=0
    for config_file in $BACKUP_PATHS; do
        local backup_file="${config_file}.BACKUP_PRE_WIREGUARD"
        if [ ! -f "$backup_file" ]; then
            continue
        fi
        if validate_backup "$backup_file" 2>/dev/null; then
            if rm -f "$backup_file" 2>/dev/null; then
                removed_backups=$((removed_backups + 1))
                debug_write "[REMOVE] Removed valid backup: $(basename "$backup_file")"
            else
                debug_write "[REMOVE WARNING] Failed to remove backup: $(basename "$backup_file")"
                kept_backups=$((kept_backups + 1))
            fi
        else
            debug_write "[REMOVE] Keeping corrupted backup for diagnosis: $(basename "$backup_file")"
            kept_backups=$((kept_backups + 1))
        fi
    done
    debug_write "[REMOVE] Backup cleanup: removed=$removed_backups, kept=$kept_backups"
    if [ -n "$iface_id" ]; then
        debug_write "[REMOVE] Removing interface from state: ID_$iface_id"
        if state_remove_iface "$iface_id"; then
            debug_write "[REMOVE] State updated successfully"
        else
            debug_write "[REMOVE WARNING] Failed to update state for ID_$iface_id"
        fi
    fi
    debug_write "[REMOVE] Completed: restore_result=$restore_result, backups_removed=$removed_backups"
    if [ "$silent" != "silent" ]; then
        echo ""
        success "$iface removed successfully!"
        if [ $removed_backups -gt 0 ]; then
            echo -e "${GREEN}Cleaned up $removed_backups backup file(s)${NC}"
        fi
        if [ $kept_backups -gt 0 ]; then
            echo -e "${YELLOW}Kept $kept_backups backup file(s) (corrupted or failed to remove)${NC}"
        fi
    fi
    return 0
}
show_status() {
    local filter_iface="$1"
    log "WireGuard status:"
    echo ""
    local interfaces=$(wg show interfaces 2>/dev/null)
    if [ -z "$interfaces" ]; then
        echo "No active WireGuard interfaces found"
        return
    fi
    for iface in $interfaces; do
        if [ -n "$filter_iface" ] && [ "$iface" != "$filter_iface" ]; then
            continue
        fi
        echo "$iface"
        local address=$(uci get "network.$iface.addresses" 2>/dev/null || echo "N/A")
        echo "  IP: $address"
        if ip link show "$iface" >/dev/null 2>&1; then
            echo "  Status: UP"
            local peer_info=$(wg show "$iface" 2>/dev/null)
            local endpoint=$(echo "$peer_info" | grep "endpoint:" | head -1)
            [ -n "$endpoint" ] && echo "  $endpoint"
            local handshake=$(echo "$peer_info" | grep "latest handshake:" | head -1)
            [ -n "$handshake" ] && echo "  $handshake"
            local transfer=$(echo "$peer_info" | grep "transfer:" | head -1)
            [ -n "$transfer" ] && echo "  $transfer"
        else
            echo "  Status: DOWN"
        fi
        echo ""
    done
}
backup_config_file() {
    local file="$1"
    local backup_file="${file}.BACKUP_PRE_WIREGUARD"
    debug_write "[BACKUP] Starting backup for: $file"
    if [ -f "$backup_file" ] && validate_backup "$backup_file" 2>/dev/null; then
        debug_write "[BACKUP] Valid backup already exists: $backup_file"
        return 0
    fi
    if [ ! -f "$file" ]; then
        debug_write "[BACKUP ERROR] Source file not found: $file"
        return 1
    fi
    if [ ! -r "$file" ]; then
        debug_write "[BACKUP ERROR] Cannot read file: $file"
        return 1
    fi
    local content=""
    if ! content=$(cat "$file" 2>/dev/null); then
        debug_write "[BACKUP ERROR] Failed to read content: $file"
        return 1
    fi
    if [ -z "$content" ]; then
        debug_write "[BACKUP WARNING] Empty file: $file"
    fi
    local checksum=""
    if command -v sha256sum >/dev/null 2>&1; then
        checksum=$(echo "$content" | sha256sum | cut -d' ' -f1)
    else
        checksum=$(echo "$content" | md5sum | cut -d' ' -f1)
        debug_write "[BACKUP] Using md5sum fallback for checksum"
    fi
    local tag="# WG_AUTOCONF_BACKUP_${VERSION}_$(date +%s)"
    debug_write "[BACKUP] Creating backup with checksum: ${checksum:0:16}..."
    local temp_backup="${backup_file}.tmp.$$"
    local backup_ok=0
    {
        echo "$tag"
        echo "$content"
        echo "# WG_AUTOCONF_CHECKSUM: $checksum"
    } > "$temp_backup" 2>/dev/null
    if [ $? -eq 0 ] && [ -f "$temp_backup" ] && [ -s "$temp_backup" ]; then
        local temp_checksum=$(sed '1d; $d' "$temp_backup" | sha256sum 2>/dev/null | cut -d' ' -f1)
        if [ "$temp_checksum" = "$checksum" ]; then
            if mv "$temp_backup" "$backup_file" 2>/dev/null; then
                backup_ok=1
                debug_write "[BACKUP] Created atomic backup: $backup_file"
            else
                debug_write "[BACKUP ERROR] Failed to replace backup file"
            fi
        else
            debug_write "[BACKUP ERROR] Checksum mismatch in temp file"
        fi
    else
        debug_write "[BACKUP ERROR] Failed to write temp backup"
    fi
    [ -f "$temp_backup" ] && rm -f "$temp_backup" 2>/dev/null
    if [ $backup_ok -eq 1 ]; then
        if validate_backup "$backup_file" 2>/dev/null; then
            debug_write "[BACKUP] Backup validated: $backup_file"
            verbose success "Backed up $(basename "$file")"
            return 0
        else
            debug_write "[BACKUP ERROR] New backup failed validation"
            rm -f "$backup_file" 2>/dev/null
            return 1
        fi
    else
        debug_write "[BACKUP ERROR] Failed to create backup: $file"
        return 1
    fi
}
validate_backup() {
    local backup_file="$1"
    debug_write "[BACKUP VALIDATE] Validating: $backup_file"
    if [ ! -f "$backup_file" ]; then
        debug_write "[BACKUP VALIDATE ERROR] File not found"
        return 1
    fi
    if [ ! -s "$backup_file" ]; then
        debug_write "[BACKUP VALIDATE ERROR] File empty"
        return 1
    fi
    local line_count=$(wc -l < "$backup_file" 2>/dev/null)
    if [ -z "$line_count" ] || [ "$line_count" -lt 3 ]; then
        debug_write "[BACKUP VALIDATE ERROR] Invalid format, less than 3 lines"
        return 1
    fi
    if ! head -1 "$backup_file" | grep -q "WG_AUTOCONF_BACKUP"; then
        debug_write "[BACKUP VALIDATE ERROR] Missing backup tag"
        return 1
    fi
    local stored_sum=""
    stored_sum=$(tail -10 "$backup_file" | grep "WG_AUTOCONF_CHECKSUM:" | tail -1 | grep -o '[0-9a-f]\{64\}')
    if [ -z "$stored_sum" ]; then
        stored_sum=$(tail -1 "$backup_file" | grep -o '[0-9a-f]\{64\}')
    fi
    if [ -z "$stored_sum" ]; then
        debug_write "[BACKUP VALIDATE ERROR] No checksum found"
        return 1
    fi
    debug_write "[BACKUP VALIDATE] Stored checksum: ${stored_sum:0:16}..."
    local computed_sum=""
    local total_lines=$line_count
    local content_lines=$((total_lines - 2))  # Restar primera y última
    if [ $content_lines -le 0 ]; then
        debug_write "[BACKUP VALIDATE ERROR] No content to checksum"
        return 1
    fi
    if command -v sha256sum >/dev/null 2>&1; then
        computed_sum=$(head -n $((total_lines - 1)) "$backup_file" | tail -n +2 | sha256sum | cut -d' ' -f1)
    else
        computed_sum=$(head -n $((total_lines - 1)) "$backup_file" | tail -n +2 | md5sum | cut -d' ' -f1)
    fi
    if [ -z "$computed_sum" ]; then
        debug_write "[BACKUP VALIDATE ERROR] Failed to compute checksum"
        return 1
    fi
    debug_write "[BACKUP VALIDATE] Computed checksum: ${computed_sum:0:16}..."
    if [ "$stored_sum" = "$computed_sum" ]; then
        debug_write "[BACKUP VALIDATE] VALID backup: $backup_file"
        return 0
    else
        debug_write "[BACKUP VALIDATE] CHECKSUM MISMATCH: $backup_file"
        debug_write "[BACKUP VALIDATE] Stored: ${stored_sum:0:16}..."
        debug_write "[BACKUP VALIDATE] Computed: ${computed_sum:0:16}..."
        return 1
    fi
}
show_backups() {
    log "Available backup files:"
    echo ""
    local backup_found=0
    for path in $BACKUP_PATHS; do
        local backup_file="${path}.BACKUP_PRE_WIREGUARD"
        if [ -f "$backup_file" ]; then
            backup_found=1
            local backup_size=$(ls -lh "$backup_file" | awk '{print $5}')
            local backup_date=$(ls -l "$backup_file" | awk '{print $6" "$7" "$8}')
            local backup_tag=$(head -1 "$backup_file" | sed 's/^# //')
            if validate_backup "$backup_file"; then
                success "$(basename $path) [VALID]"
            else
                warning "$(basename $path) [CORRUPTED]"
            fi
            echo -e "      Path: ${YELLOW}$backup_file${NC}"
            echo -e "      Tag:  ${YELLOW}$backup_tag${NC}"
            echo -e "      Size: ${YELLOW}$backup_size${NC} | Date: ${YELLOW}$backup_date${NC}"
            echo ""
        fi
    done
    if [ $backup_found -eq 0 ]; then
        warning "No backup files found!"
        return 1
    fi
    return 0
}
restore_backups() {
    local file_to_restore="$1"
    local silent="${2:-}"
    debug_write "[RESTORE] Starting restore operation"
    [ "$silent" != "silent" ] && log "Restoring backup files..."
    local restore_count=0
    local skip_count=0
    local corrupt_count=0
    local error_count=0
    for path in $BACKUP_PATHS; do
        local config_name=$(basename "$path")
        local backup_file="${path}.BACKUP_PRE_WIREGUARD"
        debug_write "[RESTORE] Processing: $config_name"
        [ -n "$file_to_restore" ] && [ "$config_name" != "$file_to_restore" ] && continue
        if [ ! -f "$backup_file" ]; then
            debug_write "[RESTORE] Backup not found: $backup_file"
            [ "$silent" != "silent" ] && warning "Backup not found for $config_name"
            skip_count=$((skip_count + 1))
            continue
        fi
        if ! validate_backup "$backup_file"; then
            debug_write "[RESTORE] Backup CORRUPTED: $backup_file"
            corrupt_count=$((corrupt_count + 1))
            if [ "$silent" != "silent" ]; then
                error "Backup CORRUPTED for $config_name!"
            else
                debug_write "[RESTORE SILENT] Corrupted backup skipped: $config_name"
            fi
            continue  # NUNCA restaurar corruptos
        fi
        local temp_restore="${ATOMIC_PATHS}/${config_name}.restore.$$"
        local restore_ok=0
        debug_write "[RESTORE] Restoring $config_name atomically..."
        if sed '1d; $d' "$backup_file" > "$temp_restore" 2>/dev/null; then
            if [ ! -s "$temp_restore" ]; then
                debug_write "[RESTORE WARNING] Restored content empty for $config_name"
            fi
            if mv "$temp_restore" "$path" 2>/dev/null; then
                restore_ok=1
                debug_write "[RESTORE] Atomically restored: $config_name"
            else
                debug_write "[RESTORE ERROR] Failed to replace $config_name"
                error_count=$((error_count + 1))
            fi
        else
            debug_write "[RESTORE ERROR] Failed to extract content from backup"
            error_count=$((error_count + 1))
        fi
        [ -f "$temp_restore" ] && rm -f "$temp_restore" 2>/dev/null
        if [ $restore_ok -eq 1 ]; then
            restore_count=$((restore_count + 1))
            [ "$silent" != "silent" ] && success "Restored $config_name from backup"
            debug_write "[RESTORE] Successfully restored: $config_name"
        else
            [ "$silent" != "silent" ] && warning "Failed to restore $config_name"
            skip_count=$((skip_count + 1))
        fi
    done
    if [ $restore_count -gt 0 ]; then
        debug_write "[RESTORE] Committing UCI changes..."
        uci commit network 2>/dev/null && debug_write "[RESTORE] network committed"
        uci commit dhcp 2>/dev/null && debug_write "[RESTORE] dhcp committed"
        uci commit firewall 2>/dev/null && debug_write "[RESTORE] firewall committed"
        /etc/init.d/firewall reload 2>/dev/null && debug_write "[RESTORE] firewall reloaded"
        [ "$silent" != "silent" ] && success "$restore_count file(s) restored successfully"
        debug_write "[RESTORE] Completed: restored=$restore_count, corrupted=$corrupt_count, errors=$error_count, skipped=$skip_count"
        return 0
    else
        debug_write "[RESTORE] No files restored: corrupted=$corrupt_count, errors=$error_count, skipped=$skip_count"
        if [ "$silent" != "silent" ]; then
            if [ $corrupt_count -gt 0 ]; then
                error "No files restored: $corrupt_count backup(s) corrupted!"
            else
                warning "No files were restored"
            fi
        fi
        return 1
    fi
}
diagnose_backup_issue() {
    local config="$1"
    local backup="${config}.BACKUP_PRE_WIREGUARD"
    if [ ! -f "$backup" ]; then
        echo "No backup found for $(basename "$config")"
        return
    fi
    echo "=== Diagnosing backup: $(basename "$backup") ==="
    echo ""
    echo "1. File structure:"
    echo "   Total lines: $(wc -l < "$backup")"
    echo "   Line 1 (tag): $(head -1 "$backup")"
    echo "   Last line: $(tail -1 "$backup")"
    echo ""
    local stored_sum=$(tail -1 "$backup" | grep -o '[0-9a-f]\{64\}')
    echo "2. Stored checksum: $stored_sum"
    echo ""
    local total_lines=$(wc -l < "$backup")
    local computed_sum=$(head -n -1 "$backup" | tail -n +2 | sha256sum | cut -d' ' -f1)
    echo "3. Computed checksum: $computed_sum"
    echo ""
    if [ "$stored_sum" = "$computed_sum" ]; then
        echo "[OK] Backup is VALID"
    else
        echo "[ERROR] Backup is INVALID"
        echo ""
        echo "5. Content analysis:"
        local content=$(head -n -1 "$backup" | tail -n +2)
        echo "   Content lines: $(echo "$content" | wc -l)"
        echo "   Content bytes: $(echo "$content" | wc -c)"
        echo ""
        if [ -f "$config" ]; then
            local current_sum=$(cat "$config" | sha256sum | cut -d' ' -f1)
            echo "6. Current file checksum: $current_sum"
            if [ "$current_sum" = "$stored_sum" ]; then
                echo "   [OK] Current file matches backup checksum"
            else
                echo "   [NOT OK] Current file DIFFERS from backup"
            fi
        fi
    fi
    echo ""
}
cleanup_backup_files() {
    local force="${1:-}"
    debug_write "[BACKUP CLEANUP] Starting backup cleanup"
    verbose log "Cleaning up backup files..."
    local removed_count=0
    local kept_count=0
    local error_count=0
    for path in $BACKUP_PATHS; do
        local backup_file="${path}.BACKUP_PRE_WIREGUARD"
        if [ ! -f "$backup_file" ]; then
            continue
        fi
        debug_write "[BACKUP CLEANUP] Processing: $(basename "$backup_file")"
        local should_remove=0
        if [ "$force" = "force" ]; then
            should_remove=1
            debug_write "[BACKUP CLEANUP] Force removal"
        elif validate_backup "$backup_file" 2>/dev/null; then
            should_remove=1
            debug_write "[BACKUP CLEANUP] Valid backup, removing"
        else
            should_remove=0
            debug_write "[BACKUP CLEANUP] Corrupted backup, keeping for diagnosis"
            kept_count=$((kept_count + 1))
        fi
        if [ $should_remove -eq 1 ]; then
            if rm -f "$backup_file" 2>/dev/null; then
                removed_count=$((removed_count + 1))
                debug_write "[BACKUP CLEANUP] Removed: $(basename "$backup_file")"
            else
                error_count=$((error_count + 1))
                debug_write "[BACKUP CLEANUP ERROR] Failed to remove: $backup_file"
            fi
        fi
    done
    debug_write "[BACKUP CLEANUP] Completed: removed=$removed_count, kept=$kept_count, errors=$error_count"
    if [ $error_count -eq 0 ]; then
        if [ $removed_count -gt 0 ]; then
            verbose success "Removed $removed_count backup file(s)"
        fi
        if [ $kept_count -gt 0 ]; then
            warning "Kept $kept_count corrupted backup(s) for diagnosis"
        fi
        return 0
    else
        warning "Backup cleanup completed with $error_count error(s)"
        return 1
    fi
}
cleanup() {
    local mode="$1"
    local target_iface="$2"
    local silent="${3:-}"
    if [ -z "$mode" ] || ! echo "$mode" | grep -qE "^(single|interactive|nuke)$"; then
        error "cleanup: Invalid mode '$mode' (use: single|interactive|nuke)"
        return 1
    fi
    state_init
    debug_write "[CLEANUP] Starting with mode=$mode, target_iface=$target_iface"
    local interfaces=""
    local interactive=0
    case "$mode" in
        single)
            if [ -z "$target_iface" ]; then
                error "cleanup: Interface name required for 'single' mode"
                return 1
            fi
            validate_iface_name "$target_iface"
            if ! iface_exists "$target_iface"; then
                error "cleanup: $target_iface does not exist!"
                return 1
            fi
            interfaces="$target_iface"
            interactive=1
            debug_write "[CLEANUP SINGLE] Processing single interface: $target_iface"
            ;;
        interactive)
            local all_ifaces=$(get_all_wg_interfaces)
            if [ -z "$all_ifaces" ]; then
                warning "No WireGuard interfaces found"
                return 0
            fi
            echo ""
            log "Available WireGuard interfaces:"
            echo ""
            local count=0
            for iface in $all_ifaces; do
                count=$((count + 1))
                local addr=$(uci get "network.$iface.addresses" 2>/dev/null || echo "N/A")
                echo "  $count) $iface [$addr]"
            done
            echo ""
            printf "Enter number (or press Enter to cancel): "
            read -r selection
            if [ -z "$selection" ]; then
                log "Cleanup cancelled"
                return 0
            fi
            count=0
            for iface in $all_ifaces; do
                count=$((count + 1))
                if [ "$count" = "$selection" ]; then
                    interfaces="$iface"
                    break
                fi
            done
            if [ -z "$interfaces" ]; then
                warning "Invalid selection"
                return 1
            fi
            interactive=1
            debug_write "[CLEANUP INTERACTIVE] Selected interface: $interfaces"
            ;;
        nuke)
            interfaces=$(get_all_wg_interfaces)
            interactive=0
            silent="silent"
            if [ -z "$interfaces" ]; then
                debug_write "[NUKE] No interfaces found"
            else
                debug_write "[NUKE] Found interfaces: $interfaces"
            fi
            ;;
    esac
    local processed_count=0
    local error_count=0
    for iface in $interfaces; do
        if [ "$silent" != "silent" ]; then
            log "Cleaning up $iface..."
            echo ""
        fi
        if [ "$interactive" -eq 1 ]; then
            local addr=$(uci get "network.$iface.addresses" 2>/dev/null || echo "N/A")
            local ep=$(uci get "network.${iface}_peer.endpoint_host" 2>/dev/null || echo "N/A")
            echo ""
            ui_lines 50
            echo "Interface: $iface"
            echo "Address: $addr"
            echo "Endpoint: $ep"
            ui_lines 50
            echo ""
            printf "Proceed with cleanup? (y/N): "
            read -r confirm
            case "$confirm" in
                y|Y|yes|YES|Yes)
                    ;;
                *)
                    log "Cleanup cancelled for $iface"
                    continue
                    ;;
            esac
            echo ""
        fi
        local rt_tables=$(grep "_vpn_${iface}" /etc/iproute2/rt_tables 2>/dev/null | awk '{print $2}')
        if [ -n "$rt_tables" ]; then
            if [ "$silent" != "silent" ]; then
                log "Unsetting routes..."
            fi
            for table in $rt_tables; do
                local lan_iface=$(echo "$table" | sed "s/_vpn_${iface}//g")
                if [ -n "$lan_iface" ]; then
                    if unset_lan_routes "$iface" "$lan_iface" 2>/dev/null; then
                        if [ "$silent" != "silent" ]; then
                            success "Routes unset: $iface <-> $lan_iface"
                        fi
                        debug_write "[CLEANUP] Routes unset: $iface <-> $lan_iface"
                    else
                        if [ "$silent" != "silent" ]; then
                            warning "Failed to unset routes for $iface <-> $lan_iface"
                        fi
                        error_count=$((error_count + 1))
                    fi
                fi
            done
            if [ "$silent" != "silent" ]; then
                echo ""
            fi
        fi
        if [ "$silent" != "silent" ]; then
            log "Deactivating interface..."
        fi
        if uci get "network.$iface" >/dev/null 2>&1; then
            if deactivate_interface "$iface" >/dev/null 2>&1; then
                if [ "$silent" != "silent" ]; then
                    success "Interface down: $iface"
                fi
                debug_write "[CLEANUP] Interface down: $iface"
            else
                if [ "$silent" != "silent" ]; then
                    warning "Failed to deactivate $iface (may already be down)"
                fi
                debug_write "[CLEANUP] deactivate_interface failed for $iface"
            fi
        else
            debug_write "[CLEANUP] Interface $iface not in UCI, skipping down"
        fi
        if [ "$silent" != "silent" ]; then
            echo ""
        fi
        if [ "$silent" != "silent" ]; then
            log "Removing interface configuration..."
        fi
        local remove_silent_mode="$silent"
        if [ "$mode" = "nuke" ]; then
            remove_silent_mode="silent"
        fi
        if uci get "network.$iface" >/dev/null 2>&1; then
            if remove_wireguard "$iface" "$remove_silent_mode"; then
                if [ "$silent" != "silent" ]; then
                    success "Interface removed: $iface"
                fi
                processed_count=$((processed_count + 1))
                debug_write "[CLEANUP] Interface removed: $iface"
            else
                error_count=$((error_count + 1))
                if [ "$silent" != "silent" ]; then
                    warning "Failed to remove $iface"
                fi
                debug_write "[CLEANUP] remove_wireguard failed for $iface"
                continue
            fi
        else
            debug_write "[CLEANUP] Interface $iface already removed from UCI"
            processed_count=$((processed_count + 1))
            if [ "$silent" != "silent" ]; then
                success "Interface already removed"
            fi
        fi
        if [ "$silent" != "silent" ]; then
            echo ""
        fi
    done
    debug_write "[CLEANUP] Completed: mode=$mode, processed=$processed_count, errors=$error_count"
    if [ $error_count -eq 0 ]; then
        if [ "$silent" != "silent" ]; then
            echo ""
            success "Cleanup completed successfully!"
        fi
        return 0
    else
        if [ "$silent" != "silent" ]; then
            echo ""
            warning "Cleanup completed with $error_count error(s)"
        fi
        return 1
    fi
}
show_routes() {
    local filter_wg_iface="$1"
    log "WireGuard routes:"
    echo ""
    if [ ! -f /etc/iproute2/rt_tables ]; then
        error "/etc/iproute2/rt_tables not found"
    fi
    if [ -n "$filter_wg_iface" ]; then
        log "Routes for $filter_wg_iface:"
        echo ""
        grep "_vpn_${filter_wg_iface}" /etc/iproute2/rt_tables 2>/dev/null | while read -r line; do
            local table_id=$(echo "$line" | awk '{print $1}')
            local table_name=$(echo "$line" | awk '{print $2}')
            local lan_iface=$(echo "$table_name" | sed "s/_vpn_${filter_wg_iface}//g")
            echo "$lan_iface:"
            echo "  Table: $table_name (ID: $table_id)"
            ip rule show | grep "lookup $table_name" | sed 's/^/  Rule: /'
            ip route show table "$table_name" 2>/dev/null | while read -r route; do
                echo "  Route: $route"
            done || echo "  (no routes found)"
            echo ""
        done
    else
        log "All routes:"
        echo ""
        grep "_vpn_" /etc/iproute2/rt_tables 2>/dev/null | while read -r line; do
            local table_id=$(echo "$line" | awk '{print $1}')
            local table_name=$(echo "$line" | awk '{print $2}')
            echo "$table_name (ID: $table_id):"
            ip rule show | grep "lookup $table_name" | sed 's/^/  Rule: /'
            ip route show table "$table_name" 2>/dev/null | while read -r route; do
                echo "  Route: $route"
            done || echo "  (no routes)"
            echo ""
        done
    fi
    [ -z "$(grep '_vpn_' /etc/iproute2/rt_tables 2>/dev/null)" ] && warning "No WireGuard routes configured"
}
set_lan_routes() {
    local wg_iface="$1"
    local lan_iface="$2"
    [ -z "$wg_iface" ] && error "WireGuard interface name required!"
    [ -z "$lan_iface" ] && error "LAN interface name required!"
    debug_write "[ROUTES SET] START: wg=$wg_iface, lan=$lan_iface"
    debug_write "[ROUTES SET] Validating interfaces..."
    if ! uci get "network.$wg_iface" >/dev/null 2>&1; then
        debug_write "[ROUTES SET ERROR] WG interface not in UCI: $wg_iface"
        error "$wg_iface does not exist in network config!"
    fi
    if ! uci get "network.$lan_iface" >/dev/null 2>&1; then
        debug_write "[ROUTES SET ERROR] LAN interface not in UCI: $lan_iface"
        error "$lan_iface does not exist in network config!"
    fi
    validate_iface_name "$wg_iface"
    debug_write "[ROUTES SET] Interfaces validated"
    state_init
    local wg_id=$(state_get_id "$wg_iface" 2>/dev/null)
    local wg_id_found=$?
    debug_write "[ROUTES SET] State ID for $wg_iface: ${wg_id:-NOT_FOUND} (found=$wg_id_found)"
    log "Setting up routes for $lan_iface through $wg_iface..."
    echo ""
    local lan_ip=""
    local lan_netmask=""
    lan_ip=$(uci get "network.$lan_iface.ipaddr" 2>/dev/null)
    if [ -z "$lan_ip" ]; then
        lan_ip=$(ip -4 addr show "$lan_iface" 2>/dev/null | grep inet | awk '{print $2}' | cut -d/ -f1 | head -1)
        debug_write "[ROUTES SET] Got LAN IP from ip command: $lan_ip"
    fi
    if [ -z "$lan_ip" ]; then
        debug_write "[ROUTES SET ERROR] Cannot determine IP for $lan_iface"
        error "Could not determine IP address for $lan_iface!"
    fi
    lan_netmask=$(uci get "network.$lan_iface.netmask" 2>/dev/null)
    if [ -z "$lan_netmask" ]; then
        local lan_cidr=$(ip -4 addr show "$lan_iface" 2>/dev/null | grep inet | awk '{print $2}' | cut -d/ -f2 | head -1)
        if [ -n "$lan_cidr" ]; then
            case "$lan_cidr" in
                24) lan_netmask="255.255.255.0" ;;
                23) lan_netmask="255.255.254.0" ;;
                22) lan_netmask="255.255.252.0" ;;
                16) lan_netmask="255.255.0.0" ;;
                8)  lan_netmask="255.0.0.0" ;;
                *)  lan_netmask="255.255.255.0" ;;
            esac
            debug_write "[ROUTES SET] Converted CIDR $lan_cidr to netmask: $lan_netmask"
        fi
    fi
    local cidr=$(netmask_to_cidr "${lan_netmask:-255.255.255.0}")
    debug_write "[ROUTES SET] Using CIDR: /$cidr (netmask: ${lan_netmask:-default})"
    if [ -z "$lan_netmask" ]; then
        warning "Netmask not found for $lan_iface, assuming /$cidr"
    fi
    local subnet=""
    if [ "$cidr" = "24" ]; then
        subnet="${lan_ip%.*}.0/$cidr"
    elif [ "$cidr" = "16" ]; then
        subnet="${lan_ip%.*.*}.0.0/$cidr"
    elif [ "$cidr" = "8" ]; then
        subnet="${lan_ip%%.*}.0.0.0/$cidr"
    else
        subnet="$(ip_to_network "$lan_ip" "$cidr")/$cidr"
    fi
    debug_write "[ROUTES SET] Calculated subnet: $subnet"
    verbose log "LAN subnet: $subnet"
    local table_name="${lan_iface}_vpn_${wg_iface}"
    debug_write "[ROUTES SET] Routing table name: $table_name"
    if [ -f /etc/iproute2/rt_tables ]; then
        debug_write "[ROUTES SET] Managing rt_tables..."
        if grep -q "^[0-9]\+ $table_name$" /etc/iproute2/rt_tables 2>/dev/null; then
            debug_write "[ROUTES SET] Table already exists in rt_tables"
        else
            local table_id=150
            local max_attempts=100
            local attempts=0
            while [ $attempts -lt $max_attempts ]; do
                if ! grep -q "^$table_id " /etc/iproute2/rt_tables 2>/dev/null; then
                    break
                fi
                table_id=$((table_id + 1))
                attempts=$((attempts + 1))
            done
            if [ $attempts -ge $max_attempts ]; then
                debug_write "[ROUTES SET ERROR] Cannot find available table ID"
                error "Cannot find available routing table ID"
            fi
            local rt_atomic="${ATOMIC_PATHS}/rt_tables.set.atomic"
            local rt_temp="${ATOMIC_PATHS}/rt_tables.temp.$$"
            if cp /etc/iproute2/rt_tables "$rt_atomic" 2>/dev/null; then
                echo "$table_id $table_name" >> "$rt_atomic"
                if [ -s "$rt_atomic" ]; then
                    cp /etc/iproute2/rt_tables "$rt_temp" 2>/dev/null
                    if mv "$rt_atomic" /etc/iproute2/rt_tables 2>/dev/null; then
                        debug_write "[ROUTES SET] Added table: $table_name (ID: $table_id)"
                        rm -f "$rt_temp" 2>/dev/null
                    else
                        mv "$rt_temp" /etc/iproute2/rt_tables 2>/dev/null
                        debug_write "[ROUTES SET ERROR] Failed to update rt_tables"
                        rm -f "$rt_atomic" 2>/dev/null
                    fi
                else
                    debug_write "[ROUTES SET ERROR] Atomic file empty"
                    rm -f "$rt_atomic" 2>/dev/null
                fi
            else
                debug_write "[ROUTES SET ERROR] Cannot copy rt_tables"
            fi
        fi
    else
        debug_write "[ROUTES SET WARNING] /etc/iproute2/rt_tables not found"
        warning "Routing tables file not found, attempting to create..."
        mkdir -p /etc/iproute2 2>/dev/null
        echo "# Reserved values" > /etc/iproute2/rt_tables 2>/dev/null
        echo "#" >> /etc/iproute2/rt_tables 2>/dev/null
        echo "255     local" >> /etc/iproute2/rt_tables 2>/dev/null
        echo "254     main" >> /etc/iproute2/rt_tables 2>/dev/null
        echo "253     default" >> /etc/iproute2/rt_tables 2>/dev/null
        echo "150     $table_name" >> /etc/iproute2/rt_tables 2>/dev/null
        debug_write "[ROUTES SET] Created rt_tables with table: $table_name"
    fi
    debug_write "[ROUTES SET] Cleaning existing rules..."
    ip rule del from "$subnet" lookup "$table_name" 2>/dev/null
    ip rule del from "$subnet" to "$subnet" lookup main 2>/dev/null
    ip route flush table "$table_name" 2>/dev/null
    debug_write "[ROUTES SET] Existing rules cleaned"
    debug_write "[ROUTES SET] Adding new routing rules..."
    if ip rule add from "$subnet" lookup "$table_name" 2>/dev/null; then
        debug_write "[ROUTES SET] Added rule: from $subnet lookup $table_name"
    else
        debug_write "[ROUTES SET WARNING] Failed to add main rule"
        warning "Failed to add routing rule for $subnet"
    fi
    if ip rule add from "$subnet" to "$subnet" lookup main 2>/dev/null; then
        debug_write "[ROUTES SET] Added local rule"
    else
        debug_write "[ROUTES SET WARNING] Failed to add local rule"
    fi
    if ip route add "$subnet" dev "$lan_iface" table "$table_name" 2>/dev/null; then
        debug_write "[ROUTES SET] Added local route: $subnet via $lan_iface"
    else
        debug_write "[ROUTES SET WARNING] Failed to add local route"
        warning "Failed to add local route for $subnet"
    fi
    if ip link show "$wg_iface" >/dev/null 2>&1; then
        if ip route add default dev "$wg_iface" table "$table_name" 2>/dev/null; then
            debug_write "[ROUTES SET] Added default route via $wg_iface"
        else
            debug_write "[ROUTES SET WARNING] Failed to add default route"
            warning "Failed to add default route via $wg_iface"
        fi
    else
        debug_write "[ROUTES SET WARNING] Interface $wg_iface not active"
        warning "$wg_iface is not active! Routes may not work until interface is up."
    fi
    debug_write "[ROUTES SET] Configuring firewall rules..."
    local fw_atomic="${ATOMIC_PATHS}/firewall.set.$$.atomic"
    local fw_backup="${ATOMIC_PATHS}/firewall.backup.$$"
    cp "$FIREWALL_CONF" "$fw_backup" 2>/dev/null
    local rules_exist=0
    if grep -q "option src '$lan_iface'" "$FIREWALL_CONF" 2>/dev/null && \
       grep -q "option dest '$wg_iface'" "$FIREWALL_CONF" 2>/dev/null; then
        local start_line=$(awk -v src="$lan_iface" -v dest="$wg_iface" '
            /^config forwarding$/ { block_start = NR }
            $0 ~ "option src[[:space:]]*'\''" src "'\''" { found_src = 1; src_line = NR }
            $0 ~ "option dest[[:space:]]*'\''" dest "'\''" && found_src && NR - src_line < 10 { 
                print block_start
                exit
            }
            /^config/ && !/^config forwarding$/ { found_src = 0 }
        ' "$FIREWALL_CONF")
        if [ -n "$start_line" ]; then
            if sed -n "${start_line},$((start_line + 10))p" "$FIREWALL_CONF" | \
               grep -q "option dest '$wg_iface'" && \
               sed -n "${start_line},$((start_line + 10))p" "$FIREWALL_CONF" | \
               grep -q "option src '$lan_iface'"; then
                rules_exist=1
            fi
        fi
    fi
    if [ $rules_exist -eq 1 ]; then
        debug_write "[ROUTES SET] Firewall rules already exist"
        warning "Forwarding rules already exist for $lan_iface <-> $wg_iface"
    else
        if cp "$FIREWALL_CONF" "$fw_atomic" 2>/dev/null; then
            local insert_line=$(grep -n "^config zone" "$fw_atomic" | tail -1 | cut -d: -f1)
            [ -z "$insert_line" ] && insert_line=$(wc -l < "$fw_atomic" 2>/dev/null)
            [ -z "$insert_line" ] && insert_line=0
            local new_rules="
config forwarding
    option src '$lan_iface'
    option dest '$wg_iface'
config forwarding
    option src '$wg_iface'
    option dest '$lan_iface'"
            local fw_temp="${ATOMIC_PATHS}/firewall.temp.$$"
            head -n "$insert_line" "$fw_atomic" > "$fw_temp" 2>/dev/null || true
            echo "$new_rules" >> "$fw_temp" 2>/dev/null
            tail -n +$((insert_line + 1)) "$fw_atomic" >> "$fw_temp" 2>/dev/null || true
            if [ -s "$fw_temp" ]; then
                if mv "$fw_temp" "$FIREWALL_CONF" 2>/dev/null; then
                    debug_write "[ROUTES SET] Firewall rules added atomically"
                    verbose success "Firewall forwarding rules added"
                else
                    debug_write "[ROUTES SET ERROR] Failed to replace firewall config"
                    mv "$fw_backup" "$FIREWALL_CONF" 2>/dev/null
                    warning "Failed to update firewall configuration"
                fi
            else
                debug_write "[ROUTES SET ERROR] Temp file empty"
                mv "$fw_backup" "$FIREWALL_CONF" 2>/dev/null
            fi
            rm -f "$fw_atomic" "$fw_temp" 2>/dev/null
        else
            debug_write "[ROUTES SET ERROR] Cannot copy firewall for atomic operation"
        fi
    fi
    rm -f "$fw_backup" 2>/dev/null
    debug_write "[ROUTES SET] Committing firewall..."
    if uci commit firewall 2>/dev/null; then
        debug_write "[ROUTES SET] Firewall committed"
    else
        debug_write "[ROUTES SET WARNING] Firewall commit failed"
        warning "Failed to commit firewall (rules may still work)"
    fi
    if /etc/init.d/firewall reload 2>/dev/null; then
        debug_write "[ROUTES SET] Firewall reloaded"
    else
        debug_write "[ROUTES SET WARNING] Firewall reload failed"
    fi
    if [ $wg_id_found -eq 0 ] && [ -n "$wg_id" ]; then
        if state_write "ID_${wg_id}_IS_RT_TABLES_IN_USE" "1" 2>/dev/null; then
            debug_write "[ROUTES SET] State updated: ID_${wg_id}_IS_RT_TABLES_IN_USE=1"
        else
            debug_write "[ROUTES SET WARNING] Failed to update state"
            warning "Failed to update routing state (non-critical)"
        fi
    fi
    echo ""
    verbose log "Route configuration summary:"
    verbose echo "  Table: $table_name"
    verbose echo "  LAN Subnet: $subnet"
    verbose echo "  Via Interface: $wg_iface"
    echo ""
    success "Routes configured successfully!"
    debug_write "[ROUTES SET] COMPLETED SUCCESSFULLY"
    return 0
}
unset_lan_routes() {
    local wg_iface="$1"
    local lan_iface="$2"
    [ -z "$wg_iface" ] && error "WireGuard interface name required!"
    [ -z "$lan_iface" ] && error "LAN interface name required!"
    debug_write "[ROUTES UNSET] START: wg=$wg_iface, lan=$lan_iface"
    state_init
    local wg_id=$(state_get_id "$wg_iface" 2>/dev/null)
    local wg_id_found=$?
    debug_write "[ROUTES UNSET] State ID for $wg_iface: ${wg_id:-NOT_FOUND}"
    log "Removing routes for $lan_iface (via $wg_iface)..."
    echo ""
    local subnet=""
    local table_name="${lan_iface}_vpn_${wg_iface}"
    debug_write "[ROUTES UNSET] Attempting to determine subnet for $lan_iface..."
    local lan_ip=$(uci get "network.$lan_iface.ipaddr" 2>/dev/null)
    local lan_netmask=$(uci get "network.$lan_iface.netmask" 2>/dev/null)
    if [ -n "$lan_ip" ]; then
        local cidr=$(netmask_to_cidr "${lan_netmask:-255.255.255.0}")
        subnet="$(ip_to_network "$lan_ip" "$cidr")/$cidr"
        debug_write "[ROUTES UNSET] Subnet from UCI: $subnet"
    else
        local ip_info=$(ip -4 addr show "$lan_iface" 2>/dev/null | grep inet | head -1)
        if [ -n "$ip_info" ]; then
            subnet=$(echo "$ip_info" | awk '{print $2}')
            debug_write "[ROUTES UNSET] Subnet from ip command: $subnet"
        else
            subnet="0.0.0.0/0"
            debug_write "[ROUTES UNSET] Cannot determine subnet, using $subnet as fallback"
            warning "Could not determine IP for $lan_iface, removing all rules for table $table_name"
        fi
    fi
    debug_write "[ROUTES UNSET] Using subnet: $subnet, table: $table_name"
    verbose log "Route table: $table_name"
    verbose log "Subnet: $subnet"
    debug_write "[ROUTES UNSET] Removing IP rules..."
    if ip rule show | grep -q "from $subnet lookup $table_name"; then
        ip rule del from "$subnet" lookup "$table_name" 2>/dev/null
        if [ $? -eq 0 ]; then
            debug_write "[ROUTES UNSET] Removed rule: from $subnet lookup $table_name"
            verbose success "Rule removed: from $subnet"
        else
            debug_write "[ROUTES UNSET WARNING] Failed to remove main rule (may not exist)"
        fi
    else
        debug_write "[ROUTES UNSET] Main rule not found"
    fi
    if ip rule show | grep -q "from $subnet to $subnet lookup main"; then
        ip rule del from "$subnet" to "$subnet" lookup main 2>/dev/null
        if [ $? -eq 0 ]; then
            debug_write "[ROUTES UNSET] Removed local rule"
            verbose success "Rule removed: from $subnet to $subnet"
        fi
    else
        debug_write "[ROUTES UNSET] Local rule not found"
    fi
    if ip route show table "$table_name" 2>/dev/null | grep -q .; then
        ip route flush table "$table_name" 2>/dev/null
        if [ $? -eq 0 ]; then
            debug_write "[ROUTES UNSET] Flushed routing table: $table_name"
            verbose success "Table flushed: $table_name"
        fi
    else
        debug_write "[ROUTES UNSET] Routing table already empty"
        verbose log "Table already empty or not found: $table_name"
    fi
    debug_write "[ROUTES UNSET] Removing firewall rules..."
    if [ ! -f "$FIREWALL_CONF" ]; then
        debug_write "[ROUTES UNSET WARNING] Firewall config not found: $FIREWALL_CONF"
    else
        local fw_atomic="${ATOMIC_PATHS}/firewall.unset.$$.atomic"
        local fw_backup="${ATOMIC_PATHS}/firewall.backup.$$"
        cp "$FIREWALL_CONF" "$fw_backup" 2>/dev/null
        debug_write "[ROUTES UNSET] Created backup: $fw_backup"
        local in_forwarding_block=0
        local block_has_lan_or_wg=0
        local current_block=""
        while IFS= read -r line || [ -n "$line" ]; do
            if echo "$line" | grep -q "^[[:space:]]*config[[:space:]]\+forwarding"; then
                if [ $in_forwarding_block -eq 1 ]; then
                    if [ $block_has_lan_or_wg -eq 0 ] && [ -n "$current_block" ]; then
                        echo "$current_block" >> "$fw_atomic"
                    fi
                fi
                in_forwarding_block=1
                block_has_lan_or_wg=0
                current_block="$line"
                continue
            fi
            if [ $in_forwarding_block -eq 1 ]; then
                current_block="${current_block}
${line}"
                if echo "$line" | grep -q "option[[:space:]]\+src[[:space:]]*'\($lan_iface\|$wg_iface\)'" || \
                   echo "$line" | grep -q "option[[:space:]]\+dest[[:space:]]*'\($lan_iface\|$wg_iface\)'"; then
                    block_has_lan_or_wg=1
                    debug_write "[ROUTES UNSET] Found matching interface in forwarding block"
                fi
                if [ -z "$line" ] || echo "$line" | grep -q "^[[:space:]]*config[[:space:]]"; then
                    if [ $block_has_lan_or_wg -eq 0 ] && [ -n "$current_block" ]; then
                        echo "$current_block" >> "$fw_atomic"
                    fi
                    in_forwarding_block=0
                    block_has_lan_or_wg=0
                    current_block=""
                    if echo "$line" | grep -q "^[[:space:]]*config[[:space:]]"; then
                        if echo "$line" | grep -q "^[[:space:]]*config[[:space:]]\+forwarding"; then
                            in_forwarding_block=1
                            current_block="$line"
                        else
                            echo "$line" >> "$fw_atomic"
                        fi
                    elif [ -n "$line" ]; then
                        echo "$line" >> "$fw_atomic"
                    fi
                    continue
                fi
            else
                echo "$line" >> "$fw_atomic"
            fi
        done < "$FIREWALL_CONF"
        if [ $in_forwarding_block -eq 1 ] && [ $block_has_lan_or_wg -eq 0 ] && [ -n "$current_block" ]; then
            echo "$current_block" >> "$fw_atomic"
        fi
        if [ -f "$fw_atomic" ] && [ -s "$fw_atomic" ]; then
            if ! diff -q "$FIREWALL_CONF" "$fw_atomic" >/dev/null 2>&1; then
                if mv "$fw_atomic" "$FIREWALL_CONF" 2>/dev/null; then
                    debug_write "[ROUTES UNSET] Firewall config updated atomically"
                    verbose success "Firewall rules removed"
                else
                    debug_write "[ROUTES UNSET ERROR] Failed to replace firewall config"
                    mv "$fw_backup" "$FIREWALL_CONF" 2>/dev/null
                    warning "Failed to update firewall configuration"
                fi
            else
                debug_write "[ROUTES UNSET] No firewall changes needed"
                rm -f "$fw_atomic" 2>/dev/null
            fi
        else
            debug_write "[ROUTES UNSET ERROR] Atomic file empty or missing"
            mv "$fw_backup" "$FIREWALL_CONF" 2>/dev/null
        fi
        rm -f "$fw_backup" 2>/dev/null
    fi
    debug_write "[ROUTES UNSET] Cleaning routing tables file..."
    if [ -f /etc/iproute2/rt_tables ]; then
        if grep -q "^[0-9]\+[[:space:]]\+$table_name$" /etc/iproute2/rt_tables 2>/dev/null; then
            local rt_atomic="${ATOMIC_PATHS}/rt_tables.unset.$$.atomic"
            local rt_backup="${ATOMIC_PATHS}/rt_tables.backup.$$"
            cp /etc/iproute2/rt_tables "$rt_backup" 2>/dev/null
            grep -v "^[0-9]\+[[:space:]]\+$table_name$" /etc/iproute2/rt_tables > "$rt_atomic" 2>/dev/null
            if [ -f "$rt_atomic" ] && [ -s "$rt_atomic" ]; then
                if ! diff -q /etc/iproute2/rt_tables "$rt_atomic" >/dev/null 2>&1; then
                    if mv "$rt_atomic" /etc/iproute2/rt_tables 2>/dev/null; then
                        debug_write "[ROUTES UNSET] Removed table from rt_tables: $table_name"
                        verbose success "Table removed from rt_tables: $table_name"
                    else
                        debug_write "[ROUTES UNSET ERROR] Failed to update rt_tables"
                        mv "$rt_backup" /etc/iproute2/rt_tables 2>/dev/null
                    fi
                else
                    debug_write "[ROUTES UNSET] Table not found in rt_tables (already removed?)"
                    rm -f "$rt_atomic" 2>/dev/null
                fi
            fi
            rm -f "$rt_backup" 2>/dev/null
        else
            debug_write "[ROUTES UNSET] Table not in rt_tables: $table_name"
            verbose log "Table not found in rt_tables: $table_name"
        fi
    else
        debug_write "[ROUTES UNSET WARNING] rt_tables file not found"
    fi
    debug_write "[ROUTES UNSET] Committing firewall changes..."
    if uci commit firewall 2>/dev/null; then
        debug_write "[ROUTES UNSET] Firewall committed"
    else
        debug_write "[ROUTES UNSET WARNING] Firewall commit failed"
        warning "Failed to commit firewall (non-critical)"
    fi
    if /etc/init.d/firewall reload 2>/dev/null; then
        debug_write "[ROUTES UNSET] Firewall reloaded"
    else
        debug_write "[ROUTES UNSET WARNING] Firewall reload failed"
    fi
    if [ $wg_id_found -eq 0 ] && [ -n "$wg_id" ]; then
        if state_write "ID_${wg_id}_IS_RT_TABLES_IN_USE" "0" 2>/dev/null; then
            debug_write "[ROUTES UNSET] State updated: ID_${wg_id}_IS_RT_TABLES_IN_USE=0"
        else
            debug_write "[ROUTES UNSET WARNING] Failed to update state"
        fi
    fi
    echo ""
    success "$lan_iface routes (via $wg_iface) successfully removed!"
    debug_write "[ROUTES UNSET] COMPLETED SUCCESSFULLY"
    return 0
}
upgrade_tmp_script() {
    local script_path="$1"
    local apk_command="$2"
    local version="$3"
    debug_write "[UPGRADE] upgrade_tmp_script STARTED...."
    verbose log "Creating temporary upgrade script at: $script_path"
    if ! touch "$script_path" 2>/dev/null; then
        debug_write "[UPGRADE] Cannot create sh in /tmp. CHECK /tmp permissions ?"
        warning "Cannot create script in /tmp. Please provide an alternative path."
        local new_path=""
        while :; do
            printf "Enter path for upgrade script (E.g: /tmp/upgrade.sh): "
            read new_path
            if [ -z "$new_path" ]; then
                warnin "PATH cannot be empty!"
                continue
            fi
            local dir_path="${new_path%/*}"
            if [ ! -d "$dir_path" ]; then
                warning "Directory does not exist!: $dir_path"
                continue
            fi
            if [ ! -w "$dir_path" ]; then
                debug_write "[UPGRADE] Custom PATH exists BUT it is NOT writable. Check user/path permissions?"
                warning "Directory is not writable!: $dir_path"
                continue
            fi
            script_path="$new_path"
            verbose log "Using alternative script path: $script_path"
            break
        done
    fi
    echo '#!/bin/ash' > "$script_path"
    echo '' >> "$script_path"
    echo "# wg-autoconf $version UPDATER script" >> "$script_path"
    echo '' >> "$script_path"
    echo 'echo "Starting upgrade process..."' >> "$script_path"
    echo 'echo ""' >> "$script_path"
    echo '' >> "$script_path"
    echo "echo 'Launching : $apk_command'" >> "$script_path"
    echo 'echo ""' >> "$script_path"
    echo '' >> "$script_path"
    echo "$apk_command" >> "$script_path"
    echo '' >> "$script_path"
    echo 'echo ""' >> "$script_path"
    echo 'echo "Cleaning up temporary files..."' >> "$script_path"
    echo "rm -f $script_path" >> "$script_path"
    echo '' >> "$script_path"
    echo 'echo ""' >> "$script_path"
    echo 'echo "Upgrade completed!"' >> "$script_path"
    chmod 755 "$script_path"
    if [ -f "$script_path" ] && [ -x "$script_path" ]; then
        echo "$script_path"
        return 0
    else
        debug_write "[UPGRADE] Unexpected error executing uppgrade. PATH: $script_path. Check logread | tail -10 ? Check permissions?"
        verbose log "Failed to create executable script at: $script_path"
        return 1
    fi
}
upgrade_app() {
    local option
    local filepath
    local upgrade_script="/tmp/wg-autoconf-upgrading.sh"
    local apk_command=""
    echo ""
    ui_lines 50 "${GREEN}wg-autoconf${NC} ${RED}$VERSION${NC} ${YELLOW}UPGRADE Module${NC}"
    verbose log "This feature allows you to update wg-autoconf easily, either from a local .apk file or directly from source."
    verbose log "An executable will be created in /tmp to proceed with the installation, thereby releasing the main binary."
    verbose echo ""
    warning "Any active connection will be DROPPED during the update process!!!"
    echo ""
    echo -e "\e[1mPlease choose upgrade method:\e[0m"
    echo "  1) Using a local .apk file"
    echo "  2) From package sources"
    echo "  0) Exit"
    echo ""
    while :; do
        printf "Choose an option : "
        read option
        case "$option" in
            1|2)
                break
                ;;
            0|exit|EXIT|Exit)
                warning "Upgrade cancelled by the user!"
                exit 1
                ;;
            *)
                error "Invalid option!"
                ;;
        esac
    done
    echo ""
    case "$option" in
        1)
            while :; do
                debug_write "[UPGRADE] Custom local APK file mode selected ..."
                printf "Enter full PATH to local APK file (E.g., /tmp/file.apk): "
                read filepath
                if [ -z "$filepath" ]; then
                    warning "File path cannot be empty."
                    exit 1
                fi
                if ! [ -f "$filepath" ]; then
                    warning "File not found: $filepath"
                    exit 1
                fi
                if echo "$filepath" | grep "\.apk$" >/dev/null 2>&1; then
                    apk_command="apk add --force-overwrite \"$filepath\""
                    break
                else
                    debug_write "[UPGRADE ERROR] Custom APK file selected ERROR!. Check xxd $filepath, check proper apk file?"
                    echo "File does not appear to be an APK file. Please provide a .apk file."
                fi
            done
            ;;
        2)
            debug_write "[UPGRADE] Sources mode selected ..."
            apk_command="apk add --upgrade wg-autoconf"
            ;;
        *)
            debug_write "[UPGRADE ERROR] This option should not have been accessed! Tampered bin?"
            warning "Invalid option selected ($option). Aborting!"
            exit 1
            ;;
    esac
    local created_script
    created_script=$(upgrade_tmp_script "$upgrade_script" "$apk_command" "$VERSION")
    if [ $? -ne 0 ] || [ -z "$created_script" ]; then
        warning "Failed to create upgrade script!"
        exit 1
    fi
    upgrade_script="$created_script"
    echo ""
    log "Launching Upgrade module ..."
    verbose info "The current application will now terminate and the upgrade will begin."
    verbose info ""
    sleep 2
    exec sh "$upgrade_script"
    debug_write "[UPGRADE] Temporary update script FAILED! Check exec sh $upgrade_script availability, permissions, or changes on ASH"
    warning "Failed to launch upgrade script!"
    exit 1
}
state_init() {
    if [ ! -d "$STATE_DIR" ]; then
        mkdir -p "$STATE_DIR" 2>/dev/null || {
            error "Failed to create $STATE_DIR"
            return 1
        }
    fi
    if [ -f "$STATE_FILE" ]; then
        debug_write "[STATE] State file already exists, skipping initialization"
        return 0
    fi
    cat > "$STATE_FILE" 2>/dev/null << 'EOF'
IS_INSTALLED=1
IS_FIRST_EXEC=1
IS_BEFORE_TO_UPGRADE=0
IS_UPGRADED=0
EOF
    if [ -f "$STATE_FILE" ]; then
        debug_write "[STATE] State file initialized at $STATE_FILE"
        verbose success "State file initialized"
        return 0
    else
        error "Failed to create state file"
        return 1
    fi
}
state_read() {
    local key="$1"
    if [ -z "$key" ]; then
        debug_write "[STATE] state_read: key parameter missing"
        return 1
    fi
    if [ ! -f "$STATE_FILE" ]; then
        debug_write "[STATE] state_read: State file not found: $STATE_FILE"
        return 1
    fi
    local value=$(grep "^${key}=" "$STATE_FILE" 2>/dev/null | cut -d= -f2-)
    if [ -n "$value" ]; then
        echo "$value"
        return 0
    else
        return 1
    fi
}
state_write() {
    local key="$1"
    local value="$2"
    if [ -z "$key" ]; then
        debug_write "[STATE] state_write: key parameter missing"
        return 1
    fi
    if echo "$key" | grep -q "IS_[A-Z_]*$" && [ "$value" != "0" ] && [ "$value" != "1" ]; then
        debug_write "[STATE] state_write: WARNING - Boolean flag $key should be 0 or 1, got: $value"
    fi
    if [ ! -f "$STATE_FILE" ]; then
        debug_write "[STATE] state_write: State file not found, attempting init"
        state_init || return 1
    fi
    local counter=0
    local temp_file=""
    while [ $counter -lt 100 ]; do  # Límite de intentos
        temp_file="${ATOMIC_PATHS}/states.write.${counter}.atomic"
        [ ! -f "$temp_file" ] && break
        counter=$((counter + 1))
    done
    [ $counter -ge 100 ] && error "Cannot create unique temp file for state_write"
    local found=0
    local output=""
    if ! [ -r "$STATE_FILE" ]; then
        debug_write "[STATE] state_write: Cannot read state file"
        return 1
    fi
    while IFS= read -r line || [ -n "$line" ]; do
        if [ -z "$line" ]; then
            continue
        fi
        if [ "${line#"#"}" != "$line" ]; then
            output="${output}${line}
"
            continue
        fi
        local line_key="${line%%=*}"
        local line_value="${line#*=}"
        if [ "$line_key" = "$key" ]; then
            found=1
            output="${output}${key}=${value}
"
        else
            output="${output}${line_key}=${line_value}
"
        fi
    done < "$STATE_FILE"
    if [ $found -eq 0 ]; then
        output="${output}${key}=${value}
"
    fi
    debug_write "[STATE] state_write: Writing to temp: $temp_file"
    printf "%s" "$output" > "$temp_file" 2>/dev/null
    if [ ! -s "$temp_file" ]; then
        debug_write "[STATE] state_write: ERROR - temp file empty"
        rm -f "$temp_file" 2>/dev/null
        return 1
    fi
    if mv "$temp_file" "$STATE_FILE" 2>/dev/null; then
        debug_write "[STATE] state_write: Updated: ${key}=${value}"
        return 0
    else
        debug_write "[STATE] state_write: ERROR - Failed to replace state file"
        rm -f "$temp_file" 2>/dev/null
        return 1
    fi
}
state_get_id() {
    local iface_name="$1"
    if [ -z "$iface_name" ]; then
        debug_write "[STATE] state_get_id: interface name missing"
        return 1
    fi
    if [ ! -f "$STATE_FILE" ]; then
        return 1
    fi
    local id=$(grep "^ID_.*_NAME=${iface_name}$" "$STATE_FILE" 2>/dev/null | \
               sed 's/^ID_\([0-9]*\)_NAME.*/\1/')
    if [ -n "$id" ]; then
        echo "$id"
        return 0
    else
        return 1
    fi
}
state_add_iface() {
    local iface_name="$1"
    if [ -z "$iface_name" ]; then
        debug_write "[STATE] state_add_iface: interface name missing"
        return 1
    fi
    if state_get_id "$iface_name" >/dev/null 2>&1; then
        debug_write "[STATE] Interface $iface_name already tracked"
        return 1
    fi
    if [ ! -f "$STATE_FILE" ]; then
        state_init || return 1
    fi
    local counter=0
    local temp_file=""
    while [ $counter -lt 100 ]; do
        temp_file="${ATOMIC_PATHS}/states.add.${counter}.atomic"
        [ ! -f "$temp_file" ] && break
        counter=$((counter + 1))
    done
    [ $counter -ge 100 ] && error "Cannot create unique temp file for state_add_iface"
    local next_id=1
    local max_id=$(grep "^ID_.*_NAME=" "$STATE_FILE" 2>/dev/null | \
                   sed 's/^ID_\([0-9]*\)_NAME.*/\1/' | \
                   sort -n | tail -1)
    if [ -n "$max_id" ]; then
        next_id=$((max_id + 1))
    fi
    local output=""
    local file_exists=0
    if [ -f "$STATE_FILE" ] && [ -r "$STATE_FILE" ]; then
        file_exists=1
        while IFS= read -r line || [ -n "$line" ]; do
            output="${output}${line}
"
        done < "$STATE_FILE"
    fi
    output="${output}ID_${next_id}_NAME=${iface_name}
ID_${next_id}_IS_CREATED=0
ID_${next_id}_IS_ACTIVE=0
ID_${next_id}_IS_RT_TABLES_IN_USE=0
"
    debug_write "[STATE] state_add_iface: Writing to temp: $temp_file"
    printf "%s" "$output" > "$temp_file" 2>/dev/null
    if [ ! -s "$temp_file" ]; then
        debug_write "[STATE] state_add_iface: ERROR - temp file empty"
        rm -f "$temp_file" 2>/dev/null
        return 1
    fi
    if mv "$temp_file" "$STATE_FILE" 2>/dev/null; then
        debug_write "[STATE] Added interface: $iface_name (ID: $next_id)"
        echo "$next_id"
        return 0
    else
        debug_write "[STATE] state_add_iface: ERROR - Failed to replace state file"
        rm -f "$temp_file" 2>/dev/null
        return 1
    fi
}
state_remove_iface() {
    local id="$1"
    if [ -z "$id" ]; then
        debug_write "[STATE] state_remove_iface: ID parameter missing"
        return 1
    fi
    if [ ! -f "$STATE_FILE" ]; then
        debug_write "[STATE] state_remove_iface: State file not found"
        return 1
    fi
    if ! echo "$id" | grep -qE '^[0-9]+$'; then
        debug_write "[STATE] state_remove_iface: Invalid ID format (must be numeric): $id"
        return 1
    fi
    local total_ifaces_before=$(state_count_ifaces)
    debug_write "[STATE] state_remove_iface: Total interfaces before: $total_ifaces_before"
    local counter=0
    local temp_file=""
    while [ $counter -lt 100 ]; do
        temp_file="${ATOMIC_PATHS}/states.remove.${counter}.atomic"
        [ ! -f "$temp_file" ] && break
        counter=$((counter + 1))
    done
    [ $counter -ge 100 ] && error "Cannot create unique temp file for state_remove_iface"
    local iface_name=""
    local remaining_ifaces=0
    local output=""
    debug_write "[STATE] state_remove_iface: Processing ID $id"
    while IFS= read -r line || [ -n "$line" ]; do
        if [ -z "$line" ]; then
            continue
        fi
        if [ "${line#"#"}" != "$line" ]; then
            output="${output}${line}"
            continue
        fi
        local line_key="${line%%=*}"
        local line_value="${line#*=}"
        if [ "$line_key" = "ID_${id}_NAME" ]; then
            iface_name="$line_value"
            debug_write "[STATE] state_remove_iface: Found interface: $iface_name"
            continue  # No añadir a output
        fi
        if echo "$line_key" | grep -q "^ID_[0-9]*_NAME$"; then
            local other_id=$(echo "$line_key" | sed 's/^ID_\([0-9]*\)_NAME$/\1/')
            if [ "$other_id" != "$id" ]; then
                remaining_ifaces=$((remaining_ifaces + 1))
                output="${output}${line}"
            fi
            continue
        fi
        if echo "$line_key" | grep -q "^ID_${id}_"; then
            debug_write "[STATE] state_remove_iface: Filtering: $line_key"
            continue
        fi
        output="${output}${line}"
    done < "$STATE_FILE"
    if [ -z "$iface_name" ]; then
        debug_write "[STATE] state_remove_iface: Interface ID $id not found"
        return 1
    fi
    debug_write "[STATE] state_remove_iface: Remaining interfaces: $remaining_ifaces"
    if [ $remaining_ifaces -eq 0 ]; then
        debug_write "[STATE] state_remove_iface: Last interface removed, calling state_reset"
        if state_reset; then
            debug_write "[STATE] state_remove_iface: Reset complete for $iface_name"
            debug_write "[STATE] state_remove_iface: State file reinitialized to defaults"
            return 0
        else
            debug_write "[STATE] state_remove_iface: state_reset failed"
            return 1
        fi
    fi
    debug_write "[STATE] state_remove_iface: Writing temp file (preserving $remaining_ifaces interfaces)"
    printf "%s" "$output" > "$temp_file" 2>/dev/null
    if [ ! -s "$temp_file" ]; then
        debug_write "[STATE] state_remove_iface: ERROR - temp file empty"
        rm -f "$temp_file" 2>/dev/null
        return 1
    fi
    if mv "$temp_file" "$STATE_FILE" 2>/dev/null; then
        debug_write "[STATE] state_remove_iface: Successfully removed $iface_name (ID: $id)"
        debug_write "[STATE] state_remove_iface: Preserved $remaining_ifaces other interfaces"
        return 0
    else
        debug_write "[STATE] state_remove_iface: ERROR - mv failed"
        rm -f "$temp_file" 2>/dev/null
        return 1
    fi
}
state_list_ifaces() {
    if [ ! -f "$STATE_FILE" ]; then
        return 1
    fi
    local iface_list=""
    local all_lines=""
    while IFS= read -r line || [ -n "$line" ]; do
        all_lines="${all_lines}${line}
"
    done < "$STATE_FILE"
    printf "%s" "$all_lines" | while IFS= read -r line || [ -n "$line" ]; do
        if echo "$line" | grep -q "^ID_[0-9]*_NAME="; then
            local id=$(echo "$line" | sed 's/^ID_\([0-9]*\)_NAME=.*/\1/')
            local name=$(echo "$line" | cut -d= -f2-)
            if [ -n "$id" ] && [ -n "$name" ]; then
                if [ -z "$iface_list" ]; then
                    iface_list="${id}:${name}"
                else
                    iface_list="${iface_list} ${id}:${name}"
                fi
            fi
        fi
    done
    if [ -n "$iface_list" ]; then
        echo "$iface_list"
        return 0
    else
        return 1
    fi
}
state_count_ifaces() {
    if [ ! -f "$STATE_FILE" ]; then
        echo 0
        return 1
    fi
    local count=$(grep -c "^ID_.*_NAME=" "$STATE_FILE" 2>/dev/null)
    if [ -z "$count" ]; then
        count=0
    fi
    echo "$count"
    [ "$count" -gt 0 ] && return 0 || return 1
}
state_reset() {
    if [ ! -f "$STATE_FILE" ]; then
        debug_write "[STATE] State file not found, initializing"
        return $(state_init)
    fi
    rm -f "$STATE_FILE" 2>/dev/null
    state_init || return 1
    debug_write "[STATE] State file reset to initial state"
    verbose success "State file reset"
    return 0
}
state_check_first_exec() {
    local first_exec=$(state_read "IS_FIRST_EXEC" 2>/dev/null)
    [ "$first_exec" = "1" ]
}
state_set_first_exec() {
    local value="${1:-1}"
    state_write "IS_FIRST_EXEC" "$value"
}
state_get_iface_state() {
    local iface="$1"
    if [ -z "$iface" ]; then
        return 1
    fi
    local id
    if echo "$iface" | grep -qE '^[0-9]+$'; then
        id="$iface"
    else
        id=$(state_get_id "$iface") || return 1
    fi
    if [ ! -f "$STATE_FILE" ]; then
        return 1
    fi
    local name=$(grep "^ID_${id}_NAME=" "$STATE_FILE" 2>/dev/null | cut -d= -f2-)
    local created=$(grep "^ID_${id}_IS_CREATED=" "$STATE_FILE" 2>/dev/null | cut -d= -f2-)
    local active=$(grep "^ID_${id}_IS_ACTIVE=" "$STATE_FILE" 2>/dev/null | cut -d= -f2-)
    local rt_tables=$(grep "^ID_${id}_IS_RT_TABLES_IN_USE=" "$STATE_FILE" 2>/dev/null | cut -d= -f2-)
    if [ -n "$name" ]; then
        echo "NAME=${name}|IS_CREATED=${created}|IS_ACTIVE=${active}|IS_RT_TABLES_IN_USE=${rt_tables}"
        return 0
    else
        return 1
    fi
}
debug_init_log() {
    mkdir -p "$DEBUG_PATH" 2>/dev/null || return 1
    if [ ! -f "$DEBUG_LOG" ]; then
        cat > "$DEBUG_LOG" << EOF
===[ wg-autoconf $VERSION DEBUG LOG ]=======================
Started: $(date '+%Y-%m-%d %H:%M:%S')
=============================================================
EOF
    fi
}
debug_state_read() {
    if [ -f "$DEBUG_PATH/debug-state" ]; then
        cat "$DEBUG_PATH/debug-state"
    else
        echo "0"
    fi
}
debug_state_write() {
    local state="$1"
    mkdir -p "$DEBUG_PATH" 2>/dev/null
    echo "$state" > "$DEBUG_PATH/debug-state"
}
debug_is_active() {
    [ "$(debug_state_read)" = "1" ]
}
debug_write() {
    local msg="$1"
    debug_is_active || return 0
    [ -z "$msg" ] && return
    if [ ! -f "$DEBUG_LOG" ]; then
        debug_init_log
    fi
    if [ -f "$DEBUG_LOG" ]; then
        printf "[%s] [%s] %s\n" "$(date '+%Y-%m-%d %H:%M:%S')" "$VERSION" "$msg" >> "$DEBUG_LOG"
        debug_rotate_logs_by_size
    fi
}
debug() {
    debug_is_active || return 0
    local cmd="$@"
    debug_write "EXEC: $cmd"
    local output
    output=$(sh -c "$cmd" 2>&1)
    local exitcode=$?
    if [ $exitcode -eq 0 ]; then
        echo "$output" | while read -r line; do
            debug_write "  $line"
        done
    else
        debug_write "ERROR ($exitcode):"
        echo "$output" | while read -r line; do
            debug_write "  $line"
        done
    fi
    return $exitcode
}
debug_rotate_logs_by_size() {
    [ ! -f "$DEBUG_LOG" ] && return
    local size=$(wc -c < "$DEBUG_LOG")
    local max_size=$((1024 * $DEBUG_LOG_MAX_SIZE))
    if [ $size -gt $max_size ]; then
        local old_num=1
        while [ -f "$DEBUG_PATH/wg-autoconf-OLD-$old_num.log" ]; do
            old_num=$((old_num + 1))
        done
        mv "$DEBUG_LOG" "$DEBUG_PATH/wg-autoconf-OLD-$old_num.log"
        debug_init_log
        debug_write "Log rotated to OLD-$old_num"
    fi
}
debug_show() {
    if [ -f "$DEBUG_LOG" ]; then
        cat "$DEBUG_LOG"
    else
        error "Logs not found: $DEBUG_LOG !"
    fi
}
debug_show_live() {
    if ! debug_is_active; then
        error "Debug is not active. Use: wg-autoconf debug on"
    fi
    if [ -f "$DEBUG_LOG" ]; then
        tail -f "$DEBUG_LOG"
    else
        error "Logs not found: $DEBUG_LOG !"
    fi
}
debug_clear() {
    if [ "$(debug_state_read)" = "1" ]; then
        error "Debug session already active. Use: wg-autoconf debug off"
    fi
    echo ""
    local old_count=$(find "$DEBUG_PATH" -name "wg-autoconf-OLD-*.log" 2>/dev/null | wc -l)
    warning "This action is destructive:"
    echo ""
    if [ -f "$DEBUG_LOG" ]; then
        local size=$(du -h "$DEBUG_LOG" | awk '{print $1}')
        echo "  $DEBUG_LOG - Current log ($size)"
    fi
    if [ $old_count -gt 0 ]; then
        find "$DEBUG_PATH" -name "wg-autoconf-OLD-*.log" 2>/dev/null |
        while read -r file; do
            local size=$(du -h "$file" | awk '{print $1}')
            echo "  $file - Old file ($size)"
        done
    fi
    if [ ! -f "$DEBUG_LOG" ] && [ $old_count -eq 0 ]; then
        warning "  No log files found!"
        return 0
    fi
    echo ""
    read -p "Continue? (y/N): " confirm
    case "$confirm" in
        y|Y|yes|YES)
            rm -f "$DEBUG_LOG" "$DEBUG_PATH/wg-autoconf-OLD-"*.log 2>/dev/null
            success "Debug logs cleared!"
            ;;
        *)
            log "Cancelled by the user!"
            ;;
    esac
}
debug_status() {
    echo ""
    ui_lines 50 "${YELLOW}DEBUG STATUS${NC}"
    echo ""
    local state=$(debug_state_read)
    if [ "$state" = "1" ]; then
        echo -e "${YELLOW}Status:${NC}           ${GREEN}ACTIVE${NC}"
    else
        echo -e "${YELLOW}Status:${NC}           ${RED}INACTIVE${NC}"
    fi
    echo -e "${YELLOW}Log path/file:    $DEBUG_LOG${NC}"
    echo ""
    if [ -f "$DEBUG_LOG" ]; then
        local size=$(du -h "$DEBUG_LOG" | awk '{print $1}')
        local lines=$(wc -l < "$DEBUG_LOG")
        echo -e "${YELLOW}Current log:${NC}      ${GREEN}$size ($lines lines)${NC}"
    else
        echo -e "${YELLOW}Current log:${NC}      ${RED}Not created yet!{NC}"
    fi
    local old_count=$(find "$DEBUG_PATH" -name "wg-autoconf-OLD-*.log" 2>/dev/null | wc -l)
    if [ $old_count -gt 0 ]; then
        echo -e "${YELLOW}Old logs:${NC}         ${GREEN}$old_count file(s)${NC}"
        find "$DEBUG_PATH" -name "wg-autoconf-OLD-*.log" 2>/dev/null |
        while read -r file; do
            local size=$(du -h "$file" | awk '{print $1}')
            echo -e "  ${YELLOW}$(basename "$file"):${NC} ${GREEN}$size${NC}"
        done
    else
        echo -e "${YELLOW}Old logs:         None${NC}"
    fi
    echo ""
    ui_lines 50
}
debug_on() {
    if debug_is_active; then
        warning "Debug is already active"
        return 0
    fi
    debug_state_write "1"
    debug_init_log
    debug_write "Debug mode activated by $(id -un)@$(cat /proc/sys/kernel/hostname)"
    success "Debug activated!"
    echo ""
    echo -e "${YELLOW}Log file:${NC}         $DEBUG_LOG"
    echo ""
    echo -e "Now you can tail in another terminal:"
    echo -e "   ${GREEN}wg-autoconf debug live${NC}"
}
debug_off() {
    if ! debug_is_active; then
        warning "Debug is already inactive"
        return 0
    fi
    debug_write "Debug mode deactivated by $(id -un)@$(cat /proc/sys/kernel/hostname)"
    debug_state_write "0"
    success "Debug deactivated!"
}
debug_handler() {
    local action="$1"
    case "$action" in
        on)
            debug_on
            ;;
        off)
            debug_off
            ;;
        show)
            debug_show
            ;;
        tail)
            debug_show_live
            ;;
        clear)
            debug_clear
            ;;
        status)
            debug_status
            ;;
        *)
            error "Usage: wg-autoconf debug [on|off|show|tail|clear|status]"
            ;;
    esac
}
verbose=0
cmd=""
cmd_args=""
if [ "$1" = "--verbose" ] || [ "$1" = "-v" ]; then
    verbose=1
    shift
fi
if [ $# -gt 0 ]; then
    last_arg=""
    for arg in "$@"; do
        last_arg="$arg"
    done
    if [ "$last_arg" = "--verbose" ] || [ "$last_arg" = "-v" ]; then
        verbose=1
        new_args=""
        first=1
        for arg in "$@"; do
            if [ "$arg" = "$last_arg" ]; then
                continue
            fi
            if [ $first -eq 1 ]; then
                new_args="$arg"
                first=0
            else
                new_args="$new_args $arg"
            fi
        done
        set -- $new_args
    fi
fi
if [ "$1" = "--help" ] || [ "$1" = "-h" ] || [ "$1" = "help" ]; then
    show_usage
    exit 0
fi
VERBOSE=$verbose
if [ $# -eq 0 ]; then
    show_header
    exit 0
fi
cmd="$1"
shift
while [ $# -gt 0 ]; do
    cmd_args="$cmd_args $1"
    shift
done
cmd_args=$(echo "$cmd_args" | sed 's/^ //')
arg1=$(echo "$cmd_args" | awk '{print $1}')
arg2=$(echo "$cmd_args" | awk '{print $2}')
arg3=$(echo "$cmd_args" | awk '{print $3}')
case "$cmd" in
    list)
        list_configs
        ;;
    list-full)
        list_configs_full
        ;;
    test)
        if [ -n "$arg1" ]; then
            test_config "$arg1"
        else
            show_header
            exit 1
        fi
        ;;
    setup)
        if [ -n "$arg1" ]; then
            setup_wireguard "$arg1"
        else
            show_header
            exit 1
        fi
        ;;
    manual)
        setup_wireguard "$arg1" "manual"
        ;;
    up)
        if [ -n "$arg1" ]; then
            activate_interface "$arg1"
        else
            show_header
            exit 1
        fi
        ;;
    down)
        if [ -n "$arg1" ]; then
            deactivate_interface "$arg1"
        else
            show_header
            exit 1
        fi
        ;;
    remove)
        if [ -n "$arg1" ]; then
            remove_wireguard "$arg1" ""
        else
            show_header
            exit 1
        fi
        ;;
    status)
        show_status "$arg1"
        ;;
    clean)
        if [ -n "$arg1" ]; then
            cleanup "single" "$arg1" ""
        else
            cleanup "all" "" ""
        fi
        ;;
    nuke)
        cleanup "nuke" "" ""
        ;;
    backups)
        case "$arg1" in
            show)
                show_backups
                ;;
            restore)
                restore_backups "$arg2"
                ;;
            diagnose|diag)
                if [ -n "$arg2" ]; then
                    diagnose_backup_issue "/etc/config/$arg2"
                else
                    for config in network dhcp firewall; do
                        diagnose_backup_issue "/etc/config/$config"
                    done
                fi
                ;;
            cleanup)
                cleanup_backup_files "$arg2"
                ;;
            *)
                show_header
                exit 1
                ;;
        esac
        ;;
    routes)
        case "$arg1" in
            set)
                if [ -n "$arg2" ] && [ -n "$arg3" ]; then
                    set_lan_routes "$arg2" "$arg3"
                else
                    show_header
                    exit 1
                fi
                ;;
            unset)
                if [ -n "$arg2" ] && [ -n "$arg3" ]; then
                    unset_lan_routes "$arg2" "$arg3"
                else
                    show_header
                    exit 1
                fi
                ;;
            show)
                show_routes "$arg2"
                ;;
            *)
                show_header
                exit 1
                ;;
        esac
        ;;
    debug)
        debug_handler "$arg1"
        ;;
    upgrade)
        upgrade_app
        ;;
    *)
        show_header
        echo ""
        error "Invalid CMD: ${NC} $cmd"
        ;;
esac