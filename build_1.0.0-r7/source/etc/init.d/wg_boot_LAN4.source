#!/bin/sh /etc/rc.common

START=92

start() {

    cat <<'EOF' >> /etc/config/firewall

# LAN 4 confs start
config zone
	  option name 'lan4'
	  list network 'lan4'
	  option input 'ACCEPT'
	  option output 'ACCEPT'
	  option forward 'REJECT'

config forwarding
	  option src 'lan4'
	  option dest 'wan'

# LAN 4 confs end
EOF


    cat <<'EOF'>> /etc/config/dhcp

# LAN 4 confs start
config dhcp 'lan4'
    option interface 'lan4'
    option start '100'
    option limit '150'
    option leasetime '12h'
    option dhcpv4 'server'

# LAN 4 confs end
EOF



    cat <<'EOF' >> /etc/config/network

# LAN 4 confs start
config interface 'lan4'
      option device 'lan4'
      option proto 'static'
      option ipaddr '192.168.4.1'
      option netmask '255.255.255.0'
      option ip6assign '60'

# LAN 4 confs end
EOF

    uci commit firewall
    uci commit dhcp
    uci commi network
    sleep 1
    ifup lan4
}

stop() {

    sed -i "/^# LAN 4 confs start$/,/^# LAN 4 confs end$/d" /etc/config/firewall
    sed -i "/^# LAN 4 confs start$/,/^# LAN 4 confs end$/d" /etc/config/dhcp
    sed -i "/^# LAN 4 confs start$/,/^# LAN 4 confs end$/d" /etc/config/network
    ip rule del from 192.168.4.0/24 lookup lan4_vpn 2>/dev/null
    ip route flush table lan4_vpn 2>/dev/null
    sleep 1
    ifdown lan4
    sleep 1
    uci delete network.lan4
    uci commit firewall
    uci commit dhcp
    uci commi network
}

restart() {
    stop
    sleep 1
    start
}
