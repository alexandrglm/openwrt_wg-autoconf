table inet fw4 {
        chain input {
                type filter hook input priority filter; policy accept;
                iif "lo" accept comment "!fw4: Accept traffic from loopback"
                ct state vmap { invalid : drop, established : accept, related : accept } comment "!fw4: Handle inbound flows"
                tcp flags & (fin | syn | rst | ack) == syn jump syn_flood comment "!fw4: Rate limit TCP syn packets"
                iifname "br-lan" jump input_lan comment "!fw4: Handle lan IPv4/IPv6 input traffic"
                iifname "lan4" jump input_lan4 comment "!fw4: Handle lan4 IPv4/IPv6 input traffic"
                iifname { "usb0", "wan" } jump input_wan comment "!fw4: Handle wan IPv4/IPv6 input traffic"
        }

        chain forward {
                type filter hook forward priority filter; policy drop;
                ct state vmap { invalid : drop, established : accept, related : accept } comment "!fw4: Handle forwarded flows"
                iifname "br-lan" jump forward_lan comment "!fw4: Handle lan IPv4/IPv6 forward traffic"
                iifname "lan4" jump forward_lan4 comment "!fw4: Handle lan4 IPv4/IPv6 forward traffic"
                iifname { "usb0", "wan" } jump forward_wan comment "!fw4: Handle wan IPv4/IPv6 forward traffic"
                jump handle_reject
        }

        chain output {
                type filter hook output priority filter; policy accept;
                oif "lo" accept comment "!fw4: Accept traffic towards loopback"
                ct state vmap { invalid : drop, established : accept, related : accept } comment "!fw4: Handle outbound flows"
                oifname "br-lan" jump output_lan comment "!fw4: Handle lan IPv4/IPv6 output traffic"
                oifname "lan4" jump output_lan4 comment "!fw4: Handle lan4 IPv4/IPv6 output traffic"
                oifname { "usb0", "wan" } jump output_wan comment "!fw4: Handle wan IPv4/IPv6 output traffic"
        }

        chain prerouting {
                type filter hook prerouting priority filter; policy accept;
                iifname "br-lan" jump helper_lan comment "!fw4: Handle lan IPv4/IPv6 helper assignment"
                iifname "lan4" jump helper_lan4 comment "!fw4: Handle lan4 IPv4/IPv6 helper assignment"
        }

        chain handle_reject {
                meta l4proto tcp reject with tcp reset comment "!fw4: Reject TCP traffic"
                reject comment "!fw4: Reject any other traffic"
        }

        chain syn_flood {
                limit rate 25/second burst 50 packets return comment "!fw4: Accept SYN packets below rate-limit"
                drop comment "!fw4: Drop excess packets"
        }

        chain input_lan {
                jump accept_from_lan
        }

        chain output_lan {
                jump accept_to_lan
        }

        chain forward_lan {
                jump accept_to_wan comment "!fw4: Accept lan to wan forwarding"
                jump accept_to_lan
        }

        chain helper_lan {
        }

        chain accept_from_lan {
                iifname "br-lan" counter packets 1 bytes 336 accept comment "!fw4: accept lan IPv4/IPv6 traffic"
        }

        chain accept_to_lan {
                oifname "br-lan" counter packets 0 bytes 0 accept comment "!fw4: accept lan IPv4/IPv6 traffic"
        }

        chain input_lan4 {
                jump accept_from_lan4
        }

        chain output_lan4 {
                jump accept_to_lan4
        }

        chain forward_lan4 {
                jump accept_to_wan comment "!fw4: Accept lan4 to wan forwarding"
                jump accept_to_lan4
        }

        chain helper_lan4 {
        }

        chain accept_from_lan4 {
                iifname "lan4" counter packets 0 bytes 0 accept comment "!fw4: accept lan4 IPv4/IPv6 traffic"
        }

        chain accept_to_lan4 {
                oifname "lan4" counter packets 0 bytes 0 accept comment "!fw4: accept lan4 IPv4/IPv6 traffic"
        }

        chain input_wan {
                tcp dport 9122 counter packets 0 bytes 0 accept comment "!fw4: Allow-SSH-WAN"
                tcp dport 80 counter packets 0 bytes 0 accept comment "!fw4: Allow-HTTP-WAN"
                tcp dport 443 counter packets 20 bytes 1040 accept comment "!fw4: Allow-HTTPS-WAN"
                udp dport 51820 counter packets 0 bytes 0 accept comment "!fw4: Allow-WG-Server"
                udp dport 51820 counter packets 0 bytes 0 accept comment "!fw4: Allow-WireGuard-wg_nl111"
                jump drop_from_wan
        }

        chain output_wan {
                jump accept_to_wan
        }

        chain forward_wan {
                jump reject_to_wan
        }

        chain accept_to_wan {
                oifname { "usb0", "wan" } counter packets 0 bytes 0 accept comment "!fw4: accept wan IPv4/IPv6 traffic"
        }

        chain reject_to_wan {
                oifname { "usb0", "wan" } counter packets 0 bytes 0 jump handle_reject comment "!fw4: reject wan IPv4/IPv6 traffic"
        }

        chain drop_from_wan {
                iifname { "usb0", "wan" } counter packets 1 bytes 152 drop comment "!fw4: drop wan IPv4/IPv6 traffic"
        }

        chain dstnat {
                type nat hook prerouting priority dstnat; policy accept;
        }

        chain srcnat {
                type nat hook postrouting priority srcnat; policy accept;
                oifname { "usb0", "wan" } jump srcnat_wan comment "!fw4: Handle wan IPv4/IPv6 srcnat traffic"
        }

        chain srcnat_wan {
                meta nfproto ipv4 masquerade comment "!fw4: Masquerade IPv4 wan traffic"
        }

        chain raw_prerouting {
                type filter hook prerouting priority raw; policy accept;
        }

        chain raw_output {
                type filter hook output priority raw; policy accept;
        }

        chain mangle_prerouting {
                type filter hook prerouting priority mangle; policy accept;
        }

        chain mangle_postrouting {
                type filter hook postrouting priority mangle; policy accept;
                oifname { "usb0", "wan" } tcp flags & (fin | syn | rst) == syn tcp option maxseg size set rt mtu comment "!fw4: Zone wan IPv4/IPv6 egress MTU fixing"
        }

        chain mangle_input {
                type filter hook input priority mangle; policy accept;
        }

        chain mangle_output {
                type route hook output priority mangle; policy accept;
        }

        chain mangle_forward {
                type filter hook forward priority mangle; policy accept;
                iifname { "usb0", "wan" } tcp flags & (fin | syn | rst) == syn tcp option maxseg size set rt mtu comment "!fw4: Zone wan IPv4/IPv6 ingress MTU fixing"
        }

        chain input_wg_nl111 {
                jump accept_from_wg_nl111
        }

        chain output_wg_nl111 {
                jump accept_to_wg_nl111
        }

        chain forward_wg_nl111 {
                jump accept_to_wan comment "!fw4: Accept wg_nl111 to wan forwarding"
                jump accept_to_wg_nl111
        }

        chain accept_from_wg_nl111 {
        }

        chain accept_to_wg_nl111 {
        }

        chain srcnat_wg_nl111 {
                meta nfproto ipv4 masquerade comment "!fw4: Masquerade IPv4 wg_nl111 traffic"
        }
}
