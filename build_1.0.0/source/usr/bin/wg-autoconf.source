#####################################################################
# WG-AUTOCONF ROUTES SHOW
#####################################################################
show_routes() {

    local filter_wg_iface="$1"

    log "WireGuard routes:"
    echo ""

    
    # 1. VALIDATE ROUTING TABLES VIA RT_TABLE
    if [ ! -f /etc/iproute2/rt_tables ]; then

        error "/etc/iproute2/rt_tables not found"

    fi

    
    # 2. DISPLAY ROUTES BASED ON FILTERING CRITERIA
    if [ -n "$filter_wg_iface" ]; then


        
        # 2.2. FILTERED MODE: SHOW ROUTES FOR SPECIFIC IFACE
        log "Routes for $filter_wg_iface:"
        echo ""

        # 2.2.1 Find all routing tables associated with the specified iface
        grep "_vpn_${filter_wg_iface}" /etc/iproute2/rt_tables 2>/dev/null | while read -r line; do

            # GET TABLES
            local table_id=$(echo "$line" | awk '{print $1}')
            local table_name=$(echo "$line" | awk '{print $2}')

            # EXTRACT LAN IFACE NAME FROM TABLE
            local lan_iface=$(echo "$table_name" | sed "s/_vpn_${filter_wg_iface}//g")

            # TABLE SECTION HEADER
            echo "$lan_iface:"
            echo "  Table: $table_name (ID: $table_id)"

            # SHOW RULES FOR THIS TABLE
            ip rule show | grep "lookup $table_name" | sed 's/^/  Rule: /'

            # SHOW ALL ROUTES
            ip route show table "$table_name" 2>/dev/null | while read -r route; do

                echo "  Route: $route"
            done || echo "  (no routes found)"

            echo ""
        done

    else
        
        # 2.3. UNFILTERED MODE: SHOW ALL WIREGUARD ROUTES
        log "All routes:"
        echo ""

        # 2.3.1 Find all VPN routing tables WITH "_vpn_" pattern
        grep "_vpn_" /etc/iproute2/rt_tables 2>/dev/null | while read -r line; do

            # GET TABLES
            local table_id=$(echo "$line" | awk '{print $1}')
            local table_name=$(echo "$line" | awk '{print $2}')

            # TABLE SECTION HEADER
            echo "$table_name (ID: $table_id):"

            # SHOW RULES FOR THIS TABLE
            ip rule show | grep "lookup $table_name" | sed 's/^/  Rule: /'

            # SHOW ALL ROUTES
            ip route show table "$table_name" 2>/dev/null | while read -r route; do

                echo "  Route: $route"

            done || echo "  (no routes)"

            echo ""
        done
    fi

    


    # 3. HANDLE EMPTY STATE WHEN NO ROUTES ARE CONFIGURED
    # CHECK PREOVIOUS VPN TABLES
    [ -z "$(grep '_vpn_' /etc/iproute2/rt_tables 2>/dev/null)" ] && warning "No WireGuard routes configured"
}


#####################################################################
# WG-AUTOCONF SET_LAN_ROUTES
#####################################################################
set_lan_routes() {

    local wg_iface="$1"
    local lan_iface="$2"

    # 0) UNCONDITIONAL PRE-CHECKS
    [ -z "$wg_iface" ] && error "WireGuard interface name required!"
    [ -z "$lan_iface" ] && error "LAN interface name required!"
    
    if ! uci get "network.$wg_iface" >/dev/null 2>&1; then
        error "SRC: $wg_iface does not exist in network config!"
    fi
    
    if ! uci get "network.$lan_iface" >/dev/null 2>&1; then
        error "DEST:  $lan_iface does not exist in network config!"
    fi
    
    validate_iface_name "$wg_iface"

    # RESOLVE UCI NAME TO REAL DEVICE
    local real_lan_iface=$(uci get network.$lan_iface.device 2>/dev/null)
    [ -z "$real_lan_iface" ] && real_lan_iface="$lan_iface"
    
    local wg_id=$(state_get_id "$wg_iface" 2>/dev/null)

    # 1. PRE-CHECKS
    state_init
    check_bins
    
    local wg_id=$(state_get_id "$wg_iface" 2>/dev/null)
    local wg_id_found=$?

    # 2. GET NETWORK DATA
    log "Setting up routes for ${GREEN}$lan_iface${NC} via ${GREEN}${BLINK}$wg_iface${NK}${NB} ..."
    echo ""
    
    local lan_ip=""
    local lan_netmask=""
    local wg_ip=""
    
    lan_ip=$(uci get "network.$lan_iface.ipaddr" 2>/dev/null)
    if [ -z "$lan_ip" ]; then
        lan_ip=$(ip -4 addr show "$lan_iface" 2>/dev/null | grep inet | awk '{print $2}' | cut -d/ -f1 | head -1)
    fi
    if [ -z "$lan_ip" ]; then
        error "Could not determine IP address for $lan_iface!"
    fi

    wg_ip=$(uci get "network.$wg_iface.addresses" 2>/dev/null | cut -d/ -f1)
    lan_netmask=$(uci get "network.$lan_iface.netmask" 2>/dev/null)
    
    if [ -z "$lan_netmask" ]; then
        local lan_cidr=$(ip -4 addr show "$lan_iface" 2>/dev/null | grep inet | awk '{print $2}' | cut -d/ -f2 | head -1)
        if [ -n "$lan_cidr" ]; then
            case "$lan_cidr" in
                24) lan_netmask="255.255.255.0" ;;
                23) lan_netmask="255.255.254.0" ;;
                22) lan_netmask="255.255.252.0" ;;
                16) lan_netmask="255.255.0.0" ;;
                8)  lan_netmask="255.0.0.0" ;;
                *)  lan_netmask="255.255.255.0" ;;
            esac
        fi
    fi
    
    local cidr=$(netmask_to_cidr "${lan_netmask:-255.255.255.0}")
    if [ -z "$lan_netmask" ]; then
        warning "Netmask not found for $lan_iface, assuming /$cidr"
    fi

    local subnet=""
    if [ "$cidr" = "24" ]; then
        subnet="${lan_ip%.*}.0/$cidr"
    elif [ "$cidr" = "16" ]; then
        subnet="${lan_ip%.*.*}.0.0/$cidr"
    elif [ "$cidr" = "8" ]; then
        subnet="${lan_ip%%.*}.0.0.0/$cidr"
    else
        subnet="$(ip_to_network "$lan_ip" "$cidr")/$cidr"
    fi
    
    verbose log "LAN subnet: $subnet"
    verbose log "Router LAN IP: $lan_ip"
    verbose log "WireGuard IP: $wg_ip"

    # 3. ROUTING TABLE SETUP
    local table_name="_vpn_${wg_iface}_${lan_iface}"
    rt_tables_health

    if [ -f /etc/iproute2/rt_tables ]; then
        local existing_tables=$(grep "_vpn_.*_${lan_iface}$" /etc/iproute2/rt_tables 2>/dev/null)
        if [ -n "$existing_tables" ]; then
            local same_wg_table=$(echo "$existing_tables" | grep "^[0-9]\+ _vpn_${wg_iface}_${lan_iface}$")
            if [ -z "$same_wg_table" ]; then
                debug_write "[ROUTES SET] Denied overwriting/re-routing an already in-use iface ($lan_iface)"
                error "'$lan_iface' is already routed to another WireGuard interface!"
                verbose log "Check '${YELLOW}/etc/iproute2/rt_tables${NC}'."
            fi
        fi
    fi

    # 4. ADD ROUTING TABLE
    add_routing_table "$table_name" "150"

    # 5. DELETE OLD RULES
    ip rule del from "$subnet" lookup "$table_name" 2>/dev/null
    ip rule del from "$subnet" to "$subnet" lookup main 2>/dev/null
    ip rule del to "$subnet" lookup "$table_name" 2>/dev/null
    ip rule del from "$wg_ip" lookup "$table_name" 2>/dev/null
    ip route flush table "$table_name" 2>/dev/null

    # 6. ADD IP RULES
    verbose log "Adding routing rules with dynamic priorities..."

    local table_id=$(grep "[[:space:]]$table_name$" /etc/iproute2/rt_tables 2>/dev/null | awk '{print $1}')
    if [ -z "$table_id" ]; then
        warning "Could not determine table ID for $table_name, using fallback priorities"
        table_id=150
    fi

    local prio_base=$((table_id * 10))
    local prio_local=$((prio_base))
    local prio_main=$((prio_base + 1))
    local prio_return=$((prio_base + 3))
    
    debug_write "[ROUTES] Using priorities: local=$prio_local, main=$prio_main, return=$prio_return (base=$prio_base)"

    add_ip_rule "from $subnet to $subnet lookup main" "$prio_local"
    add_ip_rule "from $subnet lookup $table_name" "$prio_main"
    add_ip_rule "to $subnet lookup $table_name" "$prio_return"

    # 7. ADD ROUTES TO TABLE
    verbose log "Adding routes to table $table_name..."
    
    ip route add "$subnet" dev "$real_lan_iface" table "$table_name" 2>/dev/null
    debug_write "[ROUTES] Added route: $subnet dev $lan_iface table $table_name"

    if ip link show "$wg_iface" >/dev/null 2>&1; then
        ip route add default dev "$wg_iface" table "$table_name" 2>/dev/null
        debug_write "[ROUTES] Added route: default dev $wg_iface table $table_name"
    else
        warning "$wg_iface is not active! Routes may not work until interface is up."
    fi

    # 8. DEBUG VERIFICATION
    debug_write "[ROUTES] Final ip rules:"
    debug ip rule show | grep -E "($subnet|$wg_ip|$table_name)" || true
    debug_write "[ROUTES] Final table $table_name contents:"
    debug ip route show table "$table_name" || true

    # 9. CLEANUP EXISTING FORWARDINGS (ELIMINAR DUPLICADOS)
    verbose log "Cleaning existing forwarding rules between $lan_iface and $wg_iface..."
    
    local forwarding_indices=$(uci show firewall | grep "firewall.@forwarding\[" | cut -d'[' -f2 | cut -d']' -f1 | sort -u)
    for idx in $forwarding_indices; do
        local src=$(uci get firewall.$idx.src 2>/dev/null)
        local dest=$(uci get firewall.$idx.dest 2>/dev/null)
        
        if [ "$src" = "$lan_iface" ] && [ "$dest" = "$wg_iface" ]; then
            debug_write "[ROUTES] Deleting existing forwarding: $lan_iface -> $wg_iface (index $idx)"
            uci delete "firewall.$idx"
        fi
        if [ "$src" = "$wg_iface" ] && [ "$dest" = "$lan_iface" ]; then
            debug_write "[ROUTES] Deleting existing forwarding: $wg_iface -> $lan_iface (index $idx)"
            uci delete "firewall.$idx"
        fi
    done

    # 10. ADD FRESH FORWARDING RULES
    verbose log "Adding fresh forwarding rules..."

    uci add firewall forwarding >/dev/null
    uci set firewall.@forwarding[-1].src="$lan_iface" >/dev/null
    uci set firewall.@forwarding[-1].dest="$wg_iface" >/dev/null
    debug_write "[ROUTES] Added forwarding: $lan_iface -> $wg_iface"

    uci add firewall forwarding >/dev/null
    uci set firewall.@forwarding[-1].src="$wg_iface" >/dev/null
    uci set firewall.@forwarding[-1].dest="$lan_iface" >/dev/null
    debug_write "[ROUTES] Added forwarding: $wg_iface -> $lan_iface"

    # 11. PRE-COMMIT UCI CHANGES
    uci commit firewall 2>/dev/null
    debug_write "[ROUTES] Firewall UCI committed"

    # 12    NFT RULES HANDLER
    verbose log "Creating NFT include file for masquerade rules..."
    
    #12.1   DIR
    mkdir -p "${NFT_SRCNAT_DIR}" 2>/dev/null
    
    # 12.2   95-vpn-${wg_iface}-${lan_iface}.nft FILE
    local nft_file="${NFT_SRCNAT_DIR}/95-vpn-${wg_iface}-${lan_iface}.nft"

    cat > "$nft_file" <<EOF
# wg-autoconf: srcnat rule to route $lan_iface through $wg_iface
# wg-autoconf: Created: $(date)
# wg-autoconf: This rule ensures that traffic LEAVING through $wg_iface
# wg-autoconf: has its source masked (SNAT) with the IP of $wg_iface.
meta oifname "$wg_iface" masquerade
EOF
    
    debug_write "[ROUTES] Created NFT include file: $nft_file"
    verbose success "NFT include file created for $wg_iface"

    # 12.3  IP MODES:   ipv4_only, ipv6_only, dual_stack
    verbose log "Checking WireGuard IP usage to prevent leaks..."
    
    # 12.3.1    GET detect_wg_ip_usage
    local wg_ip_usage=$(detect_wg_ip_usage "$wg_iface")
    debug_write "[ROUTES] WireGuard $wg_iface detected as: $wg_ip_usage"


    # 12.3.2 then
    mkdir -p "/usr/share/nftables.d/chain-post/forward" 2>/dev/null
    mkdir -p "/usr/share/nftables.d/chain-post/input" 2>/dev/null
    
    # 12.3.2.1  IIPV4
    case "$wg_ip_usage" in
        ipv4_only)

            verbose log "WireGuard uses ONLY IPv4 → Blocking IPv6 leaks for $lan_iface"
            
            mkdir -p "/usr/share/nftables.d/chain-post/input" 2>/dev/null
            mkdir -p "/usr/share/nftables.d/chain-post/forward" 2>/dev/null
            mkdir -p "/usr/share/nftables.d/chain-post/output" 2>/dev/null
            
            # 12.3.2.1.1    BLOCK input IPV6 Bloquear IPv6 
            local block_input="/usr/share/nftables.d/chain-post/input/96-block-ipv6-${lan_iface}.nft"
            cat > "$block_input" <<EOF
# wg-autoconf: Block IPv6 in input for $lan_iface (WG IPv4-only)
# wg-autoconf: Created: $(date)
meta nfproto ipv6 drop
EOF
            
            # 12.3.2.1.2 BLOCK forward IPV6
            local block_forward="/usr/share/nftables.d/chain-post/forward/96-block-ipv6-${lan_iface}.nft"
            cat > "$block_forward" <<EOF
# wg-autoconf: Block IPv6 in forward for $lan_iface (WG IPv4-only)
# wg-autoconf: Created: $(date)
meta nfproto ipv6 drop
EOF
            
            # 12.3.2.1.3 BLOCK output IPv6
            local block_output="/usr/share/nftables.d/chain-post/output/96-block-ipv6-${lan_iface}.nft"
            cat > "$block_output" <<EOF
# wg-autoconf: Block IPv6 in foutput for $lan_iface (WG IPv4-only)
# wg-autoconf: Created: $(date)
meta nfproto ipv6 drop
EOF
            
            debug_write "[ROUTES] Created IPv6 block files for $lan_iface chains"
            

            # 12.3.2.1.4
            verbose log "Removing IPv6 from /proc/sys ... on $real_lan_iface..."
            
            # 12.3.2.1.4.1 STOP odhcpd
            debug_write "[IPv6] Stopping odhcpd..."
            /etc/init.d/odhcpd stop
            
            # 12.3.2.1.4.2 DISABLE IPv6
            local proc_path="/proc/sys/net/ipv6/conf/$real_lan_iface/disable_ipv6"
            if [ -f "$proc_path" ]; then
                
                echo 1 > "$proc_path" 2>/dev/null
                
                debug_write "[IPv6] Disabled IPv6 on $real_lan_iface via sysctl"
            
            else
                
                debug_write "[IPv6] WARNING: $proc_path not found"
            
            fi
            
            # 12.3.2.1.4.3 FLUSH IPV6 ROUTES
            debug_write "[IPv6] Flushing IPv6 routes for $real_lan_iface"
            ip -6 route flush dev "$real_lan_iface" 2>/dev/null
            
            # 12.3.2.1.4.4 DEL IPv6 ADRRESS
            debug_write "[IPv6] Removing IPv6 addresses from $real_lan_iface"
            ip -6 addr show dev "$real_lan_iface" 2>/dev/null | grep inet6 | awk '{print $2}' | while read addr; do
                
                debug_write "[IPv6] Removing address: $addr"
                ip -6 addr del "$addr" dev "$real_lan_iface" 2>/dev/null
            
            done
            
            # 12.3.2.1.4.5 START odhcpd AGAIN
            debug_write "[IPv6] Restarting odhcpd..."
            /etc/init.d/odhcpd start
            
            # 12.3.2.1.4    CHECKS/NOTICES
            local remaining=$(ip -6 addr show dev "$real_lan_iface" 2>/dev/null | grep -c inet6)
            if [ "$remaining" -eq 0 ]; then
                
                success "IPv6 removed from $real_lan_iface"
            
            else
                
                warning "IPv6 may still be present on $real_lan_iface ($remaining addresses)"
            fi
            ;;


        # 12.3.2.2   IPV6
        ipv6_only)
            verbose log "WireGuard uses ONLY IPv6 → Blocking IPv4 leaks for $lan_iface (preserving local IPv4)"
            
            # 12.3.2.2.1 BLOCK forward IPV4 LEAKS TO WAN
            local block_forward="/usr/share/nftables.d/chain-post/forward/96-block-ipv4-${lan_iface}.nft"
            cat > "$block_forward" <<EOF
# wg-autoconf: Block IPv4 in forward for $lan_iface (WG IPv6-only)
# wg-autoconf: Created: $(date)
# wg-autoconf: Prevents IPv4 traffic from $lan_iface from exiting via WAN
iifname "$lan_iface" meta nfproto ipv4 drop
EOF
            
            # 12.3.2.2.2     BLOCK outputIPv4
            local block_output="/usr/share/nftables.d/chain-post/output/96-block-ipv4-${lan_iface}.nft"
            cat > "$block_output" <<EOF
# wg-autoconf: Block IPv4 in output for $lan_iface (WG IPv6-only)
# wg-autoconf: Created: $(date)
oifname "$lan_iface" meta nfproto ipv4 drop
EOF
            
            # 12.3.2.2.3 ALLOW LOCAL input IPv4
            local allow_input="/usr/share/nftables.d/chain-post/input/96-allow-ipv4-local-${lan_iface}.nft"
            cat > "$allow_input" <<EOF
# wg-autoconf: Allow LOCAL IPv4 for $lan_iface (WG IPv6-only)
# wg-autoconf: Created: $(date)
# wg-autoconf: Allows clients on $lan_iface to access the router via IPv4
iifname "$lan_iface" meta nfproto ipv4 accept
EOF
            
            debug_write "[ROUTES] Created IPv4 block files + local IPv4 allowance for $lan_iface"
            ;;
            

        # 12.3.2.3   IPV6/IPV4 
        dual_stack)
            
            verbose log "WireGuard uses DUAL STACK (IPv4+IPv6) → No blocking needed for $lan_iface"
            
            # 12.3.2.3.1    PRE-CLEANING NEEDED
            rm -f "/usr/share/nftables.d/chain-post/forward/96-block-ipv4-${lan_iface}.nft" 2>/dev/null
            rm -f "/usr/share/nftables.d/chain-post/forward/96-block-ipv6-${lan_iface}.nft" 2>/dev/null
            rm -f "/usr/share/nftables.d/chain-post/output/96-block-ipv4-${lan_iface}.nft" 2>/dev/null
            rm -f "/usr/share/nftables.d/chain-post/output/96-block-ipv6-${lan_iface}.nft" 2>/dev/null
            rm -f "/usr/share/nftables.d/chain-post/input/96-allow-ipv4-local-${lan_iface}.nft" 2>/dev/null
            
            # AND NO MORE AS DUAL IS THE "deault"
            ;;
    esac

    # 13. COMMIT-RELOAD FIREWALL
    debug_write "[ROUTES] Reloading firewall to apply all changes..."
    /etc/init.d/firewall reload 2>/dev/null
    # sleep 2
    debug_write "[ROUTES] Firewall reloaded"

    # 14. STATES
    if [ $wg_id_found -eq 0 ] && [ -n "$wg_id" ]; then
        state_write "ID_${wg_id}_IS_RT_TABLES_IN_USE" "1" 2>/dev/null
    fi

    # 15. D0NE!!
    success "Routes configured successfully!"
    
    return 0
}


#####################################################################
# WG-AUTOCONF UNSET_LAN_ROUTES
#####################################################################
unset_lan_routes() {

    local wg_iface="$1"
    local lan_iface="$2"

    # 0) UNCONDITIONAL PRE-CHECKS
    upgrade_avoid_garbage
    rt_tables_health

    [ -z "$wg_iface" ] && error "WireGuard interface name required!"
    [ -z "$lan_iface" ] && error "LAN interface name required!"

    state_init
    check_bins

    # RESOLVE UCI NAME TO REAL DEVICE
    local real_lan_iface=$(uci get network.$lan_iface.device 2>/dev/null)
    [ -z "$real_lan_iface" ] && real_lan_iface="$lan_iface"


    # 1.1 VERIFY INTERFACE IS UP
    if ! ip link show "$wg_iface" >/dev/null 2>&1; then
        error "Cannot unset routes: Interface $wg_iface is not UP"
    fi

    # 1.2 GET WG ID
    local wg_id=$(state_get_id "$wg_iface" 2>/dev/null)
    local wg_id_found=$?

    # 1.3 CHECK STATE (but proceed anyway)
    if [ -n "$wg_id" ] && [ "$(state_read "ID_${wg_id}_IS_RT_TABLES_IN_USE")" = "1" ]; then
        debug_write "[UNSET] Interface marked as routed in state"
    else
        warning "Interface $wg_iface was not marked as routed, but attempting cleanup anyway"
    fi

    # 2. GET TABLE NAME
    local table_name="_vpn_${wg_iface}_${lan_iface}"

    # 2.1 IF TABLE EXISTS
    if ! grep -q "[[:space:]]$table_name$" /etc/iproute2/rt_tables > /dev/null; then
        
        debug_write "[ROUTES UNSET] No routes configured for $wg_iface <-> $lan_iface"
        error "No routes configured for $wg_iface <-> $lan_iface (table '$table_name' not found!)"
            
    fi

    log "Removing routes for $lan_iface (via $wg_iface)..."

    # 3. GET WG IP
    local wg_ip=$(uci get "network.$wg_iface.addresses" 2>/dev/null | cut -d/ -f1)

    # 4. DETERMINE SUBNET
    local lan_ip=""
    local lan_netmask=""
    
    lan_ip=$(uci get "network.$lan_iface.ipaddr" 2>/dev/null)
    lan_netmask=$(uci get "network.$lan_iface.netmask" 2>/dev/null)
    
    if [ -z "$lan_ip" ]; then
        lan_ip=$(ip -4 addr show "$lan_iface" 2>/dev/null | grep inet | awk '{print $2}' | cut -d/ -f1 | head -1)
    fi
    
    if [ -z "$lan_ip" ]; then
        warning "Could not determine IP address for $lan_iface!"
        return 1
    fi

    # 4.1 CALCULATE CIDR
    if [ -z "$lan_netmask" ]; then
        local lan_cidr=$(ip -4 addr show "$lan_iface" 2>/dev/null | grep inet | awk '{print $2}' | cut -d/ -f2 | head -1)
        
        if [ -n "$lan_cidr" ]; then
            case "$lan_cidr" in
                24) lan_netmask="255.255.255.0" ;;
                23) lan_netmask="255.255.254.0" ;;
                22) lan_netmask="255.255.252.0" ;;
                16) lan_netmask="255.255.0.0" ;;
                8)  lan_netmask="255.0.0.0" ;;
                *)  lan_netmask="255.255.255.0" ;;
            esac
        fi
    fi
    
    local cidr=$(netmask_to_cidr "${lan_netmask:-255.255.255.0}")
    
    local subnet=""
    if [ "$cidr" = "24" ]; then
        subnet="${lan_ip%.*}.0/$cidr"
    elif [ "$cidr" = "16" ]; then
        subnet="${lan_ip%.*.*}.0.0/$cidr"
    elif [ "$cidr" = "8" ]; then
        subnet="${lan_ip%%.*}.0.0.0/$cidr"
    else
        subnet="$(ip_to_network "$lan_ip" "$cidr")/$cidr"
    fi
    
    verbose log "Route table: $table_name"
    verbose log "Subnet: $subnet"
    verbose log "WireGuard IP: $wg_ip"

    # 5. REMOVE IP RULES
    debug_write "[ROUTES UNSET] Removing IP rules..."
    
    # 5.1 Get table ID for dynamic priority calculation
    local table_id=$(grep "[[:space:]]$table_name$" /etc/iproute2/rt_tables 2>/dev/null | awk '{print $1}')
    
    if [ -n "$table_id" ]; then
        local prio_base=$((table_id * 10))
        local prio_local=$((prio_base))
        local prio_main=$((prio_base + 1))
        local prio_return=$((prio_base + 3))
        
        ip rule del priority "$prio_local" 2>/dev/null
        debug_write "[ROUTES UNSET] Removed local rule priority $prio_local"
        
        ip rule del priority "$prio_main" 2>/dev/null
        debug_write "[ROUTES UNSET] Removed main rule priority $prio_main"
        
        ip rule del priority "$prio_return" 2>/dev/null
        debug_write "[ROUTES UNSET] Removed return rule priority $prio_return"
    fi
    
    # 5.2 Fallback: remove by content
    ip rule del from "$subnet" to "$subnet" lookup main 2>/dev/null
    debug_write "[ROUTES UNSET] Removed local rule: from $subnet to $subnet lookup main"
    
    ip rule del from "$subnet" lookup "$table_name" 2>/dev/null
    debug_write "[ROUTES UNSET] Removed main rule: from $subnet lookup $table_name"
    
    if [ -n "$wg_ip" ]; then
        ip rule del from "$wg_ip" lookup "$table_name" 2>/dev/null
        debug_write "[ROUTES UNSET] Removed WG IP rule: from $wg_ip lookup $table_name"
    fi
    
    ip rule del to "$subnet" lookup "$table_name" 2>/dev/null
    debug_write "[ROUTES UNSET] Removed return rule: to $subnet lookup $table_name"
    
    ip rule del lookup "$table_name" 2>/dev/null
    debug_write "[ROUTES UNSET] Removed any remaining rules with table $table_name"

    # 6. FLUSH ROUTING TABLE
    ip route flush table "$table_name" 2>/dev/null
    debug_write "[ROUTES UNSET] Flushed table $table_name"



    # 7 NFT.D CLEANGINGS
    verbose log "Cleaning up NFT files for $lan_iface..."

    # 7.1. DEL 95-vpn-${wg_iface}-${lan_iface}.nft"
    local nft_file="${NFT_SRCNAT_DIR}/95-vpn-${wg_iface}-${lan_iface}.nft"
    if [ -f "$nft_file" ]; then
        
        rm -f "$nft_file"
        debug_write "[ROUTES UNSET] Removed masquerade file: $nft_file"
    
    fi

    # 7.2 DEL IPV4 BLOCK FILES -> ipv6_only MODE
    rm -f "/usr/share/nftables.d/chain-post/forward/96-block-ipv4-${lan_iface}.nft" 2>/dev/null
    rm -f "/usr/share/nftables.d/chain-post/output/96-block-ipv4-${lan_iface}.nft" 2>/dev/null
    rm -f "/usr/share/nftables.d/chain-post/input/96-allow-ipv4-local-${lan_iface}.nft" 2>/dev/null

    # 7.3 DEL IPV6 BLOCK FILES -> ipv4_only MODE
    rm -f "/usr/share/nftables.d/chain-post/input/96-block-ipv6-${lan_iface}.nft" 2>/dev/null
    rm -f "/usr/share/nftables.d/chain-post/forward/96-block-ipv6-${lan_iface}.nft" 2>/dev/null
    rm -f "/usr/share/nftables.d/chain-post/output/96-block-ipv6-${lan_iface}.nft" 2>/dev/null

    debug_write "[ROUTES UNSET] Removed all NFT leak prevention files for $lan_iface"



    # 7.4   RESTORE IPV6
    if [ -n "$real_lan_iface" ] && [ -n "$lan_iface" ]; then
        
        verbose log "Restoring IPv6 on $real_lan_iface (UCI: $lan_iface)..."
        
        # 7.4.1 VIA /proc/sys....
        local proc_path="/proc/sys/net/ipv6/conf/$real_lan_iface/disable_ipv6"
        if [ -f "$proc_path" ]; then
            
            # NETIFD-ALIKE FORCE
            echo 1 > "$proc_path" 2>/dev/null
            sleep 1
            echo 0 > "$proc_path" 2>/dev/null
            debug_write "[UNSET] Reset IPv6 stack on $real_lan_iface"
        fi
        
        # 7.4.2 Force netifd to reprocess the UCI interface
        # DEBUG! r7 This applies the netifd patch fix shown in ODHCPD REPO ISSUES
        debug_write "[UNSET] Reprocessing UCI interface $lan_iface via ubus..."
        ubus call network.interface.$lan_iface down 2>/dev/null
        sleep 1
        ubus call network.interface.$lan_iface up 2>/dev/null
        
        # 7.4.3. WAIT FOR DAD 
        debug_write "[UNSET] Waiting for DAD (Duplicated Address Detection)..."
        sleep 3
        
        # 7.4.4 FORCE RA's WITH  -SIGUSR1
        if pidof odhcpd >/dev/null 2>&1; then
            
            kill -SIGUSR1 $(pidof odhcpd) 2>/dev/null
            debug_write "[UNSET] Sent SIGUSR1 to odhcpd to refresh RAs"
        
        else
        
            /etc/init.d/odhcpd restart
            debug_write "[UNSET] odhcpd restarted"
        
        fi
        

        # 7.5 CHEKS
        local ipv6_addrs=$(ip -6 addr show dev "$real_lan_iface" 2>/dev/null | grep -c "inet6")
        if [ "$ipv6_addrs" -gt 0 ]; then
            
            success "IPv6 restored on $real_lan_iface ($ipv6_addrs addresses)"
        
        else
            
            warning "IPv6 may not be fully restored on $real_lan_iface"
            debug_write "[UNSET] Manual check: ip -6 addr show dev $real_lan_iface"
        fi
    
    else
        
        debug_write "[UNSET WARNING] No interface info available, skipping IPv6 restore"
    
    fi


    # # 7. REMOVE NFTABLES RULES -> DEBUG! REMOVED AS FW4 HANDLE THIS NOW
    # debug_write "[ROUTES UNSET] Skipping manual NFT cleanup (fw4 will regenerate from UCI)"


    # DEBUG! r7
    # TODO: It is VERY likely that, from this point on, all removals are NOT necessary 
    #       thanks to how NFT is manipulated previously... BUUUUT, I firmly believe 
    #       that it is more important to not leave orphans than to pretend everything 
    #       worked well in previous steps

    # 8. REMOVE FIREWALL RULES FROM UCI (FIND DYNAMICALLY)
    debug_write "[ROUTES UNSET] Removing firewall forwarding rules..."
    
    local forwarding_indices=$(uci show firewall | grep "firewall.@forwarding\[" | cut -d'[' -f2 | cut -d']' -f1 | sort -u)
    
    for idx in $forwarding_indices; do
        local src=$(uci get firewall.@forwarding[$idx].src 2>/dev/null)
        local dest=$(uci get firewall.@forwarding[$idx].dest 2>/dev/null)
        
        if [ "$src" = "$lan_iface" ] && [ "$dest" = "$wg_iface" ]; then
            uci delete firewall.@forwarding[$idx]
            debug_write "[ROUTES UNSET] Deleted forwarding [$idx]: $lan_iface -> $wg_iface"
        fi
        
        if [ "$src" = "$wg_iface" ] && [ "$dest" = "$lan_iface" ]; then
            uci delete firewall.@forwarding[$idx]
            debug_write "[ROUTES UNSET] Deleted forwarding [$idx]: $wg_iface -> $lan_iface"
        fi
    done
    
    uci commit firewall 2>/dev/null
    debug_write "[ROUTES UNSET] Firewall UCI committed"


    # 9. REMOVE FROM RT_TABLES
    del_routing_table "$table_name"

    # 10. CHECK REMAINING TABLES FOR THIS WG IFACE
    local remaining_tables=0
    
    if [ -f /etc/iproute2/rt_tables ]; then
        remaining_tables=$(grep "_vpn_${wg_iface}_" /etc/iproute2/rt_tables 2>/dev/null | wc -l)
    fi
    
    if ! echo "$remaining_tables" | grep -qE '^[0-9]+$'; then
        remaining_tables=0
    fi
    
    debug_write "[ROUTES UNSET] After deletion: $remaining_tables table(s) remain for $wg_iface"

    # 11. COMMIT AND RELOAD
    uci commit firewall 2>/dev/null
    /etc/init.d/firewall reload 2>/dev/null
    debug_write "[ROUTES UNSET] Firewall committed and reloaded"

    # 12. UPDATE STATE
    if [ $wg_id_found -eq 0 ] && [ -n "$wg_id" ]; then
        if [ "$remaining_tables" -eq 0 ]; then
            state_write "ID_${wg_id}_IS_RT_TABLES_IN_USE" "0" 2>/dev/null
            debug_write "[ROUTES UNSET] No more tables for $wg_iface, setting IS_RT_TABLES_IN_USE=0"
        else
            state_write "ID_${wg_id}_IS_RT_TABLES_IN_USE" "1" 2>/dev/null
            debug_write "[ROUTES UNSET] $remaining_tables table(s) remain for $wg_iface, keeping IS_RT_TABLES_IN_USE=1"
        fi
    fi

    # 13. VERIFY CLEANUP
    debug_write "[ROUTES UNSET] Verification - IP rules after cleanup:"
    debug ip rule show | grep -E "($subnet|$wg_ip|$table_name)" || true
    
    debug_write "[ROUTES UNSET] Verification - Table $table_name after cleanup:"
    debug ip route show table "$table_name" 2>/dev/null || verbose echo "Table $table_name does not exist!"

    # 14. EXTRA CLEANUP: Remove any orphaned rules that might reference this table
    debug_write "[ROUTES UNSET] Extra cleanup: removing any orphaned rules for $table_name"
    local orphan_rules=$(ip rule show | grep "lookup $table_name" | awk '{print $1}' | sed 's/://')
    for prio in $orphan_rules; do
        ip rule del priority "$prio" 2>/dev/null
        debug_write "[ROUTES UNSET] Removed orphaned rule priority $prio"
    done

    # 15. D0NE!
    echo ""
    success "$lan_iface routes (via $wg_iface) successfully removed!"
    debug_write "[ROUTES UNSET] Completed successfully"

    return 0
}
