#####################################################################
# HELPER -> BIN AVAILABILITY
#####################################################################
# DEBUG!
# TODO:     Room for bin-specific actions
check_bins() {


    # 0. INIT
    CAP_IP_ROUTE=0
    CAP_IP_FULL=0
    CAP_NFTABLES=0
    CAP_IPTABLES=0
    CAP_WG=0
    
    # 1. IP-TINY AVAILABILITY
    if ip route show >/dev/null 2>&1; then
        CAP_IP_ROUTE=1
    fi
    
    # 2. IP-FULL
    if ip -6 rule show >/dev/null 2>&1; then
        CAP_IP_FULL=1
    fi
    
    # 3. NFT
    if command -v nft >/dev/null 2>&1; then
        CAP_NFTABLES=1
    fi

    # 4. IPTABLES
    # DEBUG! Iptables is not core package from openWRT,
    # but iptables-nft extra binaries available, so ...
    if command -v iptables >/dev/null 2>&1; then
        CAP_IPTABLES=1
    fi
    
    # 5. WIREGUARD-TOOLS
    if command -v wg >/dev/null 2>&1; then
        CAP_WG=1
    fi
    
    debug_write "[SYSTEM BINS AVAILABILITY]  IP_ROUTE=$CAP_IP_ROUTE IP_FULL=$CAP_IP_FULL IPTABLES=$CAP_IPTABLES NFT=$CAP_NFTABLES WG=$CAP_WG"
}


#####################################################################
# HELPER -> ENDPOINT PARSERS
#####################################################################
parse_endpoint() {

    local endpoint="$1"
    local format="${2:-pair}"
    
    local host=""
    local port=""
    
    # 1. CASE IPv6 with [brackets] [2001:db8::1]:51820
    if echo "$endpoint" | grep -q '^\[.*\]:'; then

        host=$(echo "$endpoint" | sed 's/^\[\(.*\)\]:.*/\1/')
        port=$(echo "$endpoint" | sed 's/^.*\]://')
    
    # 2. CASE IPv4 or hostname
    else

        host=$(echo "$endpoint" | cut -d: -f1)
        port=$(echo "$endpoint" | cut -d: -f2)
    fi
    
    # 2. MISSING PORT = DEFAULT PORT
    [ -z "$port" ] && port="$DEFAULT_PORT"
    

    # 3. RETURNS
    # DEBUG!
    # TODO: IMPROVE * CASE WITH A BETTER SUPPORT
    case "$format" in
        host) 
            echo "$host"
            ;;
        port)
            echo "$port"
            ;;
        pair)
            echo "$host|$port"
            ;;
        string)
            echo "${host}:${port}"
            ;;
        *) 
            echo "$host|$port"
            ;;
    esac
}



#####################################################################
# HELPER -> ALlowed IPs for UCI (SPACE-SEPARATED) or CONF file (COMMA-SEP)
#####################################################################
allowed_ips_to_uci() {
    
    local ips="$1"
    local result=""
    
    echo "$ips" | tr ',' '\n' | while read ip; do
        
        ip=$(echo "$ip" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
        
        [ -n "$ip" ] && echo "    list allowed_ips '$ip'"
    
    done
}


# SPACE-SEPARATED TO COMMA-SEPARATED
allowed_ips_from_uci() {
    
    local section="$1"
    local result=""
    local ips=$(get_uci_list "$section" "allowed_ips")
    
    echo "$ips"
}

#####################################################################
# HANDLER -> RT_TABLES SAFETY, ADD_ROUTING_TABLE, DEL_ROUTING_TABLE
#####################################################################
rt_tables_health() {

    if [ ! -f "$DEFAULT_TABLES" ] || ! grep -q "local" "$DEFAULT_TABLES"; then
        
        # DEBUG! 
        debug_write "[ROUTE TABLES SAFETY] RT_TABLES file NOT FOUND! Trying a restoration. Please Check 'ip', reboot, perform a cleanup!"

        warning "Routing tables file not found, attempting to create..."
        warning "This is trully BIZARRE, please, pay attention:"
        echo -e "   Your ${RED}/etc/iproute2/rt_tables${NC} is MISSING, and this SHOULD NOT be happening!"
        echo -e "   To be safe, at this point, a new fully-compatible rt_tables file is being created"
        echo -e "   Even this will work well, you may prefer to check your configs. and/or reboot the device"
        echo ""
        verbose log "The 'rt_tables' file is used by default by a ${YELLOW}CORE${NC} dependency included as standard in ALL OpenWRT builds (the 'ip' package)."        
        verbose echo -e "   This is highly unusual for this file to be missing. 'wg-autoconf' has encountered this issue and, while it didn't cause the problem, ${GREEN}this issue can be fixed${NC}."        
        verbose echo -e "   ${YELLOW}HOWEVER, just because it can be fixed temporarily doesn't mean the error won't happen again${NC}; it is up to you to find out what has happened with 'ip'/'rt_tables'"

        
        
        mkdir -p /etc/iproute2 2>/dev/null

        if {
            echo "# rt_tables file restored by"
            echo "#   wg-autoconf $VERSION "
            echo "# Check your 'ip' package issues!"
            echo "#"
            echo "# reserved values"
            echo "#"
            echo "128     prelocal"
            echo "255     local"
            echo "254     main"
            echo "253     default"
            echo "0       unspec"
            echo "#"
            echo "# local"
            echo "#"
            echo "#1      inr.ruhep"
        } > /etc/iproute2/rt_tables 2>/dev/null; then

            debug_write "[ROUTE TABLES SAFETY] rt_tables RESTORED OK! "
            echo ""
            success " Route Tables succesfully restored! "
            echo ""
            
            return 0

        else

            debug_write "[ROUTE TABLES SAFETY] ERROR restoring rt_tables! This is an IMPOSSIBLE error. Check filesystem corruption! Check /overlay corruption! REWRITE A NEW RT_TABLE FILE at $DEFAULT_TABLES !!! "

            echo ""
            warning "${RED}Route Tables couldn't be restored!${NC}"
            echo ""

            return 1
        
        fi

    else

        return 0
    
    fi

}

add_routing_table() {

    local table_name="$1"
    local preferred_id="${2:-150}"
    
    if [ ! -f /etc/iproute2/rt_tables ]; then
        rt_tables_health
    fi
    
    if ! grep -q "^[0-9]\+[[:space:]]\+$table_name$" /etc/iproute2/rt_tables 2>/dev/null; then
        
        local table_id=$preferred_id
        
        while grep -q "^$table_id " /etc/iproute2/rt_tables 2>/dev/null && [ $table_id -lt 250 ]; do
            
            table_id=$((table_id + 1))
        
        done
        
        
        if [ $table_id -ge 250 ]; then
            
            error "No available routing table IDs"
        
        fi
        
        atomic_append "/etc/iproute2/rt_tables" "$table_id $table_name"
        debug_write "[RT_TABLES] Added $table_name with ID $table_id"
    
    fi
}



# DEBUG!
# D0NE!: rewrited, added FLUSH BEFOOOOOORE removing from rt_tables
del_routing_table() {
    
    local table_name="$1"
    
    # 1. GET TABLE ID (IF EXISTS)
    local table_id=$(grep "[[:space:]]$table_name$" /etc/iproute2/rt_tables 2>/dev/null | awk '{print $1}')
    
    
    # 2. FLUSH ROUTES FROM TABLE (IF ID EXISTS)
    #    CRITICAL: Must flush BEFORE!!!!!! removing from rt_tables
    #    Otherwise, table may persist in kernel with routes
    if [ -n "$table_id" ]; then
        
        ip route flush table "$table_id" 2>/dev/null
        debug_write "[RT_TABLES] Flushed table $table_name (ID: $table_id)"
    
    else
        
        debug_write "[RT_TABLES] No table ID found for $table_name, skipping flush"
    
    fi
    
    # 3. REMOVE ENTRY FROM RT_TABLES
    if grep -q "^[0-9]\+[[:space:]]\+$table_name$" /etc/iproute2/rt_tables 2>/dev/null; then
        
        atomic_filter "/etc/iproute2/rt_tables" "^[0-9]\+[[:space:]]\+$table_name$"
        debug_write "[RT_TABLES] Removed $table_name from rt_tables"
    
    else
        
        debug_write "[RT_TABLES] Table $table_name not found in rt_tables, nothing to remove"
    
    fi
}


#####################################################################
# HANDLER -> IP RULES HANDLER
#####################################################################
add_ip_rule() {
    
    local rule="$1"
    local priority="$2"
    
    # 1.1 IF RULE EXIST
    if ip rule show | grep -q "priority $priority"; then
        
        ip rule del priority "$priority" 2>/dev/null
    
    fi
    
    # DEBUG!
    # TODO: ROOM FOR check_bins() BEHAVIOURS
    ip rule add $rule priority "$priority" 2>/dev/null
    
    debug_write "[IPRULE] Added: $rule priority $priority"

}


#####################################################################
# HANDLER -> IP RULES HANDLER
#####################################################################
del_ip_rules_by_table() {
    
    local table="$1"
    
    # DEBUG!
    # TODO: ROOM FOR check_bins() BEHAVIOURS
    
    # 1. GET TABLE ID (IF EXISTS)
    local table_id=$(grep "[[:space:]]$table$" /etc/iproute2/rt_tables 2>/dev/null | awk '{print $1}')
    
    debug_write "[IPRULE] Cleaning rules for table: $table (ID: ${table_id:-none})"
    
    # 2. REMOVE RULES BY TABLE NAME
    ip rule show | grep "lookup $table" | while read rule; do
        
        local priority=$(echo "$rule" | awk '{print $1}' | sed 's/://')
        
        if [ -n "$priority" ]; then
            
            ip rule del priority "$priority" 2>/dev/null
            debug_write "[IPRULE] Removed priority $priority (name: $table)"
        
        fi
    
    done
    
    # 3. REMOVE RULES BY TABLE ID (IF EXISTS)
    if [ -n "$table_id" ]; then
        
        ip rule show | grep "lookup $table_id" | while read rule; do
            
            local priority=$(echo "$rule" | awk '{print $1}' | sed 's/://')
            
            if [ -n "$priority" ]; then
                
                ip rule del priority "$priority" 2>/dev/null
                debug_write "[IPRULE] Removed priority $priority (id: $table_id)"
            
            fi
        
        done
    
    fi
}

