    echo -e " ${YELLOW}debug show${NC}                       ${ITALIC}- Show latest debug log${NI}"
    echo -e " ${YELLOW}debug live${NC}                       ${ITALIC}- Tail debug log live${NI}"

    echo ""
    ui_lines 80 "${BLUE}Usage:${NC} wg-autoconf ${YELLOW}COMMAND${NC} ${GREEN}<args>${NC}"

    exit 1
}



