    echo -e " ${WHITE}${BOLD}// 2.2 CLIENT MANAGEMENT //${NB}${NC}"
    echo -e "   ${ITALIC}${BLUE}Manage client peers attached to a WireGuard server${NI}${NC}"
    echo ""

    echo -e "   ${YELLOW}${BOLD}server add${NB}${NC} ${GREEN}${UNDERLINE}<wg_server> <client>${NU}${NC}          ${ITALIC}${BLUE}> Create client peer + keypair${NI}${NC}"
    echo -e "                                               ${ITALIC}Assigns IP and generates client config${NI}"
    echo ""

    echo -e "   ${YELLOW}${BOLD}server revoke${NB}${NC} ${GREEN}${UNDERLINE}<wg_server> <client>${NU}${NC}       ${ITALIC}${BLUE}> Disable and remove client peer${NI}${NC}"
    echo -e "                                               ${ITALIC}Removes peer and updates running interface${NI}"
    echo ""

    # 2.3 SERVER STATUS
    echo ""
    echo -e " ${WHITE}${BOLD}// 2.3 SERVER STATUS & MONITORING //${NB}${NC}"
    echo -e "   ${ITALIC}${BLUE}Inspect runtime state and traffic statistics${NI}${NC}"
    echo ""

    echo -e "   ${YELLOW}${BOLD}server stats${NB}${NC} ${GREEN}${UNDERLINE}<wg_server>${NU}${NC}                 ${ITALIC}${BLUE}> Show peers, handshake and traffic${NI}${NC}"
    echo -e "                                               ${ITALIC}Displays RX/TX, last handshake, endpoint${NI}"
    echo ""


    # 3.    STATUS
    echo ""
    echo -e " ${WHITE}${BOLD}// 3. STATUS & MONITORING //${NB}${NC}"
    echo -e "   ${ITALIC}${BLUE}Check interface state, handshake, traffic${NI}${NC}"
    echo ""
    
    echo -e "   ${YELLOW}${BOLD}status${NB}${NC} ${GREEN}${UNDERLINE}[<wg_iface>]${NU}${NC}                      ${ITALIC}${BLUE}> Show all/specific interface status${NI}${NC}"
    echo -e "                                              ${ITALIC} Displays: UCI state, UP/DOWN, handshake,${NI}"
    echo -e "                                              ${ITALIC} transfer, routes, backup validity${NI}"
    echo ""



    # 4.    BACKUP FLOW
    echo ""
    echo -e " ${WHITE}${BOLD}// 4. BACKUP & RECOVERY$ //${NB}${NC}"
    echo -e "   ${ITALIC}${BLUE}Automatic backups of network/dhcp/firewall before changes${NI}${NC}"
    echo ""
    
    echo -e "   ${YELLOW}${BOLD}backups show${NB}${NC}                             ${ITALIC}${BLUE}> List all backups with validation status${NI}${NC}"
    echo -e "                                              ${ITALIC} Shows: path, tag, size, date, valid/corrupted${NI}"
    echo ""
    
    echo -e "   ${YELLOW}${BOLD}backups restore${NB}${NC} ${GREEN}${UNDERLINE}<file>${NU}${NC}                   ${ITALIC}${BLUE}> Restore specific config (network/dhcp/firewall)${NI}${NC}"
    echo -e "                                              ${ITALIC} Validates checksum before restoring${NI}"
    echo ""
    
    echo -e "   ${YELLOW}${BOLD}backups diag${NB}${NC} ${GREEN}${UNDERLINE}[<file>]${NU}${NC}                    ${ITALIC}${BLUE}> Diagnose backup corruption issues${NI}${NC}"
    echo -e "                                              ${ITALIC} Shows line count, checksums, content analysis${NI}"
    echo ""



    # 5.    CLEANUP
    echo ""
    echo -e " ${WHITE}${BOLD}// 5. CLEANUP OPERATIONS //${NB}${NC}"
    echo -e "   ${ITALIC}${BLUE}Remove configurations, interfaces, and orphaned artifacts${NI}${NC}"
    echo ""
    
    echo -e "   ${YELLOW}${BOLD}clean${NB}${NC} ${GREEN}${UNDERLINE}[<wg_iface>]${NU}${NC}                       ${ITALIC}${BLUE}> Interactive menu or single interface cleanup${NI}${NC}"
    echo -e "                                              ${ITALIC} Removes: routes, interface, UCI, state${NI}"
    echo ""
    
    echo -e "   ${RED}${BOLD}${REVERSE}nuke${NR}${NB}${NC}                                     ${ITALIC}${RED}${BOLD}> FORCE REMOVE EVERYTHING (no prompts)${NB}${NI}${NC}"
    echo -e "                                              ${ITALIC} Removes:${NI}"
    echo -e "                                                * ${GREEN}${UNDERLINE}All wg_* interfaces${NU}${NC} (UCI + kernel)"
    echo -e "                                                * ${GREEN}${UNDERLINE}All _vpn_* and wg_* routing tables${NU}${NC}"
    echo -e "                                                * ${GREEN}${UNDERLINE}All orphaned ip rules${NU}${NC} (by name and ID)"
    echo -e "                                                * ${GREEN}${UNDERLINE}All NFT chains containing 'wg'${NU}${NC}"
    echo -e "                                                * ${GREEN}${UNDERLINE}Restores valid backups${NU}${NC}"
    echo -e "                                                * ${GREEN}${UNDERLINE}Resets state file${NU}${NC}"
    echo ""



    # 6.    USER SETTINGS
    echo ""
    echo -e " ${WHITE}${BOLD}// 6. USER SETTINGS //${NB}${NC}"
    echo -e "   ${ITALIC}${BLUE}Override built-in defaults permanently${NI}${NC}"
    echo ""
    
    echo -e "   ${YELLOW}${BOLD}settings show${NB}${NC}                            ${ITALIC}${BLUE}> Display current user settings${NI}${NC}"
    echo ""
    
    echo -e "   ${YELLOW}${BOLD}settings set${NB}${NC} ${GREEN}${UNDERLINE}<key> <value>${NU}${NC}               ${ITALIC}${BLUE}> Set default value${NI}${NC}"
    echo -e "                                              ${ITALIC} Keys: ${GREEN}dns, port, allowed, colours, verbose${NU}${NC}"
    echo -e "                                                * ${YELLOW}${BOLD}settings set${NB}${NC} ${GREEN}${UNDERLINE}dns${NU}${NC} ${BLUE}\"1.1.1.1, 8.8.8.8\"${NC}"
    echo -e "                                                * ${YELLOW}${BOLD}settings set${NB}${NC} ${GREEN}${UNDERLINE}port${NU}${NC} ${BLUE}51820${NC}"
    echo -e "                                                * ${YELLOW}${BOLD}settings set${NB}${NC} ${GREEN}${UNDERLINE}allowed${NU}${NC} ${BLUE}\"0.0.0.0/0, ::/0\"${NC}"
    echo -e "                                                * ${YELLOW}${BOLD}settings set${NB}${NC} ${GREEN}${UNDERLINE}colours${NU}${NC} ${BLUE}1${NC} (on/off)"
    echo -e "                                                * ${YELLOW}${BOLD}settings set${NB}${NC} ${GREEN}${UNDERLINE}verbose${NU}${NC} ${BLUE}0${NC} (on/off)"
    echo ""
    
    echo -e "   ${YELLOW}${BOLD}settings edit${NB}${NC}                            ${ITALIC}${BLUE}> Edit settings file with \$EDITOR${NI}${NC}"
    echo -e "   ${YELLOW}${BOLD}settings reset${NB}${NC}                           ${ITALIC}${BLUE}> Restore built-in defaults${NI}${NC}"
    echo ""



    # 7.    DEBUG TOOLS
    echo ""
    echo -e " ${WHITE}${BOLD}// 7. DEBUGGING & LOGS //${NB}${NC}"
    echo -e "   ${ITALIC}${BLUE}Detailed logging and system introspection${NI}${NC}"
    echo ""
    
    echo -e "   ${YELLOW}${BOLD}debug on${NB}${NC} | ${YELLOW}${BOLD}off${NB}${NC}                           ${ITALIC}${BLUE}> Enable/disable debug logging${NI}${NC}"
    echo -e "                                             ${ITALIC} Writes to: ${GREEN}${UNDERLINE}$DEBUG_LOG${NU}${NC}"
    echo ""
    
    echo -e "   ${YELLOW}${BOLD}debug show${NB}${NC}                               ${ITALIC}${BLUE}> Display current debug log${NI}${NC}"
    echo -e "   ${YELLOW}${BOLD}debug live${NB}${NC}                               ${ITALIC}${BLUE}> Tail debug log (requires ${YELLOW}${BOLD}debug on${NB}${ITALIC}${BLUE})${NI}${NC}"
    echo -e "   ${YELLOW}${BOLD}debug clear${NB}${NC}                              ${ITALIC}${BLUE}> Remove all debug logs${NI}${NC}"
    echo ""
    
    echo -e "   ${YELLOW}${BOLD}debug states${NB}${NC}                             ${ITALIC}${BLUE}> Show internal state file${NI}${NC}"
    echo -e "   ${YELLOW}${BOLD}debug tables${NB}${NC}                             ${ITALIC}${BLUE}> Show ${GREEN}${UNDERLINE}/etc/iproute2/rt_tables${NU}${NC}"
    echo -e "   ${YELLOW}${BOLD}debug network${NB}${NC}                            ${ITALIC}${BLUE}> Show ${GREEN}${UNDERLINE}/etc/config/network${NU}${ITALIC}${BLUE} (WG sections only)${NI}${NC}"
    echo -e "   ${YELLOW}${BOLD}debug firewall${NB}${NC}                           ${ITALIC}${BLUE}> Show ${GREEN}${UNDERLINE}/etc/config/firewall${NU}${ITALIC}${BLUE} (WG sections only)${NI}${NC}"
    echo -e "   ${YELLOW}${BOLD}debug dhcp${NB}${NC}                               ${ITALIC}${BLUE}> Show ${GREEN}${UNDERLINE}/etc/config/dhcp${NU}${ITALIC}${BLUE} (WG sections only)${NI}${NC}"
    echo ""




    # 8. FLAGS
    echo ""
    echo -e " ${WHITE}${BOLD}// 8. GLOBAL FLAGS //${NB}${NC}"
    echo -e "   ${ITALIC}${BLUE}Can be used with any command${NI}${NC}"
    echo ""
    
    echo -e "   ${BLUE}${BOLD}--verbose${NB}${NC}, ${BLUE}${BOLD}-v${NB}${NC}                            ${ITALIC}${BLUE}> Show detailed command output${NI}${NC}"
    echo -e "                                              ${ITALIC} Useful for a visual step-by-step action->response${NI}"
    echo ""
    
    echo -e "   ${BLUE}${BOLD}--help${NB}${NC}, ${BLUE}${BOLD}-h${NB}${NC}, ${BLUE}${BOLD}help${NB}${NC}                         ${ITALIC}${BLUE}> Show this manual${NI}${NC}"
    echo ""



    # 9.   USAGE CMDS EXAMPLES
    echo ""
    echo -e " ${WHITE}${BOLD}// USAGE EXAMPLES //${NB}${NC}"
    echo -e "   ${ITALIC}${BLUE}Common usage patterns${NI}${NC}"
    echo ""
    
    echo -e "   ${WHITE}${BOLD}* Basic WG Client setup:${NB}${NC}"
    echo -e "     ${YELLOW}${BOLD}wg-autoconf setup${NB}${NC} ${GREEN}${UNDERLINE}mullvad${NU}${NC}"
    echo -e "     ${YELLOW}${BOLD}wg-autoconf up${NB}${NC} ${GREEN}${UNDERLINE}wg_mullvad${NU}${NC}"
    echo -e "     ${YELLOW}${BOLD}wg-autoconf routes set${NB}${NC} ${GREEN}${UNDERLINE}wg_mullvad lan4${NU}${NC}"
    echo -e "     ${YELLOW}${BOLD}wg-autoconf status${NB}${NC}"
    echo ""

    echo -e "   ${WHITE}${BOLD}* Basic WG Server setup:${NB}${NC}"
    echo -e "     ${YELLOW}${BOLD}wg-autoconf server create${NB}${NC} ${GREEN}${UNDERLINE}wg_home${NU}${NC}"
    echo -e "     ${YELLOW}${BOLD}wg-autoconf server add${NB}${NC} ${GREEN}${UNDERLINE}wg_home phone${NU}${NC}"
    echo ""

    echo -e "   ${WHITE}${BOLD}* Enable multiple clients for a server:${NB}${NC}"
    echo -e "     ${YELLOW}${BOLD}wg-autoconf server add${NB}${NC} ${GREEN}${UNDERLINE}wg_home laptop${NU}${NC}"
    echo -e "     ${YELLOW}${BOLD}wg-autoconf server revoke${NB}${NC} ${GREEN}${UNDERLINE}wg_home laptop${NU}${NC}"

    echo -e "   ${WHITE}${BOLD}* Remove server completely:${NB}${NC}"
    echo ""

    
    echo -e "   ${WHITE}${BOLD}* Complete teardown:${NB}${NC}"
    echo -e "     ${YELLOW}${BOLD}wg-autoconf down${NB}${NC} ${GREEN}${UNDERLINE}wg_mullvad${NU}${NC}"
    echo -e "     ${YELLOW}${BOLD}wg-autoconf remove${NB}${NC} ${GREEN}${UNDERLINE}wg_mullvad${NU}${NC}"
    echo -e "     ${YELLOW}${BOLD}wg-autoconf backups restore${NB}${NC} ${GREEN}${UNDERLINE}network${NU}${NC}"
    echo -e "     ${YELLOW}${BOLD}wg-autoconf server remove${NB}${NC} ${GREEN}${UNDERLINE}wg_home${NU}${NC}"

    
    echo -e "   ${WHITE}${BOLD}* Emergency cleanup:${NB}${NC}"
    echo -e "     ${YELLOW}${BOLD}wg-autoconf ${GREEN}--verbose ${RED}nuke${NB}${NC}"
    echo ""

    ui_lines 80 "${GREEN}${BOLD}${BLINK}DOCS/ISSUES${NB}${NK}:${NC}  ${BLUE}${UNDERLINE}https://github.com/alexandrglm/openwrt_wg-autoconf${NU}${NC}"
    echo ""

    exit 1
}


#####################################################################
#
# ██╗     ██╗███████╗████████╗
# ██║     ██║██╔════╝╚══██╔══╝
# ██║     ██║███████╗   ██║
# ██║     ██║╚════██║   ██║
# ███████╗██║███████║   ██║
# ╚══════╝╚═╝╚══════╝   ╚═╝
#
#####################################################################
# D0NE!! Make really useful both methods

# 1   LIST
list_configs() {

    local file_arg="$1"


    if [ -n "$file_arg" ]; then

        local conf_file="$WG_CONF_DIR/$file_arg.conf"

        if [ ! -f "$conf_file" ]; then
            
            error "Configuration file $file_arg not found!"
        
        fi
        
        log "Configuration file: $file_arg"
        echo ""
        echo -e "${BLUE}$(basename $conf_file)${NC}"
        ui_lines 50
        cat "$conf_file" | sed 's/^/   /'
        echo ""
        ui_lines 50
        return
    fi



    echo ""
    ui_lines 49 "${YELLOW}Config files found on ${GREEN}$WG_CONF_DIR${NC}"
    echo ""

    local count=0
    local line=""
    local found=0

    for conf in "$WG_CONF_DIR"/*.conf; do

        [ -f "$conf" ] || continue

        found=1
        name=$(basename "$conf" .conf)

        if [ $count -eq 5 ]; then

            echo -e "${GREEN}$line${NC}"

            line="   $name"
            count=1

        else

            if [ $count -eq 0 ]; then

                line="   $name"

            else

                line="$line ${NC}|${GREEN} $name${NC}"
            fi

            count=$((count + 1))
        fi
    done



    if [ $found -eq 0 ]; then

        warning "No configuration files found in $WG_CONF_DIR"

    else

        [ -n "$line" ] && echo -e "${GREEN}$line${NC}"

    fi

    echo ""
    ui_lines 50
}
#####################################################################
# 2.    LIST-FULL
list_configs_full() {

    ui_lines 79 "${YELLOW} Full Configs Inspection${NC}"
    echo ""

    local found=0

    for conf in "$WG_CONF_DIR"/*.conf; do
        [ -f "$conf" ] || continue
        found=1

        ui_lines 40 "${BLUE}$(basename $conf)${NC}"
        cat "$conf" | sed 's/^/   /'
        echo ""
        # ui_lines 40
        echo ""
    done

    if [ $found -eq 0 ]; then
        warning "No configuration files found in $WG_CONF_DIR"
    fi

    ui_lines 80
}



#####################################################################
#
# ████████╗███████╗███████╗████████╗
# ╚══██╔══╝██╔════╝██╔════╝╚══██╔══╝
#    ██║   █████╗  ███████╗   ██║
#    ██║   ██╔══╝  ╚════██║   ██║
#    ██║   ███████╗███████║   ██║
#    ╚═╝   ╚══════╝╚══════╝   ╚═╝
#
#####################################################################
# D0NE!!: Make really useful a test mode, not onlye check key params
#    WG-AUTOCONF test
test_config() {

    local CONF_NAME="$1"
    local conf_file="$WG_CONF_DIR/$CONF_NAME.conf"


    # 1.1   IF EXISTS
    [ -f "$conf_file" ] || error "Configuration file ${YELLOW}$conf_file${NC} not found!"

    verbose echo ""
    verbose log "Testing ${YELLOW}$CONF_NAME${NC} ..."
    echo ""
    
    # 1.2   CONF VLAIDATIOPN
    ui_lines 79 "${YELLOW}FULL CONFIGURATION VALIDATION${NC}"
    echo ""
    
    # 1.2.1 REQUIRED FIELDS FROM CON
    local required_fields="PrivateKey PublicKey Address Endpoint AllowedIPs"
    local optional_fields="DNS"
    
    local all_ok=1
    
    # 2. CHECK - VALIDATE FIELDS
    for field in $required_fields; do
        
        # 2.1 SETUP_WIREGUARD (SETUP / MANUAL) MODE VALIDATION
        local value=$(get_conf_value "$field" "$conf_file" "raw")
        

        if [ -z "$value" ]; then
            
            echo -e "  ${RED}[ERROR]${NC}  [MISSING] $field: NOT FOUND" >&2
            all_ok=0
        

        # 2.2 TEST_CONFIGS MODE VALIDATIO
        else
            
            local validation_output=""
            
            validation_output=$(validate_wg_config "auto" "$conf_file" "$field" "$value" "1" 2>&1)
            
            local validation_exit=$?
            
            if [ $validation_exit -eq 0 ]; then
                
                success "  $field: ${GREEN}Valid${NC}"
               
                
                local display_value="$value"
                
                # 2.2.1 VALUE CLEANINGS
                [ ${#display_value} -gt 50 ] && display_value="${display_value:0:47}..."
                


                # 2.3   FOR VALID VALUE
                echo -e "        ${BLUE}Value:${NC} $display_value"
            
            
            # 2.4   FOR AN INVALID VALUE
            else
                

                echo -e "  ${RED}[INVALID]${NC} $field: Failed Validation!"
                
                if [ -n "$validation_output" ]; then
                    
                    local error_msg=$(echo "$validation_output" | grep -o "VALIDATION_ERROR: .*" | sed 's/VALIDATION_ERROR: //' | head -1)
                    
                    [ -n "$error_msg" ] && echo -e "        ${RED}Error:${NC} $error_msg"
                fi
                
                all_ok=0
            
            fi
    
        fi
    
        echo ""
    
    done
    
    # 3. OPTIONAL (DNS SPECIFIC ISSUES) VALIDATION
    # DEBUG! r7 ... maybe allowed_ips should be there
    #               Room for future SWITCH/BYPASS?
    for field in $optional_fields; do
        
        local value=$(get_conf_value "$field" "$conf_file" "raw")
        
        if [ -z "$value" ]; then
            
            warning "  [OPTIONAL] $field: Not specified (will use defaults)"
        
        else
            
            # 3.1   OPTIONALS FOR TEST_CONFIG() MODE
            local validation_output=""
            validation_output=$(validate_wg_config "auto" "$conf_file" "$field" "$value" "1" 2>&1)
            local validation_exit=$?
            
            
            if [ $validation_exit -eq 0 ]; then
                
                success "  $field: ${GREEN}Valid${NC}"
                
                # 3.1.1 VALUE CLEANINGS
                
                local display_value="$value"
                
                [ ${#display_value} -gt 50 ] && display_value="${display_value:0:47}..."
                
                
                # 3.2   FOR A VALID (OPTIONAL) VALUE
                echo -e "        ${BLUE}Value:${NC} $display_value"
            
            

            # 3.3   FOR A INVALID (OPTIONAL) VALUE
            else
                
                
                echo -e "  ${RED}[INVALID]${NC} $field: Failed Validation!"
                
                if [ -n "$validation_output" ]; then
                    
                    local error_msg=$(echo "$validation_output" | grep -o "VALIDATION_ERROR: .*" | sed 's/VALIDATION_ERROR: //' | head -1)
                    
                    [ -n "$error_msg" ] && echo -e "        ${RED}Error:${NC} $error_msg"
                
                fi
                
                all_ok=0
            fi
        fi
        
        echo ""
    
    
    done




    # 4. PUBKEY/PRIVKEY VALIDATIONS CLEAN_WG_KEY()
    echo ""
    ui_lines 49 "${YELLOW}KEY CRYPTO VALIDATION${NC}"
    echo ""
    
    local private_key_raw=$(get_conf_value "PrivateKey" "$conf_file" "raw")
    local public_key_raw=$(get_conf_value "PublicKey" "$conf_file" "raw")
    
    if [ -n "$private_key_raw" ]; then
        
        local private_key_clean=$(clean_wg_key "$private_key_raw")
        
        if echo "$private_key_clean" | wg pubkey >/dev/null 2>&1; then
            
            success "  PrivateKey: ${GREEN}Cryptographically valid${NC}"
            echo -e "        ${BLUE}Key:${NC} $(echo "$private_key_clean" | cut -c1-15)..."
        
        else

            echo -e "  ${RED}[INVALID]${NC} PrivateKey: ${RED}Not a valid WireGuard key!${NC}"
            all_ok=0
        fi
    
    fi
    
    if [ -n "$public_key_raw" ]; then
        
        local public_key_clean=$(clean_wg_key "$public_key_raw")
        
        if echo "$public_key_clean" | wg pubkey >/dev/null 2>&1; then
            
            success "  PublicKey: ${GREEN}Cryptographically valid${NC}"
            echo -e "        ${BLUE}Key:${NC} $(echo "$public_key_clean" | cut -c1-15)..."
        
        else
            
            echo -e "  ${RED}[INVALID]${NC} PublicKey: ${RED}Not a valid WireGuard key!${NC}"
            all_ok=0
        fi
    fi





    # 5. ENDPOINT
    echo ""
    ui_lines 49 "${YELLOW}ENDPOINT DETAILS${NC}"
    echo ""
    

    # 5.1 GET
    local endpoint=$(get_conf_value "Endpoint" "$conf_file" "raw")
    
    # 5.2 SPLIT host:port
    if [ -n "$endpoint" ]; then
        
        local host_part=$(echo "$endpoint" | cut -d: -f1)
        local port_part=$(echo "$endpoint" | cut -d: -f2)
        
        [ -z "$port_part" ] && port_part="$DEFAULT_PORT"
        
        echo -e "  ${YELLOW}Host: ${GREEN}$host_part${NC}"
        echo -e "  ${YELLOW}Port: ${GREEN}$port_part${NC}"
        
        
        # 5.3 CHECK IF HOST UP (nslookup)
        # DEBUG! ... nslookup from Busybox ... or what else?
        if ! echo "$host_part" | grep -qE '^([0-9]{1,3}\.){3}[0-9]{1,3}$' && \
           ! echo "$host_part" | grep -qE '^\[.*\]$'; then
            
            verbose echo ""
            verbose warning "  [NOTE] Hostname detected: $host_part"
            verbose echo ""

            if nslookup "$host_part" >/dev/null 2>&1; then
                
                echo ""
                success "  ${GREEN}Hostname resolves correctly!${NC}"
            
            else
                
                echo ""
                warning "  ${RED}Hostname does not resolve (may cause connection issues)!${NC}"
                all_ok=0
            
            fi
        fi
    fi
    


    # 6. SHOW
    echo ""
    ui_lines 49 "${YELLOW}TEST RESULTS${NC}"
    
    if [ $all_ok -eq 1 ]; then

        echo ""
        success "${GREEN}CONFIGURATION FILE IS VALID AND READY FOR USE!${NC}"
        echo ""
        echo -e "   ${BLUE}You can now use:${NC}"
        echo -e "     ${YELLOW}wg-autoconf setup ${GREEN}$CONF_NAME${NC}"
        echo ""
    
    else
        echo ""
        warning "${RED}CONFIGURATION FILE HAS ERRORS!${NC}"
        echo ""
        echo -e " ${YELLOW}Please fix the issues above before using this configuration!${NC}"
        echo ""
    fi
    
    ui_lines 80
}

#####################################################################
#
# ███████╗███████╗████████╗██╗   ██╗██████╗
# ██╔════╝██╔════╝╚══██╔══╝██║   ██║██╔══██╗
# ███████╗█████╗     ██║   ██║   ██║██████╔╝
# ╚════██║██╔══╝     ██║   ██║   ██║██╔═══╝
# ███████║███████╗   ██║   ╚██████╔╝██║
# ╚══════╝╚══════╝   ╚═╝    ╚═════╝ ╚═╝
#
#####################################################################

# TODO:     Main idea, from here, will be to REFACTOR the three functions into a single one,  
#           preparing snippets with each necessary block for each file
#####################################################################
# WG-AUTOCONF SETUP NETWORK CONFIG
#####################################################################
setup_network_config() {

    local iface_name="$1"
    local private_key="$2"
    local address="$3"
    local public_key="$4"
    local endpoint_host="$5"
    local endpoint_port="$6"
    local allowed_ips="$7"
    local dns="$8"

    verbose log "Setting up NETWORK config for $iface_name..."
    debug_write "[SETUP NETWORK] Starting config for $iface_name"

    # 1. VALIDATE AND FORMAT DNS
    validate_config_value "DNS" "$dns" "manual"
    
    local dns_uci=$(get_conf_value "DNS" "" "uci" "$dns")


    # 2. IF EXIST IFACE
    if uci get "network.$iface_name" >/dev/null 2>&1; then
        
        debug_write "[SETUP NETWORK] Interface already exists: $iface_name"
        warning "Interface $iface_name already exists in network config"
        
        return 0
    
    fi


    # 3. GET NEXT TAG ID
    local tag_id=$(get_next_tag_id "$NETWORK_CONF" "network")
    debug_write "[SETUP NETWORK] Using tag id: $tag_id"


    # 3.1 IF TAG EXIST ->  SKIP
    if grep -q "# wg-autoconf network start id $tag_id" "$NETWORK_CONF" 2>/dev/null; then
        
        debug_write "[SETUP NETWORK ERROR] Tag id $tag_id already exists"
        warning "NETWORK tag with id $tag_id already exists. Skipping..."
        
        return 0
    fi


    # 4. GENERATE CONFIGURATION CONTENT
    local new_content="

# wg-autoconf network start id $tag_id
config interface '$iface_name'
    option proto 'wireguard'
    option private_key '$private_key'
    option addresses '$address'
    option dns '$dns_uci'

config wireguard_$iface_name '${iface_name}_peer'
    option public_key '$public_key'
    option endpoint_host '$endpoint_host'
    option endpoint_port '$endpoint_port'
    option route_allowed_ips '0'
    option persistent_keepalive '25'
"

    # 4.1 Add AllowedIPs as UCI list
    local allowed_ips_list=$(allowed_ips_to_uci "$allowed_ips")
    new_content="${new_content}${allowed_ips_list}
"
    new_content="${new_content}# wg-autoconf network end id $tag_id
"


    # 5. ATOMIC FILE OPERATIONS
    # DEBUG!    Room for atpmic funcs
    local atomic_temp="${ATOMIC_PATHS}/network.atomic"
    debug_write "[SETUP NETWORK] Using temp file for operations: $atomic_temp"
    
    # 5.1 ATOMIC CP OPER
    if ! cp "$NETWORK_CONF" "$atomic_temp" 2>/dev/null; then
        
        warning "Cannot copy ${YELLOW}network${NC} config for atomic operation!"
        return 1
    
    fi
    
    # 5.2 ADD NEW_CONTENT
    echo "$new_content" >> "$atomic_temp" 2>/dev/null
    
    # 5.3 ATOMIC MV OPER DE VUELTA
    if ! mv "$atomic_temp" "$NETWORK_CONF" 2>/dev/null; then
        
        warning "Atomic replacement of network config failed!"
        rm -f "$atomic_temp" 2>/dev/null
        
        return 1
    
    fi


    # 6. COMMIT UCI CHANGES
    debug_write "[SETUP NETWORK] Committing UCI network config"
    if ! uci commit network 2>/dev/null; then
        
        warning "Failed to commit network configuration"
        debug_write "[SETUP NETWORK ERROR] uci commit network failed"
        
        return 1
    fi


    # 7. D0NE!
    verbose success "Added NETWORK config for $iface_name (id: $tag_id)"
    debug_write "[SETUP NETWORK] Successfully added $iface_name with tag id $tag_id"
    
    return 0
}

#####################################################################
# WG-AUTOCONF setup DHCP config
#####################################################################
setup_dhcp_config() {

    local iface_name="$1"

    verbose log "Setting up DHCP config for $iface_name..."
    debug_write "[SETUP DHCP] Starting config for $iface_name"

    # 1. IFACE EXIST VERIFY
    if uci get "dhcp.$iface_name" >/dev/null 2>&1; then
        
        warning "DHCP config for $iface_name already exists"
        debug_write "[SETUP DHCP] Config already exists: $iface_name"
        
        return 0
    fi

    # 2. GET LATEST TAG ID
    local tag_id=$(get_next_tag_id "$DHCP_CONF" "dhcp")
    debug_write "[SETUP DHCP] Using tag id: $tag_id"

    # 2.1 DUPLICATED TAG VERUFUICATION
    if grep -q "# wg-autoconf dhcp start id $tag_id" "$DHCP_CONF" 2>/dev/null; then
        
        warning "DHCP tag with id $tag_id already exists. Skipping..."
        debug_write "[SETUP DHCP ERROR] Tag id $tag_id already exists"
        
        return 0
    
    fi

    # 3. PRE-SET CONTENT
    local new_content="
# wg-autoconf dhcp start id $tag_id
config dhcp '$iface_name'
    option interface '$iface_name'
    option ignore '1'
# wg-autoconf dhcp end id $tag_id
"

    # 5. ATOMIC OPERS
    local atomic_temp="${ATOMIC_PATHS}/dhcp.atomic"
    debug_write "[SETUP DHCP] Using atomic temp: $atomic_temp"
    
    # 5.1 cp native
    if ! cp "$DHCP_CONF" "$atomic_temp" 2>/dev/null; then
        
        warning "Cannot copy ${YELLOW}DHCP${NC} config for atomic operation!"
        return 1
    
    fi
    
    # 5.2 add content
    echo "$new_content" >> "$atomic_temp" 2>/dev/null
    

    # 5.3 Replace native with modified
    if ! mv "$atomic_temp" "$DHCP_CONF" 2>/dev/null; then
        
        warning "Atomic replacement of DHCP config failed!"
        rm -f "$atomic_temp" 2>/dev/null
        
        return 1
    fi

    # 6. COMMITS
    debug_write "[SETUP DHCP] Committing UCI DHCP config"
    
    if ! uci commit dhcp 2>/dev/null; then
        
        warning "Failed to commit ${YELLOW}DHCP${NC} configuration"
        debug_write "[SETUP DHCP ERROR] uci commit dhcp failed"
        
        return 1
    fi

    
    # D0ne!
    verbose success "Added DHCP config for $iface_name (id: $tag_id)"
    debug_write "[SETUP DHCP] Successfully added $iface_name with tag id $tag_id"
    
    return 0
}
#####################################################################
# WG-AUTOCONF setup Firewall config
#####################################################################
setup_firewall_config() {
    # DEBUG!
    # D0NE!: refactor, remove fw config manipulation. UCI -> automatic NFT = PERFECT

    local iface_name="$1"
    local endpoint_port="$2"

    verbose log "Setting up Firewall config for $iface_name..."
    debug_write "[SETUP FIREWALL] Starting config for $iface_name (port: $endpoint_port)"

    # 1. CHECK IF ZONE ALREADY EXISTS (BY NAME)
    if uci get "firewall.$iface_name" >/dev/null 2>&1; then
        
        warning "Firewall zone for $iface_name already exists"
        debug_write "[SETUP FIREWALL] Zone already exists: $iface_name"
        
        return 0
    
    fi

    # 2. CREATE ZONE WITH NAME
    debug_write "[SETUP FIREWALL] Creating zone firewall.$iface_name"
    
    uci set "firewall.$iface_name=zone"
    uci set "firewall.$iface_name.name=$iface_name"
    uci set "firewall.$iface_name.network=$iface_name"
    uci set "firewall.$iface_name.input=ACCEPT"
    uci set "firewall.$iface_name.output=ACCEPT"
    uci set "firewall.$iface_name.forward=ACCEPT"
    uci set "firewall.$iface_name.masq=1"
    uci set "firewall.$iface_name.mtu_fix=1"


    # 3. CREATE RULE TO ALLOW WG FROM WAN
    local rule_name="Allow_WireGuard_${iface_name}"
    
    debug_write "[SETUP FIREWALL] Creating rule: $rule_name"
    
    uci set "firewall.$rule_name=rule"
    uci set "firewall.$rule_name.name=Allow-WireGuard-${iface_name}"
    uci set "firewall.$rule_name.src=wan"
    uci set "firewall.$rule_name.dest_port=$endpoint_port"
    uci set "firewall.$rule_name.proto=udp"
    uci set "firewall.$rule_name.target=ACCEPT"


    # 4. CREATE FORWARDING WG -> WAN
    local fwd_name="${iface_name}_to_wan"
    
    debug_write "[SETUP FIREWALL] Creating forwarding: $iface_name -> wan"
    
    uci set "firewall.$fwd_name=forwarding"
    uci set "firewall.$fwd_name.src=$iface_name"
    uci set "firewall.$fwd_name.dest=wan"



    # 5. COMMIT UCI CHANGES
    debug_write "[SETUP FIREWALL] Committing UCI firewall config"

    if ! uci commit firewall 2>/dev/null; then

        warning "Failed to commit firewall configuration"
        debug_write "[SETUP FIREWALL ERROR] uci commit firewall failed"

        return 1

    fi


    # 6. RELOAD FIREWALL TO APPLY CHANGES
    debug_write "[SETUP FIREWALL] Reloading firewall service"

    if ! /etc/init.d/firewall reload 2>/dev/null; then

        warning "Failed to reload firewall (configuration may still work)"
        debug_write "[SETUP FIREWALL WARNING] Firewall reload failed"

    else

        debug_write "[SETUP FIREWALL] Firewall reloaded successfully"

        sleep 2

    fi



    # 7. D0NE!
    verbose success "Added Firewall config for $iface_name (port: $endpoint_port)"
    debug_write "[SETUP FIREWALL] Successfully added $iface_name"
    
    return 0
}

#####################################################################
# WG-AUTOCONF SETUP_WIREGUARD
#####################################################################
setup_wireguard() {

    local conf_name="$1"
    local mode="$2"
    local conf_file=""
    local is_manual=0


    # 0) UNCONDITIONAL PRE-CHECKS
    # upgrade_avoid_garbage, moved to init


    # A) MANUAL MODE DETECTION
    [ "$mode" = "manual" ] && is_manual=1


    # 1. CONFIGURATION FILE HANDLING
    # 1.1 When using conf file as base
    if [ -n "$conf_name" ]; then
        
        conf_file="$WG_CONF_DIR/$conf_name.conf"
        
        # DEBUG! Check redundances
        if [ ! -f "$conf_file" ]; then
        
            if [ $is_manual -eq 0 ]; then
        
                error "$conf_file is missing!!!"
        
            else
        
                warning "Configuration file not found: $conf_file"
                conf_file=""
        
            fi
        
        else
        
            if [ $is_manual -eq 1 ]; then
                log "Loading defaults from $conf_name.conf..."
            fi
        fi
    fi


    # 2. PRE-CHECKS

    state_init
    check_bins


    # 2.1 First execution verification
    if ! state_check_first_exec; then

        # 2.1.1 CHECK SAFETY (ifaces, tags, rt_tables)
        verbose log "Checking previous WireGuard configuration..."

        local active_ifaces=$(get_all_wg_interfaces)
        local has_tags=$(grep -c "# wg-autoconf" "$NETWORK_CONF" "$DHCP_CONF" "$FIREWALL_CONF" 2>/dev/null | grep -v ":0$" | wc -l)
        local has_tables=$(grep -c "_vpn_" /etc/iproute2/rt_tables 2>/dev/null || echo 0)

        # 2.1.2 NOTICE USER ABOUT PRE-EXISTING CONFIGS
        if [ -n "$active_ifaces" ] || [ "$has_tags" -gt 0 ] || [ "$has_tables" -gt 0 ]; then
            
            echo ""
            debug_write "[SETUP] Found active WG configs/interfaces when attemping to setup a new WG connection!"
            debug_write "    Ifaces: $active_ifaces, tags: $has_tags, tables: $has_tables"
            debug_write "    (This is OK as wg-autoconf allows managing multiple WG setups!)"
            
            warning "Found previous setups!: "
            echo ""
            echo -e "  - ${YELLOW}WG Interfaces:${NC}    $active_ifaces"
            echo ""
            verbose log "An active WireGuard interface or connection already exists"
            verbose echo "   You may continue configuring as many additional interfaces as required"
            verbose echo "   This notice is simply for your situational awareness"
            verbose echo ""
            
            verbose log "If you think there should be no pre-existing configuration, abort now and run 'wg-autoconf nuke' to ensure a clean slate"
            verbose echo ""

            printf "${YELLOW}Proceed with another WG setup? (${GREEN}Y${YELLOW}/${RED}n${YELLOW}):${NC} "
            read -r confirm
            case "$confirm" in
            
                y|Y|yes|YES|Yes|okidoki|OKIDOKI|Okidoki|OkiDoki)
                    ;;
                *) error "Setup cancelled"
                    ;;
            esac
        
        else
        
            state_write "IS_FIRST_EXEC" "1"
            debug_write "[SETUP] No configs found, IS_FIRST_EXEC reset to 1"
        
        fi
    fi


    # 3. CONFIGURATION VARIABLES INIT
    local iface_name=""
    local private_key=""
    local public_key=""
    local address=""
    local endpoint_host=""
    local endpoint_port=""
    local allowed_ips=""
    local dns=""

    
    # A) AUTO MODE -> FROM .CONF FILE
    if [ $is_manual -eq 0 ]; then
        
        log "Setting up wg from $conf_name.conf..."
        echo ""

    
        # 3.1 VALIDATE ALL FIELDS FROM .CONF
        debug_write "[SETUP] Validating configuration file..."
        
        # PrivateKey
        private_key=$(get_conf_value "PrivateKey" "$conf_file" "raw")
        validate_config_value "PrivateKey" "$private_key" "auto"
        private_key=$(clean_wg_key "$private_key")
        
        # PublicKey
        public_key=$(get_conf_value "PublicKey" "$conf_file" "raw")
        validate_config_value "PublicKey" "$public_key" "auto"
        public_key=$(clean_wg_key "$public_key")
        
        # Address
        address=$(get_conf_value "Address" "$conf_file" "raw")
        validate_config_value "Address" "$address" "auto"
        
        # Endpoint (with IPv6 support)
        endpoint=$(get_conf_value "Endpoint" "$conf_file" "raw")
        validate_config_value "Endpoint" "$endpoint" "auto"
        
    
        # 3.2 PARSE ENDPOINT (IPv4/IPv6/hostname)
        local parsed=$(parse_endpoint "$endpoint" "pair")
        endpoint_host=$(echo "$parsed" | cut -d'|' -f1)
        endpoint_port=$(echo "$parsed" | cut -d'|' -f2)
        
        # AllowedIPs
        allowed_ips_raw=$(get_conf_value "AllowedIPs" "$conf_file" "raw")
        if [ -n "$allowed_ips_raw" ]; then
            
            validate_config_value "AllowedIPs" "$allowed_ips_raw" "auto"
            allowed_ips=$(process_allowed_ips "$allowed_ips_raw" | tr '\n' ' ')
        
        else
            
            warning "Allowed IPs missing! Using defaults ($DEFAULT_ALLOW_IPS)"
            allowed_ips="$DEFAULT_ALLOW_IPS"
        
        fi
        
        # DNS
        dns=$(get_conf_value "DNS" "$conf_file" "raw")
        
        if [ -n "$dns" ]; then
            
            validate_config_value "DNS" "$dns" "auto"
            
            # DNS LEAKAGE NOTICE
            dns_leakage "$dns" "$address" "setup"
        
        else
            
            dns="$DEFAULT_DNS"
            warning "DNS not found, using defaults ("${DEFAULT_DNS}")"
            verbose log "Even using defaults, DNS will be tunneled in any case"
            dns_leakage "$dns" "$address" "setup"
        
        fi
        
        debug_write "[SETUP AUTO] Configuration validated successfully"


    
        # 3.3 SET INTERFACE NAME FROM CONF NAME
        iface_name="wg_$conf_name"
        
        validate_wg_config "auto" "" "InterfaceName" "$iface_name"

    
        # 3.4 CHECK ADDRESS COLLISIONS
        local collision=$(address_collision "$address")
        
        if [ -n "$collision" ]; then
            
            debug_write "[SETUP AUTO] IP collision: $address for $iface_name"
            error "Address $address already in use by $collision!"
            # YA SE VA A EXIT 1 POR error()

        
        fi

    
    # B) MANUAL MODE
    else

        log "Starting MANUAL setup (interactive configuration)..."
        debug_write "[MANUAL] Manual setup with no .conf, started"
        echo ""

    
        # 4. SET INTERFACE NAME
        ui_lines 79 "${YELLOW}1. WIREGUARD INTERFACE NAME${NC} (must start with 'wg')"
        default_iface="wg0"

        while true; do

            # 4.1 Prompt for interface name
            printf "Enter interface name (${BLUE}default: $default_iface)${NC}:"
            
            read -r iface_input
            [ -z "$iface_input" ] && iface_input="$default_iface"
            
            
            # 4.2 Validate interface name
            if ! validate_wg_config "manual" "" "InterfaceName" "$iface_input" 2>/dev/null; then
                
                warning "Invalid interface name: $iface_input"
                continue
            
            fi

            # 4.3 IF IFACE
            if iface_collision "$iface_input"; then
                
                debug_write "[SETUP MANUAL] Attempt to overwrite $iface_input"

                warning "Interface $iface_input already exists!"
                
            
                printf "${YELLOW}Try another name? (${GREEN}Y${YELLOW}/${RED}n${YELLOW}):${NC} "
                read -r retry
                case "$retry" in
                    y|Y|yes|YES|Yes|okidoki|OKIDOKI|Okidoki|OkiDoki)
                        continue
                        ;;
                    *) 
                        error "Interface name already in use!"
                        ;;
                esac
            fi

            iface_name="$iface_input"
            break
        done

    
        # 5. SET WIREGUARD KEYS
        echo ""
        ui_lines 79 "${YELLOW}2. WIREGUARD KEYS ${NC}"

        # 5.1 Private Key
        default_privkey=""
        
        if [ -n "$conf_file" ] && [ -f "$conf_file" ]; then
            
            default_privkey=$(get_conf_value "PrivateKey" "$conf_file" "raw")
        
        fi

        if [ -n "$default_privkey" ]; then
            
            echo "   [From $conf_name.conf: $(echo $default_privkey | cut -c1-10)...]"
            
            printf "Enter PRIVATE key (${BLUE}or press Enter for default${NC}): "
            read -r private_key_raw
            [ -z "$private_key_raw" ] && private_key_raw="$default_privkey"
        
        else
            
            printf "Enter PRIVATE key: "
            read -r private_key_raw
        
        fi
        
        # Validate private key
        [ -z "$private_key_raw" ] && error "Private key is required!"
        validate_wg_config "manual" "" "PrivateKey" "$private_key_raw"
        private_key=$(clean_wg_key "$private_key_raw")

        # 5.2 Public Key
        default_pubkey=""
        
        if [ -n "$conf_file" ] && [ -f "$conf_file" ]; then
            default_pubkey=$(get_conf_value "PublicKey" "$conf_file" "raw")
        fi

        if [ -n "$default_pubkey" ]; then
            
            echo "   [From $conf_name.conf: $(echo $default_pubkey | cut -c1-10)...]"
            
            printf "Enter PUBLIC key (${BLUE}or press Enter for default${NC}): "
            read -r public_key_raw
            [ -z "$public_key_raw" ] && public_key_raw="$default_pubkey"
        
        else
            
            printf "Enter PUBLIC key: "
            read -r public_key_raw
        
        fi
    
        # Validate public key
        [ -z "$public_key_raw" ] && error "Public key is required!"
        validate_wg_config "manual" "" "PublicKey" "$public_key_raw"
        
        public_key=$(clean_wg_key "$public_key_raw")



    
        # 6. SET LOCAL ADDRESS
        echo ""
        ui_lines 79 "${YELLOW}3. LOCAL ADDRESS${NC}"

        default_address=""
        if [ -n "$conf_file" ] && [ -f "$conf_file" ]; then
            default_address=$(get_conf_value "Address" "$conf_file" "raw")
        fi

        while true; do
            
            if [ -n "$default_address" ]; then
                
                printf "Enter local IP address (${BLUE} default: $default_address${NC}): "
                read -r address_input
                [ -z "$address_input" ] && address_input="$default_address"
            
            else
                
                printf "Enter local IP address (${BLUE}e.g., 10.2.0.2/32${NC}): "
                read -r address_input
            
            fi

            # Validate address
            [ -z "$address_input" ] && error "Address is required!"
            validate_wg_config "manual" "" "Address" "$address_input"
            
            # Check address collision
            local collision=$(address_collision "$address_input")
            if [ -n "$collision" ]; then
                
                warning "Address $address_input already in use by $collision!"
                debug_write "[SETUP MANUAL] IP collision: $address_input"
        
                printf "${YELLOW}Try another address? (${GREEN}Y${YELLOW}/${RED}n${YELLOW}):${NC} "
                read -r retry
                case "$retry" in
                    y|Y|yes|YES|Yes|okidoki|OKIDOKI|Okidoki|OkiDoki)
                        continue
                        ;;
                    *) 
                        error "Address already in use!"
                        ;;
                esac
            fi

            address="$address_input"
            break
        done

    

        # 7. SET ENDPOINT
        echo ""
        ui_lines 79 "${YELLOW}4. ENDPOINT${NC}"

        # 7.1 Get default from conf file if available
        default_endpoint=""
        
        if [ -n "$conf_file" ] && [ -f "$conf_file" ]; then
            
            default_endpoint=$(get_conf_value "Endpoint" "$conf_file" "raw")
        
        fi

        # 7.2 Parse default endpoint (with IPv6 support)
        default_endpoint_host=""
        default_endpoint_port=""
        
        if [ -n "$default_endpoint" ]; then
            
            parsed=$(parse_endpoint "$default_endpoint" "pair")
            
            default_endpoint_host=$(echo "$parsed" | cut -d'|' -f1)
            default_endpoint_port=$(echo "$parsed" | cut -d'|' -f2)
        
        fi

        # 7.3 Interactive endpoint configuration
        while true; do
            
            # 7.3.1 HOST
            if [ -n "$default_endpoint_host" ]; then
                
                printf "Enter endpoint host (${BLUE}default: $default_endpoint_host${NC}): "
                read -r endpoint_host_input
                
                [ -z "$endpoint_host_input" ] && endpoint_host_input="$default_endpoint_host"
            
            else
                
                printf "Enter endpoint host (IP or domain): "
                read -r endpoint_host_input
            fi
            
            [ -z "$endpoint_host_input" ] && error "Endpoint host is required!"
            
            
            
            # 7.3.2 PORT
            if [ -n "$default_endpoint_port" ]; then
                
                printf "Enter endpoint port (${BLUE}default: $default_endpoint_port${NC}): "
                read -r endpoint_port_input
                
                [ -z "$endpoint_port_input" ] && endpoint_port_input="$default_endpoint_port"
            
            else
                
                print "Enter endpoint port (${BLUE} WG default: 51820${NC}): "
                read -r endpoint_port_input
                
                [ -z "$endpoint_port_input" ] && endpoint_port_input="$DEFAULT_PORT"
            
            fi
            
            
            # 7.4   REBULD AND VALIDATE
            local endpoint_full="$endpoint_host_input:$endpoint_port_input"
            
            if validate_wg_config "manual" "" "Endpoint" "$endpoint_full" 2>/dev/null; then
                
                endpoint_host="$endpoint_host_input"
                endpoint_port="$endpoint_port_input"
                
                break
            
            else
                
                warning "Invalid endpoint format. Please try again."
            
            fi
        
        done

    

        # 8. SET ALLOWED IPS
        echo ""
        ui_lines 79 "${YELLOW}5. ALLOWED IPs${NC}"
        echo -e "\033[1m   (use COMMA-SEPARATED values, e.g.: 0.0.0.0/0, ::/0)\033[0m"

        default_allowed_ips=""
        
        if [ -n "$conf_file" ] && [ -f "$conf_file" ]; then
            
            default_allowed_ips=$(get_conf_value "AllowedIPs" "$conf_file" "raw")
        
        fi

        while true; do
            
            if [ -n "$default_allowed_ips" ]; then
            
                printf "Enter allowed IPs (${BLUE}default: $default_allowed_ips${NC}): "
                read -r allowed_ips_input
                
                [ -z "$allowed_ips_input" ] && allowed_ips_input="$default_allowed_ips"
            
            else

                printf "Enter allowed IPs: "
                echo -e "\033[1m   (use COMMA-SEPARATED values, e.g.: 0.0.0.0/0, ::/0)\033[0m"
                read -r allowed_ips_input
                
                [ -z "$allowed_ips_input" ] && allowed_ips_input="0.0.0.0/0"
            
            fi
            
            if validate_wg_config "manual" "" "AllowedIPs" "$allowed_ips_input"; then
                
                allowed_ips="$allowed_ips_input"
               
                break
            
            else
                
                warning "Invalid AllowedIPs format. Please try again."
            
            fi
        
        done

    
        # 9. SET DNS SERVERS
        echo ""
        ui_lines 79 "${YELLOW}6. DNS SERVERS${NC}"
        echo -e "\033[1m   (use COMMA-SEPARATED values, e.g.: 1.1.1.1, 1.0.0.1, 2606:4700:4700::1111)\033[0m"

        # 9.1 GET FROM CONF FILR
        local default_dns=""
        
        if [ -n "$conf_file" ] && [ -f "$conf_file" ]; then
            
            default_dns=$(get_conf_value "DNS" "$conf_file" "raw")
        
        fi
        
        
        # 9.2 ELSE USE DEFAULTS
        [ -z "$default_dns" ] && default_dns="$DEFAULT_DNS"

        while true; do
            
            printf "Enter DNS servers (${BLUE}default: $default_dns)${NC} "
            
            read -r dns_input
            
            if [ -z "$dns_input" ]; then
                
                dns="$default_dns"
                
                verbose echo -e "${GREEN}Using default DNS: $default_dns${NC}"
                
                break
            
            else
                
                if validate_wg_config "manual" "" "DNS" "$dns_input"; then
                    
                    dns="$dns_input"   
                    break
                
                else
                    
                    warning "Invalid DNS format. Please try again."
                
                fi

            fi
        
        done

        # DNS LEAKAGE NOTIUCE HERE
        dns_leakage "$dns" "$address" "manual"

    


        # 10. SAVE CONFIGURATION TO .CONF FILE (OPTIONAL)
        echo ""
        ui_lines 79 "${YELLOW}7. SAVE WIREGUARD CONFIGURATION FILE${NC}"

        echo ""
        ui_lines 49 "${MAGENTA}${BOLD}CONFIG SUMMARY${NB}${NC}"
        echo -e " Interface:           $iface_name"
        echo -e " Private Key:         $(echo $private_key | cut -c1-10)..."
        echo -e " Public Key:          $(echo $public_key | cut -c1-10)..."
        echo -e " Local IP:            $address"
        echo -e " Endpoint:            $endpoint_host:$endpoint_port"
        echo -e " Allowed IPs:         $allowed_ips"
        echo -e " DNS:                 $dns"
        ui_lines 50
        echo ""

        # CONFIRM SAVE NEW CONIG FILE
        printf "${YELLOW}Save config as .conf file in $WG_CONF_DIR? (${GREEN}y${YELLOW}/${RED}N${YELLOW}):${NC} "
        read -r save_conf

        case "$save_conf" in
            y|Y|yes|YES|Yes|okidoki|OKIDOKI|Okidoki|OkiDoki)
                
                printf "${GREEN}Enter config filename (without .conf extension):${NC} " 
                read -r conf_filename
                [ -z "$conf_filename" ] && conf_filename="manual-$(date +%s)"
                
                save_wireguard_conf "$conf_filename" "$private_key" "$public_key" \
                                    "$address" "$endpoint_host" "$endpoint_port" \
                                    "$allowed_ips" "$dns"
                
                debug_write "[MANUAL SETUP] New config created ($conf_filename)"
                success "Configuration file saved as $conf_filename.conf"
                ;;
            *)
                verbose warning "Configuration NOT saved to file"
                ;;
        esac

    
        # 11. CONFIRM SETUP
        printf "${YELLOW}Confirm setup? (${GREEN}Y${YELLOW}/${RED}n${YELLOW}):${NC} "
        read -r  confirm
        case "$confirm" in
            y|Y|yes|YES|Yes|okidoki|OKIDOKI|Okidoki|OkiDoki)
                ;;
            *)
                log "Setup cancelled!"
                return 1
                ;;
        esac
    fi

    
    # 12. FINAL VALIDATIONS BEFORE APPLYING CONFIG HEADACHE
    # 12.1 IF IFACE DOESNOT!!!! EXIST
    if iface_collision "$iface_name"; then
        
        warning "$iface_name already exists!"
        
        debug_write "[SETUP] Attempt to overwrite for $iface_name"
        
        log "WG-AUTOCONF setup CANCELLED!"
        
        exit 0
    
    fi

    
    # 13. BACKUP CONFIGURATION FILES
    backup_config_file "$NETWORK_CONF"
    backup_config_file "$DHCP_CONF"
    backup_config_file "$FIREWALL_CONF"

    
    # 14. APPLY CONFIGURATIONS (NETWORK, DHCP, FIREWALL)
    debug_write "[SETUP] Calling setup_network_config with:"
    debug_write "  iface_name=$iface_name"
    debug_write "  private_key=$private_key"
    debug_write "  address=$address"
    debug_write "  public_key=$public_key"
    debug_write "  endpoint_host=$endpoint_host"
    debug_write "  endpoint_port=$endpoint_port"
    debug_write "  allowed_ips=$allowed_ips"
    debug_write "  dns=$dns"
    setup_network_config "$iface_name" "$private_key" "$address" \
                         "$public_key" "$endpoint_host" "$endpoint_port" \
                         "$allowed_ips" "$dns"
    
    setup_dhcp_config "$iface_name"
    setup_firewall_config "$iface_name" "$endpoint_port"

    
    # 15. COMMITS
    uci commit network
    uci commit dhcp
    uci commit firewall

    
    # 16. STATES MANAGEMENT
    local iface_id=$(state_add_iface "$iface_name")
    
    if [ $? -eq 0 ]; then
        
        state_write "ID_${iface_id}_IS_CREATED" "1"
        state_write "IS_FIRST_EXEC" "0"
        debug_write "[SETUP] State updated: ID_${iface_id}_IS_CREATED=1, IS_FIRST_EXEC=0"
    
    else
        
        warning "Failed to add interface to state file"
        debug_write "[SETUP STATES] ERROR! with state file!!!!"
    
    fi

    
    # 17. D0NE!
    verbose echo ""
    verbose success "D0ne!"
    echo ""
    ui_lines 65 "${GREEN}Your WireGuard Setup${NC}"
    echo -e "- ${BLUE}Interface:${NC}          ${YELLOW}$iface_name${NC}"
    echo -e "- ${BLUE}Local IP:${NC}           ${YELLOW}$address${NC}"
    echo -e "- ${BLUE}Endpoint:${NC}           ${YELLOW}${endpoint_host:-N/A}:${endpoint_port:-N/A}${NC}"
    echo -e "- ${BLUE}DNS:${NC}                ${YELLOW}${dns}${NC}"
    
    ui_lines 65 "${GREEN}FINISH SETUP${NC}"
    echo -e "${GREEN}1.${NC} ${BLUE}ENABLE WG:${NC}         ${YELLOW}wg-autoconf up ${GREEN}$iface_name${NC}"
    echo -e "${GREEN}2.${NC} ${BLUE}VERIFY:${NC}            ${YELLOW}wg-autoconf ${GREEN}$iface_name${NC}"
    echo -e "${GREEN}3.${NC} ${BLUE}TEST WG:${NC}           ${YELLOW}traceroute -i ${GREEN}$iface_name ${BLUE}openwrt.com${NC}"
    echo -e "${GREEN}4.${NC} ${BLUE}ROUTE IT:${NC}          ${YELLOW}wg-autoconf routes set ${GREEN}$iface_name <dst>${NC}"
    ui_lines 66
    
    return 0
}

#####################################################################
# WG-AUTOCONF SAVE WIREGUARD CONFIG FILE
#####################################################################
save_wireguard_conf() {

    local conf_filename="$1"
    local private_key="$2"
    local public_key="$3"
    local address="$4"
    local endpoint_host="$5"
    local endpoint_port="$6"
    local allowed_ips="$7"
    local dns="$8"


    # 1. VALIDATE DNS
    validate_config_value "DNS" "$dns" "manual"
    

    # 2. FORMAT VALUES FOR .CONF FILE

    # 2.1 Format DNS (comma-separated to space-separated)
    local dns_conf=$(get_conf_value "DNS" "" "conf" "$dns")
    
    # 2.2 Format endpoint (ensure proper IPv6 handling)
    local endpoint_formatted=$(parse_endpoint "${endpoint_host}:${endpoint_port}" "string")
    
    # 2.3 Format AllowedIPs (ensure comma-separated with spaces)
    local allowed_ips_conf=$(echo "$allowed_ips" | sed 's/[[:space:]]*,[[:space:]]*/, /g; s/^[[:space:]]*//; s/[[:space:]]*$//')


    # 3. CHECK IF FILE ALREADY EXISTS
    local conf_file="$WG_CONF_DIR/$conf_filename.conf"

    if [ -f "$conf_file" ]; then

        warning "Config file already exists: $conf_file"

        printf "${YELLOW}Overwrite? (${GREEN}y${YELLOW}/${RED}N${YELLOW}):${NC} "
        read -r confirm
        case "$confirm" in
            y|Y|yes|YES|Yes|okidoki|OKIDOKI|Okidoki|OkiDoki)
                ;;
            *) 
                log "Config NOT saved"; 
                return 1
                ;;
        esac
    fi


    # 4. GENERATE CONFIG FILE

    cat > "$conf_file" << EOF
[Interface]
PrivateKey = $private_key
Address = $address
DNS = $dns_conf

[Peer]
PublicKey = $public_key
AllowedIPs = $allowed_ips_conf
Endpoint = $endpoint_formatted
# PersistentKeepalive = 25
EOF


    # 5. FINAL OUTPUT
    success "Config saved to: $conf_file"
    verbose log "You can now use: wg-autoconf setup $conf_filename"
}



#####################################################################
# WG-AUTOCONF ACTIVATE_INTERFACE (UP)
#####################################################################
activate_interface() {

    local iface="$1"

    # 0) UNCONDITIONAL PRE-CHECKS
    [ -z "$iface" ] && error "Interface name required!"
    debug_write "[UP] Activating interface: $iface"

    uci get "network.$iface" >/dev/null 2>&1 || error "$iface DOES NOT exist in UCI"
    validate_iface_name "$iface"

    # 1. PRE-CHECKS
    state_init
    check_bins

    # 2. GET ID FROM STATE MACHINE
    local iface_id=$(state_get_id "$iface")
    if [ $? -ne 0 ]; then
        debug_write "[UP] Interface ID not found, adding to state"
        iface_id=$(state_add_iface "$iface") || iface_id=""
    fi

    # 3. VERIFY/CREATE INTERFACE
    verbose log "Enabling $iface..."
    debug_write "[UP] Checking if interface exists"

    if ! ip link show "$iface" >/dev/null 2>&1; then
        debug_write "[UP] Interface not found, creating it"
        ip link add dev "$iface" type wireguard || {
            error "Failed to create interface $iface"
        }
    fi

    # 4. FORCE LINK UP
    ip link set "$iface" up
    debug_write "[UP] Link set up"

    # 5. LOAD PRIVATE KEY FROM UCI
    local privkey=$(uci get network.$iface.private_key 2>/dev/null)
    if [ -n "$privkey" ]; then
        echo "$privkey" | wg set "$iface" private-key /dev/stdin
        debug_write "[UP] Private key configured"
    else
        warning "No private key found for $iface"
    fi

    # 6. LOAD PEERS FROM UCI
    local peer_count=0
    local peer_section="network.${iface}_peer"

    if uci get "$peer_section" >/dev/null 2>&1; then
        local pubkey=$(uci get "$peer_section.public_key" 2>/dev/null)
        local endpoint_host=$(uci get "$peer_section.endpoint_host" 2>/dev/null)
        local endpoint_port=$(uci get "$peer_section.endpoint_port" 2>/dev/null)
        local keepalive=$(uci get "$peer_section.persistent_keepalive" 2>/dev/null)
        local allowed_ips=$(get_uci_list "$peer_section" "allowed_ips")
        
        debug_write "[UP] AllowedIPs from UCI: '$allowed_ips'"
        
        if [ -n "$pubkey" ]; then
            wg set "$iface" peer "$pubkey" \
                ${allowed_ips:+allowed-ips "$allowed_ips"} \
                ${endpoint_host:+endpoint "${endpoint_host}:${endpoint_port:-51820}"} \
                ${keepalive:+persistent-keepalive "$keepalive"}
            peer_count=$((peer_count + 1))
            debug_write "[UP] Peer configured: $pubkey"
        fi
    fi

    if [ $peer_count -eq 0 ]; then
        warning "No peers configured for $iface"
    fi

    # 7. ASSIGN IP ADDRESS FROM UCI
    local address=$(uci get network.$iface.addresses 2>/dev/null)

    if [ -n "$address" ]; then
        local wg_ip=$(echo "$address" | cut -d/ -f1)

        # 7.1 ADD IP ADDRESS TO INTERFACE
        ip addr add "$address" dev "$iface" 2>/dev/null || {
            debug_write "[UP] IP address already assigned or invalid: $address"
        }

        # 7.2 CREATE DEDICATED ROUTING TABLE FOR THIS INTERFACE
        local table_name="${iface}"
        
        if ! grep -q "^[0-9]\+[[:space:]]\+$table_name$" /etc/iproute2/rt_tables 2>/dev/null; then
            local table_id=200
            while grep -q "^$table_id " /etc/iproute2/rt_tables 2>/dev/null && [ $table_id -lt 250 ]; do
                table_id=$((table_id + 1))
            done
            echo "$table_id $table_name" >> /etc/iproute2/rt_tables
            debug_write "[UP] Created routing table $table_name (ID: $table_id)"
        fi
        
        # 7.2.2 Add default route via this interface in the new table
        ip route add default dev "$iface" table "$table_name" 2>/dev/null
        debug_write "[UP] Added default route to table $table_name"
        
        # 7.2.3 Add rule for traffic FROM this IP (con prioridad dinámica)
        local table_id=$(grep "[[:space:]]${table_name}$" /etc/iproute2/rt_tables 2>/dev/null | awk '{print $1}')
        local prio_from=$((table_id * 10))
        local prio_to=$((table_id * 10 + 1))
        
        ip rule add from "$wg_ip" lookup "$table_name" priority $prio_from 2>/dev/null
        debug_write "[UP] Added ip rule for $wg_ip -> $table_name (priority $prio_from)"
        
        # 7.2.4 Add return rule for traffic TO this IP
        ip rule add to "$wg_ip" lookup "$table_name" priority $prio_to 2>/dev/null
        debug_write "[UP] Added return rule for $wg_ip (priority $prio_to)"
        
    else
        warning "No IP address configured for $iface"
    fi

    # 8. WAIT FOR INTERFACE TO BE OPERATIONAL
    local timeout=3
    local count=0
    while [ $count -lt $timeout ]; do
        if ip link show "$iface" >/dev/null 2>&1 && \
           ip addr show "$iface" 2>/dev/null | grep -q "inet "; then
            debug_write "[UP] Interface $iface is operational after ${count}s"
            break
        fi
        sleep 1
        count=$((count + 1))
    done

    # 9. RELOAD FIREWALL TO APPLY ZONE RULES
    if [ "$CAP_NFTABLES" = "1" ]; then
        
        debug_write "[UP] Reloading firewall to apply zone rules"
        /etc/init.d/firewall reload 2>/dev/null
        sleep 2
    
    fi

    # 10    NFT.D PRE-STRUCTURING
    debug_write "[UP] Creating NFT include files (workarounds) for $iface"

    mkdir -p "${NFT_INCLUDE_DIR}/chain-post/input" 2>/dev/null
    mkdir -p "${NFT_INCLUDE_DIR}/chain-post/output" 2>/dev/null
    mkdir -p "${NFT_INCLUDE_DIR}/chain-post/forward" 2>/dev/null
    mkdir -p "${NFT_SRCNAT_DIR}" 2>/dev/null
    
    # 10.1 INPUT JUMP
    local input_file="${NFT_INCLUDE_DIR}/chain-post/input/91-wg-${iface}-jump.nft"
    cat > "$input_file" <<EOF
# wg-autoconf: Input jump para $iface (workaround)
# wg-autoconf:Creado: $(date)
iifname "$iface" jump input_$iface
EOF
    debug_write "[UP] Created: $input_file"
    


    # 10.2 OUTPUT JUMP
    local output_file="${NFT_INCLUDE_DIR}/chain-post/output/91-wg-${iface}-jump.nft"
    cat > "$output_file" <<EOF
# wg-autoconf: Output jump para $iface (workaround)
# wg-autoconf:Creado: $(date)
oifname "$iface" jump output_$iface
EOF
    debug_write "[UP] Created: $output_file"
    


    # 10.3 ACCEPT RULES
    local accept_file="${NFT_INCLUDE_DIR}/chain-post/forward/91-wg-${iface}-accept.nft"
    cat > "$accept_file" <<EOF
# wg-autoconf: Accept rules para $iface (workaround)
# wg-autoconf:Creado: $(date)
iifname "$iface" accept
oifname "$iface" accept
EOF
    debug_write "[UP] Created: $accept_file"





    # 10.4 SRCNAT JUMP
    local srcnat_file="${NFT_SRCNAT_DIR}/91-wg-${iface}-jump.nft"
    cat > "$srcnat_file" <<EOF
# wg-autoconf: Srcnat jump para $iface (workaround)
# wg-autoconf:Creado: $(date)
meta oifname "$iface" jump srcnat_$iface
EOF
    debug_write "[UP] Created: $srcnat_file"
    


    # 10.5  COMMIT/RELOAD FOR NFTs
    debug_write "[UP] Reloading firewall to apply workaround includes"
    /etc/init.d/firewall reload 2>/dev/null
    # sleep 1



    # 11. VERIFY WITH WG SHOW 
    if [ "$CAP_WG" = "1" ]; then
        
        if wg show "$iface" >/dev/null 2>&1; then
            
            debug_write "[UP] WireGuard configuration verified"
            
            if [ "$VERBOSE" = "1" ]; then
                
                echo ""
                echo "$iface Info:"
                wg show "$iface"
            fi
        
        else
            
            warning "WireGuard configuration may be incomplete"
        
        fi
    fi

    
    # 12. UPDATE STATE
    if [ -n "$iface_id" ]; then
        
        if state_write "ID_${iface_id}_IS_ACTIVE" "1"; then
        
            debug_write "[UP] State updated: ID_${iface_id}_IS_ACTIVE=1"
        
        else
        
            debug_write "[UP WARNING] Failed to update state"
        
        fi
    fi

    # 13. D0NE
    success "Interface '$iface' enabled!"
    debug_write "[UP] Interface $iface successfully enabled"
    echo ""
    echo -e "${YELLOW}Now you can set up routes if needed!${NC}"
    
    return 0
}
#####################################################################
# WG-AUTOCONF DEACTIVATE_INTERFACE (DOWN)
#####################################################################
deactivate_interface() {

    local iface="$1"
    local force="${2:-no}"

    # 0) UNCONDITIONAL PRE-CHECKS
    # upgrade_avoid_garbage, moved to init

    [ -z "$iface" ] && error "Interface name required"
    debug_write "[DOWN] Deactivating interface: $iface"

    # 1. SKIP UCI CHECK IF FORCE MODE (NUKE)
    if [ "$force" != "force" ]; then
        uci get "network.$iface" >/dev/null 2>&1 || error "$iface DOES NOT exist"
    fi
    validate_iface_name "$iface"

    # 1. PRE-CHECKS
    state_init
    check_bins

    # 2. GET INTERFACE ID FROM STATE
    local iface_id=$(state_get_id "$iface")
    
    if [ $? -ne 0 ]; then
        debug_write "[DOWN] Interface ID not found in state for $iface"
        iface_id=""
    else
        debug_write "[DOWN] Found interface ID: $iface_id"
    fi

    log "Disabling $iface..."
    debug_write "[DOWN] Removing interface configuration"

    
    # 2.5 VERIFY IFACE NOT ROUTED (AUTO-RECOVERY)
    if [ -n "$iface_id" ]; then
        
        local is_routed=$(state_read "ID_${iface_id}_IS_ROUTED" 2>/dev/null)
        
        if [ "$is_routed" = "1" ]; then
            
            warning "Interface $iface is still ROUTED. Attempting to unset routes first..."
            
            # 2.5.1 IF ROUTED AUTORECOVERY -
            # DEBUG r7  find and clean all _vpn_ tables
            local vpn_tables=$(grep "_vpn_${iface}_" /etc/iproute2/rt_tables 2>/dev/null | awk '{print $2}')
            
            for table in $vpn_tables; do
                
                local lan_iface=$(echo "$table" | sed "s/^_vpn_${iface}_//")
                
                if [ -n "$lan_iface" ]; then
                
                    unset_lan_routes "$iface" "$lan_iface" >/dev/null 2>&1
                    debug_write "[DOWN] Auto-unset routes for $iface <-> $lan_iface"
                
                fi
            done
            
            warning "Routes auto-cleaned. Please in future use 'routes unset' first."
        fi
    fi

    # 3. REMOVE PEERS
    if [ "$CAP_WG" = "1" ]; then
        
        local peers=$(wg show "$iface" peers 2>/dev/null | tr '\n' ' ')
        
        if [ -n "$peers" ]; then
            
            wg set "$iface" peer $peers remove 2>/dev/null
            debug_write "[DOWN] Removed peers from $iface"
        
        else
        
            debug_write "[DOWN] No peers found for $iface"
        
        fi
    
    else
    
        debug_write "[DOWN] wg binary not available, skipping peer cleanup"
    
    fi



    # 4. DELETE INTERFACE FROM KERNEL
    if ip link show "$iface" >/dev/null 2>&1; then
        
        # 4.1 IP LINK DEL 
        ip link delete "$iface" 2>/dev/null
        
        if [ $? -eq 0 ]; then
            
            debug_write "[DOWN] Interface $iface deleted successfully"

            # 4.2 CLEANUP ROUTING TABLES AND RULES
            debug_write "[DOWN] Cleaning up routing tables and rules for $iface"
            
            # 4.2.1 Cleanup wg_* tables (created in activate_interface)
            local wg_tables=$(grep "[[:space:]]${iface}$" /etc/iproute2/rt_tables 2>/dev/null | awk '{print $2}')
            
            for table in $wg_tables; do
                
                debug_write "[DOWN] Cleaning up rules for wg table: $table"
                
                # 1 CLEAN RULES
                del_ip_rules_by_table "$table"
                
                # 2 DEL RULES (tabla)
                del_routing_table "$table"
                
                debug_write "[DOWN] Removed wg table and rules: $table"
            done

            # 4.2.2 CLEANUP _vpn_* TABLES
            local vpn_tables=$(grep "_vpn_${iface}_" /etc/iproute2/rt_tables 2>/dev/null | awk '{print $2}')
            
            for table in $vpn_tables; do
                
                debug_write "[DOWN] Cleaning up rules for vpn table: $table"
                
                # 1 CLEAN RULES
                del_ip_rules_by_table "$table"
                
                # 2 DEL RULES (tabla)
                del_routing_table "$table"
                
                debug_write "[DOWN] Removed vpn table and rules: $table"
            
            done

            # 4.2.3 GET WG IP - TRY UCI FIRST, THEN KERNEL (CRITICAL FOR NUKE)
            local wg_ip=""
            
            # 4.2.3.1 Try UCI first
            wg_ip=$(uci get "network.$iface.addresses" 2>/dev/null | cut -d/ -f1)
            
            # 4.2.3.2 If not in UCI but interface exists, get IP from kernel
            if [ -z "$wg_ip" ] && ip link show "$iface" >/dev/null 2>&1; then
                
                wg_ip=$(ip addr show "$iface" 2>/dev/null | grep inet | awk '{print $2}' | cut -d/ -f1 | head -1)
                
                if [ -n "$wg_ip" ]; then
                
                    debug_write "[DOWN] Got IP $wg_ip from kernel for $iface"
                
                else
                
                    debug_write "[DOWN] No IP found for $iface in kernel"
                
                fi
            fi
            
            # 4.2.4 EXTRA RULES/TABLES CLEANUP FOR ORPHANED / NUKE MODE
            if [ -n "$wg_ip" ]; then
                
                debug_write "[DOWN] Removing ip rules for IP $wg_ip"
                
                # 4.2.4.1 Remove "from $wg_ip" rules
                local from_rules=$(ip rule show | grep "from $wg_ip" | awk '{print $1}' | sed 's/://')
                
                for prio in $from_rules; do
                
                    ip rule del priority "$prio" 2>/dev/null
                
                    debug_write "[DOWN] Removed from rule priority $prio for $wg_ip"
                
                done
                
                # 4.2.4.2 Remove "to $wg_ip" rules
                local to_rules=$(ip rule show | grep "to $wg_ip" | awk '{print $1}' | sed 's/://')
                
                for prio in $to_rules; do
                
                    ip rule del priority "$prio" 2>/dev/null
                
                    debug_write "[DOWN] Removed to rule priority $prio for $wg_ip"
                
                done
            fi
            


            # 4.2.5 EXTRA CLEANUP ORPHANED RULES BY INTERFACE NAME
            debug_write "[DOWN] Cleaning up any remaining ip rules for $iface"
            
            local rules_to_clean=$(ip rule show | grep -E "lookup.*${iface}" | awk '{print $1}' | sed 's/://')
            
            for prio in $rules_to_clean; do
            
                ip rule del priority "$prio" 2>/dev/null
            
                debug_write "[DOWN] Removed ip rule priority $prio"
            
            done

            # 4.2.6 CLEAN NFT.D FILES 
            debug_write "[DOWN] Cleaning up NFT workaround include files for $iface"
            
            # 4.2.6.1   DEL input/output jumps
            find "${NFT_INCLUDE_DIR}/chain-post/input" -name "91-wg-${iface}-*.nft" -exec rm -f {} \; 2>/dev/null
            find "${NFT_INCLUDE_DIR}/chain-post/output" -name "91-wg-${iface}-*.nft" -exec rm -f {} \; 2>/dev/null
            
            # 4.2.6.2   DEL accept rules
            find "${NFT_INCLUDE_DIR}/chain-post/forward" -name "91-wg-${iface}-*.nft" -exec rm -f {} \; 2>/dev/null
            
            # 4.2.6.3   del srcnat jumps
            find "${NFT_SRCNAT_DIR}" -name "91-wg-${iface}-*.nft" -exec rm -f {} \; 2>/dev/null
            
            debug_write "[DOWN] NFT workaround include files cleaned up"

            # # 4.2.7 NFTABLES CLEANUP REMOVED
            # debug_write "[DOWN] Skipping manual NFT cleanup (fw4 will regenerate from UCI)"

        # 4.3 IFDOWN FALLBACK
        # DEBUG r7, SESSION 16
        # TODO: Is an ifdown fallback really needed? If so EVERYTHING (rules, nft,etc) would need to be replicated!!!
        else
            
            debug_write "[DOWN WARNING] Failed to delete interface $iface"
            
            # 4.3.1 Try ifdown first (legacy)
            ifdown "$iface" >/dev/null 2>&1
            debug_write "[DOWN] Fallback: ifdown $iface executed"
            
            # 4.3.2 If interface still exists, force remove with ip link
            if ip link show "$iface" >/dev/null 2>&1; then
                
                debug_write "[DOWN] ifdown failed, trying force delete again"
                
                ip link delete "$iface" 2>/dev/null
                
                
                if [ $? -eq 0 ]; then
                    
                    debug_write "[DOWN] Interface $iface deleted successfully on second attempt"
                
                else
                    
                    debug_write "[DOWN CRITICAL] Cannot delete interface $iface"
                fi
            fi
        fi

    else
        debug_write "[DOWN] Interface $iface does not exist in kernel"
    fi

    # 5. UPDATE STATE
    if [ -n "$iface_id" ]; then
        
        if state_write "ID_${iface_id}_IS_ACTIVE" "0"; then
            
            debug_write "[DOWN] State updated: ID_${iface_id}_IS_ACTIVE=0"
        
        else
        
            warning "Failed to update state for $iface"
        
            debug_write "[DOWN WARNING] state_write failed for ID_${iface_id}_IS_ACTIVE"
        
        fi
    fi

    
    
    # 6. RELOAD FIREWALL TO APPLY CHANGES
    debug_write "[DOWN] Reloading firewall to apply interface removal"
    /etc/init.d/firewall reload 2>/dev/null
    sleep 2

    
    # 7. VERIFY INTERFACE IS GONE
    if ! ip link show "$iface" >/dev/null 2>&1; then
        
        success "$iface disabled and removed!"
        debug_write "[DOWN] Interface $iface successfully disabled"
    
    else
        
        warning "$iface may still exist"
        
        debug_write "[DOWN WARNING] Interface $iface still exists after removal"
        
        ip link show "$iface" | while read line; do
        
            debug_write "[DOWN] $line"
        
        done
    fi
    
    return 0
}


#####################################################################
# WG-AUTOCONF REMOVE_WIREGUARD
#####################################################################
remove_wireguard() {

    local iface="$1"
    local silent="${2:-no}"

    # 0) UNCONDITIONAL PRE-CHECKS
    # upgrade_avoid_garbage, moved to init
    debug_write "[REMOVE] Starting removal of $iface"
    validate_iface_name "$iface"
    

    # 1. CHECK IF INTERFACE EXISTS IN UCI
    if ! uci get "network.$iface" >/dev/null 2>&1; then
        
        debug_write "[REMOVE] Interface $iface not found in UCI"
        
        # 1.1 CLEAN STATES EVEN IF IFACE DOES NOT EXIST
        state_init
        
        local iface_id=$(state_get_id "$iface")
        
        if [ -n "$iface_id" ]; then
            state_remove_iface "$iface_id"
            debug_write "[REMOVE] Cleaned state for non-existent interface: $iface"
        fi
        
        [ "$silent" != "silent" ] && success "$iface removed (was not in UCI)"
        return 0
    fi
    

    # 2. PRE-CHECKS
    [ "$silent" != "silent" ] && verbose log "Removing $iface..."
    state_init
    check_bins

    # 3. GET INTERFACE ID FROM STATE
    local iface_id=$(state_get_id "$iface")
    
    if [ $? -ne 0 ]; then
        debug_write "[REMOVE] Interface ID not found in state for $iface"
        debug_write "    Tampered bin?? Bad uninstallation? CLEAN ALL WITH NUKE!"
        
        if [ "$silent" != "silent" ]; then
            verbose error "Interface $iface NOT found in state configuration"
            verbose warning "Post-operation manual checks are required upon completion:"
            verbose warning "  - You might make a full cleanup with ${YELLOW}wg-autoconf nuke${NC}"
        fi
        iface_id=""
    fi

    # 4. DEACTIVATE INTERFACE (DOWN + DELETE via DEACTIVATE_IFACE HELPER)
    debug_write "[REMOVE] Deactivating interface: $iface"
    deactivate_interface "$iface" >/dev/null 2>&1
    debug_write "[REMOVE] Interface deactivated"


    # 7. DETERMINE IF BACKUPS SHOULD BE RESTORED
    local should_restore_backups=0
    local remaining_ifaces=$(get_all_wg_interfaces)
    local remaining_count=0
    
    for remaining_iface in $remaining_ifaces; do
        if [ "$remaining_iface" != "$iface" ]; then
            remaining_count=$((remaining_count + 1))
        fi
    done
    
    debug_write "[REMOVE] Remaining WireGuard interfaces after removal: $remaining_count"
    
    if [ "$remaining_count" -eq 0 ] || [ "$silent" = "silent" ]; then
        should_restore_backups=1
        debug_write "[REMOVE] Will restore backups (last interface or nuke mode)"
    else
        debug_write "[REMOVE] NOT restoring backups ($remaining_count other interfaces exist)"
    fi

    # 5. REMOVE CONFIGURATION TAGS (NETWORK, DHCP, FIREWALL)
    debug_write "[REMOVE] Finding and removing configuration tags"
    
    # 5.1 NETWORK TAGS
    local net_line=$(grep -n "config interface '$iface'" "$NETWORK_CONF" 2>/dev/null | cut -d: -f1)
    
    if [ -n "$net_line" ]; then
        local network_tag_id=$(sed -n "1,${net_line}p" "$NETWORK_CONF" | grep "# wg-autoconf network start id" | tail -1 | sed 's/.*id //g')
        
        if [ -n "$network_tag_id" ]; then
            debug_write "[REMOVE] Found network tag id: $network_tag_id"
            remove_tagged_block "$NETWORK_CONF" "network" "$network_tag_id"
        fi
    fi
    

    # 5.2 DHCP TAGS
    local dhcp_line=$(grep -n "config dhcp '$iface'" "$DHCP_CONF" 2>/dev/null | cut -d: -f1)
    
    if [ -n "$dhcp_line" ]; then
        local dhcp_tag_id=$(sed -n "1,${dhcp_line}p" "$DHCP_CONF" | grep "# wg-autoconf dhcp start id" | tail -1 | sed 's/.*id //g')
        
        if [ -n "$dhcp_tag_id" ]; then
            debug_write "[REMOVE] Found DHCP tag id: $dhcp_tag_id"
            remove_tagged_block "$DHCP_CONF" "dhcp" "$dhcp_tag_id"
        fi
    fi
    

    # 5.3 FIREWALL TAGS
    local fw_line=$(grep -n "option name '$iface'" "$FIREWALL_CONF" 2>/dev/null | head -1 | cut -d: -f1)
    
    if [ -n "$fw_line" ]; then
        local firewall_tag_id=$(sed -n "1,${fw_line}p" "$FIREWALL_CONF" | grep "# wg-autoconf firewall start id" | tail -1 | sed 's/.*id //g')
        
        if [ -n "$firewall_tag_id" ]; then
            debug_write "[REMOVE] Found firewall tag id: $firewall_tag_id"
            remove_tagged_block "$FIREWALL_CONF" "firewall" "$firewall_tag_id"
        fi
    fi

    # 6. CLEANUP ROUTING TABLES (if any)
    debug_write "[REMOVE] Cleaning up routing tables for $iface"
    
    local route_tables=$(grep "_vpn_${iface}_" /etc/iproute2/rt_tables 2>/dev/null | awk '{print $2}')
    for table in $route_tables; do
        debug_write "[REMOVE] Removing routing table: $table"
        del_routing_table "$table"
        del_ip_rules_by_table "$table"
    done



    # 8. RESTORE BACKUPS
    local restore_result=0
    local restore_silent=""
    
    [ "$silent" = "silent" ] && restore_silent="silent"
    
    if [ "$should_restore_backups" -eq 1 ]; then
        debug_write "[REMOVE] Restoring backups..."
        
        if restore_backups "" "$restore_silent"; then
            debug_write "[REMOVE] Backups restored successfully"
            [ "$silent" != "silent" ] && verbose success "Configuration files restored from backup"
            restore_result=1
        else
            debug_write "[REMOVE WARNING] Backup restoration had issues"
            if [ "$silent" != "silent" ]; then
                warning "No valid backups found or restoration had issues"
            fi
            restore_result=0
        fi
    else
        debug_write "[REMOVE] Skipping backup restoration (other interfaces exist)"
        cleanup_backup_files ""
    fi

    # 9. COMMITS -> UCI & RELOADS
    debug_write "[REMOVE] Committing UCI changes"
    verbose log "Applying changes..."

    uci commit network 2>/dev/null && debug_write "[REMOVE] network committed"
    uci commit dhcp 2>/dev/null && debug_write "[REMOVE] dhcp committed"
    uci commit firewall 2>/dev/null && debug_write "[REMOVE] firewall committed"
    
    /etc/init.d/network reload 2>/dev/null && debug_write "[REMOVE] network reloaded"
    /etc/init.d/firewall reload 2>/dev/null && debug_write "[REMOVE] firewall reloaded"

    # 10. CLEANUP BACKUP FILES (IF RESTORED)
    if [ $restore_result -eq 1 ]; then
        debug_write "[REMOVE] Cleaning up restored backup files"
        
        local removed_backups=0
        local kept_backups=0
        
        for config_file in $BACKUP_PATHS; do
            local backup_file="${config_file}.BACKUP_PRE_WIREGUARD"
            
            [ ! -f "$backup_file" ] && continue
            
            if validate_backup "$backup_file" 2>/dev/null; then
                if rm -f "$backup_file" 2>/dev/null; then
                    removed_backups=$((removed_backups + 1))
                    debug_write "[REMOVE] Removed valid backup: $(basename "$backup_file")"
                else
                    debug_write "[REMOVE WARNING] Failed to remove backup: $(basename "$backup_file")"
                    kept_backups=$((kept_backups + 1))
                fi
            else
                debug_write "[REMOVE] Keeping corrupted backup for diagnosis: $(basename "$backup_file")"
                kept_backups=$((kept_backups + 1))
            fi
        done
        
        debug_write "[REMOVE] Backup cleanup: removed=$removed_backups, kept=$kept_backups"
    fi

    # 11. FINAL NFT CLEANUP (BUT! only if chains remain)
    if [ "$CAP_NFTABLES" = "1" ]; then
        
        # DEBUG! Safety cleanup ... should not be needed if deactivate_interface worked???
        local orphan_chains=""
        
        for chain in input_${iface} output_${iface} forward_${iface} \
                    accept_from_${iface} accept_to_${iface} srcnat_${iface}; do
        
            if nft list chain inet fw4 "$chain" >/dev/null 2>&1; then
        
                orphan_chains="$orphan_chains $chain"
        
            fi
        
        done
        
        if [ -n "$orphan_chains" ]; then
        
            debug_write "[REMOVE] Warning: Found orphaned NFT chains after deactivation: $orphan_chains"
        
            for chain in $orphan_chains; do
        
                nft delete chain inet fw4 "$chain" 2>/dev/null
                debug_write "[REMOVE] Removed orphaned NFT chain: $chain"
        
            done
        
        else
        
            debug_write "[REMOVE] No orphaned NFT chains found"
        
        fi
    fi



    # 12. REMOVE INTERFACE FROM STATE
    if [ -n "$iface_id" ]; then
        
        debug_write "[REMOVE] Removing interface from state: ID_$iface_id"
        
        if state_remove_iface "$iface_id"; then
        
            debug_write "[REMOVE] State updated successfully"
        
        else
        
            debug_write "[REMOVE WARNING] Failed to update state for ID_$iface_id"
            
            if [ "$silent" != "silent" ]; then
        
                echo -e "${RED}[ERROR]${NC} wg-autoconf state malfunction"
        
                warning "Post-operation manual checks are required"
                warning "  - Run ${YELLOW}wg-autoconf nuke${NC} for full cleanup"
            fi
        fi
    fi

    # 13. D0NE!
    debug_write "[REMOVE] Completed: restore_result=$restore_result, remaining_ifaces=$remaining_count"
    
    if [ "$silent" != "silent" ]; then
        
        verbose success "$iface removed successfully!"
        
        if [ "$should_restore_backups" -eq 1 ] && [ $restore_result -eq 1 ]; then
        
            verbose echo -e "${GREEN}Configuration restored from backups${NC}"
        
        elif [ "$should_restore_backups" -eq 0 ]; then
        
            log "${YELLOW}Backups preserved (other interfaces exist)${NC}"
        
        fi
    fi
    
    return 0
}

