VERSION="v1.0.0-r1"

STATE_FILE="/usr/libexec/wg-autoconf/states"
STATE_DIR="/usr/libexec/wg-autoconf"
WG_CONF_DIR="/etc/wireguard"
NETWORK_CONF="/etc/config/network"
DHCP_CONF="/etc/config/dhcp"
FIREWALL_CONF="/etc/config/firewall"
BACKUP_PATHS="$NETWORK_CONF $DHCP_CONF $FIREWALL_CONF"
ATOMIC_PATHS="/usr/libexec/wg-autoconf/atomics"
DEBUG_PATH="/usr/libexec/wg-autoconf/debug"
DEBUG_LOG="$DEBUG_PATH/wg-autoconf.log"
DEBUG_LOG_MAX_SIZE=512
DEBUG_IS_ACTIVE=0
ADVANCED_MODE=0
CONF_NAME=""
VERBOSE=0
USER_SETTINGS_FILE="/usr/libexec/wg-autoconf/user_settings"
DEFAULT_DNS="1.1.1.1, 1.0.0.1"
DEFAULT_PORT=51820
DEFAULT_ALLOW_IPS="0.0.0.0/0"
DEFAULT_COLOURS=1
DEFAULT_TABLES="/etc/iproute2/rt_tables"



#####################################################################
# ██╗   ██╗  ███████╗  ███████╗  ██████╗ 
# ██║   ██║  ██╔════╝  ██╔════╝  ██╔══██╗
# ██║   ██║  ███████╗  █████╗    ██████╔╝
# ██║   ██║  ╚════██║  ██╔══╝    ██╔══██╗
# ╚██████╔╝  ███████║  ███████╗  ██║  ██║
#  ╚═════╝   ╚══════╝  ╚══════╝  ╚═╝  ╚═╝
#####################################################################
create_default_user_settings() {

    local settings_dir=$(dirname "$USER_SETTINGS_FILE")
    mkdir -p "$settings_dir" 2>/dev/null
    
    {
        echo "# wg-autoconf $VERSION User Settings"
        echo "# This file overrides built-in defaults."
        echo "# Use: wg-autoconf settings set <key> <value>"
        echo "# Or edit manually and reload with: wg-autoconf settings edit"
        echo 'DEFAULT_DNS="1.1.1.1, 1.0.0.1"'
        echo 'DEFAULT_PORT="51820"'
        echo 'DEFAULT_ALLOW_IPS="0.0.0.0/0"'
        echo 'DEFAULT_COLOURS="1"'
    } > "$USER_SETTINGS_FILE"
    
    chmod 644 "$USER_SETTINGS_FILE" 2>/dev/null
}

show_user_settings() {

    if [ -f "$USER_SETTINGS_FILE" ]; then
        
        cat "$USER_SETTINGS_FILE"
    
    else
        
        warning "No user settings file found. Creating default..."
        create_default_user_settings
        cat "$USER_SETTINGS_FILE"
    fi

}

set_user_setting() {

    local key="$1"
    local value="$2"
    
    #   1. SETS
    # DEBUG!    Future usage by DECONSTUCTING A VAR WITH ALL KEYS
    case "$key" in
        dns|DNS) 
            key="DEFAULT_DNS"
            ;;
        port|PORT)
            key="DEFAULT_PORT"
            ;;
        allowed|allowedips|ALLOWED|ALLOWEDIPS)
            key="DEFAULT_ALLOW_IPS"
            ;;
        colours|colors|colour|color|COLORS|COLOURS|COLOR|COLORS)
            key="DEFAULT_COLOURS"
            ;;
        *) key="DEFAULT_${key^^}"
        ;;
    esac
    
    # 2.    VALIDATIONS
    case "$key" in
        DEFAULT_DNS) 
            validate_wg_config "manual" "" "DNS" "$value" || return 1 
            ;;
        DEFAULT_PORT) 
            if ! echo "$value" | grep -qE '^[0-9]+$' || [ "$value" -lt 1 ] || [ "$value" -gt 65535 ]; then
                
                error "Invalid port: $value"
            fi
            ;;
        DEFAULT_ALLOW_IPS)
            validate_wg_config "manual" "" "AllowedIPs" "$value" || return 1
            ;;
        DEFAULT_COLOURS)
            case "$(echo "$value" | tr '[:upper:]' '[:lower:]')" in
                0|off|no|false|disable|OFF|NO|FALSE|DISABLE)
                    value="0"
                    ;;
                1|on|yes|true|enable|ON|YES|TRUE|ENABLE)
                    value="1"
                    ;;
                *)
                    error "Invalid colours value: '${YELLOW}$value${NC}' (use: 0/1, on/off, yes/no, true/false, enable/disable)"
                    ;;
            esac
            ;;
        *)
            error "Unknown setting: ${YELLOW}'$key'${NC}. Check available user settings: ${YELLOW}wg-autoconf settings ${GREEN}show${NC}" 
            ;;
    esac
    
    
    # 3. SAVE
    [ ! -f "$USER_SETTINGS_FILE" ] && create_default_user_settings
    
    if grep -q "^$key=" "$USER_SETTINGS_FILE"; then
        
        sed -i "s/^$key=.*/$key=\"$value\"/" "$USER_SETTINGS_FILE"
    
    else
        
        echo "$key=\"$value\"" >> "$USER_SETTINGS_FILE"
    
    fi
    
    # 4. RELOAD
    # DEBUG! r7
    # Eval usage .... 
    # TODO: Tests with source
    eval "$key=\"$value\""
    success "Setting updated: ${YELLOW}${key#DEFAULT_} ${NC} = ${GREEN}$value${NC}"

}


load_user_settings() {


    # 1. LOAD
    [ ! -f "$USER_SETTINGS_FILE" ] && create_default_user_settings
    
    while IFS='=' read -r key value 2>/dev/null; do
        
        # 1.1 KEY-VALUE PARSERS
        key=$(echo "$key" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
        value=$(echo "$value" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
        
        # 1.2   BACKTIPS PARSER
        value=$(echo "$value" | sed 's/^"//;s/"$//;s/^'"'"'//;s/'"'"'$//')
        
        # 1.3 BY CASE
        case "$key" in
            DEFAULT_DNS)
                DEFAULT_DNS="$value"
                ;;
            DEFAULT_PORT)
                DEFAULT_PORT="$value"
                ;;
            DEFAULT_ALLOW_IPS)
                DEFAULT_ALLOW_IPS="$value"
                ;;
            DEFAULT_COLOURS)
                DEFAULT_COLOURS="$value"
                ;;
        esac
    done < "$USER_SETTINGS_FILE"
}


