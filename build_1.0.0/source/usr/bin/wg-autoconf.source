# DEBUG! rel5
# TODO:     Test colours/escapes in older devices, different shells, etc
# REASON:  Different ASNI colour interpretation for older shells
# POSSIBLE FIX?: Remove colours ... or try tput in openwrt or ... idk

if [ "$DEFAULT_COLOURS" = "1" ]; then
    RED='\033[1;31m'
    GREEN='\033[0;32m'
    YELLOW='\033[1;33m'
    BLUE='\033[0;34m'
    NC='\033[0m'
else
    RED=''
    GREEN=''
    YELLOW=''
    BLUE=''
    NC=''
fi

log() { echo -e "${BLUE}[wg-autoconf]${NC} $1" >&2; }
error() { echo -e "${RED}[ERROR]${NC} $1" >&2; exit 1; }
success() { echo -e "${GREEN}[OK]${NC} $1" >&2; }
warning() { echo -e "${YELLOW}[WARNING]${NC} $1" >&2; }

ui_lines() {

    length="$1"
    shift

    if [ -z "$1" ]; then
        printf '%*s\n' "$length" '' | tr ' ' '='
        return
    fi

    coloured_title="$*"



    # DEBUG! rel5
    # DONE: printf works perfectly on oldest bb-ash shells, printf as standarised
    # REASON:
    #   The '%b' format is a bash/ksh extension, not POSIX
    #   Older ash versions may prints literal "b" !
    #
    # POSSIBLE FIX?: echo -e or strip colors before length calculation using sed only
    # 
    clean_length=$(printf '%b' "$coloured_title" | sed 's/\x1b\[[0-9;]*m//g' | awk '{print length($0)}')

    base_length=$((clean_length + 5))
    padding=$((length - base_length))

    printf '==[ '
    printf '%b' "$coloured_title"
    printf ' ]'
    [ "$padding" -gt 0 ] && printf '%*s' "$padding" '' | tr ' ' '='
    printf '\n'
}



#####################################################################
# HANDLER -> RT_TABLES SAFETY
#####################################################################
rt_tables_health() {

    if [ ! -f "$DEFAULT_TABLES" ] || ! grep -q "local" "$DEFAULT_TABLES"; then
        
        # DEBUG! 
        debug_write "[ROUTE TABLES SAFETY] RT_TABLES file NOT FOUND! Trying a restoration. Please Check 'ip', reboot, perform a cleanup!"

        warning "Routing tables file not found, attempting to create..."
        warning "This is trully BIZARRE, please, pay attention:"
        echo -e "   Your ${RED}/etc/iproute2/rt_tables${NC} is MISSING, and this SHOULD NOT be happening!"
        echo -e "   To be safe, at this point, a new fully-compatible rt_tables file is being created"
        echo -e "   Even this will work well, you may prefer to check your configs. and/or reboot the device"
        echo ""
        verbose log "The 'rt_tables' file is used by default by a ${YELLOW}CORE${NC} dependency included as standard in ALL OpenWRT builds (the 'ip' package)."        
        verbose echo -e "   This is highly unusual for this file to be missing. 'wg-autoconf' has encountered this issue and, while it didn't cause the problem, ${GREEN}this issue can be fixed${NC}."        
        verbose echo -e "   ${YELLOW}HOWEVER, just because it can be fixed temporarily doesn't mean the error won't happen again${NC}; it is up to you to find out what has happened with 'ip'/'rt_tables'"

        
        
        mkdir -p /etc/iproute2 2>/dev/null

        if {
            echo "# rt_tables file restored by"
            echo "#   wg-autoconf $VERSION "
            echo "# Check your 'ip' package issues!"
            echo "#"
            echo "# reserved values"
            echo "#"
            echo "128     prelocal"
            echo "255     local"
            echo "254     main"
            echo "253     default"
            echo "0       unspec"
            echo "#"
            echo "# local"
            echo "#"
            echo "#1      inr.ruhep"
        } > /etc/iproute2/rt_tables 2>/dev/null; then

            debug_write "[ROUTE TABLES SAFETY] rt_tables RESTORED OK! "
            echo ""
            success " Route Tables succesfully restored! "
            echo ""
            
            return 0

        else

            debug_write "[ROUTE TABLES SAFETY] ERROR restoring rt_tables! This is an IMPOSSIBLE error. Check filesystem corruption! Check /overlay corruption! REWRITE A NEW RT_TABLE FILE at $DEFAULT_TABLES !!! "

            echo ""
            warning "${RED}Route Tables couldn't be restored!${NC}"
            echo ""

            return 1
        
        fi

    else

        return 0
    
    fi

}
#####################################################################
# HANDLER -> DNS LEAKAGE NOTICE
#####################################################################
#####################################################################
# DNS LEAKAGE WARNING HELPER
#
# Advierte al usuario sobre posibles problemas con DNS configuradas.
# Se llama cuando la DNS es idéntica a la Local Address (sin CIDR).
#
# Parámetros:
#   $1: DNS servers (comma-separated)
#   $2: Local Address (con CIDR, e.g., 10.0.0.2/32)
#   $3: Contexto ("setup" o "manual")
#
# Casos de advertencia:
#   1. DNS = Local Address (sin CIDR) - posible DNS del proveedor
#   2. DNS insegura/desconocida
#   3. Sugerir alternativas
#
# Solo muestra advertencias, NO modifica configuración.
#####################################################################
dns_leakage() {

    local dns_servers="$1"
    local local_address="$2"
    local context="$3"
    
    # 1. GET VARS FOM CONF
    local local_ip=$(echo "$local_address" | cut -d/ -f1)
    
    # 1.1 SAVE IN ATOMICS
    local temp_file="${ATOMIC_PATHS}/dns_leakage_$$.tmp"
    
    # 1.2   SET DIFFERENT MODES
    local dns_list=""
    local has_local_ip_dns=0
    local has_tunnel_range_dns=0
    
    # 1.3   SET DIFFERENT LINES
    local temp_dns="$dns_servers,"
    
    # 1.4.    EXTRACT EACH LINE
    while [ -n "$temp_dns" ]; do
        
        # 1.4.1     FIST LINE
        dns_entry="${temp_dns%%,*}"
        dns_entry=$(echo "$dns_entry" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
        
        if [ -n "$dns_entry" ]; then

            # 1.4.1.2   FRIST LINE, ADD TO LIST
            if [ -z "$dns_list" ]; then
                
                dns_list="$dns_entry"
            
            
            # 1.4.1.3   MORE LINES? ADD TO LIST
            else
                
                dns_list="$dns_list, $dns_entry"
            
            fi
            
            
            
            # 1.5.1     CASE 1 ->  DNS = has_local_ip_dns
            [ "$dns_entry" = "$local_ip" ] && has_local_ip_dns=1
            
            # 1.5.2     CASE 2 ->  DNS = has_tunnel_range_dns
            if echo "$dns_entry" | grep -qE '^(10\.|172\.(1[6-9]|2[0-9]|3[0-1])\.|192\.168\.)' || \
               
                echo "$dns_entry" | grep -qE '^[fF][dD][0-9a-fA-F]{2}:' ; then
                    
                    has_tunnel_range_dns=1
            
            fi
        fi
        
        # 1.6   DELETE TMP
        temp_dns="${temp_dns#*,}"
    
    done
    
    
    # 1.7   NO DNS ENTRY? exit/return 0
    if [ -z "$dns_list" ]; then

        warning "   NO DNS FOUND IN YOUR SETUP!"
        return 0

    fi

    # 2. SHOWCASE
    warning "   ${YELLOW}DNS Security Note${NC} about '$dns_list' (re-setup with ${BLUE}--verbose${NC})"

    verbose echo ""
    verbose ui_lines 49 "${YELLOW}DNS LEAKAGE WARNING${NC}"
    verbose echo ""
    verbose echo -e "   ${GREEN}This is a common issue for any WireGuard users & almost any WireGuard providers!${NC}"
    verbose echo ""
    


    # 2.1 CASE 1 ->  DNS = has_local_ip_dns
    if [ $has_local_ip_dns -eq 1 ]; then

        verbose echo -e "   ${RED}  POTENTIAL DNS LEAK DETECTED${NC}"
        verbose echo ""
        verbose echo "   You're using your local VPN IP '($local_ip)' as DNS server."
        verbose echo ""
        verbose echo -e "   ${YELLOW}Possible issues:${NC}"
        verbose echo "     1. Provider DNS may be blocked"
        verbose echo "     2. Provider DNS may log/block your queries"
        verbose echo "     2. DNS queries may NOT be encrypted through tunnel"
        verbose echo "     3. If VPN disconnects, DNS may leak to your ISP"
    
    # 2.2   CASE 2 ->  DNS = has_tunnel_range_dns
    elif [ $has_tunnel_range_dns -eq 1 ]; then
        
        verbose echo -e "   ${YELLOW}  POTENTIAL DNS IN TUNNEL RANGE DETECTED${NC}"
        verbose echo ""
        verbose echo "   You're using a DNS server in a private/tunnel IP range ('$dns_list')"
        verbose echo ""
        verbose echo "   This typically means:"
        verbose echo "     - The VPN provider runs their own DNS resolver"
        verbose echo "     - OR you intentionally set it this way"
        verbose echo ""
        verbose echo -e "   ${YELLOW}Possible issues:${NC}"
        verbose echo "     1. Provider might not have set a DNS via tunnel (DNS Fails)"
        verbose echo "     2. Provider DNS may log/block your queries"
        verbose echo "     3. DNS queries may NOT be encrypted through tunnel"
        verbose echo "     4. If VPN disconnects, DNS may leak to your ISP"
    
    # 2.3   CASE *) ANY OTHER DNS VALUE
    else
        
        verbose echo -e "      ${YELLOW}Your actual DNS config:${NC}"
        verbose echo "$dns_servers" | tr ',' '\n' | while IFS= read -r dns_entry; do
            
            dns_entry=$(echo "$dns_entry" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
            
            [ -z "$dns_entry" ] && continue
            
            verbose echo "         - $dns_entry"
        
        done


    fi
    
    # 2.4 COMMON VERBOSES
    verbose echo ""
    verbose echo -e "   ${YELLOW}Assuming you know what you're doing...${NC}"
    verbose echo -e "      ${GREEN}Recommendations:${NC}"
    verbose echo "        a) Use a trusted public DNS (1.1.1.1, 9.9.9.9). They WILL BE ALWAYS TUNNELED!"
    verbose echo "        b) Run your own local DNS resolver (dnscrypt, unbound), and set it here NOW"
    verbose echo "        c) Proceed using default DNS values from the .conf provider if you trust them"
    verbose echo ""
    
    
    # 2.5   CONTEXT CASES
    # if [ "$context" = "manual" ]; then
        
    #     verbose echo -e "${BLUE}In manual mode, you can change DNS manualy! (Sorry for stating the obvious)${NC}"
    #     verbose echo ""
    
    # else
        
    #     verbose echo -e "${BLUE}In auto mode, you must edit .conf file, o retake in manual mode.${NC}"
    #     verbose ""
    
    # fi
    
    verbose ui_lines 50
    verbose echo ""
}



#####################################################################
# HANDLER -> GET FROM CONF FILES, VALIDATE THE CONF FILES, VALIDATE WG MANUIAL
#####################################################################

get_conf_value() {

    local key="$1"
    local file="$2"
    local format="${3:-raw}"
    local direct_value="$4"
    
    local raw_value=""
    
    if [ -n "$direct_value" ]; then
        
        raw_value="$direct_value"
    
    elif [ -f "$file" ]; then
        
        raw_value=$(grep "^$key[ \t]*=" "$file" 2>/dev/null | head -1 | cut -d= -f2- | sed 's/^[ \t]*//;s/[ \t]*$//')
    
    else
        raw_value=""
    fi
    
    if [ -z "$raw_value" ]; then
        echo ""
        return 0
    fi
    
    case "$format" in
        
        raw)
            echo "$raw_value"
            ;;
        uci)
            echo "$raw_value" | tr ',' ' ' | sed 's/\s\+/ /g' | sed 's/^ //;s/ $//'
            ;;
        conf)
            echo "$raw_value" | tr ' ' ',' | sed 's/,/, /g' | sed 's/, ,/,/g' | sed 's/^, //;s/, $//'
            ;;
        *)
            echo "$raw_value"
            ;;
    esac
}

validate_config_value() {

    local key="$1"
    local value="$2"
    local context="${3:-setup}"
    
    case "$key" in
        DNS)
            validate_wg_config "$context" "" "DNS" "$value"
            ;;
        AllowedIPs)
            validate_wg_config "$context" "" "AllowedIPs" "$value"
            ;;
        Endpoint)
            validate_wg_config "$context" "" "Endpoint" "$value"
            ;;
        PrivateKey|PublicKey)
            validate_wg_config "$context" "" "$key" "$value"
            ;;
        Address)
            validate_wg_config "$context" "" "Address" "$value"
            ;;
        *)
            [ -z "$value" ] && error "Value for $key cannot be empty"
            ;;
    esac
    
    return 0
}

# CASES FIELD VALIDATIONS
#
# 1.    DNS
# 2.    ALLOWED IPS
# 3.    ENDPOINT
# 4.    KEYS (PRIV/PUB)
# 5.    LOCAL ADDRESS
# 6.    IFACE NAME
validate_wg_config() {

    local config_type="$1"
    local config_file="$2"
    local field="$3"
    local value="$4"
    local test_mode="${5:-0}"
    
    debug_write "[VALIDATE] Validating $field: '$value' (test_mode=$test_mode)"

    _validate_error() {

        local msg="$1"

        if [ "$test_mode" = "1" ]; then

            # DEBUG! r7
            #   Room for custom fields-messages for test_configurations()
            #   And ... this is my first nested func using ash xD
            warning "VALIDATION ERROR!: $msg" >&2
            return 1
        
        else

            error "$msg"

        fi 

    }
    
    case "$field" in




        DNS)

            if [ -z "$value" ]; then
                
                debug_write "[VALIDATE] DNS empty, will use defaults ($DEFAULT_DNS)"
                return 0
            
            fi
            
            local error_msg=""
            local actual_count=0
            
            error_msg=$(echo "$value" | tr ',' '\n' | while IFS= read -r entry; do
                
                entry=$(echo "$entry" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
                
                [ -z "$entry" ] && continue
                
                if echo "$entry" | grep -qE '^([0-9]{1,3}\.){3}[0-9]{1,3}$'; then
                    
                    local IFS='.'
                    
                    set -- $entry
                    
                    if [ "$1" -ge 0 -a "$1" -le 255 ] && \
                       [ "$2" -ge 0 -a "$2" -le 255 ] && \
                       [ "$3" -ge 0 -a "$3" -le 255 ] && \
                       [ "$4" -ge 0 -a "$4" -le 255 ]; then
                            
                            echo "valid"
                    
                    else
                        
                        # DEBUG! r7
                        # 
                        error "ERROR: Invalid IPv4 DNS: $entry"
                        exit 1
                    
                    fi
                
                elif echo "$entry" | grep -qE '^[a-fA-F0-9:]+(:[a-fA-F0-9:]+)*$'; then
                    
                    echo "valid"
                
                else

                    # DEBUG! r7
                    # DO NOT PARSE _validate_error here! No subshell!
                    _validate_error "ERROR: Invalid DNS format: $entry"
                    exit 1
                
                fi
            
            done 2>&1)
            
            
            if echo "$error_msg" | grep -q "^ERROR:"; then
                local err=$(echo "$error_msg" | grep "^ERROR:" | head -1 | sed 's/^ERROR: //')
                _validate_error "$err"
                
                return 1
            fi
            
            actual_count=$(echo "$error_msg" | grep -c "^valid$")
            
            if [ "$actual_count" -eq 0 ]; then

                _validate_error "No valid DNS servers found!"
                return 1
                
            fi

            debug_write "[VALIDATE] DNS OK: $actual_count servers"
            return 0
            ;;






        AllowedIPs)

            if [ -z "$value" ]; then
             
                _validate_error "AllowedIPs cannot be empty"
                return 1
            fi


            local valid_count=$(echo "$value" | tr ',' '\n' | while IFS= read -r entry; do
                
                entry=$(echo "$entry" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
                
                [ -z "$entry" ] && continue
                

                # 2.1   HAS CIDR
                if ! echo "$entry" | grep -q '/'; then
                    
                    # DEBUG! r7
                    # NOT TO PARSE _validate_error for this subshel type
                    error "AllowedIPs entry missing CIDR: $entry"
                    exit 1

                fi
                
                local ip_part=$(echo "$entry" | cut -d/ -f1)
                local cidr_part=$(echo "$entry" | cut -d/ -f2)
                
                # 2.2   CIDR IS INT
                if ! echo "$cidr_part" | grep -qE '^[0-9]+$'; then
                    
                    # DEBUG! r7
                    # DO NOT PARSE _validate_error for this subshel type
                    error "Invalid CIDR in AllowedIPs: $cidr_part"
                    exit 1

                fi
                
                # 2.3.1 CIDR VALID FOR IPv4
                if echo "$ip_part" | grep -qE '^([0-9]{1,3}\.){3}[0-9]{1,3}$'; then
                    
                    if [ "$cidr_part" -lt 0 ] || [ "$cidr_part" -gt 32 ]; then
                        
                        # DEBUG! r7
                        # DO NOT PARSE _validate_error for this subshel type
                        error "Invalid IPv4 CIDR: /$cidr_part"
                        exit 1

                    fi
                
                    # 2.3.2  IPv4 IS VALID
                    local IFS='.'
                    set -- $ip_part
                    
                    if [ "$1" -ge 0 -a "$1" -le 255 ] && \
                       [ "$2" -ge 0 -a "$2" -le 255 ] && \
                       [ "$3" -ge 0 -a "$3" -le 255 ] && \
                       [ "$4" -ge 0 -a "$4" -le 255 ]; then
                    
                            echo "valid"
                    
                    else
                    
                        # DEBUG! r7
                         # DO NOT PARSE _validate_error for this subshel type
                        error "Invalid IPv4 in AllowedIPs: $ip_part"
                        exit 1

                    fi
                
                
                # 2.3.2 CIDR VALID FOR IPv6
                elif echo "$ip_part" | grep -qE '^[a-fA-F0-9:]+(:[a-fA-F0-9:]+)*$'; then
                    
                    if [ "$cidr_part" -lt 0 ] || [ "$cidr_part" -gt 128 ]; then
                        

                        # DEBUG! r7
                        # DO NOT PARSE _validate_error for this subshel type
                        error "Invalid IPv6 CIDR: /$cidr_part"
                        exit 1

                    fi
                    
                    echo "valid"
                
                
                else
                    
                    # DEBUG! r7
                    # DO NOT PARSE _validate_error for this subshel type
                    error "Invalid AllowedIPs entry: $entry"
                    exit 1

                fi
            
            
            
            done | wc -l)
            


            if [ "$valid_count" -eq 0 ]; then
                _validate_error "No valid AllowedIPs found"
                return 1
            fi
            
            # D0ne
            debug_write "[VALIDATE] AllowedIPs OK: $valid_count entries"
            ;;


        
        
        
        Endpoint)

            if [ -z "$value" ]; then 
            
                _validate_error "Endpoint cannot be empty"
                return 1
            
            fi

            local host_part 
            local port_part
            
            # 3.1 CASE IPv6 like [2001:db8::1]:51820
            if echo "$value" | grep -q '^\[.*\]:'; then
                
                host_part=$(echo "$value" | sed 's/^\[\(.*\)\]:.*/\1/')
                port_part=$(echo "$value" | sed 's/^.*\]://')
            
            else
                
                host_part=$(echo "$value" | cut -d: -f1)
                port_part=$(echo "$value" | cut -d: -f2)
            
            fi
            
            # 3.1.1 NO HOST? EXIT
            if [ -z "$host_part" ]; then
            
                _validate_error "Endpoint host cannot be empty"
                return 1
            fi
            # 3.1.2 NO PORT? USING DEFAULT
            # DEBUG! r7
            #   Room for DNS pre-checks before using default but ...
            #   to do so an active wg connection is needed so ...
            #   ... a pre-check could simply ping/tracert a NON 10.x DNS
            # TODO:     idk
            if [ -z "$port_part" ]; then
            
                debug_write "[VALIDATION] No ENDPOINT:PORT found"
                port_part="$DEFAULT_PORT"
            
            fi

            # 3.2 CASE IPv4 like 125.221.221.221:51820
            if echo "$host_part" | grep -qE '^([0-9]{1,3}\.){3}[0-9]{1,3}$'; then
                
                local IFS='.'
                
                set -- $host_part
                
                if ! [ "$1" -ge 0 -a "$1" -le 255 ] || \
                    ! [ "$2" -ge 0 -a "$2" -le 255 ] || \
                    ! [ "$3" -ge 0 -a "$3" -le 255 ] || \
                    ! [ "$4" -ge 0 -a "$4" -le 255 ]; then
                    
                    _validate_error "Invalid IPv4 endpoint: $host_part"
                    return 1
                fi
            
            # 3.3 CASE ITS AN IPv6 WITHOUT [] like 2001:db8::1:51820
            elif echo "$host_part" | grep -qE '^[a-fA-F0-9:]+(:[a-fA-F0-9:]+)*$'; then
                # 3.3.1 DO NOTHING
                : 
            
            # 3.4 CASE ITS A HOST
            elif echo "$host_part" | grep -qE '^[a-zA-Z0-9]([a-zA-Z0-9\-]{0,61}[a-zA-Z0-9])?(\.[a-zA-Z0-9]([a-zA-Z0-9\-]{0,61}[a-zA-Z0-9])?)*$'; then
                
                if [ ${#host_part} -gt 253 ]; then 
                
                    _validate_error "Hostname too long: $host_part"
                    return 1

                fi
            
            else
                
                _validate_error "Invalid endpoint host: $host_part"
                return 1
            
            fi
            

            # 3.5 PORT VALIDATION
            if ! echo "$port_part" | grep -qE '^[0-9]+$'; then
                
                _validate_error "Invalid endpoint port: $port_part"
                return 1
            
            fi
            
            if [ "$port_part" -lt 1 -o "$port_part" -gt 65535 ]; then

                _validate_error "Port out of range: $port_part"
                return 1
            fi
            
            # D0ne
            debug_write "[VALIDATE] Endpoint OK: $host_part:$port_part"
            ;;
        
        



        

        PrivateKey|PublicKey)

            if [ -z "$value" ]; then
            
                _validate_error "$field cannot be empty"
                return 1

            fi
            
            # 4.1   KEY BASE64 LENGTH 44 with/without =
            local clean_key=$(echo "$value" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//' | tr -d '\r\n')
            local key_len=${#clean_key}
            
            if [ $key_len -lt 43 -o $key_len -gt 44 ]; then
                
                _validate_error "Invalid $field length: $key_len (expected 43-44 chars)"
                return 1
            fi
            
            
            # 4.2 KEY VALID CHARS
            if ! echo "$clean_key" | grep -qE '^[A-Za-z0-9+/]+=*$'; then

                _validate_error "Invalid $field format (not valid base64)"
                return 1
            
            fi

            # D0ne!
            debug_write "[VALIDATE] $field OK"
            ;;
        




        Address)

            if [ -z "$value" ]; then
                
                _validate_error "Address cannot be empty"
                return 1
            fi
            
            # 5.1   HAS CIDR
            if ! echo "$value" | grep -q '/'; then
            
                _validate_error "Address missing CIDR: $value"
                return 1
            
            fi
            
            local ip_part=$(echo "$value" | cut -d/ -f1)
            local cidr_part=$(echo "$value" | cut -d/ -f2)
            
            # 5.2   CIDR IS INT
            if ! echo "$cidr_part" | grep -qE '^[0-9]+$'; then
                
                _validate_error "Invalid CIDR in Address: $cidr_part"
                return 1
            
            fi
            
            
            
            # 5.3   CASE ITS IPv4
            if echo "$ip_part" | grep -qE '^([0-9]{1,3}\.){3}[0-9]{1,3}$'; then
                
                if [ "$cidr_part" -lt 0 -o "$cidr_part" -gt 32 ]; then
                    
                    _validate_error "Invalid IPv4 CIDR: /$cidr_part"
                    return 1
                
                fi

                local IFS='.'
                
                set -- $ip_part
                if ! [ "$1" -ge 0 -a "$1" -le 255 ] || \
                ! [ "$2" -ge 0 -a "$2" -le 255 ] || \
                ! [ "$3" -ge 0 -a "$3" -le 255 ] || \
                ! [ "$4" -ge 0 -a "$4" -le 255 ]; then
                  
                    _validate_error "Invalid IPv4 address: $ip_part"
                    return 1
                fi
            
            # 5.4  CASE ITS IPv6
            elif echo "$ip_part" | grep -qE '^[a-fA-F0-9:]+(:[a-fA-F0-9:]+)*$'; then
                
                if [ "$cidr_part" -lt 0 -o "$cidr_part" -gt 128 ]; then
                    
                    _validate_error "Invalid IPv6 CIDR: /$cidr_part"
                    return 1
                fi
            
            else
                
                _validate_error "Invalid Address format: $value"
                return 1
            
            fi
            
            
            
            # D0ne!
            debug_write "[VALIDATE] Address OK: $value"
            ;;
        





        InterfaceName)

            if [ -z "$value" ]; then
            
                _validate_error "Interface name cannot be empty"
                return 1
            fi
            
            if ! echo "$value" | grep -q '^wg'; then
                
                _validate_error "Interface name must start with 'wg': $value"
                return 1
            fi
            
            if [ ${#value} -gt 15 ]; then
                
                _validate_error "Interface name too long: $value (max 15 chars)"
                return 1
            fi
            
            if ! echo "$value" | grep -qE '^wg[a-zA-Z0-9_\-]+$'; then
                
                _validate_error "Invalid interface name: $value (only letters, numbers, _, -)"
                return 1
            fi
            
            if [ "$value" = "wg" ]; then
                _validate_error "Interface name cannot be just 'wg'"
                return 1
            fi
            

            # D0ne!
            debug_write "[VALIDATE] InterfaceName OK: $value"
            ;;
        




        *)
            _validate_error "Unknown validation field: $field"
            return 1
            ;;
    esac
    
    return 0
}

#####################################################################
# GET ALL WG INTERFACES FROM UCI
#####################################################################
get_all_wg_interfaces() {

    # 1. Get all
    # 2. Grep them for what we need (network fields DOT wg*)
    # 3. 1st cut:   -d. + 2nd field
    # 4. 2nd cut:   -d= + 1st subflied (Remove any =* including =)
    # 4. Sort all alphabetically, removing duplicates
    # 5. Satinised reponse d0ne! :D

    uci show network 2>/dev/null | grep "network\.wg[^=]*=interface" | cut -d. -f2 | cut -d= -f1 | sort -u
}
#####################################################################
# VALIDATE INTERFACE NAME
#####################################################################
validate_iface_name() {

    local iface="$1"

    if ! echo "$iface" | grep -q "^wg"; then
        error "Interface name must start with 'wg'"
    fi
}

#####################################################################
# CHECK IFACE ALREADY EXISTS
#####################################################################
iface_exists() {

    local iface="$1"

    uci get "network.$iface" >/dev/null 2>&1

}
#####################################################################
# CHECK ADDRESS ALREADY EXISTS IN ANY OTHER IFACE
#####################################################################
address_exists() {

    local address="$1"
    local exclude_iface="${2:-}"

    local existing_ifaces=$(get_all_wg_interfaces)

    for iface in $existing_ifaces; do

        [ "$iface" = "$exclude_iface" ] && continue

        local existing_addr=$(uci get "network.$iface.addresses" 2>/dev/null)
    
        if [ "$existing_addr" = "$address" ]; then
    
            echo "$iface"
            return 0
    
        fi
    
    done

    return 1
}


#####################################################################
# TAG HANDLER -> Get next available tag ID
#####################################################################
get_next_tag_id() {

    local file="$1"
    local tag="$2"

    # Getting the actual max TAG ID in use
    # 1.    Grep desired tagged line
    # 2.    Sed it by "*id [value]"
    # 3.    Sort it, cleaning
    # 4.    Tail the latest (the higher) in the list 
    local max_id=$(grep "# wg-autoconf $tag start id" "$file" 2>/dev/null | sed 's/.*id //g' | sort -n | tail -1)

    [ -z "$max_id" ] && max_id=0

    echo $((max_id + 1))
}
#####################################################################
# TAG HANDLER -> Remove tagged blocks from config files by ID
#####################################################################
remove_tagged_block() {

    local file="$1"
    local tag="$2"
    local tag_id="$3"
    
    debug_write "[REMOVE TAG] Starting: file=$file, tag=$tag, id=$tag_id"
    

    # 1- FILE EXIST??
    [ -f "$file" ] || {
    
        debug_write "[REMOVE TAG ERROR] File not found: $file"
        error "$file does not exist!"
        return 1
    
    }
    
    
    # 2. TAG EXISTS??
    if ! grep -q "# wg-autoconf $tag start id $tag_id" "$file" 2>/dev/null; then
    
        warning "Tag '$tag' with id $tag_id not found in $file. Skipping..."
        debug_write "[REMOVE TAG] Tag not found, skipping"
    
        return 0
    fi
    
    # 3. GET EXACT LINES TAG-STARTS / TAG-END
    local start_line=$(grep -n "# wg-autoconf $tag start id $tag_id" "$file" 2>/dev/null | cut -d: -f1)
    local end_line=$(grep -n "# wg-autoconf $tag end id $tag_id" "$file" 2>/dev/null | cut -d: -f1)
    
    # 3.1- TAG EXISTANCE VERIFICACIONT
    if [ -z "$start_line" ] || [ -z "$end_line" ]; then
        
        warning "Cannot find start/end lines for tag $tag id $tag_id"
        debug_write "[REMOVE TAG ERROR] Cannot find start/end lines: start=$start_line, end=$end_line"
        
        return 1
    
    fi
    
    # 3.2 TAMPERED TAG BLOCKS, START LINE DOES NOT MATCH END LINE
    if [ "$start_line" -ge "$end_line" ]; then
        
        warning "Invalid tag range: start=$start_line, end=$end_line"
        debug_write "[REMOVE TAG ERROR] Invalid range: start=$start_line >= end=$end_line"
        
        return 1
    fi
    
    # 3.3 ELSE IF OK
    debug_write "[REMOVE TAG] Found lines: start=$start_line, end=$end_line"
    

    # 4. ADD TAGS, ATOMIC OPERS
    local temp_file="${ATOMIC_PATHS}/$(basename "$file").${tag}.${tag_id}.atomic"
    debug_write "[REMOVE TAG] Using temp file: $temp_file"
    

    if ! head -n $((start_line - 1)) "$file" > "$temp_file" 2>/dev/null; then
    
        debug_write "[REMOVE TAG ERROR] head command failed"
        
        rm -f "$temp_file" 2>/dev/null
    
        return 1
    fi
    
    # 4.2   
    if [ ! -f "$temp_file" ]; then

        debug_write "[REMOVE TAG ERROR] Temp file not created after head"
    
        return 1
    fi
    
    # 4.3 COPY LINES BEFORE THE HIGHEST BLOCK
    if ! tail -n +$((end_line + 1)) "$file" >> "$temp_file" 2>/dev/null; then
        
        debug_write "[REMOVE TAG ERROR] tail command failed"
        
        rm -f "$temp_file" 2>/dev/null
        
        return 1
    fi
    
    # 4. VERIFY
    if [ ! -s "$temp_file" ]; then
        
        warning "Resulting file would be empty after removing '$tag' block"
        debug_write "[REMOVE TAG ERROR] Temp file empty or missing"
        
        rm -f "$temp_file" 2>/dev/null
        
        return 1
    fi
    
    # 5. CHMODs GET, THE MORE ATOMIC THE BETTER
    local orig_perm="644"
    
    if command -v stat >/dev/null 2>&1 && stat -c "%a" "$file" >/dev/null 2>&1; then
        
        orig_perm=$(stat -c "%a" "$file" 2>/dev/null || echo "644")
    
    else
        
        orig_perm=$(ls -l "$file" | awk '{print $1}' 2>/dev/null | grep -o '...$' | tr 'rwx-' '4210' 2>/dev/null || echo "644")
    fi
    
    debug_write "[REMOVE TAG] Original permissions: $orig_perm"
    

    # 6. REPLACE ORIG FILE WITH TEMP
    if ! mv "$temp_file" "$file" 2>/dev/null; then
        
        debug_write "[REMOVE TAG ERROR] mv failed: $temp_file -> $file"
        
        rm -f "$temp_file" 2>/dev/null
        
        error "Failed to remove block from $file"
        
        return 1
    fi
    
    # 6.1   CHMODs SET
    if ! chmod "$orig_perm" "$file" 2>/dev/null; then
        
        debug_write "[REMOVE TAG WARNING] Failed to restore permissions for $file"
    
    fi
    
    verbose success "Removed '$tag' block (id: $tag_id) from $file"
    debug_write "[REMOVE TAG] Successfully removed $tag block id $tag_id from $file"
    
    return 0
}


#####################################################################
# WG KEY HANDLER -> CLEANING
#####################################################################
clean_wg_key() {

    local key="$1"

    key=$(echo "$key" | sed 's/^[ \t]*//;s/[ \t]*$//')
    key=$(echo "$key" | tr -d '\r\n')
    [ "${key:0:1}" = "+" ] && key="${key:1}"

    local len=${#key}
    [ $len -eq 43 ] && key="${key}="

    echo "$key"
}


#####################################################################
# WG/OpenWRT Network ALLOWED IPS
#####################################################################
process_allowed_ips() {

    local ips="$1"

    ips=$(echo "$ips" | sed 's/^[ \t]*//;s/[ \t]*$//')

    echo "$ips" | tr ',' '\n' | sed 's/^[ \t]*//;s/[ \t]*$//' | grep -v '^$'
}

#####################################################################
# NETMASK TO CIDR converter
#####################################################################
netmask_to_cidr() {

    local mask="$1"

    case "$mask" in
        255.255.255.0)   echo 24 ;;
        255.255.255.128) echo 25 ;;
        255.255.255.192) echo 26 ;;
        255.255.255.224) echo 27 ;;
        255.255.255.240) echo 28 ;;
        255.255.255.248) echo 29 ;;
        255.255.255.252) echo 30 ;;
        255.255.0.0)     echo 16 ;;
        255.0.0.0)       echo 8 ;;
        *)               echo 24 ;;
    esac
}

#####################################################################
# IP to network address converter
#####################################################################
ip_to_network() {
    local ip="$1"
    local cidr="$2"

    # DEBUG! rel5
    # TODO:     Test in older devices, different shells, etc
    # REASON:
    #   Standard ash (BusyBox) has crappy array support....syntax may fail!
    #   ASH array syntax `array=(value1 value2)` is not portable for older ash versions
    # POSSIBLE FIX?: Poositional params...  or space-separated strings instead of arrays
    case "$cidr" in
        24)
            echo "${ip%.*}.0"
            ;;
        25|26|27|28|29)

            local octet=${ip##*.}
            local bits=$((32 - cidr))

            local step=1 i
            i=0

            while [ $i -lt $bits ]; do
                step=$((step * 2))
                i=$((i + 1))
            done

            step=$((256 / step))

            local net=$(( (octet / step) * step ))

            echo "${ip%.*}.$net"
            ;;
        16)
            echo "${ip%.*.*}.0"
            ;;
        8)
            echo "${ip%.*.*.*}.0"
            ;;
        *)
            echo "${ip%.*}.0"
            ;;
    esac
}


#####################################################################
# ██╗  ██╗███████╗██╗     ██████╗
# ██║  ██║██╔════╝██║     ██╔══██╗
# ███████║█████╗  ██║     ██████╔╝
# ██╔══██║██╔══╝  ██║     ██╔═══╝
# ██║  ██║███████╗███████╗██║
# ╚═╝  ╚═╝╚══════╝╚══════╝╚═╝
#####################################################################
# DEBUG! rel5
# TODO:     Test in different devices, shells; eval usage?; entire refactoring
# REASON:
#   Use of "$@" to execute cmds may have quoting issues in older ash
#   Complex arguments with spaces or special characters may not be preserved correctly
#####################################################################
# VERBOSE MODE
#####################################################################
verbose() {

    if [ "$VERBOSE" = "1" ]; then
        "$@"
    fi
}

#####################################################################
# CMD HEADER
#####################################################################
show_header() {

    echo ""
    echo -e "${GREEN}WireGuard Auto-Config${NC} - ${RED}$VERSION${NC}"
    echo ""
    echo -e "   ${BLUE}Usage:${NC} wg-autoconf ${YELLOW}COMMAND${NC} ${GREEN}<args>${NC}"
    echo -e "     ${YELLOW}'wg-autoconf --help' for full help${NC}"
    echo ""
}

#####################################################################
# SHOW HELP/UPSAGE
#####################################################################
show_usage() {
    
    echo ""
    ui_lines 80 "${GREEN}WireGuard Auto-Config${NC} - ${RED}$VERSION${NC} HELP"
    echo ""

    echo -e "${GREEN}Configuration Management:${NC}"
    echo -e " ${YELLOW}list${NC}                             - List Available .conf files at /etc/wireguard"
    echo -e " ${YELLOW}list${NC} ${GREEN}<config file>${NC}               - Show configuration"
    echo -e " ${YELLOW}test${NC} ${GREEN}<config file>${NC}               - Test a .conf file"
    echo ""
    echo -e " ${YELLOW}setup${NC} ${GREEN}<config file>${NC}              - Setup from .conf (creates wg_<CONF_NAME>)"
    echo -e " ${YELLOW}manual${NC}                           - Create new advanced configuration from scratch"
    echo -e " ${YELLOW}manual${NC} ${GREEN}<config file>${NC}             - Advanced mode using existing .conf as base"
    echo ""

    echo -e "${BLUE}Interface Control:${NC}"
    echo -e " ${YELLOW}status${NC}                           - Show all WG interfaces"
    echo -e " ${YELLOW}status${NC} ${GREEN}<wg iface>${NC}                - Show specific WG interface"
    echo -e " ${YELLOW}up${NC} ${GREEN}<wg iface>${NC}                    - Enable WG interface"
    echo -e " ${YELLOW}down${NC} ${GREEN}<wg iface>${NC}                  - Disable WG interface"
    echo -e " ${YELLOW}remove${NC} ${GREEN}<wg iface>${NC}                - Delete WG interface (unsetup)"
    echo ""

    echo -e "${YELLOW}Routing & Traffic Control:${NC}"
    echo -e " ${YELLOW}routes show${NC}                      - Show all routes"
    echo -e " ${YELLOW}routes show${NC} ${GREEN}<wg iface>${NC}           - Show routes for WG interface"
    echo -e " ${YELLOW}routes set${NC} ${GREEN}<wg iface> <iface>${NC}    - Set routes: LAN -> WG"
    echo -e " ${YELLOW}routes unset${NC} ${GREEN}<wg iface> <iface>${NC}  - Unset routes: LAN -> WG"
    echo ""

    echo -e "\033[0;35mBackup/Recovery & Upgrade:\033[0m"
    echo -e " ${YELLOW}backups show${NC}                     - List available backups"
    echo -e " ${YELLOW}backups restore${NC} ${GREEN}<file>${NC}           - Restore backup files"
    echo ""
    echo -e " ${YELLOW}upgrade${NC}                          - Upgrade wg-autoconf safely"
    echo ""

    echo -e "${RED}Cleanup Operations:${NC}"
    echo -e " ${YELLOW}clean${NC}                            - Clean WG configs (interactive)"
    echo -e " ${YELLOW}clean${NC} ${GREEN}<wg iface>${NC}                 - Clean specific interface"
    echo -e " ${RED}nuke${NC}                             - ${RED}Force removal & cleanup ALL WG configs (no prompts)${NC}"

    echo ""
    echo -e "${GREEN}Verbosity Mode:${NC}"
    echo -e " ${YELLOW}--verbose / -v${NC}                   - Verbose mode for any command"

    echo ""
    echo -e "${GREEN}Debug Mode:${NC}"
    echo -e " ${YELLOW}debug on / off${NC}                   - Enable/Disable Debug logging functions"
    echo -e " ${YELLOW}debug clear${NC}                      - Clear latest/backuped logs"
    echo -e " ${YELLOW}debug show${NC}                       - Show latest debug log"
    echo -e " ${YELLOW}debug live${NC}                       - Tail debug log live"

    echo ""
    ui_lines 80 "${BLUE}Usage:${NC} wg-autoconf ${YELLOW}COMMAND${NC} ${GREEN}<args>${NC}"

    exit 1
}



#####################################################################
#
# ██╗     ██╗███████╗████████╗
# ██║     ██║██╔════╝╚══██╔══╝
# ██║     ██║███████╗   ██║
# ██║     ██║╚════██║   ██║
# ███████╗██║███████║   ██║
# ╚══════╝╚═╝╚══════╝   ╚═╝
#
#####################################################################
# TODO: Make really useful both methods

# 1   LIST
list_configs() {

    local file_arg="$1"


    if [ -n "$file_arg" ]; then

        local conf_file="$WG_CONF_DIR/$file_arg.conf"

        if [ ! -f "$conf_file" ]; then
            
            error "Configuration file $file_arg not found!"
        
        fi
        
        log "Configuration file: $file_arg"
        echo ""
        echo -e "${BLUE}$(basename $conf_file)${NC}"
        ui_lines 50
        cat "$conf_file" | sed 's/^/   /'
        echo ""
        ui_lines 50
        return
    fi



    echo ""
    ui_lines 49 "${YELLOW}Config files found on ${GREEN}$WG_CONF_DIR${NC}"
    echo ""

    local count=0
    local line=""
    local found=0

    for conf in "$WG_CONF_DIR"/*.conf; do

        [ -f "$conf" ] || continue

        found=1
        name=$(basename "$conf" .conf)

        if [ $count -eq 5 ]; then

            echo -e "${GREEN}$line${NC}"

            line="   $name"
            count=1

        else

            if [ $count -eq 0 ]; then

                line="   $name"

            else

                line="$line ${NC}|${GREEN} $name${NC}"
            fi

            count=$((count + 1))
        fi
    done



    if [ $found -eq 0 ]; then

        warning "No configuration files found in $WG_CONF_DIR"

    else

        [ -n "$line" ] && echo -e "${GREEN}$line${NC}"

    fi

    echo ""
    ui_lines 50
}
#####################################################################
# 2.    LIST-FULL
list_configs_full() {

    ui_lines 79 "${YELLOW} Full Configs Inspection${NC}"
    echo ""

    local found=0

    for conf in "$WG_CONF_DIR"/*.conf; do
        [ -f "$conf" ] || continue
        found=1

        ui_lines 40 "${BLUE}$(basename $conf)${NC}"
        cat "$conf" | sed 's/^/   /'
        # echo ""
        # ui_lines 40
        echo ""
    done

    if [ $found -eq 0 ]; then
        warning "No configuration files found in $WG_CONF_DIR"
    fi

    ui_lines 80
}



#####################################################################
#
# ████████╗███████╗███████╗████████╗
# ╚══██╔══╝██╔════╝██╔════╝╚══██╔══╝
#    ██║   █████╗  ███████╗   ██║
#    ██║   ██╔══╝  ╚════██║   ██║
#    ██║   ███████╗███████║   ██║
#    ╚═╝   ╚══════╝╚══════╝   ╚═╝
#
#####################################################################
# DONE: Make really useful a test mode, not onlye check key params
#    WG-AUTOCONF test
test_config() {

    local CONF_NAME="$1"
    local conf_file="$WG_CONF_DIR/$CONF_NAME.conf"


    # 1.1   IF EXISTS
    [ -f "$conf_file" ] || error "Configuration file ${YELLOW}$conf_file${NC} not found!"

    verbose echo ""
    verbose log "Testing ${YELLOW}$CONF_NAME${NC} ..."
    echo ""
    
    # 1.2   CONF VLAIDATIOPN
    ui_lines 79 "${YELLOW}FULL CONFIGURATION VALIDATION${NC}"
    echo ""
    
    # 1.2.1 REQUIRED FIELDS FROM COND
    local required_fields="PrivateKey PublicKey Address Endpoint AllowedIPs"
    local optional_fields="DNS"
    
    local all_ok=1
    
    # 2. CHECK - VALIDATE FIELDS
    for field in $required_fields; do
        
        # 2.1 SETUP_WIREGUARD (SETUP / MANUAL) MODE VALIDATION
        local value=$(get_conf_value "$field" "$conf_file" "raw")
        

        if [ -z "$value" ]; then
            
            echo -e "  ${RED}[ERROR]${NC}  [MISSING] $field: NOT FOUND" >&2
            all_ok=0
        

        # 2.2 TEST_CONFIGS MODE VALIDATIO
        else
            
            local validation_output=""
            
            validation_output=$(validate_wg_config "auto" "$conf_file" "$field" "$value" "1" 2>&1)
            
            local validation_exit=$?
            
            if [ $validation_exit -eq 0 ]; then
                
                success "  $field: ${GREEN}Valid${NC}"
               
                
                local display_value="$value"
                
                # 2.2.1 VALUE CLEANINGS
                [ ${#display_value} -gt 50 ] && display_value="${display_value:0:47}..."
                


                # 2.3   FOR VALID VALUE
                echo -e "        ${BLUE}Value:${NC} $display_value"
            
            
            # 2.4   FOR AN INVALID VALUE
            else
                

                echo -e "  ${RED}[INVALID]${NC} $field: Failed Validation!"
                
                if [ -n "$validation_output" ]; then
                    
                    local error_msg=$(echo "$validation_output" | grep -o "VALIDATION_ERROR: .*" | sed 's/VALIDATION_ERROR: //' | head -1)
                    
                    [ -n "$error_msg" ] && echo -e "        ${RED}Error:${NC} $error_msg"
                fi
                
                all_ok=0
            
            fi
    
        fi
    
        echo ""
    
    done
    
    # 3. OPTIONAL (DNS SPECIFIC ISSUES) VALIDATION
    # DEBUG! r7 ... maybe allowed_ips should be there
    #               Room for future SWITCH/BYPASS
    for field in $optional_fields; do
        
        local value=$(get_conf_value "$field" "$conf_file" "raw")
        
        if [ -z "$value" ]; then
            
            warning "  [OPTIONAL] $field: Not specified (will use defaults)"
        
        else
            
            # 3.1   OPTIONALS FOR TEST_CONFIG() MODE
            local validation_output=""
            validation_output=$(validate_wg_config "auto" "$conf_file" "$field" "$value" "1" 2>&1)
            local validation_exit=$?
            
            
            if [ $validation_exit -eq 0 ]; then
                
                success "  $field: ${GREEN}Valid${NC}"
                
                # 3.1.1 VALUE CLEANINGS
                
                local display_value="$value"
                
                [ ${#display_value} -gt 50 ] && display_value="${display_value:0:47}..."
                
                
                # 3.2   FOR A VALID (OPTIONAL) VALUE
                echo -e "        ${BLUE}Value:${NC} $display_value"
            
            

            # 3.3   FOR A INVALID (OPTIONAL) VALUE
            else
                
                
                echo -e "  ${RED}[INVALID]${NC} $field: Failed Validation!"
                
                if [ -n "$validation_output" ]; then
                    
                    local error_msg=$(echo "$validation_output" | grep -o "VALIDATION_ERROR: .*" | sed 's/VALIDATION_ERROR: //' | head -1)
                    
                    [ -n "$error_msg" ] && echo -e "        ${RED}Error:${NC} $error_msg"
                
                fi
                
                all_ok=0
            fi
        fi
        
        echo ""
    
    
    done




    # 4. PUBKEY/PRIVKEY VALIDATIONS CLEAN_WG_KEY()
    echo ""
    ui_lines 49 "${YELLOW}KEY CRYPTO VALIDATION${NC}"
    echo ""
    
    local private_key_raw=$(get_conf_value "PrivateKey" "$conf_file" "raw")
    local public_key_raw=$(get_conf_value "PublicKey" "$conf_file" "raw")
    
    if [ -n "$private_key_raw" ]; then
        
        local private_key_clean=$(clean_wg_key "$private_key_raw")
        
        if echo "$private_key_clean" | wg pubkey >/dev/null 2>&1; then
            
            success "  PrivateKey: ${GREEN}Cryptographically valid${NC}"
            echo -e "        ${BLUE}Key:${NC} $(echo "$private_key_clean" | cut -c1-15)..."
        
        else

            echo -e "  ${RED}[INVALID]${NC} PrivateKey: ${RED}Not a valid WireGuard key!${NC}"
            all_ok=0
        fi
    
    fi
    
    if [ -n "$public_key_raw" ]; then
        
        local public_key_clean=$(clean_wg_key "$public_key_raw")
        
        if echo "$public_key_clean" | wg pubkey >/dev/null 2>&1; then
            
            success "  PublicKey: ${GREEN}Cryptographically valid${NC}"
            echo -e "        ${BLUE}Key:${NC} $(echo "$public_key_clean" | cut -c1-15)..."
        
        else
            
            echo -e "  ${RED}[INVALID]${NC} PublicKey: ${RED}Not a valid WireGuard key!${NC}"
            all_ok=0
        fi
    fi





    # 5. ENDPOINT
    echo ""
    ui_lines 49 "${YELLOW}ENDPOINT DETAILS${NC}"
    echo ""
    

    # 5.1 GET
    local endpoint=$(get_conf_value "Endpoint" "$conf_file" "raw")
    
    # 5.2 SPLIT host:port
    if [ -n "$endpoint" ]; then
        
        local host_part=$(echo "$endpoint" | cut -d: -f1)
        local port_part=$(echo "$endpoint" | cut -d: -f2)
        
        [ -z "$port_part" ] && port_part="$DEFAULT_PORT"
        
        echo -e "  ${YELLOW}Host: ${GREEN}$host_part${NC}"
        echo -e "  ${YELLOW}Port: ${GREEN}$port_part${NC}"
        
        
        # 5.3 CHECK IF HOST UP (nslookup)
        # DEBUG! ... nslookup from Busybox ... or what else?
        if ! echo "$host_part" | grep -qE '^([0-9]{1,3}\.){3}[0-9]{1,3}$' && \
           ! echo "$host_part" | grep -qE '^\[.*\]$'; then
            
            verbose echo ""
            verbose warning "  [NOTE] Hostname detected: $host_part"
            verbose echo ""

            if nslookup "$host_part" >/dev/null 2>&1; then
                
                echo ""
                success "  ${GREEN}Hostname resolves correctly!${NC}"
            
            else
                
                echo ""
                warning "  ${RED}Hostname does not resolve (may cause connection issues)!${NC}"
                all_ok=0
            
            fi
        fi
    fi
    


    # 6. SHOW
    echo ""
    ui_lines 49 "${YELLOW}TEST RESULTS${NC}"
    
    if [ $all_ok -eq 1 ]; then

        echo ""
        success "${GREEN}CONFIGURATION FILE IS VALID AND READY FOR USE!${NC}"
        echo ""
        echo -e "   ${BLUE}You can now use:${NC}"
        echo -e "     ${YELLOW}wg-autoconf setup ${GREEN}$CONF_NAME${NC}"
        echo ""
    
    else
        echo ""
        warning "${RED}CONFIGURATION FILE HAS ERRORS!${NC}"
        echo ""
        echo -e " ${YELLOW}Please fix the issues above before using this configuration!${NC}"
        echo ""
    fi
    
    ui_lines 80
}

