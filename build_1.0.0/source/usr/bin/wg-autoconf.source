upgrade_avoid_garbage() {
    
    debug_write "[UPGRADE GARBAGE] Checking for upgrade garbage..."

    # Hipotheticaly ... init not needed here    
    # state_init 2>/dev/null || {
    #     debug_write "[UPGRADE_GARBAGE] State file not found, assuming clean state"
    #     return 0
    # }
    
    local prev_upgrade=$(state_read "IS_PREV_TO_UPGRADE" 2>/dev/null)
    debug_write "[UPGRADE_GARBAGE] IS_PREV_TO_UPGRADE value: '$prev_upgrade'"
    
    # STATES PRECHECKS
    if [ -z "$prev_upgrade" ]; then
        
        debug_write "[UPGRADE GARBAGE] State file not found! Check setup/manual errors!"
        warning "Something went wrong! 'wg-autoconf nuke' is recommended at this point"

        exit 1
    fi
    
    if [ "$prev_upgrade" = "0" ]; then
        
        debug_write "[UPGRADE GARBAGE] Clean state detected! Continue setup OK!"
        return 0
    fi
    
    # if IS_PREV_TO_UPGRADE = 1
    if [ "$prev_upgrade" = "1" ]; then
        
        echo ""
        ui_lines 79 "${RED}WARNING: POTENTIAL UPGRADE GARBAGE DETECTED ${NC}"
        echo ""
        
        warning "A previous upgrade attempt was interrupted or failed!"
        echo ""
        
        echo -e "${YELLOW}Possible issues:${NC}"
        echo "  - WireGuard interfaces may be in inconsistent state"
        echo "  - Configuration files may be partially modified"
        echo "  - Active VPN connections might be unstable"
        echo ""
        
        echo -e "${GREEN}Recommended action:${NC}"
        echo "  Run: ${YELLOW}wg-autoconf nuke${NC}"
        echo ""
        echo "This will:"
        echo "  - Clean all WireGuard interfaces"
        echo "  - Restore original configuration files from backups"
        echo "  - Reset wg-autoconf internal state"
        echo ""
        
        echo -e "${YELLOW}After cleanup, you can:${NC}"
        echo "  - Re-setup your VPN connections"
        echo "  - Retry the upgrade if needed"
        echo ""
        
        ui_lines 79 "${RED}MANUAL INTERVENTION REQUIRED${NC}"
        echo ""
        
        printf "${YELLOW}Run '${GREEN}wg-autoconf nuke${YELLOW}' now? (${GREEN}Y${YELLOW}/${RED}n${YELLOW}):${NC} "
        read -r confirm
        case "$confirm" in
            y|Y|yes|YES|Yes|okidoki|OKIDOKI|Okidoki|OkiDoki)
                log "Running nuke to clean up upgrade garbage..."
                cleanup "nuke" "" ""
                ;;
            *)
                error "Cannot continue with potential upgrade garbage"
                warning "Run 'wg-autoconf nuke' first, or perform a full deinstall/reinstall"
                ;;
        esac
    fi
    
    

    success "Upgrade misfunction is fixed!"
    state_write "IS_PREV_TO_UPGRADE" "0" 2>/dev/null
    debug_write "[UPGRADE_GARBAGE] Reset IS_PREV_TO_UPGRADE to 0"
    
    return 0
}

upgrade_tmp_script() {

    local script_path="$1"
    local apk_command="$2"
    local version="$3"

    # 0) UNCONDITIONAL PRE-CHECKS
    # upgrade_avoid_garbage, moved to init

    debug_write "[UPGRADE] upgrade_tmp_script STARTED...."
    
    verbose log "Creating temporary upgrade script at: $script_path"

    # VERIFY tmp PATH
    if ! touch "$script_path" 2>/dev/null; then

        debug_write "[UPGRADE] Cannot create sh in /tmp. CHECK /tmp permissions ?"
        warning "Cannot create script in /tmp. Please provide an alternative path."

        local new_path=""

        while :; do

            printf "${YELLOW}Enter path for upgrade script${NC} (E.g: /tmp/upgrade.sh): "
            read -r new_path

            if [ -z "$new_path" ]; then

                warning "PATH cannot be empty!"
                continue
            fi


            local dir_path="${new_path%/*}"

            if [ ! -d "$dir_path" ]; then
                warning "Directory does not exist!: $dir_path"
                continue
            fi

            if [ ! -w "$dir_path" ]; then
                debug_write "[UPGRADE] Custom PATH exists BUT it is NOT writable. Check user/path permissions?"
                warning "Directory is not writable!: $dir_path"
                continue
            fi

            script_path="$new_path"
            verbose log "Using alternative script path: $script_path"
            break
        done
    fi

    # DEBUG! r7
    # TODO:     idk
    # I'm operating on the assumption here that the provided APK is valid
    # and the installation is going through without a hitch...
    #
    # An inspection method—using xxd would be perfect...
    # but it requires the NOT CORE xxd as dependence
    #
    # For the future... remove the entire upgrade option
    # Intentions are good, but a straightforward set of:
    #   - upgrade()
    #   - pre_upgrade()
    #   - post_upgrade() 
    # .... would be better to check and notice the user
    # whether there are any active wg iface is running
    # before upgrade/reinstall/uninstalling th app


    {
        echo "#!/bin/ash"
        echo "# wg-autoconf $version Updater Script"
        echo ''
        echo "STATE_FILE_UPGRADE='$STATE_FILE'"
        echo "DEBUG_LOG_UPGRADE='$DEBUG_LOG'"
        echo ''
        echo 'echo -e "\033[0;32mwg-autoconf\033[0m \033[1;31m'"$version"'\033[0m \033[1;33mUpdater Module\033[0m"'
        echo ''
        echo 'echo -e "\033[0;32mStarting upgrade process...\033[0m"'
        echo 'echo ""'
        echo ''
        echo 'echo -e "\033[0;33mLaunching:\033[0m \033[1m'"$apk_command"'\033[0m"'
        echo 'echo ""'
        echo ''
        echo "$apk_command"
        echo 'upgrade_exit=$?'
        echo ''
        echo 'if [ $upgrade_exit -eq 0 ]; then'
        echo ''
        echo '    if [ -f "$STATE_FILE_UPGRADE" ]; then'
        echo ''
        echo '        sed -i "s/^IS_PREV_TO_UPGRADE=.*/IS_PREV_TO_UPGRADE=0/" "$STATE_FILE_UPGRADE"'
        echo '        if grep -q "^IS_UPGRADED=" "$STATE_FILE_UPGRADE" 2>/dev/null; then'
        echo '            sed -i "s/^IS_UPGRADED=.*/IS_UPGRADED=1/" "$STATE_FILE_UPGRADE"'
        echo '        else'
        echo '            echo "IS_UPGRADED=1" >> "$STATE_FILE_UPGRADE"'
        echo '        fi'
        echo '    fi'
        echo ''
        echo '    if [ -f "$DEBUG_LOG_UPGRADE" ]; then'
        echo '        echo "[$(date "+%Y-%m-%d %H:%M:%S")] [UPGRADE External Module] Upgrade completed successfully" >> "$DEBUG_LOG_UPGRADE"'
        echo '    fi'
        echo ''
        echo '    echo ""'
        echo '    echo -e "\033[0;33mCleaning up temporary files...\033[0m"'
        echo "    rm -f $script_path"
        echo '    echo ""'
        echo '    echo -e "\033[0;32mUpgrade completed!\033[0m"'
        echo '    exit 0'
        echo ''
        echo 'else'
        echo '    if [ -f "$DEBUG_LOG_UPGRADE" ]; then'
        echo '        echo "[$(date "+%Y-%m-%d %H:%M:%S")] [UPGRADE Module] Upgrade failed with exit code: $upgrade_exit" >> "$DEBUG_LOG_UPGRADE"'
        echo '    fi'
        echo '    echo ""'
        echo '    echo -e "\033[0;33mCleaning up temporary files...\033[0m"'
        echo "    rm -f $script_path"
        echo '    echo ""'
        echo '    echo -e "\033[1;31mUpgrade failed with exit code: $upgrade_exit\033[0m"'
        echo '    exit $upgrade_exit'
        echo 'fi'
    } > "$script_path" 2>/dev/null

    chmod 755 "$script_path"

    if [ -f "$script_path" ] && [ -x "$script_path" ]; then

        echo "$script_path"
        return 0

    else

        debug_write "[UPGRADE] Unexpected error executing uppgrade. PATH: $script_path. Check logread | tail -10 ? Check permissions?"
        verbose log "Failed to create executable script at: $script_path"
        return 1
    fi
}

upgrade_app() {

    local option
    local filepath
    local upgrade_script="${ATOMICS}/wg-autoconf-upgrading.sh"
    local apk_command=""

    echo ""
    ui_lines 50 "${GREEN}wg-autoconf${NC} ${RED}$VERSION${NC} ${YELLOW}UPGRADE Module${NC}"

    verbose log "This feature allows you to update wg-autoconf easily, either from a local .apk file or directly from source."
    verbose log "An executable will be created in /tmp to proceed with the installation, thereby releasing the main binary."
    verbose echo ""
    warning "Any active connection will be DROPPED during the update process!!!"

    echo ""
    echo -e "\e[1mPlease choose upgrade method:\e[0m"
    echo "  1) Using a local .apk file"
    echo "  2) From package sources"
    echo "  0) Exit"
    echo ""

    while :; do
        printf "${YELLOW}Choose an option :${NC} "
        read -r option

        case "$option" in
            1|2)
                break
                ;;
            0|exit|EXIT|Exit)
                warning "Upgrade cancelled by the user!"
                exit 1
                ;;
            *)
                error "Invalid option!"
                ;;
        esac
    done

    echo ""

    case "$option" in
        1)
            while :; do
                debug_write "[UPGRADE] Custom local APK file mode selected ..."
                printf "${YELLOW}Enter full PATH to local APK file${NC} (E.g., /tmp/file.apk): "
                read -r filepath

                if [ -z "$filepath" ]; then
                    warning "File path cannot be empty."
                    exit 1
                fi

                if ! [ -f "$filepath" ]; then
                    warning "File not found: $filepath"
                    exit 1
                fi

                if echo "$filepath" | grep "\.apk$" >/dev/null 2>&1; then
                    apk_command="apk add --upgrade \"$filepath\""
                    break

                else
                    debug_write "[UPGRADE ERROR] Custom APK file selected ERROR!. Check xxd $filepath, check proper apk file?"
                    echo "File does not appear to be an APK file. Please provide a .apk file."
                fi
            done
            ;;
        2)
            debug_write "[UPGRADE] Sources mode selected ..."
            apk_command="apk add --upgrade wg-autoconf"
            ;;
        *)
            debug_write "[UPGRADE ERROR] This option should not have been accessed! Tampered bin?"
            warning "Invalid option selected ($option). Aborting!"
            exit 1
            ;;
    esac

    local created_script

    created_script=$(upgrade_tmp_script "$upgrade_script" "$apk_command" "$VERSION")

    if [ $? -ne 0 ] || [ -z "$created_script" ]; then
        warning "Failed to create upgrade script!"
        exit 1
    fi

    upgrade_script="$created_script"

    # STATES IS_PREV_TO_UPGRADE
    state_write "IS_PREV_TO_UPGRADE" "1" 2>/dev/null
    debug_write "[UPGRADE] Set IS_PREV_TO_UPGRADE=1"

    # echo ""
    log "Launching Upgrade module ..."
    verbose log "The current application will now terminate and the upgrade will begin."
    verbose log ""

    sleep 2

    # DEBUG! rel5
    # TODO:     Add sha expected sums for tmp script, and validation (or remove entire func)
    # REASON:
    #       Risky exec sh method may allowe tampered scripts, or contain errors
    # POSSIBLE FIX?:
    #       Add validation, by checking expexted sha sums
    #       Look for safer temp file paths (/dev/shm/ ?)
    #       Directly remove upgrade_app function!!!!
    exec sh "$upgrade_script"


    debug_write "[UPGRADE] Temporary update script FAILED! Check exec sh $upgrade_script availability, permissions, or changes on ASH"
    warning "Failed to launch upgrade script!"
    exit 1
}



###########################################################
#
# ██████╗ ███████╗██████╗ ██╗   ██╗ ██████╗
# ██╔══██╗██╔════╝██╔══██╗██║   ██║██╔════╝
# ██║  ██║█████╗  ██████╔╝██║   ██║██║  ███╗
# ██║  ██║██╔══╝  ██╔══██╗██║   ██║██║   ██║
# ██████╔╝███████╗██████╗╚██████╔╝╚███████═╝
# ╚═════╝ ╚══════╝╚═════╝ ╚═════╝  ╚═════╝
#
###########################################################

###########################################################
# DEBUG LOGGING SYSTEM
###########################################################

debug_init_log() {

    mkdir -p "$DEBUG_PATH" 2>/dev/null || return 1

    if [ ! -f "$DEBUG_LOG" ]; then
        cat > "$DEBUG_LOG" << EOF
===[ wg-autoconf $VERSION DEBUG LOG ]=======================
Started: $(date '+%Y-%m-%d %H:%M:%S')
=============================================================

EOF
    fi
}

debug_state_read() {

    if [ -f "$DEBUG_PATH/debug-state" ]; then
        cat "$DEBUG_PATH/debug-state"
    else
        echo "0"
    fi

}

debug_state_write() {

    local state="$1"
    mkdir -p "$DEBUG_PATH" 2>/dev/null
    echo "$state" > "$DEBUG_PATH/debug-state"
}

debug_is_active() {

    [ "$(debug_state_read)" = "1" ]

}

debug_write() {

    local msg="$1"
    
    # SOLO si debug está activo O si es un error crítico
    debug_is_active || return 0
    
    [ -z "$msg" ] && return
    
    # Verificar que el log esté inicializado
    if [ ! -f "$DEBUG_LOG" ]; then
        debug_init_log
    fi
    
    # Escribir al log
    if [ -f "$DEBUG_LOG" ]; then
        printf "[%s] [%s] %s\n" "$(date '+%Y-%m-%d %H:%M:%S')" "$VERSION" "$msg" >> "$DEBUG_LOG"
        debug_rotate_logs_by_size
    fi
}

debug() {

    debug_is_active || return 0
    
    local cmd="$@"
    debug_write "EXEC: $cmd"
    
    local output
    output=$(sh -c "$cmd" 2>&1)
    local exitcode=$?
    
    if [ $exitcode -eq 0 ]; then
    
        echo "$output" | while read -r line; do
            debug_write "  $line"
        done
    
    else
    
        debug_write "ERROR ($exitcode):"
        echo "$output" | while read -r line; do
    
            debug_write "  $line"
    
        done
    fi
    
    return $exitcode
}


debug_rotate_logs_by_size() {

    [ ! -f "$DEBUG_LOG" ] && return

    local size=$(wc -c < "$DEBUG_LOG")
    local max_size=$((1024 * $DEBUG_LOG_MAX_SIZE))

    if [ $size -gt $max_size ]; then

        local old_num=1
        while [ -f "$DEBUG_PATH/wg-autoconf-OLD-$old_num.log" ]; do
            old_num=$((old_num + 1))
        done

        mv "$DEBUG_LOG" "$DEBUG_PATH/wg-autoconf-OLD-$old_num.log"

        debug_init_log
        debug_write "Log rotated to OLD-$old_num"
    fi

}

debug_show() {

    if [ -f "$DEBUG_LOG" ]; then
        cat "$DEBUG_LOG"
    else
        error "Logs not found: $DEBUG_LOG !"
    fi
}

debug_show_live() {

    if ! debug_is_active; then
        error "Debug is not active. Use: wg-autoconf debug on"
    fi

    if [ -f "$DEBUG_LOG" ]; then
        tail -f "$DEBUG_LOG"
    else
        error "Logs not found: $DEBUG_LOG !"
    fi
}

debug_clear() {

    # VERIFY STATE
    if [ "$(debug_state_read)" = "1" ]; then

        error "Debug session already active. Use: wg-autoconf debug off"

    fi

    echo ""
    local old_count=$(find "$DEBUG_PATH" -name "wg-autoconf-OLD-*.log" 2>/dev/null | wc -l)

    warning "This action is destructive:"
    echo ""

    # CURRENT
    if [ -f "$DEBUG_LOG" ]; then

        local size=$(du -h "$DEBUG_LOG" | awk '{print $1}')
        echo "  $DEBUG_LOG - Current log ($size)"

    fi


    # OLDS
    if [ $old_count -gt 0 ]; then

        find "$DEBUG_PATH" -name "wg-autoconf-OLD-*.log" 2>/dev/null |

        while read -r file; do
            local size=$(du -h "$file" | awk '{print $1}')
            echo "  $file - Old file ($size)"
        done

    fi

    if [ ! -f "$DEBUG_LOG" ] && [ $old_count -eq 0 ]; then

        warning "  No log files found!"
        return 0

    fi

    echo ""

    printf "${YELLOW}Continue? (${GREEN}y${YELLOW}/${RED}N${YELLOW}):${NC} "
    read -r confirm
    case "$confirm" in
        y|Y|yes|YES|Yes|okidoki|OKIDOKI|Okidoki|OkiDoki)
            rm -f "$DEBUG_LOG" "$DEBUG_PATH/wg-autoconf-OLD-"*.log 2>/dev/null
            success "Debug logs cleared!"
            ;;
        *)
            log "Cancelled by the user!"
            ;;
    esac
}

debug_status() {

    echo ""
    ui_lines 50 "${YELLOW}DEBUG STATUS${NC}"
    echo ""

    local state=$(debug_state_read)

    if [ "$state" = "1" ]; then
        echo -e "${YELLOW}Status:${NC}           ${GREEN}ACTIVE${NC}"
    else
        echo -e "${YELLOW}Status:${NC}           ${RED}INACTIVE${NC}"
    fi

    echo -e "${YELLOW}Log path/file:    $DEBUG_LOG${NC}"
    echo ""


    # (GET AND) SHOW SIZES
    if [ -f "$DEBUG_LOG" ]; then

        local size=$(du -h "$DEBUG_LOG" | awk '{print $1}')
        local lines=$(wc -l < "$DEBUG_LOG")

        echo -e "${YELLOW}Current log:${NC}      ${GREEN}$size ($lines lines)${NC}"

    else

        echo -e "${YELLOW}Current log:${NC}      ${RED}Not created yet!${NC}"

    fi


    # SHOW OLD's SIZES if
    local old_count=$(find "$DEBUG_PATH" -name "wg-autoconf-OLD-*.log" 2>/dev/null | wc -l)

    if [ $old_count -gt 0 ]; then

        echo -e "${YELLOW}Old logs:${NC}         ${GREEN}$old_count file(s)${NC}"

        find "$DEBUG_PATH" -name "wg-autoconf-OLD-*.log" 2>/dev/null |

        while read -r file; do

            local size=$(du -h "$file" | awk '{print $1}')

            echo -e "  ${YELLOW}$(basename "$file"):${NC} ${GREEN}$size${NC}"

        done

    else
        echo -e "${YELLOW}Old logs:         None${NC}"
    fi

    echo ""
    ui_lines 50
}

debug_on() {

    # 1. VERITY
    if debug_is_active; then
        warning "Debug is already active"
        return 0
    fi

    # 2. STATE
    debug_state_write "1"
    debug_init_log

    debug_write "Debug mode activated by $(id -un)@$(cat /proc/sys/kernel/hostname)"

    # 3. RESULTS
    success "Debug activated!"
    echo ""
    echo -e "${YELLOW}Log file:${NC}         $DEBUG_LOG"
    echo ""
    echo -e "Now you can tail in another terminal:"
    echo -e "   ${GREEN}wg-autoconf debug live${NC}"
}

debug_off() {


    # 1. VERIFY
    if ! debug_is_active; then

        warning "Debug is already inactive"
        return 0

    fi

    # 2. STATE
    debug_write "Debug mode deactivated by $(id -un)@$(cat /proc/sys/kernel/hostname)"
    debug_state_write "0"


    # RESULTS
    success "Debug deactivated!"
}

debug_handler() {

    local action="$1"

    case "$action" in
        on)
            debug_on
            ;;
        off)
            debug_off
            ;;
        show)
            debug_show
            ;;
        live)
            debug_show_live
            ;;
        clear)
            debug_clear
            ;;
        status)
            debug_status
            ;;
        states)
            cat /usr/libexec/wg-autoconf/states
            ;;
        network)
            cat /etc/config/network
            ;;
        dhcp)
            cat /etc/config/dhcp
            ;;
        firewall)
            cat /etc/config/firewall
            ;;
        tables)
            cat /etc/iproute2/rt_tables
            ;;
        rules)
            ip rule show
            ;;
        chains)
            nft list ruleset | grep chain -A 3
            ;;
        nft)
            nft list ruleset
            ;;
        backups)
            ls -Rla /etc/config/*.BACKUP_PRE_WIREGUARD | awk -v YB="\033[1;33m" -v GN="\033[0;32m" -v NC="\033[0m" '{print YB " DATE:" NC "\t", $6, $7, $8, YB " - FILE: " NC GN $9 NC}'
            ;;
        *)
            error "${YELLOW}Usage: ${GREEN}wg-autoconf debug${NC} [${BLUE}on | off| show | live | clear | status | states | tables | network | dhcp | firewall${NC}]"
            ;;
    esac
}







# ###########################################################
# ██╗   ██╗██████╗██████╗ █████╗██╗   ██╗ █████╗██╗    ██████╗███████╗
# ██║     ║██╔═══╝██╔═══╝██╔═══╝╚██╗ ██╔╝██╔═══╝██║    ██╔═══╝██╔════╝
# ██║   ██║█████╗ █████╗ ██║     ╚████╔╝ ██║    ██║    █████╗ ███████╗
# ██║   ██║██╔══╝ ██╔══╝ ██║      ╚██╔╝  ██║    ██║    ██╔══╝ ╚════██║
# █████╗██║██║    ██████╗╚█████╗   ██║   ╚█████╗██████╗██████╗███████║
# ╚════╝╚═╝╚═╝    ╚═════╝ ╚════╝   ╚═╝    ╚════╝╚═════╝╚═════╝╚══════╝
# ###########################################################


#####################################################################
# WG-AUTOCONF STATE MANAGEMENT SYSTEM
#
# Unified state tracking for WireGuard interface lifecycle,
# configuration status, and upgrade state.
#
# State File: /usr/libexec/wg-autoconf/states (KEY=VALUE format)
#
# Global States:
#   IS_INSTALLED     - APK installed (1=yes, 0=no)
#   IS_FIRST_EXEC    - First execution after install/nuke (1=yes, 0=no)
#   IS_PREV_TO_UPGRADE - Pre-upgrade state (1=yes, 0=no)
#   IS_UPGRADED      - Post-upgrade state (1=yes, 0=no)
#
# Per-Interface States (ID_N_*):
#   ID_N_NAME                - Interface name (e.g., wg0)
#   ID_N_IS_CREATED          - Config created in UCI (1=yes, 0=no)
#   ID_N_IS_ACTIVE           - Interface up/running (1=yes, 0=no)
#   ID_N_IS_RT_TABLES_IN_USE - Routing tables configured (1=yes, 0=no)
#
#####################################################################



#####################################################################
# STATE_INIT - Initialize state file if it doesn't exist
#
# Creates state file with default values only if missing.
# Safe operation - does not overwrite existing state.
#
# Params: None
# Return: 0 on success, 1 if file already exists or mkdir fails
#
#####################################################################


state_safety() {

    
    # 0.    CORRUPTED CASES
    _corrupted() {
    
        echo ""
        ui_lines 79 "${RED}STATE FILE CORRUPTED${NC}"
        echo ""
        warning "State file has invalid format or is corrupted!"
        echo ""

        verbose echo -e "   ${YELLOW}This usually indicates:${NC}"
        verbose echo -e "     - Manual editing of state file (${RED}NEVER DO THIS${NC})"
        verbose echo -e "     - File corruption due to improper shutdown"
        verbose echo -e "     - Incomplete upgrade or installation"
        verbose echo -e "     - Filesystem corruption or overlay issues"
        verbose echo ""
        verbose echo -e "   ${YELLOW}CRITICAL:${NC} ${RED}This state file cannot be trusted or recovered${NC}"
        verbose echo -e "   ${YELLOW}ACTION REQUIRED:${NC} ${GREEN}A COMPLETE CLEANUP IS NECESSARY${NC}"
        verbose echo ""
        echo -e "   ${BLUE}wg-autoconf will now perform a FULL CLEANUP:${NC}"
        echo ""
        echo -e "   ${YELLOW}  THIS WILL RESET ALL EXISTING WIREGUARD CONFIGURATIONS ${NC}"
        echo -e "   ${YELLOW}   Any active VPN connections will be terminated${NC}"
        echo ""
        
        printf "${YELLOW}Proceed with FULL CLEANUP? (${GREEN}y${YELLOW}/${RED}N${YELLOW}):${NC} "
        
        read -r confirm
        case "$confirm" in
            y|Y|yes|YES|Yes|okidoki|OKIDOKI|Okidoki|OkiDoki)

                
                debug_write "[STATE SAFETY] User confirmed NUKE operation to recover corrupted state"

                echo ""
                verbose log "${BLUE}Initiating FULL CLEANUP to recover from corrupted states ...${NC}"
                
                cleanup "nuke" "" "silent"
                
                if [ -f "$STATE_FILE" ] && [ "$(head -1 "$STATE_FILE" 2>/dev/null)" = "IS_INSTALLED=1" ]; then
                    
                    debug_write "[STATE SAFETY] New valid state file created!"

                    success "State file successfully recreated!"
                    echo ""
                    log "${GREEN}System is now clean and ready for fresh WireGuard setup${NC}"
                    echo ""
                    
                    return 0
                
                else
                    
                    debug_write "[STATE SAFETY CRITICAL] State file still invalid after NUKE"

                    warning "${RED}CRITICAL${NC}: Failed to recreate state file even after NUKE!"
                    echo ""
                    echo -e "   ${RED}This indicates a deeper system problem:${NC}"
                    echo -e "     - Filesystem may be read-only or corrupted"
                    echo -e "     - $STATE_DIR may have incorrect permissions"
                    echo -e "     - Overlay filesystem issues"
                    echo ""
                    echo -e "   ${YELLOW}Manual intervention required:${NC}"
                    echo -e "     ${GREEN}1.${NC} Check filesystem: ${YELLOW}mount | grep overlay${NC}"
                    echo -e "     ${GREEN}2.${NC} Check permissions: ${YELLOW}ls -la $STATE_DIR${NC}"
                    echo -e "     ${GREEN}3.${NC} Try manual cleanup: ${YELLOW}rm -f $STATE_FILE${NC}"
                    echo -e "     ${GREEN}4.${NC} Reinstall: ${YELLOW}apk remove --purge wg-autoconf && apk add wg-autoconf${NC}"
                    echo ""
                    
                    return 1
                fi
                ;;
            *)

                debug_write "[STATE SAFETY] User cancelled NUKE operation, cannot proceed with corrupted state"
                
                echo ""
                warning "FULL CLEANUP cancelled by user"
                echo ""
                echo -e "   ${YELLOW}Cannot continue with corrupted state file${NC}"
                echo -e "   ${YELLOW}Run '${GREEN}wg-autoconf nuke${YELLOW}' manually to reset${NC}"
                echo ""
                
                return 1
                ;;
        esac
    }

    debug_write "[STATE SAFETY] Starting state file verification"

    

    # 1 IF EXIST
    if [ ! -f "$STATE_FILE" ]; then
        
        debug_write "[STATE SAFETY] State file DOES NOT EXIST: $STATE_FILE"
        _corrupted
        
        return $?
    
    fi

    
    # 2.    IF FIRST LINE IS EXACTLY "IS_INSTALLED=1"
    local first_line=$(head -1 "$STATE_FILE" 2>/dev/null | tr -d '\r\n')
    
    if [ "$first_line" != "IS_INSTALLED=1" ]; then
        
        debug_write "[STATE SAFETY] Invalid first line: '$first_line'"
        
        _corrupted
        return $?
    
    else
        
        debug_write "[STATE SAFETY] First line verification passed: IS_INSTALLED=1"
    
    fi

    


    # 3.    IF IS_PREV_TO_UPGRADE FLAG
    local prev_upgrade=$(state_read "IS_PREV_TO_UPGRADE" 2>/dev/null)
    
    if [ -z "$prev_upgrade" ]; then
        
        debug_write "[STATE SAFETY] IS_PREV_TO_UPGRADE not found"
        
        _corrupted
        return $?
    
    elif [ "$prev_upgrade" = "1" ]; then
        
        debug_write "[STATE SAFETY] IS_PREV_TO_UPGRADE = 1 - Calling upgrade_avoid_garbage"
        
        upgrade_avoid_garbage
        
    
    elif [ "$prev_upgrade" = "0" ]; then
        
        debug_write "[STATE SAFETY] IS_PREV_TO_UPGRADE verification passed: 0"
    
    else
        
        debug_write "[STATE SAFETY] IS_PREV_TO_UPGRADE invalid value: '$prev_upgrade'"
        _corrupted
        return $?
    
    fi

    
    

    # 4.    IF IS_UPGRADED FLAG
    local upgraded=$(state_read "IS_UPGRADED" 2>/dev/null)
    
    if [ -z "$upgraded" ]; then
        
        debug_write "[STATE SAFETY] IS_UPGRADED not found"
        
        _corrupted
        return $?
    
    elif [ "$upgraded" = "1" ]; then
        
        debug_write "[STATE SAFETY] IS_UPGRADED = 1, Post-upgrade state detected"
        
        echo ""
        ui_lines 79 "${YELLOW}POST-UPGRADE STATE DETECTED${NC}"
        echo ""
        warning "System is in post-upgrade state!"
        echo ""
        verbose echo -e "   ${YELLOW}This means:${NC}"
        verbose echo -e "     - wg-autoconf was upgraded while WireGuard was active"
        verbose echo -e "     - Your VPN connections may still be running"
        verbose echo -e "     - ${RED}Configuration state may be inconsistent${NC}"
        verbose echo ""
        echo -e "   ${BLUE}wg-autoconf will now:${NC}"
        echo -e "     ${GREEN}1.${NC} Reset to a normal upgrade state"
        echo -e "     ${GREEN}2.${NC} ${YELLOW}IMPORTANT: Flag reset does NOT fix potential configuration issues${NC}"
        echo ""
        echo -e "   ${YELLOW}RECOMMENDED:${NC}"
        echo -e "     - Terminate all active WireGuard connections"
        echo -e "     - Run '${GREEN}wg-autoconf nuke${YELLOW}' for complete cleanup"
        echo -e "     - Re-setup your VPN connections from scratch"
        echo ""
        ui_lines 79
        echo ""
        
        debug_write "[STATE SAFETY] Auto-resetting IS_UPGRADED from 1 to 0"
        state_write "IS_UPGRADED" "0" 2>/dev/null
        
    
    elif [ "$upgraded" = "0" ]; then
        
        debug_write "[STATE SAFETY] IS_UPGRADED verification passed: 0"
    
    else
        
        debug_write "[STATE SAFETY] IS_UPGRADED invalid value: '$upgraded'"
        _corrupted
        return $?
    fi

    debug_write "[STATE SAFETY] All state file checks passed successfully"
    return 0
}


state_init() {

    if [ ! -d "$STATE_DIR" ]; then

        mkdir -p "$STATE_DIR" 2>/dev/null || {
            
            error "Failed to create $STATE_DIR"
            return 1
        }
    fi


    if [ -f "$STATE_FILE" ]; then
        
        debug_write "[STATE] State file already exists, skipping initialization"
        return 0
    
    fi


    cat > "$STATE_FILE" 2>/dev/null << 'EOF'
IS_INSTALLED=1
IS_FIRST_EXEC=1
IS_PREV_TO_UPGRADE=0
IS_UPGRADED=0
EOF

    if [ -f "$STATE_FILE" ]; then

        debug_write "[STATE] State file initialised at $STATE_FILE"
        verbose success "State file initialised"
        
        return 0
    
    else
        
        error "Failed to create state file"
        return 1
    
    fi
}

#####################################################################
# STATE_READ - Read a value from state file
#
# Returns the value of a specific key from the state file.
# Returns empty string if key not found.
#
# Params:
#   $1: Key to read (e.g., "IS_INSTALLED", "ID_1_NAME")
#
# Return: 0 if key found, 1 if not found or file missing
#
# Output: The value (printed to stdout)
#
#####################################################################
state_read() {

    local key="$1"

    if [ -z "$key" ]; then
        debug_write "[STATE] state_read: key ($key) parameter missing"
        return 1
    fi

    if [ ! -f "$STATE_FILE" ]; then
        
        debug_write "[STATE] state_read: State file not found: $STATE_FILE"
        
        return 1
    
    fi

    local value=$(grep "^${key}=" "$STATE_FILE" 2>/dev/null | cut -d= -f2-)

    if [ -n "$value" ]; then
        
        echo "$value"
    
        return 0
    
    else
    
        return 1
    
    fi
}

#####################################################################
# STATE_WRITE - Write/update a key-value pair in state file
#
# Creates or updates a key in the state file. If key exists,
# replaces old value. If key doesn't exist, appends new entry.
#
# Params:
#   $1: Key to write (e.g., "IS_INSTALLED", "ID_1_IS_ACTIVE")
#   $2: Value to assign
#
# Return: 0 on success, 1 on failure
#
#####################################################################
state_write() {


    local key="$1"
    local value="$2"

    if [ -z "$key" ]; then

        debug_write "[STATE] state_write: key ($key) parameter missing"
        return 1
    
    fi


    if echo "$key" | grep -q "IS_[A-Z_]*$" && [ "$value" != "0" ] && [ "$value" != "1" ]; then
        
        debug_write "[STATE] state_write: WARNING! Boolean flag $key should be 0 or 1, got: $value"
    
    fi


    if [ ! -f "$STATE_FILE" ]; then
        
        debug_write "[STATE] state_write: State file not found, attempting state_init"
        state_init || return 1
    
    fi




    local counter=0
    local temp_file=""
    while [ $counter -lt 100 ]; do

        temp_file="${ATOMIC_PATHS}/states.write.${counter}.atomic"
        [ ! -f "$temp_file" ] && break
        counter=$((counter + 1))
    
    done
    [ $counter -ge 100 ] && error "Cannot create unique temp file for state_write"

    local found=0
    local output=""


    if ! [ -r "$STATE_FILE" ]; then
        
        debug_write "[STATE] state_write: Cannot read state file"
        return 1
    
    fi



    while IFS= read -r line || [ -n "$line" ]; do

        if [ -z "$line" ]; then
            continue
        fi
        
        if [ "${line#"#"}" != "$line" ]; then

            # DEBUG! r7
            # Foirce the line jump without \n BUUUUT using a literal newline with "

            output="${output}${line}
"
            continue
        fi
        
        local line_key="${line%%=*}"
        local line_value="${line#*=}"
        
        if [ "$line_key" = "$key" ]; then
            found=1
            output="${output}${key}=${value}
"
        else
            output="${output}${line_key}=${line_value}
"
        fi
    done < "$STATE_FILE"

    if [ $found -eq 0 ]; then
        output="${output}${key}=${value}
"
    fi


    debug_write "[STATE] state_write: Writing to temp: $temp_file"
    printf "%s" "$output" > "$temp_file" 2>/dev/null

    if [ ! -s "$temp_file" ]; then
        
        debug_write "[STATE] state_write: ERROR - temp file empty"
        rm -f "$temp_file" 2>/dev/null
        
        return 1
    
    fi


    if mv "$temp_file" "$STATE_FILE" 2>/dev/null; then
        
        debug_write "[STATE] state_write: Updated: ${key}=${value}"
        
        return 0
    
    else
        
        debug_write "[STATE] state_write: ERROR! Failed to replace state file"
        
        rm -f "$temp_file" 2>/dev/null
        
        return 1
    
    fi
}

#####################################################################
# STATE_GET_ID - Get interface ID by name
#
# Searches state file for an interface name and returns its ID.
# Interface names are stored as ID_N_NAME entries.
#
# Params:
#   $1: Interface name to search (e.g., "wg0")
#
# Return: 0 if found, 1 if not found
#
# Output: The ID number (e.g., "1" for ID_1_NAME)
#
#####################################################################
state_get_id() {

    local iface_name="$1"

    if [ -z "$iface_name" ]; then
        debug_write "[STATE] state_get_id: interface name missing"
        return 1
    fi

    if [ ! -f "$STATE_FILE" ]; then
        return 1
    fi

    local id=$(grep "^ID_.*_NAME=${iface_name}$" "$STATE_FILE" 2>/dev/null | \
               sed 's/^ID_\([0-9]*\)_NAME.*/\1/')

    if [ -n "$id" ]; then
        echo "$id"
        return 0
    else
        return 1
    fi
}

#####################################################################
# STATE_ADD_IFACE - Add new interface to state tracking
#
# Creates ID_N entries for a new WireGuard interface.
# Automatically finds next available ID and initializes all
# per-interface state flags.
#
# Params:
#   $1: Interface name (e.g., "wg0")
#
# Return: 0 on success, 1 if interface already tracked
#
# Output: The assigned ID (printed to stdout)
#
#####################################################################
state_add_iface() {
    local iface_name="$1"

    if [ -z "$iface_name" ]; then
        debug_write "[STATE] state_add_iface: interface name missing"
        return 1
    fi



    if state_get_id "$iface_name" >/dev/null 2>&1; then
        debug_write "[STATE] Interface $iface_name already tracked"
        return 1
    fi

    if [ ! -f "$STATE_FILE" ]; then
        state_init || return 1
    fi




    local counter=0
    local temp_file=""
    while [ $counter -lt 100 ]; do
        temp_file="${ATOMIC_PATHS}/states.add.${counter}.atomic"
        [ ! -f "$temp_file" ] && break
        counter=$((counter + 1))
    done
    [ $counter -ge 100 ] && error "Cannot create unique temp file for state_add_iface"




    local next_id=1
    local max_id=$(grep "^ID_.*_NAME=" "$STATE_FILE" 2>/dev/null | \
                   sed 's/^ID_\([0-9]*\)_NAME.*/\1/' | \
                   sort -n | tail -1)

    if [ -n "$max_id" ]; then
        next_id=$((max_id + 1))
    fi




    local output=""
    local file_exists=0
    

    if [ -f "$STATE_FILE" ] && [ -r "$STATE_FILE" ]; then
        file_exists=1
        while IFS= read -r line || [ -n "$line" ]; do

            output="${output}${line}
"
        done < "$STATE_FILE"
    fi


    output="${output}ID_${next_id}_NAME=${iface_name}
ID_${next_id}_IS_CREATED=0
ID_${next_id}_IS_ACTIVE=0
ID_${next_id}_IS_RT_TABLES_IN_USE=0
"




    debug_write "[STATE] state_add_iface: Writing to temp: $temp_file"
    printf "%s" "$output" > "$temp_file" 2>/dev/null

    if [ ! -s "$temp_file" ]; then
        
        debug_write "[STATE] state_add_iface: ERROR - temp file empty"
        rm -f "$temp_file" 2>/dev/null
        
        return 1
    fi





    if mv "$temp_file" "$STATE_FILE" 2>/dev/null; then
        
        debug_write "[STATE] Added interface: $iface_name (ID: $next_id)"
        echo "$next_id"
        
        return 0
    else
        debug_write "[STATE] state_add_iface: ERROR - Failed to replace state file"
        rm -f "$temp_file" 2>/dev/null
        return 1
    fi
}
#####################################################################
# STATE_REMOVE_IFACE - Remove interface from state tracking
#
# Deletes all ID_N_* entries associated with a specific interface.
# Removes interface by ID number.
#
# Params:
#   $1: Interface ID (e.g., "1" for ID_1_*)
#
# Return: 0 on success, 1 on failure
#
#####################################################################
state_remove_iface() {

    local id="$1"

    if [ -z "$id" ]; then
        
        debug_write "[STATE] state_remove_iface: ID parameter missing"
        return 1
    fi

    if [ ! -f "$STATE_FILE" ]; then
        
        debug_write "[STATE] state_remove_iface: State file not found"
        return 1
    fi


    if ! echo "$id" | grep -qE '^[0-9]+$'; then
        
        debug_write "[STATE] state_remove_iface: Invalid ID format (must be numeric): $id"
        return 1
    fi



    local total_ifaces_before=$(state_count_ifaces)
    debug_write "[STATE] state_remove_iface: Total interfaces before: $total_ifaces_before"




    local counter=0
    local temp_file=""

    while [ $counter -lt 100 ]; do

        temp_file="${ATOMIC_PATHS}/states.remove.${counter}.atomic"
        [ ! -f "$temp_file" ] && break
        counter=$((counter + 1))

    done
    [ $counter -ge 100 ] && error "Cannot create unique temp file for state_remove_iface"

    local iface_name=""
    local remaining_ifaces=0
    local output=""
    



    debug_write "[STATE] state_remove_iface: Processing ID $id"
    
    while IFS= read -r line || [ -n "$line" ]; do

        if [ -z "$line" ]; then
            continue
        fi
        
        if [ "${line#"#"}" != "$line" ]; then


            # DEBUG! r7
            # Foirce the line jump without \n BUUUUT using a literal newline with "
            output="${output}${line}
"
            continue
        fi
        
        local line_key="${line%%=*}"
        local line_value="${line#*=}"
        

        if [ "$line_key" = "ID_${id}_NAME" ]; then

            iface_name="$line_value"
            debug_write "[STATE] state_remove_iface: Found interface: $iface_name"

            continue
        fi
        


        if echo "$line_key" | grep -q "^ID_[0-9]*_NAME$"; then

            local other_id=$(echo "$line_key" | sed 's/^ID_\([0-9]*\)_NAME$/\1/')
            if [ "$other_id" != "$id" ]; then

                remaining_ifaces=$((remaining_ifaces + 1))

                # DEBUG! r7
                # Foirce the line jump without \n BUUUUT using a literal newline with "
                output="${output}${line}
"
            
            fi
            
            
            continue
        
        fi
        

        if echo "$line_key" | grep -q "^ID_${id}_"; then
            
            debug_write "[STATE] state_remove_iface: Filtering: $line_key"
            continue
        fi
        

        # DEBUG! r7
        # Foirce the line jump without \n BUUUUT using a literal newline with "
        output="${output}${line}
"
    
    
    done < "$STATE_FILE"
    


    if [ -z "$iface_name" ]; then
        
        debug_write "[STATE] state_remove_iface: Interface ID $id not found"
        return 1
    
    fi
    
    debug_write "[STATE] state_remove_iface: Remaining interfaces: $remaining_ifaces"
    

    
    
    # IF LAST IFACE
    if [ $remaining_ifaces -eq 0 ]; then

        debug_write "[STATE] state_remove_iface: Last interface removed, calling state_reset"
        
        if state_reset; then
            
            debug_write "[STATE] state_remove_iface: Reset complete for $iface_name"
            debug_write "[STATE] state_remove_iface: State file reinitialized to defaults"
            
            return 0
        
        else
            
            debug_write "[STATE] state_remove_iface: state_reset failed"
            return 1
        
        fi
    fi
    
    


    # IF MULTIPLE IFACES
    debug_write "[STATE] state_remove_iface: Writing temp file (preserving $remaining_ifaces interfaces)"
    printf "%s" "$output" > "$temp_file" 2>/dev/null
    
    if [ ! -s "$temp_file" ]; then
        
        debug_write "[STATE] state_remove_iface: ERROR - temp file empty"
        
        rm -f "$temp_file" 2>/dev/null
        return 1
   
    fi
    
    if mv "$temp_file" "$STATE_FILE" 2>/dev/null; then
        
        debug_write "[STATE] state_remove_iface: Successfully removed $iface_name (ID: $id)"
        debug_write "[STATE] state_remove_iface: Preserved $remaining_ifaces other interfaces"
        
        return 0
    
    else
        
        debug_write "[STATE] state_remove_iface: ERROR - mv failed"
        
        rm -f "$temp_file" 2>/dev/null
        return 1
    fi
}
#####################################################################
# STATE_LIST_IFACES - List all tracked interfaces
#
# Returns all interface names and their IDs from state file.
# Format: "ID:NAME ID:NAME ..."
#
# Params: None
#
# Return: 0 if interfaces found, 1 if none
#
# Output: Space-separated list of "ID:NAME" pairs
#
#####################################################################
#####################################################################
# STATE_LIST_IFACES
#####################################################################
state_list_ifaces() {

    if [ ! -f "$STATE_FILE" ]; then
        return 1
    fi

    local iface_list=""
    local line=""

    # DEBUG!
    # REmoved WHILE + PIPED SHELLS
    while IFS= read -r line || [ -n "$line" ]; do
        
        if echo "$line" | grep -q "^ID_[0-9]*_NAME="; then
            local id=$(echo "$line" | sed 's/^ID_\([0-9]*\)_NAME=.*/\1/')
            local name=$(echo "$line" | cut -d= -f2-)
            
            if [ -n "$id" ] && [ -n "$name" ]; then
                if [ -z "$iface_list" ]; then
                    iface_list="${id}:${name}"
                else
                    iface_list="${iface_list} ${id}:${name}"
                fi
            fi
        fi
    done < "$STATE_FILE"

    if [ -n "$iface_list" ]; then
        echo "$iface_list"
        return 0
    else
        return 1
    fi
}

state_count_ifaces() {


    if [ ! -f "$STATE_FILE" ]; then
        echo 0
        return 1
    fi

    local count=$(grep -c "^ID_.*_NAME=" "$STATE_FILE" 2>/dev/null)

    if [ -z "$count" ]; then
        count=0
    fi

    echo "$count"
    [ "$count" -gt 0 ] && return 0 || return 1
}

#####################################################################
# STATE_RESET - Reset state file to initial state
#
# Completely clears and reinitializes state file.
# Used during nuke/full cleanup when removing all configurations.
#
# WARNING: Destructive operation - clears all tracked interfaces!
#
# Params: None
#
# Return: 0 on success, 1 on failure
#
#####################################################################
state_reset() {

    if [ ! -f "$STATE_FILE" ]; then
        
        debug_write "[STATE] State file not found, initializing"
        return $(state_init)
    
    fi

    rm -f "$STATE_FILE" 2>/dev/null
    state_init || return 1

    debug_write "[STATE] State file reset to initial state"
    verbose success "State file reset"
    
    return 0
}

#####################################################################
# STATE_CHECK_FIRST_EXEC - Check if this is first execution
#
# Convenience function to check IS_FIRST_EXEC flag.
#
# Params: None
#
# Return: 0 if first exec (flag=1), 1 otherwise
#
#####################################################################
state_check_first_exec() {
    local first_exec=$(state_read "IS_FIRST_EXEC" 2>/dev/null)
    [ "$first_exec" = "1" ]
}

#####################################################################
# STATE_SET_FIRST_EXEC - Set first execution flag
#
# Params:
#   $1: Value (1=first exec, 0=not first)
#
# Return: 0 on success, 1 on failure
#
#####################################################################
state_set_first_exec() {
    local value="${1:-1}"
    state_write "IS_FIRST_EXEC" "$value"
}

#####################################################################
# STATE_GET_IFACE_STATE - Get all state flags for an interface
#
# Returns all state information for a specific interface.
# Format: "NAME=value|IS_CREATED=value|IS_ACTIVE=value|IS_RT_TABLES_IN_USE=value"
#
# Params:
#   $1: Interface name or ID (e.g., "wg0" or "1")
#
# Return: 0 if found, 1 if not found
#
# Output: Pipe-separated state values
#
#####################################################################
state_get_iface_state() {

    local iface="$1"

    if [ -z "$iface" ]; then
        return 1
    fi

    local id
    if echo "$iface" | grep -qE '^[0-9]+$'; then
        id="$iface"
    else
        id=$(state_get_id "$iface") || return 1
    fi

    if [ ! -f "$STATE_FILE" ]; then
        return 1
    fi



    local name=$(grep "^ID_${id}_NAME=" "$STATE_FILE" 2>/dev/null | cut -d= -f2-)
    local created=$(grep "^ID_${id}_IS_CREATED=" "$STATE_FILE" 2>/dev/null | cut -d= -f2-)
    local active=$(grep "^ID_${id}_IS_ACTIVE=" "$STATE_FILE" 2>/dev/null | cut -d= -f2-)
    local rt_tables=$(grep "^ID_${id}_IS_RT_TABLES_IN_USE=" "$STATE_FILE" 2>/dev/null | cut -d= -f2-)

    if [ -n "$name" ]; then
        echo "NAME=${name}|IS_CREATED=${created}|IS_ACTIVE=${active}|IS_RT_TABLES_IN_USE=${rt_tables}"
        return 0
    else
        return 1
    fi
}

#####################################################################
# STATE SERVER MANAGEMENT - SERVER FUNCTIONS
#####################################################################

state_server_create() {
    local server_name="$1"
    local subnet="$2"
    local dns="$3"
    local privkey="$4"
    local pubkey="$5"
    local port="$6"

    if [ -z "$server_name" ] || [ -z "$subnet" ] || [ -z "$privkey" ]; then
        return 1
    fi

    local server_id=$(grep "^SERVER_.*_NAME=" "$STATE_FILE" 2>/dev/null | wc -l)
    server_id=$((server_id + 1))

    state_write "SERVER_${server_id}_ID" "$server_id"
    state_write "SERVER_${server_id}_NAME" "$server_name"
    state_write "SERVER_${server_id}_SUBNET" "$subnet"
    state_write "SERVER_${server_id}_DNS" "$dns"
    state_write "SERVER_${server_id}_PRIVKEY" "$privkey"
    state_write "SERVER_${server_id}_PUBKEY" "$pubkey"
    state_write "SERVER_${server_id}_LISTEN_PORT" "$port"
    state_write "SERVER_${server_id}_NEXT_IP" "${subnet%.*}.2"
    state_write "SERVER_${server_id}_USER_COUNT" "0"

    debug_write "[SERVER STATE] Created: SERVER_${server_id} = $server_name"
    echo "$server_id"
    return 0
}

state_server_add_user() {
    local server_id="$1"
    local user_name="$2"
    local user_ip="$3"
    local user_pubkey="$4"
    local user_privkey="$5"

    if [ -z "$server_id" ] || [ -z "$user_name" ]; then
        return 1
    fi

    local user_count=$(state_read "SERVER_${server_id}_USER_COUNT" 2>/dev/null)
    [ -z "$user_count" ] && user_count=0
    
    local next_user=$((user_count + 1))

    state_write "SERVER_${server_id}_USER_${next_user}_NAME" "$user_name"
    state_write "SERVER_${server_id}_USER_${next_user}_IP" "$user_ip"
    state_write "SERVER_${server_id}_USER_${next_user}_PUBKEY" "$user_pubkey"
    state_write "SERVER_${server_id}_USER_${next_user}_PRIVKEY" "$user_privkey"
    state_write "SERVER_${server_id}_USER_${next_user}_CREATED" "$(date +%s)"
    state_write "SERVER_${server_id}_USER_${next_user}_LAST_HS" "0"
    state_write "SERVER_${server_id}_USER_${next_user}_BYTES_RX" "0"
    state_write "SERVER_${server_id}_USER_${next_user}_BYTES_TX" "0"

    state_write "SERVER_${server_id}_USER_COUNT" "$next_user"

    local subnet=$(state_read "SERVER_${server_id}_SUBNET")
    local next_octet=$((${user_ip##*.} + 1))
    local next_ip="${subnet%.*}.$next_octet"
    state_write "SERVER_${server_id}_NEXT_IP" "$next_ip"

    debug_write "[SERVER STATE] Added user: SERVER_${server_id}_USER_${next_user} = $user_name @ $user_ip"
    return 0
}

state_server_revoke_user() {
    local server_id="$1"
    local user_index="$2"

    if [ -z "$server_id" ] || [ -z "$user_index" ]; then
        return 1
    fi

    local temp_file="${STATE_FILE}.tmp.$$"
    grep -v "^SERVER_${server_id}_USER_${user_index}_" "$STATE_FILE" > "$temp_file"
    
    if mv "$temp_file" "$STATE_FILE"; then
        debug_write "[SERVER STATE] Revoked user: SERVER_${server_id}_USER_${user_index}"
        return 0
    else
        rm -f "$temp_file"
        return 1
    fi
}

state_server_list_users() {
    local server_id="$1"
    
    if [ -z "$server_id" ]; then
        return 1
    fi

    local user_count=$(state_read "SERVER_${server_id}_USER_COUNT" 2>/dev/null)
    [ -z "$user_count" ] && user_count=0

    if [ "$user_count" -eq 0 ]; then
        return 1
    fi

    for i in $(seq 1 "$user_count"); do
        local user_name=$(state_read "SERVER_${server_id}_USER_${i}_NAME" 2>/dev/null)
        if [ -n "$user_name" ]; then
            echo "$i:$user_name"
        fi
    done
    return 0
}

state_server_get_next_ip() {
    local server_id="$1"
    
    if [ -z "$server_id" ]; then
        return 1
    fi

    state_read "SERVER_${server_id}_NEXT_IP" 2>/dev/null
    return $?
}

state_server_delete() {
    local server_id="$1"

    if [ -z "$server_id" ]; then
        return 1
    fi

    local temp_file="${STATE_FILE}.tmp.$$"
    grep -v "^SERVER_${server_id}_" "$STATE_FILE" > "$temp_file"
    
    if mv "$temp_file" "$STATE_FILE"; then
        debug_write "[SERVER STATE] Deleted: SERVER_${server_id}"
        return 0
    else
        rm -f "$temp_file"
        return 1
    fi
}

state_server_exists() {
    local server_id="$1"
    
    if [ -z "$server_id" ]; then
        return 1
    fi

    grep -q "^SERVER_${server_id}_NAME=" "$STATE_FILE" 2>/dev/null
    return $?
}

state_server_find_by_name() {
    local server_name="$1"
    
    if [ -z "$server_name" ]; then
        return 1
    fi

    # Buscar con o sin comillas
    local result=$(grep "^SERVER_.*_NAME=$server_name$\|^SERVER_.*_NAME=\"$server_name\"$" "$STATE_FILE" 2>/dev/null | cut -d_ -f2)
    
    if [ -n "$result" ]; then
        echo "$result"
        return 0
    else
        return 1
    fi
}

#####################################################################
#
# ██████╗ ██████╗ ███████╗    ██╗███╗   ██╗██╗████████╗
# ██╔══██╗██╔══██╗██╔════╝    ██║████╗  ██║██║╚══██╔══╝
# ██████╔╝██████╔╝█████╗      ██║██╔██╗ ██║██║   ██║   
# ██╔═══╝ ██╔══██╗██╔══╝      ██║██║╚██╗██║██║   ██║   
# ██║     ██║  ██║███████╗    ██║██║ ╚████║██║   ██║   
# ╚═╝     ╚═╝  ╚═╝╚══════╝    ╚═╝╚═╝  ╚═══╝╚═╝   ╚═╝  
#
#####################################################################

# 1. UNCONDITIONALS 
#load_user_settings
upgrade_avoid_garbage
state_safety



###########################################################
# ███╗   ███╗ █████╗ ██╗███╗   ██╗
# ████╗ ████║██╔══██╗██║████╗  ██║
# ██╔████╔██║███████║██║██╔██╗ ██║
# ██║╚██╔╝██║██╔══██║██║██║╚██╗██║
# ██║ ╚═╝ ██║██║  ██║██║██║ ╚████║
# ╚═╝     ╚═╝╚═╝  ╚═╝╚═╝╚═╝  ╚═══╝
###########################################################
###########################################################
# MAIN - Command parsing and routing
###########################################################

verbose=0
cmd=""
cmd_args=""


# 1. PROCESS GLOBAL FLAGS (--verbose/-v, --help/-h)

# Check for --verbose/-v at beginning
if [ "$1" = "--verbose" ] || [ "$1" = "-v" ]; then
    verbose=1
    shift
fi

# Check for --verbose/-v at end
if [ $# -gt 0 ]; then
    last_arg=""
    for arg in "$@"; do
        last_arg="$arg"
    done
    
    if [ "$last_arg" = "--verbose" ] || [ "$last_arg" = "-v" ]; then
        verbose=1
        new_args=""
        first=1
        for arg in "$@"; do
            if [ "$arg" = "$last_arg" ]; then
                continue
            fi
            if [ $first -eq 1 ]; then
                new_args="$arg"
                first=0
            else
                new_args="$new_args $arg"
            fi
        done
        set -- $new_args
    fi
fi

# Check for help
if [ "$1" = "--help" ] || [ "$1" = "-h" ] || [ "$1" = "help" ]; then
    show_usage
    exit 0
fi

VERBOSE=$verbose

if [ $# -eq 0 ]; then
    show_header
    exit 0
fi

cmd="$1"
shift

while [ $# -gt 0 ]; do
    cmd_args="$cmd_args $1"
    shift
done

cmd_args=$(echo "$cmd_args" | sed 's/^ //')


# 3. EXTRACT POSITIONAL ARGUMENTS
arg1=$(echo "$cmd_args" | awk '{print $1}')
arg2=$(echo "$cmd_args" | awk '{print $2}')
arg3=$(echo "$cmd_args" | awk '{print $3}')


# 4. COMMAND DISPATCHER
case "$cmd" in
    docs)
        show_minidoc
        ;;
    list)
        list_configs
        ;;
    
    list-full)
        list_configs_full
        ;;
    
    test)
        if [ -n "$arg1" ]; then
            test_config "$arg1"
        else
            show_header
            exit 1
        fi
        ;;
    server)
        server_handler "$arg1" "$arg2" "$arg3"
        ;;
    setup)
        if [ -n "$arg1" ]; then
            setup_wireguard "$arg1"
        else
            show_header
            exit 1
        fi
        ;;
    
    manual)
        setup_wireguard "$arg1" "manual"
        ;;
    
    up)
        if [ -n "$arg1" ]; then
            activate_interface "$arg1"
        else
            show_header
            exit 1
        fi
        ;;
    
    down)
        if [ -n "$arg1" ]; then
            deactivate_interface "$arg1"
        else
            show_header
            exit 1
        fi
        ;;
    remove)
        if [ -n "$arg1" ]; then
            remove_wireguard "$arg1" ""
        else
            show_header
            exit 1
        fi
        ;;
    status)
        show_status "$arg1"
        ;;
    clean)
        if [ -n "$arg1" ]; then
            cleanup "single" "$arg1" ""
        else
            cleanup "interactive" "" ""
        fi
        ;;
    nuke)
        cleanup "nuke" "" ""
        ;;
    backups)
        case "$arg1" in
            show)
                show_backups
                ;;
            restore)
                restore_backups "$arg2"
                ;;
            diag)
                if [ -n "$arg2" ]; then
                    diagnose_backup_issue "/etc/config/$arg2"
                else
                    for config in network dhcp firewall; do
                        diagnose_backup_issue "/etc/config/$config"
                    done
                fi
                ;;
            cleanup)
                cleanup_backup_files "$arg2"
                ;;
            *)
                show_header
                exit 1
                ;;
        esac
        ;;
    
    routes)
        case "$arg1" in
            set)
                if [ -n "$arg2" ] && [ -n "$arg3" ]; then
                    set_lan_routes "$arg2" "$arg3"
                else
                    show_header
                    exit 1
                fi
                ;;
            unset)
                if [ -n "$arg2" ] && [ -n "$arg3" ]; then
                    unset_lan_routes "$arg2" "$arg3"
                else
                    show_header
                    exit 1
                fi
                ;;
            show)
                show_routes "$arg2"
                ;;
            *)
                show_header
                exit 1
                ;;
        esac
        ;;
    
    debug)
        debug_handler "$arg1"
        ;;
    
    upgrade)
        upgrade_app
        ;;
    settings|config)
        case "$arg1" in
            show)
                [ -f "$USER_SETTINGS_FILE" ] && cat "$USER_SETTINGS_FILE" || echo "(using built-in defaults)"
                ;;
            set)
                set_user_setting "$arg2" "$arg3"
                ;;
            edit)
                ${EDITOR:-vi} "$USER_SETTINGS_FILE"
                load_user_settings
                ;;
            reset)
                rm -f "$USER_SETTINGS_FILE" 2>/dev/null
                load_user_settings
                success "Settings reset to defaults"
                ;;
            *)
                echo "Usage: wg-autoconf settings [show|set|edit|reset]"
                ;;
        esac
        ;;
    *)
        show_header
        echo ""
        error "Invalid CMD: ${NC} $cmd"
        ;;
esac