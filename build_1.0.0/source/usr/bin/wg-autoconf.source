STATE_FILE="/usr/libexec/wg-autoconf/states"
STATE_DIR="/usr/libexec/wg-autoconf"

WG_CONF_DIR="/etc/wireguard"

NETWORK_CONF="/etc/config/network"
DHCP_CONF="/etc/config/dhcp"
FIREWALL_CONF="/etc/config/firewall"


NFT_INCLUDE_DIR="/usr/share/nftables.d"
NFT_SRCNAT_DIR="${NFT_INCLUDE_DIR}/chain-post/srcnat"
NFT_FORWARD_DIR="${NFT_INCLUDE_DIR}/chain-post/forward"

BACKUP_PATHS="$NETWORK_CONF $DHCP_CONF $FIREWALL_CONF"

ATOMIC_PATHS="/usr/libexec/wg-autoconf/atomics"

