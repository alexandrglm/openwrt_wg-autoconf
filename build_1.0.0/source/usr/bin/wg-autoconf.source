#   Use of "$@" to execute cmds may have quoting issues in older ash
#   Complex arguments with spaces or special characters may not be preserved correctly
#####################################################################
# VERBOSE MODE
#####################################################################
verbose() {

    if [ "$VERBOSE" = "1" ]; then
        "$@"
    fi
}

#####################################################################
# CMD HEADER
#####################################################################
show_header() {

    echo ""
    echo -e "${GREEN}WireGuard Auto-Config${NC} - ${RED}$VERSION${NC}"
    echo ""
    echo -e "   ${BLUE}Usage:${NC} wg-autoconf ${YELLOW}COMMAND${NC} ${GREEN}<args>${NC}"
    echo -e "     ${YELLOW}'wg-autoconf --help' for full help${NC}"
    echo ""
}

#####################################################################
# SHOW HELP/UPSAGE
#####################################################################
# DEBUG!
# TODO: Update commnands, look for more "likable" styles, idk
show_usage() {
    
    echo ""
    ui_lines 80 "${GREEN}WireGuard Auto-Config${NC} - ${RED}$VERSION${NC} HELP"
    echo ""

    echo -e "${GREEN}Configuration Management:${NC}"
    echo -e " ${YELLOW}list${NC}                             - List Available .conf files at /etc/wireguard"
    echo -e " ${YELLOW}list${NC} ${GREEN}<config file>${NC}               - Show configuration"
    echo -e " ${YELLOW}test${NC} ${GREEN}<config file>${NC}               - Test a .conf file"
    echo ""
    echo -e " ${YELLOW}setup${NC} ${GREEN}<config file>${NC}              - Setup from .conf (creates wg_<CONF_NAME>)"
    echo -e " ${YELLOW}manual${NC}                           - Create new advanced configuration from scratch"
    echo -e " ${YELLOW}manual${NC} ${GREEN}<config file>${NC}             - Advanced mode using existing .conf as base"
    echo ""

    echo -e "${BLUE}Interface Control:${NC}"
    echo -e " ${YELLOW}status${NC}                           - Show all WG interfaces"
    echo -e " ${YELLOW}status${NC} ${GREEN}<wg iface>${NC}                - Show specific WG interface"
    echo -e " ${YELLOW}up${NC} ${GREEN}<wg iface>${NC}                    - Enable WG interface"
    echo -e " ${YELLOW}down${NC} ${GREEN}<wg iface>${NC}                  - Disable WG interface"
    echo -e " ${YELLOW}remove${NC} ${GREEN}<wg iface>${NC}                - Delete WG interface (unsetup)"
    echo ""

    echo -e "${YELLOW}Routing & Traffic Control:${NC}"
    echo -e " ${YELLOW}routes show${NC}                      - Show all routes"
    echo -e " ${YELLOW}routes show${NC} ${GREEN}<wg iface>${NC}           - Show routes for WG interface"
    echo -e " ${YELLOW}routes set${NC} ${GREEN}<wg iface> <iface>${NC}    - Set routes: LAN -> WG"
    echo -e " ${YELLOW}routes unset${NC} ${GREEN}<wg iface> <iface>${NC}  - Unset routes: LAN -> WG"
    echo ""

    echo -e "\033[0;35mBackup/Recovery & Upgrade:\033[0m"
    echo -e " ${YELLOW}backups show${NC}                     - List available backups"
    echo -e " ${YELLOW}backups restore${NC} ${GREEN}<file>${NC}           - Restore backup files"
    echo ""
    echo -e " ${YELLOW}upgrade${NC}                          - Upgrade wg-autoconf safely"
    echo ""

    echo -e "${RED}Cleanup Operations:${NC}"
    echo -e " ${YELLOW}clean${NC}                            - Clean WG configs (interactive)"
    echo -e " ${YELLOW}clean${NC} ${GREEN}<wg iface>${NC}                 - Clean specific interface"
    echo -e " ${RED}nuke${NC}                             - ${RED}Force removal & cleanup ALL WG configs (no prompts)${NC}"

    echo ""
    echo -e "${GREEN}Verbosity Mode:${NC}"
    echo -e " ${YELLOW}--verbose / -v${NC}                   - Verbose mode for any command"

    echo ""
    echo -e "${GREEN}Debug Mode:${NC}"
    echo -e " ${YELLOW}debug on / off${NC}                   - Enable/Disable Debug logging functions"
    echo -e " ${YELLOW}debug clear${NC}                      - Clear latest/backuped logs"
    echo -e " ${YELLOW}debug show${NC}                       - Show latest debug log"
    echo -e " ${YELLOW}debug live${NC}                       - Tail debug log live"

    echo ""
    ui_lines 80 "${BLUE}Usage:${NC} wg-autoconf ${YELLOW}COMMAND${NC} ${GREEN}<args>${NC}"

    exit 1
}



#####################################################################
#
# ██╗     ██╗███████╗████████╗
# ██║     ██║██╔════╝╚══██╔══╝
# ██║     ██║███████╗   ██║
# ██║     ██║╚════██║   ██║
# ███████╗██║███████║   ██║
# ╚══════╝╚═╝╚══════╝   ╚═╝
#
#####################################################################
# DONE! Make really useful both methods

# 1   LIST
list_configs() {

    local file_arg="$1"


    if [ -n "$file_arg" ]; then

        local conf_file="$WG_CONF_DIR/$file_arg.conf"

        if [ ! -f "$conf_file" ]; then
            
            error "Configuration file $file_arg not found!"
        
        fi
        
        log "Configuration file: $file_arg"
        echo ""
        echo -e "${BLUE}$(basename $conf_file)${NC}"
        ui_lines 50
        cat "$conf_file" | sed 's/^/   /'
        echo ""
        ui_lines 50
        return
    fi



    echo ""
    ui_lines 49 "${YELLOW}Config files found on ${GREEN}$WG_CONF_DIR${NC}"
    echo ""

    local count=0
    local line=""
    local found=0

    for conf in "$WG_CONF_DIR"/*.conf; do

        [ -f "$conf" ] || continue

        found=1
        name=$(basename "$conf" .conf)

        if [ $count -eq 5 ]; then

            echo -e "${GREEN}$line${NC}"

            line="   $name"
            count=1

        else

            if [ $count -eq 0 ]; then

                line="   $name"

            else

                line="$line ${NC}|${GREEN} $name${NC}"
            fi

            count=$((count + 1))
        fi
    done



    if [ $found -eq 0 ]; then

        warning "No configuration files found in $WG_CONF_DIR"

    else

        [ -n "$line" ] && echo -e "${GREEN}$line${NC}"

    fi

    echo ""
    ui_lines 50
}
#####################################################################
# 2.    LIST-FULL
list_configs_full() {

    ui_lines 79 "${YELLOW} Full Configs Inspection${NC}"
    echo ""

    local found=0

    for conf in "$WG_CONF_DIR"/*.conf; do
        [ -f "$conf" ] || continue
        found=1

        ui_lines 40 "${BLUE}$(basename $conf)${NC}"
        cat "$conf" | sed 's/^/   /'
        echo ""
        # ui_lines 40
        echo ""
    done

    if [ $found -eq 0 ]; then
        warning "No configuration files found in $WG_CONF_DIR"
    fi

    ui_lines 80
}



#####################################################################
#
# ████████╗███████╗███████╗████████╗
# ╚══██╔══╝██╔════╝██╔════╝╚══██╔══╝
#    ██║   █████╗  ███████╗   ██║
#    ██║   ██╔══╝  ╚════██║   ██║
#    ██║   ███████╗███████║   ██║
#    ╚═╝   ╚══════╝╚══════╝   ╚═╝
#
#####################################################################
# DONE!: Make really useful a test mode, not onlye check key params
#    WG-AUTOCONF test
test_config() {

    local CONF_NAME="$1"
    local conf_file="$WG_CONF_DIR/$CONF_NAME.conf"


    # 1.1   IF EXISTS
    [ -f "$conf_file" ] || error "Configuration file ${YELLOW}$conf_file${NC} not found!"

    verbose echo ""
    verbose log "Testing ${YELLOW}$CONF_NAME${NC} ..."
    echo ""
    
    # 1.2   CONF VLAIDATIOPN
    ui_lines 79 "${YELLOW}FULL CONFIGURATION VALIDATION${NC}"
    echo ""
    
    # 1.2.1 REQUIRED FIELDS FROM COND
    local required_fields="PrivateKey PublicKey Address Endpoint AllowedIPs"
    local optional_fields="DNS"
    
    local all_ok=1
    
    # 2. CHECK - VALIDATE FIELDS
    for field in $required_fields; do
        
        # 2.1 SETUP_WIREGUARD (SETUP / MANUAL) MODE VALIDATION
        local value=$(get_conf_value "$field" "$conf_file" "raw")
        

        if [ -z "$value" ]; then
            
            echo -e "  ${RED}[ERROR]${NC}  [MISSING] $field: NOT FOUND" >&2
            all_ok=0
        

        # 2.2 TEST_CONFIGS MODE VALIDATIO
        else
            
            local validation_output=""
            
            validation_output=$(validate_wg_config "auto" "$conf_file" "$field" "$value" "1" 2>&1)
            
            local validation_exit=$?
            
            if [ $validation_exit -eq 0 ]; then
                
                success "  $field: ${GREEN}Valid${NC}"
               
                
                local display_value="$value"
                
                # 2.2.1 VALUE CLEANINGS
                [ ${#display_value} -gt 50 ] && display_value="${display_value:0:47}..."
                


                # 2.3   FOR VALID VALUE
                echo -e "        ${BLUE}Value:${NC} $display_value"
            
            
            # 2.4   FOR AN INVALID VALUE
            else
                

                echo -e "  ${RED}[INVALID]${NC} $field: Failed Validation!"
                
                if [ -n "$validation_output" ]; then
                    
                    local error_msg=$(echo "$validation_output" | grep -o "VALIDATION_ERROR: .*" | sed 's/VALIDATION_ERROR: //' | head -1)
                    
                    [ -n "$error_msg" ] && echo -e "        ${RED}Error:${NC} $error_msg"
                fi
                
                all_ok=0
            
            fi
    
        fi
    
        echo ""
    
    done
    
    # 3. OPTIONAL (DNS SPECIFIC ISSUES) VALIDATION
    # DEBUG! r7 ... maybe allowed_ips should be there
    #               Room for future SWITCH/BYPASS
    for field in $optional_fields; do
        
        local value=$(get_conf_value "$field" "$conf_file" "raw")
        
        if [ -z "$value" ]; then
            
            warning "  [OPTIONAL] $field: Not specified (will use defaults)"
        
        else
            
            # 3.1   OPTIONALS FOR TEST_CONFIG() MODE
            local validation_output=""
            validation_output=$(validate_wg_config "auto" "$conf_file" "$field" "$value" "1" 2>&1)
            local validation_exit=$?
            
            
            if [ $validation_exit -eq 0 ]; then
                
                success "  $field: ${GREEN}Valid${NC}"
                
                # 3.1.1 VALUE CLEANINGS
                
                local display_value="$value"
                
                [ ${#display_value} -gt 50 ] && display_value="${display_value:0:47}..."
                
                
                # 3.2   FOR A VALID (OPTIONAL) VALUE
                echo -e "        ${BLUE}Value:${NC} $display_value"
            
            

            # 3.3   FOR A INVALID (OPTIONAL) VALUE
            else
                
                
                echo -e "  ${RED}[INVALID]${NC} $field: Failed Validation!"
                
                if [ -n "$validation_output" ]; then
                    
                    local error_msg=$(echo "$validation_output" | grep -o "VALIDATION_ERROR: .*" | sed 's/VALIDATION_ERROR: //' | head -1)
                    
                    [ -n "$error_msg" ] && echo -e "        ${RED}Error:${NC} $error_msg"
                
                fi
                
                all_ok=0
            fi
        fi
        
        echo ""
    
    
    done




    # 4. PUBKEY/PRIVKEY VALIDATIONS CLEAN_WG_KEY()
    echo ""
    ui_lines 49 "${YELLOW}KEY CRYPTO VALIDATION${NC}"
    echo ""
    
    local private_key_raw=$(get_conf_value "PrivateKey" "$conf_file" "raw")
    local public_key_raw=$(get_conf_value "PublicKey" "$conf_file" "raw")
    
    if [ -n "$private_key_raw" ]; then
        
        local private_key_clean=$(clean_wg_key "$private_key_raw")
        
        if echo "$private_key_clean" | wg pubkey >/dev/null 2>&1; then
            
            success "  PrivateKey: ${GREEN}Cryptographically valid${NC}"
            echo -e "        ${BLUE}Key:${NC} $(echo "$private_key_clean" | cut -c1-15)..."
        
        else

            echo -e "  ${RED}[INVALID]${NC} PrivateKey: ${RED}Not a valid WireGuard key!${NC}"
            all_ok=0
        fi
    
    fi
    
    if [ -n "$public_key_raw" ]; then
        
        local public_key_clean=$(clean_wg_key "$public_key_raw")
        
        if echo "$public_key_clean" | wg pubkey >/dev/null 2>&1; then
            
            success "  PublicKey: ${GREEN}Cryptographically valid${NC}"
            echo -e "        ${BLUE}Key:${NC} $(echo "$public_key_clean" | cut -c1-15)..."
        
        else
            
            echo -e "  ${RED}[INVALID]${NC} PublicKey: ${RED}Not a valid WireGuard key!${NC}"
            all_ok=0
        fi
    fi





    # 5. ENDPOINT
    echo ""
    ui_lines 49 "${YELLOW}ENDPOINT DETAILS${NC}"
    echo ""
    

    # 5.1 GET
    local endpoint=$(get_conf_value "Endpoint" "$conf_file" "raw")
    
    # 5.2 SPLIT host:port
    if [ -n "$endpoint" ]; then
        
        local host_part=$(echo "$endpoint" | cut -d: -f1)
        local port_part=$(echo "$endpoint" | cut -d: -f2)
        
        [ -z "$port_part" ] && port_part="$DEFAULT_PORT"
        
        echo -e "  ${YELLOW}Host: ${GREEN}$host_part${NC}"
        echo -e "  ${YELLOW}Port: ${GREEN}$port_part${NC}"
        
        
        # 5.3 CHECK IF HOST UP (nslookup)
        # DEBUG! ... nslookup from Busybox ... or what else?
        if ! echo "$host_part" | grep -qE '^([0-9]{1,3}\.){3}[0-9]{1,3}$' && \
           ! echo "$host_part" | grep -qE '^\[.*\]$'; then
            
            verbose echo ""
            verbose warning "  [NOTE] Hostname detected: $host_part"
            verbose echo ""

            if nslookup "$host_part" >/dev/null 2>&1; then
                
                echo ""
                success "  ${GREEN}Hostname resolves correctly!${NC}"
            
            else
                
                echo ""
                warning "  ${RED}Hostname does not resolve (may cause connection issues)!${NC}"
                all_ok=0
            
            fi
        fi
    fi
    


    # 6. SHOW
    echo ""
    ui_lines 49 "${YELLOW}TEST RESULTS${NC}"
    
    if [ $all_ok -eq 1 ]; then

        echo ""
        success "${GREEN}CONFIGURATION FILE IS VALID AND READY FOR USE!${NC}"
        echo ""
        echo -e "   ${BLUE}You can now use:${NC}"
        echo -e "     ${YELLOW}wg-autoconf setup ${GREEN}$CONF_NAME${NC}"
        echo ""
    
    else
        echo ""
        warning "${RED}CONFIGURATION FILE HAS ERRORS!${NC}"
        echo ""
        echo -e " ${YELLOW}Please fix the issues above before using this configuration!${NC}"
        echo ""
    fi
    
    ui_lines 80
}

#####################################################################
#
# ███████╗███████╗████████╗██╗   ██╗██████╗
# ██╔════╝██╔════╝╚══██╔══╝██║   ██║██╔══██╗
# ███████╗█████╗     ██║   ██║   ██║██████╔╝
# ╚════██║██╔══╝     ██║   ██║   ██║██╔═══╝
# ███████║███████╗   ██║   ╚██████╔╝██║
# ╚══════╝╚══════╝   ╚═╝    ╚═════╝ ╚═╝
#
#####################################################################

# TODO:     Main idea, from here, will be to REFACTOR the three functions into a single one,  
#           preparing snippets with each necessary block for each file
#####################################################################
# WG-AUTOCONF SETUP NETWORK CONFIG
#####################################################################
setup_network_config() {

    local iface_name="$1"
    local private_key="$2"
    local address="$3"
    local public_key="$4"
    local endpoint_host="$5"
    local endpoint_port="$6"
    local allowed_ips="$7"
    local dns="$8"

    verbose log "Setting up NETWORK config for $iface_name..."
    debug_write "[SETUP NETWORK] Starting config for $iface_name"

    # 1. VALIDATE AND FORMAT DNS
    validate_config_value "DNS" "$dns" "manual"
    
    local dns_uci=$(get_conf_value "DNS" "" "uci" "$dns")


    # 2. IF EXIST IFACE
    if uci get "network.$iface_name" >/dev/null 2>&1; then
        
        debug_write "[SETUP NETWORK] Interface already exists: $iface_name"
        warning "Interface $iface_name already exists in network config"
        
        return 0
    
    fi


    # 3. GET NEXT TAG ID
    local tag_id=$(get_next_tag_id "$NETWORK_CONF" "network")
    debug_write "[SETUP NETWORK] Using tag id: $tag_id"


    # 3.1 IF TAG EXIST ->  SKIP
    if grep -q "# wg-autoconf network start id $tag_id" "$NETWORK_CONF" 2>/dev/null; then
        
        debug_write "[SETUP NETWORK ERROR] Tag id $tag_id already exists"
        warning "NETWORK tag with id $tag_id already exists. Skipping..."
        
        return 0
    fi


    # 4. GENERATE CONFIGURATION CONTENT
    local new_content="

# wg-autoconf network start id $tag_id
config interface '$iface_name'
    option proto 'wireguard'
    option private_key '$private_key'
    option addresses '$address'
    option dns '$dns_uci'

config wireguard_$iface_name '${iface_name}_peer'
    option public_key '$public_key'
    option endpoint_host '$endpoint_host'
    option endpoint_port '$endpoint_port'
    option route_allowed_ips '0'
    option persistent_keepalive '25'
"

    # 4.1 Add AllowedIPs as UCI list
    local allowed_ips_list=$(allowed_ips_to_uci "$allowed_ips")
    new_content="${new_content}${allowed_ips_list}
"
    new_content="${new_content}# wg-autoconf network end id $tag_id
"


    # 5. ATOMIC FILE OPERATIONS
    # DEBUG!    Room for atpmic funcs
    local atomic_temp="${ATOMIC_PATHS}/network.atomic"
    debug_write "[SETUP NETWORK] Using temp file for operations: $atomic_temp"
    
    # 5.1 ATOMIC CP OPER
    if ! cp "$NETWORK_CONF" "$atomic_temp" 2>/dev/null; then
        
        warning "Cannot copy ${YELLOW}network${NC} config for atomic operation!"
        return 1
    
    fi
    
    # 5.2 ADD NEW_CONTENT
    echo "$new_content" >> "$atomic_temp" 2>/dev/null
    
    # 5.3 ATOMIC MV OPER DE VUELTA
    if ! mv "$atomic_temp" "$NETWORK_CONF" 2>/dev/null; then
        
        warning "Atomic replacement of network config failed!"
        rm -f "$atomic_temp" 2>/dev/null
        
        return 1
    
    fi


    # 6. COMMIT UCI CHANGES
    debug_write "[SETUP NETWORK] Committing UCI network config"
    if ! uci commit network 2>/dev/null; then
        
        warning "Failed to commit network configuration"
        debug_write "[SETUP NETWORK ERROR] uci commit network failed"
        
        return 1
    fi


    # 7. D0NE!
    verbose success "Added NETWORK config for $iface_name (id: $tag_id)"
    debug_write "[SETUP NETWORK] Successfully added $iface_name with tag id $tag_id"
    
    return 0
}

#####################################################################
# WG-AUTOCONF setup DHCP config
#####################################################################
setup_dhcp_config() {

    local iface_name="$1"

    verbose log "Setting up DHCP config for $iface_name..."
    debug_write "[SETUP DHCP] Starting config for $iface_name"

    # 1. IFACE EXIST VERIFY
    if uci get "dhcp.$iface_name" >/dev/null 2>&1; then
        
        warning "DHCP config for $iface_name already exists"
        debug_write "[SETUP DHCP] Config already exists: $iface_name"
        
        return 0
    fi

    # 2. GET LATEST TAG ID
    local tag_id=$(get_next_tag_id "$DHCP_CONF" "dhcp")
    debug_write "[SETUP DHCP] Using tag id: $tag_id"

    # 2.1 DUPLICATED TAG VERUFUICATION
    if grep -q "# wg-autoconf dhcp start id $tag_id" "$DHCP_CONF" 2>/dev/null; then
        
        warning "DHCP tag with id $tag_id already exists. Skipping..."
        debug_write "[SETUP DHCP ERROR] Tag id $tag_id already exists"
        
        return 0
    
    fi

    # 3. PRE-SET CONTENT
    local new_content="
# wg-autoconf dhcp start id $tag_id
config dhcp '$iface_name'
    option interface '$iface_name'
    option ignore '1'
# wg-autoconf dhcp end id $tag_id
"

    # 5. ATOMIC OPERS
    local atomic_temp="${ATOMIC_PATHS}/dhcp.atomic"
    debug_write "[SETUP DHCP] Using atomic temp: $atomic_temp"
    
    # 5.1 cp native
    if ! cp "$DHCP_CONF" "$atomic_temp" 2>/dev/null; then
        
        warning "Cannot copy ${YELLOW}DHCP${NC} config for atomic operation!"
        return 1
    
    fi
    
    # 5.2 add content
    echo "$new_content" >> "$atomic_temp" 2>/dev/null
    

    # 5.3 Replace native with modified
    if ! mv "$atomic_temp" "$DHCP_CONF" 2>/dev/null; then
        
        warning "Atomic replacement of DHCP config failed!"
        rm -f "$atomic_temp" 2>/dev/null
        
        return 1
    fi

    # 6. COMMITS
    debug_write "[SETUP DHCP] Committing UCI DHCP config"
    
    if ! uci commit dhcp 2>/dev/null; then
        
        warning "Failed to commit ${YELLOW}DHCP${NC} configuration"
        debug_write "[SETUP DHCP ERROR] uci commit dhcp failed"
        
        return 1
    fi

    
    # D0ne!
    verbose success "Added DHCP config for $iface_name (id: $tag_id)"
    debug_write "[SETUP DHCP] Successfully added $iface_name with tag id $tag_id"
    
    return 0
}
#####################################################################
# WG-AUTOCONF setup Firewall config
#####################################################################
setup_firewall_config() {

    local iface_name="$1"
    local endpoint_port="$2"

    verbose log "Setting up Firewall config for $iface_name..."
    debug_write "[SETUP FIREWALL] Starting config for $iface_name (port: $endpoint_port)"

    # 1.    IF EXIST VERIFY
    if uci get "firewall.$iface_name" >/dev/null 2>&1; then
        
        warning "Firewall zone for $iface_name already exists"
        debug_write "[SETUP FIREWALL] Zone already exists: $iface_name"
        
        return 0
    fi

    # 2. GET ID TAGS, GET THE LATEST
    local tag_id=$(get_next_tag_id "$FIREWALL_CONF" "firewall")
    debug_write "[SETUP FIREWALL] Using tag id: $tag_id"

    # 2.1 DUPLICATE TAGS VERUFY
    if grep -q "# wg-autoconf firewall start id $tag_id" "$FIREWALL_CONF" 2>/dev/null; then
        
        warning "Firewall tag with id $tag_id already exists. Skipping..."
        debug_write "[SETUP FIREWALL ERROR] Tag id $tag_id already exists"
        
        return 0
    fi


    # 3. PRE-SET CONTENT
    local new_content="
# wg-autoconf firewall start id $tag_id

config zone
    option name '$iface_name'
    option input 'ACCEPT'
    option output 'ACCEPT'
    option forward 'ACCEPT'
    option masq '1'
    option mtu_fix '1'
    list network '$iface_name'

config rule
    option name 'Allow-WireGuard-$iface_name'
    option src 'wan'
    option dest_port '$endpoint_port'
    option proto 'udp'
    option target 'ACCEPT'

config forwarding
    option src '$iface_name'
    option dest 'wan'

# wg-autoconf firewall end id $tag_id
"

    # 5. FILE OPERATIONS
    local atomic_temp="${ATOMIC_PATHS}/firewall.atomic"
    debug_write "[SETUP FIREWALL] Using atomic temp: $atomic_temp"
    
    # 5.1 cp native
    if ! cp "$FIREWALL_CONF" "$atomic_temp" 2>/dev/null; then
        
        warning "Cannot copy ${YELLOW}firewall${NC} config for atomic operation!"
        
        return 1
    
    fi
    
    # 5.2 Add new content
    echo "$new_content" >> "$atomic_temp" 2>/dev/null
    
    # 5.3   Replace native with modified
    if ! mv "$atomic_temp" "$FIREWALL_CONF" 2>/dev/null; then
        
        warning "Atomic replacement of firewall config failed"
        rm -f "$atomic_temp" 2>/dev/null
        
        return 1
    
    fi

    # 6. COMMITS (AND INIT.D RELOAD)
    debug_write "[SETUP FIREWALL] Committing UCI firewall config"
    
    if ! uci commit firewall 2>/dev/null; then
        
        warning "Failed to commit firewall configuration"
        debug_write "[SETUP FIREWALL ERROR] uci commit firewall failed"
        
        return 1
    fi

    debug_write "[SETUP FIREWALL] Reloading firewall service"
    
    if ! /etc/init.d/firewall reload 2>/dev/null; then
        
        warning "Failed to reload firewall (configuration may still work)"
        debug_write "[SETUP FIREWALL WARNING] Firewall reload failed"
    
    else
        
        debug_write "[SETUP FIREWALL] Firewall reloaded successfully"
    
    fi

    
    # D0ne!
    verbose success "Added Firewall config for $iface_name (id: $tag_id, port: $endpoint_port)"
    debug_write "[SETUP FIREWALL] Successfully added $iface_name with tag id $tag_id"
    
    return 0
}


#####################################################################
# WG-AUTOCONF SETUP_WIREGUARD
#####################################################################
setup_wireguard() {

    local conf_name="$1"
    local mode="$2"
    local conf_file=""
    local is_manual=0


    # 0) UNCONDITIONAL PRE-CHECKS
    # upgrade_avoid_garbage, moved to init


    # A) MANUAL MODE DETECTION
    [ "$mode" = "manual" ] && is_manual=1


    # 1. CONFIGURATION FILE HANDLING
    # 1.1 When using conf file as base
    if [ -n "$conf_name" ]; then
        
        conf_file="$WG_CONF_DIR/$conf_name.conf"
        
        # DEBUG! Check redundances
        if [ ! -f "$conf_file" ]; then
        
            if [ $is_manual -eq 0 ]; then
        
                error "$conf_file is missing!!!"
        
            else
        
                warning "Configuration file not found: $conf_file"
                conf_file=""
        
            fi
        
        else
        
            if [ $is_manual -eq 1 ]; then
                log "Loading defaults from $conf_name.conf..."
            fi
        fi
    fi


    # 2. PRE-CHECKS

    state_init
    check_bins


    # 2.1 First execution verification
    if ! state_check_first_exec; then

        # 2.1.1 CHECK SAFETY (ifaces, tags, rt_tables)
        verbose log "Checking previous WireGuard configuration..."

        local active_ifaces=$(get_all_wg_interfaces)
        local has_tags=$(grep -c "# wg-autoconf" "$NETWORK_CONF" "$DHCP_CONF" "$FIREWALL_CONF" 2>/dev/null | grep -v ":0$" | wc -l)
        local has_tables=$(grep -c "_vpn_" /etc/iproute2/rt_tables 2>/dev/null || echo 0)

        # 2.1.2 NOTICE USER ABOUT PRE-EXISTING CONFIGS
        if [ -n "$active_ifaces" ] || [ "$has_tags" -gt 0 ] || [ "$has_tables" -gt 0 ]; then
            
            echo ""
            debug_write "[SETUP] Found active WG configs/interfaces when attemping to setup a new WG connection!"
            debug_write "    Ifaces: $active_ifaces, tags: $has_tags, tables: $has_tables"
            debug_write "    (This is OK as wg-autoconf allows managing multiple WG setups!)"
            
            warning "Found previous setups!: "
            echo ""
            echo -e "  - ${YELLOW}WG Interfaces:${NC}    $active_ifaces"
            echo ""
            verbose log "An active WireGuard interface or connection already exists"
            verbose echo "   You may continue configuring as many additional interfaces as required"
            verbose echo "   This notice is simply for your situational awareness"
            verbose echo ""
            
            verbose log "If you think there should be no pre-existing configuration, abort now and run 'wg-autoconf nuke' to ensure a clean slate"
            verbose echo ""

            printf "${YELLOW}Proceed with another WG setup? (${GREEN}Y${YELLOW}/${RED}n${YELLOW}):${NC} "
            read -r confirm
            case "$confirm" in
            
                y|Y|yes|YES|Yes|okidoki|OKIDOKI|Okidoki|OkiDoki)
                    ;;
                *) error "Setup cancelled"
                    ;;
            esac
        
        else
        
            state_write "IS_FIRST_EXEC" "1"
            debug_write "[SETUP] No configs found, IS_FIRST_EXEC reset to 1"
        
        fi
    fi


    # 3. CONFIGURATION VARIABLES INIT
    local iface_name=""
    local private_key=""
    local public_key=""
    local address=""
    local endpoint_host=""
    local endpoint_port=""
    local allowed_ips=""
    local dns=""

    
    # A) AUTO MODE -> FROM .CONF FILE
    if [ $is_manual -eq 0 ]; then
        
        log "Setting up wg from $conf_name.conf..."
        echo ""

    
        # 3.1 VALIDATE ALL FIELDS FROM .CONF
        debug_write "[SETUP] Validating configuration file..."
        
        # PrivateKey
        private_key=$(get_conf_value "PrivateKey" "$conf_file" "raw")
        validate_config_value "PrivateKey" "$private_key" "auto"
        private_key=$(clean_wg_key "$private_key")
        
        # PublicKey
        public_key=$(get_conf_value "PublicKey" "$conf_file" "raw")
        validate_config_value "PublicKey" "$public_key" "auto"
        public_key=$(clean_wg_key "$public_key")
        
        # Address
        address=$(get_conf_value "Address" "$conf_file" "raw")
        validate_config_value "Address" "$address" "auto"
        
        # Endpoint (with IPv6 support)
        endpoint=$(get_conf_value "Endpoint" "$conf_file" "raw")
        validate_config_value "Endpoint" "$endpoint" "auto"
        
    
        # 3.2 PARSE ENDPOINT (IPv4/IPv6/hostname)
        local parsed=$(parse_endpoint "$endpoint" "pair")
        endpoint_host=$(echo "$parsed" | cut -d'|' -f1)
        endpoint_port=$(echo "$parsed" | cut -d'|' -f2)
        
        # AllowedIPs
        allowed_ips_raw=$(get_conf_value "AllowedIPs" "$conf_file" "raw")
        if [ -n "$allowed_ips_raw" ]; then
            
            validate_config_value "AllowedIPs" "$allowed_ips_raw" "auto"
            allowed_ips=$(process_allowed_ips "$allowed_ips_raw" | tr '\n' ' ')
        
        else
            
            warning "Allowed IPs missing! Using defaults ($DEFAULT_ALLOW_IPS)"
            allowed_ips="$DEFAULT_ALLOW_IPS"
        
        fi
        
        # DNS
        dns=$(get_conf_value "DNS" "$conf_file" "raw")
        
        if [ -n "$dns" ]; then
            
            validate_config_value "DNS" "$dns" "auto"
            
            # DNS LEAKAGE NOTICE
            dns_leakage "$dns" "$address" "setup"
        
        else
            
            dns="$DEFAULT_DNS"
            warning "DNS not found, using defaults ("${DEFAULT_DNS}")"
            verbose log "Even using defaults, DNS will be tunneled in any case"
            dns_leakage "$dns" "$address" "setup"
        
        fi
        
        debug_write "[SETUP AUTO] Configuration validated successfully"


    
        # 3.3 SET INTERFACE NAME FROM CONF NAME
        iface_name="wg_$conf_name"
        
        validate_wg_config "auto" "" "InterfaceName" "$iface_name"

    
        # 3.4 CHECK ADDRESS COLLISIONS
        local collision=$(address_exists "$address")
        
        if [ -n "$collision" ]; then
            
            debug_write "[SETUP AUTO] IP collision: $address for $iface_name"
            error "Address $address already in use by $collision!"
            # YA SE VA A EXIT 1 POR error()

        
        fi

    
    # B) MANUAL MODE
    else

        log "Starting MANUAL setup (interactive configuration)..."
        debug_write "[MANUAL] Manual setup with no .conf, started"
        echo ""

    
        # 4. SET INTERFACE NAME
        ui_lines 79 "${YELLOW}1. WIREGUARD INTERFACE NAME${NC} (must start with 'wg')"
        default_iface="wg0"

        while true; do

            # 4.1 Prompt for interface name
            printf "Enter interface name (${BLUE}default: $default_iface)${NC}:"
            
            read -r iface_input
            [ -z "$iface_input" ] && iface_input="$default_iface"
            
            
            # 4.2 Validate interface name
            if ! validate_wg_config "manual" "" "InterfaceName" "$iface_input" 2>/dev/null; then
                
                warning "Invalid interface name: $iface_input"
                continue
            
            fi

            # 4.3 IF IFACE
            if iface_exists "$iface_input"; then
                
                debug_write "[SETUP MANUAL] Attempt to overwrite $iface_input"

                warning "Interface $iface_input already exists!"
                
            
                printf "${YELLOW}Try another name? (${GREEN}Y${YELLOW}/${RED}n${YELLOW}):${NC} "
                read -r retry
                case "$retry" in
                    y|Y|yes|YES|Yes|okidoki|OKIDOKI|Okidoki|OkiDoki)
                        continue
                        ;;
                    *) 
                        error "Interface name already in use!"
                        ;;
                esac
            fi

            iface_name="$iface_input"
            break
        done

    
        # 5. SET WIREGUARD KEYS
        echo ""
        ui_lines 79 "${YELLOW}2. WIREGUARD KEYS ${NC}"

        # 5.1 Private Key
        default_privkey=""
        
        if [ -n "$conf_file" ] && [ -f "$conf_file" ]; then
            
            default_privkey=$(get_conf_value "PrivateKey" "$conf_file" "raw")
        
        fi

        if [ -n "$default_privkey" ]; then
            
            echo "   [From $conf_name.conf: $(echo $default_privkey | cut -c1-10)...]"
            
            printf "Enter PRIVATE key (${BLUE}or press Enter for default${NC}): "
            read -r private_key_raw
            [ -z "$private_key_raw" ] && private_key_raw="$default_privkey"
        
        else
            
            printf "Enter PRIVATE key: "
            read -r private_key_raw
        
        fi
        
        # Validate private key
        [ -z "$private_key_raw" ] && error "Private key is required!"
        validate_wg_config "manual" "" "PrivateKey" "$private_key_raw"
        private_key=$(clean_wg_key "$private_key_raw")

        # 5.2 Public Key
        default_pubkey=""
        
        if [ -n "$conf_file" ] && [ -f "$conf_file" ]; then
            default_pubkey=$(get_conf_value "PublicKey" "$conf_file" "raw")
        fi

        if [ -n "$default_pubkey" ]; then
            
            echo "   [From $conf_name.conf: $(echo $default_pubkey | cut -c1-10)...]"
            
            printf "Enter PUBLIC key (${BLUE}or press Enter for default${NC}): "
            read -r public_key_raw
            [ -z "$public_key_raw" ] && public_key_raw="$default_pubkey"
        
        else
            
            printf "Enter PUBLIC key: "
            read -r public_key_raw
        
        fi
    
        # Validate public key
        [ -z "$public_key_raw" ] && error "Public key is required!"
        validate_wg_config "manual" "" "PublicKey" "$public_key_raw"
        
        public_key=$(clean_wg_key "$public_key_raw")



    
        # 6. SET LOCAL ADDRESS
        echo ""
        ui_lines 79 "${YELLOW}3. LOCAL ADDRESS${NC}"

        default_address=""
        if [ -n "$conf_file" ] && [ -f "$conf_file" ]; then
            default_address=$(get_conf_value "Address" "$conf_file" "raw")
        fi

        while true; do
            
            if [ -n "$default_address" ]; then
                
                printf "Enter local IP address (${BLUE} default: $default_address${NC}): "
                read -r address_input
                [ -z "$address_input" ] && address_input="$default_address"
            
            else
                
                printf "Enter local IP address (${BLUE}e.g., 10.2.0.2/32${NC}): "
                read -r address_input
            
            fi

            # Validate address
            [ -z "$address_input" ] && error "Address is required!"
            validate_wg_config "manual" "" "Address" "$address_input"
            
            # Check address collision
            local collision=$(address_exists "$address_input")
            if [ -n "$collision" ]; then
                
                warning "Address $address_input already in use by $collision!"
                debug_write "[SETUP MANUAL] IP collision: $address_input"
        
                printf "${YELLOW}Try another address? (${GREEN}Y${YELLOW}/${RED}n${YELLOW}):${NC} "
                read -r retry
                case "$retry" in
                    y|Y|yes|YES|Yes|okidoki|OKIDOKI|Okidoki|OkiDoki)
                        continue
                        ;;
                    *) 
                        error "Address already in use!"
                        ;;
                esac
            fi

            address="$address_input"
            break
        done

    

        # 7. SET ENDPOINT
        echo ""
        ui_lines 79 "${YELLOW}4. ENDPOINT${NC}"

        # 7.1 Get default from conf file if available
        default_endpoint=""
        
        if [ -n "$conf_file" ] && [ -f "$conf_file" ]; then
            
            default_endpoint=$(get_conf_value "Endpoint" "$conf_file" "raw")
        
        fi

        # 7.2 Parse default endpoint (with IPv6 support)
        default_endpoint_host=""
        default_endpoint_port=""
        
        if [ -n "$default_endpoint" ]; then
            
            parsed=$(parse_endpoint "$default_endpoint" "pair")
            
            default_endpoint_host=$(echo "$parsed" | cut -d'|' -f1)
            default_endpoint_port=$(echo "$parsed" | cut -d'|' -f2)
        
        fi

        # 7.3 Interactive endpoint configuration
        while true; do
            
            # 7.3.1 HOST
            if [ -n "$default_endpoint_host" ]; then
                
                printf "Enter endpoint host (${BLUE}default: $default_endpoint_host${NC}): "
                read -r endpoint_host_input
                
                [ -z "$endpoint_host_input" ] && endpoint_host_input="$default_endpoint_host"
            
            else
                
                printf "Enter endpoint host (IP or domain): "
                read -r endpoint_host_input
            fi
            
            [ -z "$endpoint_host_input" ] && error "Endpoint host is required!"
            
            
            
            # 7.3.2 PORT
            if [ -n "$default_endpoint_port" ]; then
                
                printf "Enter endpoint port (${BLUE}default: $default_endpoint_port${NC}): "
                read -r endpoint_port_input
                
                [ -z "$endpoint_port_input" ] && endpoint_port_input="$default_endpoint_port"
            
            else
                
                print "Enter endpoint port (${BLUE} WG default: 51820${NC}): "
                read -r endpoint_port_input
                
                [ -z "$endpoint_port_input" ] && endpoint_port_input="$DEFAULT_PORT"
            
            fi
            
            
            # 7.4   REBULD AND VALIDATE
            local endpoint_full="$endpoint_host_input:$endpoint_port_input"
            
            if validate_wg_config "manual" "" "Endpoint" "$endpoint_full" 2>/dev/null; then
                
                endpoint_host="$endpoint_host_input"
                endpoint_port="$endpoint_port_input"
                
                break
            
            else
                
                warning "Invalid endpoint format. Please try again."
            
            fi
        
        done

    

        # 8. SET ALLOWED IPS
        echo ""
        ui_lines 79 "${YELLOW}5. ALLOWED IPs${NC}"
        echo -e "\033[1m   (use COMMA-SEPARATED values, e.g.: 0.0.0.0/0, ::/0)\033[0m"

        default_allowed_ips=""
        
        if [ -n "$conf_file" ] && [ -f "$conf_file" ]; then
            
            default_allowed_ips=$(get_conf_value "AllowedIPs" "$conf_file" "raw")
        
        fi

        while true; do
            
            if [ -n "$default_allowed_ips" ]; then
            
                printf "Enter allowed IPs (${BLUE}default: $default_allowed_ips${NC}): "
                read -r allowed_ips_input
                
                [ -z "$allowed_ips_input" ] && allowed_ips_input="$default_allowed_ips"
            
            else

                printf "Enter allowed IPs: "
                echo -e "\033[1m   (use COMMA-SEPARATED values, e.g.: 0.0.0.0/0, ::/0)\033[0m"
                read -r allowed_ips_input
                
                [ -z "$allowed_ips_input" ] && allowed_ips_input="0.0.0.0/0"
            
            fi
            
            if validate_wg_config "manual" "" "AllowedIPs" "$allowed_ips_input"; then
                
                allowed_ips="$allowed_ips_input"
               
                break
            
            else
                
                warning "Invalid AllowedIPs format. Please try again."
            
            fi
        
        done

    
        # 9. SET DNS SERVERS
        echo ""
        ui_lines 79 "${YELLOW}6. DNS SERVERS${NC}"
        echo -e "\033[1m   (use COMMA-SEPARATED values, e.g.: 1.1.1.1, 1.0.0.1, 2606:4700:4700::1111)\033[0m"

        # 9.1 GET FROM CONF FILR
        local default_dns=""
        
        if [ -n "$conf_file" ] && [ -f "$conf_file" ]; then
            
            default_dns=$(get_conf_value "DNS" "$conf_file" "raw")
        
        fi
        
        
        # 9.2 ELSE USE DEFAULTS
        [ -z "$default_dns" ] && default_dns="$DEFAULT_DNS"

        while true; do
            
            printf "Enter DNS servers (${BLUE}default: $default_dns)${NC} "
            
            read -r dns_input
            
            if [ -z "$dns_input" ]; then
                
                dns="$default_dns"
                
                verbose echo -e "${GREEN}Using default DNS: $default_dns${NC}"
                
                break
            
            else
                
                if validate_wg_config "manual" "" "DNS" "$dns_input"; then
                    
                    dns="$dns_input"   
                    break
                
                else
                    
                    warning "Invalid DNS format. Please try again."
                
                fi

            fi
        
        done

        # DNS LEAKAGE NOTIUCE HERE
        dns_leakage "$dns" "$address" "manual"

    


        # 10. SAVE CONFIGURATION TO .CONF FILE (OPTIONAL)
        echo ""
        ui_lines 79 "${YELLOW}7. SAVE WIREGUARD CONFIGURATION FILE${NC}"

        echo ""
        ui_lines 50 "CONFIG SUMMARY"
        echo -e "Interface:           $iface_name"
        echo -e "Private Key:         $(echo $private_key | cut -c1-10)..."
        echo -e "Public Key:          $(echo $public_key | cut -c1-10)..."
        echo -e "Local IP:            $address"
        echo -e "Endpoint:            $endpoint_host:$endpoint_port"
        echo -e "Allowed IPs:         $allowed_ips"
        echo -e "DNS:                 $dns"
        ui_lines 50
        echo ""

        # CONFIRM SAVE NEW CONIG FILE
        printf "${YELLOW}Save config as .conf file in $WG_CONF_DIR? (${GREEN}y${YELLOW}/${RED}N${YELLOW}):${NC} "
        read -r save_conf

        case "$save_conf" in
            y|Y|yes|YES|Yes|okidoki|OKIDOKI|Okidoki|OkiDoki)
                
                printf "${GREEN}Enter config filename (without .conf extension):${NC} " 
                read -r conf_filename
                [ -z "$conf_filename" ] && conf_filename="manual-$(date +%s)"
                
                save_wireguard_conf "$conf_filename" "$private_key" "$public_key" \
                                    "$address" "$endpoint_host" "$endpoint_port" \
                                    "$allowed_ips" "$dns"
                
                debug_write "[MANUAL SETUP] New config created ($conf_filename)"
                success "Configuration file saved as $conf_filename.conf"
                ;;
            *)
                verbose warning "Configuration NOT saved to file"
                ;;
        esac

    
        # 11. CONFIRM SETUP
        printf "${YELLOW}Confirm setup? (${GREEN}Y${YELLOW}/${RED}n${YELLOW}):${NC} "
        read -r  confirm
        case "$confirm" in
            y|Y|yes|YES|Yes|okidoki|OKIDOKI|Okidoki|OkiDoki)
                ;;
            *)
                log "Setup cancelled!"
                return 1
                ;;
        esac
    fi

    
    # 12. FINAL VALIDATIONS BEFORE APPLYING CONFIG HEADACHE
    # 12.1 IF IFACE DOESNOT!!!! EXIST
    if iface_exists "$iface_name"; then
        
        warning "$iface_name already exists!"
        
        debug_write "[SETUP] Attempt to overwrite for $iface_name"
        
        log "WG-AUTOCONF setup CANCELLED!"
        
        exit 0
    
    fi

    
    # 13. BACKUP CONFIGURATION FILES
    backup_config_file "$NETWORK_CONF"
    backup_config_file "$DHCP_CONF"
    backup_config_file "$FIREWALL_CONF"

    
    # 14. APPLY CONFIGURATIONS (NETWORK, DHCP, FIREWALL)
    debug_write "[SETUP] Calling setup_network_config with:"
    debug_write "  iface_name=$iface_name"
    debug_write "  private_key=$private_key"
    debug_write "  address=$address"
    debug_write "  public_key=$public_key"
    debug_write "  endpoint_host=$endpoint_host"
    debug_write "  endpoint_port=$endpoint_port"
    debug_write "  allowed_ips=$allowed_ips"
    debug_write "  dns=$dns"
    setup_network_config "$iface_name" "$private_key" "$address" \
                         "$public_key" "$endpoint_host" "$endpoint_port" \
                         "$allowed_ips" "$dns"
    
    setup_dhcp_config "$iface_name"
    setup_firewall_config "$iface_name" "$endpoint_port"

    
    # 15. COMMITS
    uci commit network
    uci commit dhcp
    uci commit firewall

    
    # 16. STATES MANAGEMENT
    local iface_id=$(state_add_iface "$iface_name")
    
    if [ $? -eq 0 ]; then
        
        state_write "ID_${iface_id}_IS_CREATED" "1"
        state_write "IS_FIRST_EXEC" "0"
        debug_write "[SETUP] State updated: ID_${iface_id}_IS_CREATED=1, IS_FIRST_EXEC=0"
    
    else
        
        warning "Failed to add interface to state file"
        debug_write "[SETUP STATES] ERROR! with state file!!!!"
    
    fi

    
    # 17. D0NE!
    verbose echo ""
    verbose success "D0ne!"
    echo ""
    ui_lines 65 "${GREEN}WireGuard CONFIG${NC}"
    echo -e "- ${BLUE}Interface:${NC}          ${YELLOW}$iface_name${NC}"
    echo -e "- ${BLUE}Local IP:${NC}           ${YELLOW}$address${NC}"
    echo -e "- ${BLUE}Endpoint:${NC}           ${YELLOW}${endpoint_host:-N/A}:${endpoint_port:-N/A}${NC}"
    echo -e "- ${BLUE}DNS:${NC}                ${YELLOW}${dns}${NC}"
    
    ui_lines 65 "${GREEN}FINISH SETUP${NC}"
    echo -e "${GREEN}1.${NC} ${BLUE}ENABLE WG:${NC}         ${YELLOW}wg-autoconf up ${GREEN}$iface_name${NC}"
    echo -e "${GREEN}2.${NC} ${BLUE}VERIFY:${NC}            ${YELLOW}wg-autoconf ${GREEN}$iface_name${NC}"
    echo -e "${GREEN}3.${NC} ${BLUE}TEST WG:${NC}           ${YELLOW}ping -I ${GREEN}$iface_name ${BLUE}openwrt.com${NC}"
    echo -e "${GREEN}4.${NC} ${BLUE}ROUTE IT:${NC}          ${YELLOW}wg-autoconf routes set ${GREEN}$iface_name <dst iface>${NC}"
    ui_lines 66
    
    return 0
}

#####################################################################
# WG-AUTOCONF SAVE WIREGUARD CONFIG FILE
#####################################################################
save_wireguard_conf() {

    local conf_filename="$1"
    local private_key="$2"
    local public_key="$3"
    local address="$4"
    local endpoint_host="$5"
    local endpoint_port="$6"
    local allowed_ips="$7"
    local dns="$8"


    # 1. VALIDATE DNS
    validate_config_value "DNS" "$dns" "manual"
    

    # 2. FORMAT VALUES FOR .CONF FILE

    # 2.1 Format DNS (comma-separated to space-separated)
    local dns_conf=$(get_conf_value "DNS" "" "conf" "$dns")
    
    # 2.2 Format endpoint (ensure proper IPv6 handling)
    local endpoint_formatted=$(parse_endpoint "${endpoint_host}:${endpoint_port}" "string")
    
    # 2.3 Format AllowedIPs (ensure comma-separated with spaces)
    local allowed_ips_conf=$(echo "$allowed_ips" | sed 's/[[:space:]]*,[[:space:]]*/, /g; s/^[[:space:]]*//; s/[[:space:]]*$//')


    # 3. CHECK IF FILE ALREADY EXISTS
    local conf_file="$WG_CONF_DIR/$conf_filename.conf"

    if [ -f "$conf_file" ]; then

        warning "Config file already exists: $conf_file"

        printf "${YELLOW}Overwrite? (${GREEN}y${YELLOW}/${RED}N${YELLOW}):${NC} "
        read -r confirm
        case "$confirm" in
            y|Y|yes|YES|Yes|okidoki|OKIDOKI|Okidoki|OkiDoki)
                ;;
            *) 
                log "Config NOT saved"; 
                return 1
                ;;
        esac
    fi


    # 4. GENERATE CONFIG FILE

    cat > "$conf_file" << EOF
[Interface]
PrivateKey = $private_key
Address = $address
DNS = $dns_conf

[Peer]
PublicKey = $public_key
AllowedIPs = $allowed_ips_conf
Endpoint = $endpoint_formatted
# PersistentKeepalive = 25
EOF


    # 5. FINAL OUTPUT
    success "Config saved to: $conf_file"
    verbose log "You can now use: wg-autoconf setup $conf_filename"
}



#####################################################################
# WG-AUTOCONF ACTIVATE_INTERFACE (UP)
#####################################################################
activate_interface() {

    local iface="$1"

    # 0) UNCONDITIONAL PRE-CHECKS
    # upgrade_avoid_garbage, moved to init

    [ -z "$iface" ] && error "Interface name required!"
    debug_write "[UP] Activating interface: $iface"

    uci get "network.$iface" >/dev/null 2>&1 || error "$iface DOES NOT exist in UCI"
    
    validate_iface_name "$iface"


    # 1. PRE-CHECKS
    state_init
    check_bins



    # 2. GET ID FROM STATE MACHINE
    local iface_id=$(state_get_id "$iface")
    
    if [ $? -ne 0 ]; then
    
        debug_write "[UP] Interface ID not found, adding to state"
        iface_id=$(state_add_iface "$iface") || iface_id=""
    
    fi

    # 3. VERIFY/CREATE INTERFACE
    verbose log "Enabling $iface..."
    debug_write "[UP] Checking if interface exists"

    if ! ip link show "$iface" >/dev/null 2>&1; then
    
        debug_write "[UP] Interface not found, creating it"
    
        ip link add dev "$iface" type wireguard || {
    
            error "Failed to create interface $iface"
    
        }
    
    fi

    # 4. FORCE LINK UP -> FIXES WITH "IFUP" BIN
    ip link set "$iface" up
    debug_write "[UP] Link set up"

    # 5. LOAD PRIVATE KEY FROM UCI
    local privkey=$(uci get network.$iface.private_key 2>/dev/null)

    if [ -n "$privkey" ]; then

        echo "$privkey" | wg set "$iface" private-key /dev/stdin
        debug_write "[UP] Private key configured"

    else

        warning "No private key found for $iface"

    fi

    # 6. LOAD PEERS FROM UCI
    local peer_count=0
    local peer_section="network.${iface}_peer"

    if uci get "$peer_section" >/dev/null 2>&1; then
        
        local pubkey=$(uci get "$peer_section.public_key" 2>/dev/null)
        local endpoint_host=$(uci get "$peer_section.endpoint_host" 2>/dev/null)
        local endpoint_port=$(uci get "$peer_section.endpoint_port" 2>/dev/null)
        local keepalive=$(uci get "$peer_section.persistent_keepalive" 2>/dev/null)
        
        # 6.1 GET allowed_ips list from UCI
        local allowed_ips=$(get_uci_list "$peer_section" "allowed_ips")
        
        debug_write "[UP] AllowedIPs from UCI: '$allowed_ips'"
        
        if [ -n "$pubkey" ]; then
            wg set "$iface" peer "$pubkey" \
                ${allowed_ips:+allowed-ips "$allowed_ips"} \
                ${endpoint_host:+endpoint "${endpoint_host}:${endpoint_port:-51820}"} \
                ${keepalive:+persistent-keepalive "$keepalive"}
            peer_count=$((peer_count + 1))
            debug_write "[UP] Peer configured: $pubkey"
        fi
    fi

    if [ $peer_count -eq 0 ]; then
        warning "No peers configured for $iface"
    fi

    # 7. ASSIGN IP ADDRESS FROM UCI
    local address=$(uci get network.$iface.addresses 2>/dev/null)

    if [ -n "$address" ]; then

        local wg_ip=$(echo "$address" | cut -d/ -f1)

        # 7.1 ADD IP ADDRESS TO INTERFACE
        ip addr add "$address" dev "$iface" 2>/dev/null || {

            debug_write "[UP] IP address already assigned or invalid: $address"
        }


        
        # 7.2 CREATE DEDICATED ROUTING TABLE FOR THIS INTERFACE
        local table_name="${iface}"
        
        # 7.2.1 Add table to rt_tables if not exists
        if ! grep -q "^[0-9]\+[[:space:]]\+$table_name$" /etc/iproute2/rt_tables 2>/dev/null; then
            
            local table_id=200
            
            while grep -q "^$table_id " /etc/iproute2/rt_tables 2>/dev/null && [ $table_id -lt 250 ]; do
            
                table_id=$((table_id + 1))
            
            done
            
            echo "$table_id $table_name" >> /etc/iproute2/rt_tables
            debug_write "[UP] Created routing table $table_name (ID: $table_id)"
        
        fi
        
        # 7.2.2 Add default route via this interface in the new table
        ip route add default dev "$iface" table "$table_name" 2>/dev/null
        debug_write "[UP] Added default route to table $table_name"
        
        # 7.2.3 Add rule for traffic FROM this IP
        ip rule add from "$wg_ip" lookup "$table_name" priority 2000 2>/dev/null
        debug_write "[UP] Added ip rule for $wg_ip -> $table_name"
        
        # 7.2.4 Add return rule for traffic TO this IP
        ip rule add to "$wg_ip" lookup "$table_name" priority 2001 2>/dev/null
        debug_write "[UP] Added return rule for $wg_ip"

    
    else
        
        warning "No IP address configured for $iface"
    
    fi

    # 8. WAIT FOR INTERFACE TO BE OPERATIONAL
    local timeout=3
    local count=0

    while [ $count -lt $timeout ]; do

        if ip link show "$iface" >/dev/null 2>&1 && \
        ip addr show "$iface" 2>/dev/null | grep -q "inet "; then

            debug_write "[UP] Interface $iface is operational after ${count}s"
            break
        fi

        sleep 1
        count=$((count + 1))

    done

    if [ $count -ge $timeout ]; then

        debug_write "[UP WARNING] Interface $iface did not become operational"
        warning "Interface $iface may not be fully operational"

    fi

    # 9. VERIFY WITH WG SHOW (IF AVAILABLE)
    if [ "$CAP_WG" = "1" ]; then

        if wg show "$iface" >/dev/null 2>&1; then

            debug_write "[UP] WireGuard configuration verified"
            
            if [ "$VERBOSE" = "1" ]; then
                echo ""
                echo "$iface Info:"
                wg show "$iface"
            fi

        else
            
            warning "WireGuard configuration may be incomplete"
        fi
    
    else
        
        debug_write "[UP] wg binary not available, skipping verification"
    
    fi

    # 10. UPDATE STATE
    if [ -n "$iface_id" ]; then

        if state_write "ID_${iface_id}_IS_ACTIVE" "1"; then

            debug_write "[UP] State updated: ID_${iface_id}_IS_ACTIVE=1"

        else

            debug_write "[UP WARNING] Failed to update state"

        fi

    fi

    # 11. D0NE
    success "Interface '$iface' enabled!"
    debug_write "[UP] Interface $iface successfully enabled"

    echo ""
    echo -e "${YELLOW}Now you can set up routes if needed!${NC}"
    
    return 0
}


#####################################################################
# WG-AUTOCONF DEACTIVATE_INTERFACE (DOWN)
#####################################################################
deactivate_interface() {

    local iface="$1"


    # 0) UNCONDITIONAL PRE-CHECKS
    # upgrade_avoid_garbage, moved to init

    [ -z "$iface" ] && error "Interface name required"
    debug_write "[DOWN] Deactivating interface: $iface"

    uci get "network.$iface" >/dev/null 2>&1 || error "$iface DOES NOT exist"
    validate_iface_name "$iface"



    # 1. PRE-CHECKS
    state_init
    check_bins



    # 2. GET INTERFACE ID FROM STATE
    local iface_id=$(state_get_id "$iface")
    
    if [ $? -ne 0 ]; then
        
        debug_write "[DOWN] Interface ID not found in state for $iface"
        iface_id=""
    
    else
        debug_write "[DOWN] Found interface ID: $iface_id"
    fi

    log "Disabling $iface..."
    debug_write "[DOWN] Removing interface configuration"


    # 3. REMOVE PEERS (IF WG AVAILABLE)
    if [ "$CAP_WG" = "1" ]; then
        
        local peers=$(wg show "$iface" peers 2>/dev/null | tr '\n' ' ')
        
        if [ -n "$peers" ]; then
           
            wg set "$iface" peer $peers remove 2>/dev/null
            debug_write "[DOWN] Removed peers from $iface"
        
        else
            debug_write "[DOWN] No peers found for $iface"
        fi
    
    else
        debug_write "[DOWN] wg binary not available, skipping peer cleanup"
    fi


    # 4. DELETE INTERFACE FROM KERNEL HEADACHE
    if ip link show "$iface" >/dev/null 2>&1; then
        
        # 4.1 IP LINK DEL 
        ip link delete "$iface" 2>/dev/null
        
        if [ $? -eq 0 ]; then
            
            debug_write "[DOWN] Interface $iface deleted successfully"

            # 4.2 CLEANUP ROUTING TABLES AND RULES
            debug_write "[DOWN] Cleaning up routing tables and rules for $iface"
            
            # 4.2.1 Cleanup wg_* tables (created in activate_interface)
            # DEBUG!
            # Main idea ... find table NAME
            # ORDER:
            #   - 1 CLEAN RULES
            #   - 2 DEL RULES

            local wg_tables=$(grep "[[:space:]]${iface}$" /etc/iproute2/rt_tables 2>/dev/null | awk '{print $2}')
            
            for table in $wg_tables; do
                
                debug_write "[DOWN] Cleaning up rules for wg table: $table"
                
                # HEADACHE!!!!!

                #  1 CLEAN RULES -> Why? Rules exists so table exist
                del_ip_rules_by_table "$table"
                
                # - 2 DEL RULES -> NOW TABLE CAN BE DELETED
                del_routing_table "$table"
                
                # FINALLY -> NO ORPHAN RULES NOR TABLES! :D
                # HEADACHE!!!!! REMEMBER THIS EXACT ORDER!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
                debug_write "[DOWN] Removed wg table and rules: $table"
            
            done
            

            # 4.2.2 CLEANUP _vpn_* TABLES
            local vpn_tables=$(grep "_vpn_${iface}_" /etc/iproute2/rt_tables 2>/dev/null | awk '{print $2}')
            
            for table in $vpn_tables; do
                
                debug_write "[DOWN] Cleaning up rules for vpn table: $table"
                
                #  1 CLEAN RULES -> Why? Rules exists so table exist
                del_ip_rules_by_table "$table"
                
                # - 2 DEL RULES -> NOW TABLE CAN BE DELETED
                del_routing_table "$table"

                 # FINALLY -> NO ORPHAN RULES NOR TABLES! :D
                # HEADACHE!!!!! REMEMBER THIS EXACT ORDER!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
                
                debug_write "[DOWN] Removed vpn table and rules: $table"
            
            done
            


            # 4.2.3 EXTRA RULES/TABLES CLEANUP FOR OPRHANED / NUKE M;ODE
            local wg_ip=$(uci get "network.$iface.addresses" 2>/dev/null | cut -d/ -f1)
            
            if [ -n "$wg_ip" ]; then

                debug_write "[DOWN] Removing ip rules for IP $wg_ip"
                
                # 4.2.3.1   DEL  "from $wg_ip"
                local from_rules=$(ip rule show | grep "from $wg_ip" | awk '{print $1}' | sed 's/://')
                
                for prio in $from_rules; do
                    
                    ip rule del priority "$prio" 2>/dev/null
                    debug_write "[DOWN] Removed from rule priority $prio for $wg_ip"
                
                done
                
                 # 4.2.3.1 DEL  "to $wg_ip"
                local to_rules=$(ip rule show | grep "to $wg_ip" | awk '{print $1}' | sed 's/://')
                for prio in $to_rules; do
                    
                    ip rule del priority "$prio" 2>/dev/null
                    
                    debug_write "[DOWN] Removed to rule priority $prio for $wg_ip"
                
                done
            
            fi
            
            # 4.2.4EXTRA CLEANUP ORPHANED 2
            debug_write "[DOWN] Cleaning up any remaining ip rules for $iface"
            local rules_to_clean=$(ip rule show | grep -E "lookup.*${iface}" | awk '{print $1}' | sed 's/://')
            for prio in $rules_to_clean; do
                
                ip rule del priority "$prio" 2>/dev/null
                
                debug_write "[DOWN] Removed ip rule priority $prio"
            
            done
        
        # 4.3 IFDOWN FALLBACK (IP-TINY VS IP-FULL DEBUG)
        else
            
            debug_write "[DOWN WARNING] Failed to delete interface $iface"
            ifdown "$iface" >/dev/null 2>&1
            debug_write "[DOWN] Fallback: ifdown $iface executed"
        fi

    else
        
        debug_write "[DOWN] Interface $iface does not exist in kernel"
    
    fi


    
    # 5. UPDATE STATE
    if [ -n "$iface_id" ]; then
        
        if state_write "ID_${iface_id}_IS_ACTIVE" "0"; then
            
            debug_write "[DOWN] State updated: ID_${iface_id}_IS_ACTIVE=0"
        else
            
            warning "Failed to update state for $iface"
            debug_write "[DOWN WARNING] state_write failed for ID_${iface_id}_IS_ACTIVE"
        
        fi
    fi


    # 6. VERIFY INTERFACE IS GONE
    if ! ip link show "$iface" >/dev/null 2>&1; then
        
        success "$iface disabled and removed!"
        debug_write "[DOWN] Interface $iface successfully disabled"
    
    else
        
        warning "$iface may still exist"
        debug_write "[DOWN WARNING] Interface $iface still exists after removal"
        
    
        ip link show "$iface" | while read line; do
            
            debug_write "[DOWN] $line"
        
        done
    fi
    
    return 0
}


#####################################################################
# WG-AUTOCONF REMOVE_WIREGUARD
#####################################################################
remove_wireguard() {

    local iface="$1"
    local silent="${2:-no}"


    # 0) UNCONDITIONAL PRE-CHECKS
    # upgrade_avoid_garbage, moved to init
    debug_write "[REMOVE] Starting removal of $iface"
    validate_iface_name "$iface"
    

    # 1. CHECK IF INTERFACE EXISTS IN UCI
    if ! uci get "network.$iface" >/dev/null 2>&1; then
        
        debug_write "[REMOVE] Interface $iface not found in UCI"
        
        # 1.1 CLEAN STATES EVEN IF IFACE DOES NOT EXIST
        # DEBUG!
        # TODO: Check Nuke/Single mode VS WITH and WITHOUT state_init HERE
        state_init
        
        local iface_id=$(state_get_id "$iface")
        
        if [ -n "$iface_id" ]; then
            
            state_remove_iface "$iface_id"
            debug_write "[REMOVE] Cleaned state for non-existent interface: $iface"
        
        fi
        
        [ "$silent" != "silent" ] && success "$iface removed (was not in UCI)"
        
        return 0
    
    fi
    

    # 2. PRE-CHECKS
    [ "$silent" != "silent" ] && verbose log "Removing $iface..."
    
    state_init
    check_bins


    # 3. GET INTERFACE ID FROM STATE
    local iface_id=$(state_get_id "$iface")
    
    if [ $? -ne 0 ]; then
        
        debug_write "[REMOVE] Interface ID not found in state for $iface"
        debug_write "    Tampered bin?? Bad uninstallation? CLEAN ALL WITH NUKE!"
        
        if [ "$silent" != "silent" ]; then
            
            verbose error "Interface $iface NOT found in state configuration"
            verbose warning "Post-operation manual checks are required upon completion:"
            verbose warning "  - You might make a full cleanup with ${YELLOW}wg-autoconf nuke${NC}"
        fi
        
        iface_id=""
    fi


    # 4. DEACTIVATE INTERFACE (DOWN + DELETE via DEACTIVATE_IFACE HELPER)
    debug_write "[REMOVE] Deactivating interface: $iface"
    deactivate_interface "$iface" >/dev/null 2>&1
    debug_write "[REMOVE] Interface deactivated"


    # 5. REMOVE CONFIGURATION TAGS (NETWORK, DHCP, FIREWALL)
    debug_write "[REMOVE] Finding and removing configuration tags"
    
    # 5.1 NETWORK TAGS
    local net_line=$(grep -n "config interface '$iface'" "$NETWORK_CONF" 2>/dev/null | cut -d: -f1)
    
    if [ -n "$net_line" ]; then
        
        local network_tag_id=$(sed -n "1,${net_line}p" "$NETWORK_CONF" | grep "# wg-autoconf network start id" | tail -1 | sed 's/.*id //g')
        
        if [ -n "$network_tag_id" ]; then
            
            debug_write "[REMOVE] Found network tag id: $network_tag_id"
            remove_tagged_block "$NETWORK_CONF" "network" "$network_tag_id"
        
        fi
    fi
    

    # 5.2 DHCP TAGS
    local dhcp_line=$(grep -n "config dhcp '$iface'" "$DHCP_CONF" 2>/dev/null | cut -d: -f1)
    
    if [ -n "$dhcp_line" ]; then
        
        local dhcp_tag_id=$(sed -n "1,${dhcp_line}p" "$DHCP_CONF" | grep "# wg-autoconf dhcp start id" | tail -1 | sed 's/.*id //g')
        
        if [ -n "$dhcp_tag_id" ]; then
            debug_write "[REMOVE] Found DHCP tag id: $dhcp_tag_id"
            remove_tagged_block "$DHCP_CONF" "dhcp" "$dhcp_tag_id"
        fi
    fi
    


    # 5.3 FIREWALL TAGS
    local fw_line=$(grep -n "option name '$iface'" "$FIREWALL_CONF" 2>/dev/null | head -1 | cut -d: -f1)
    
    if [ -n "$fw_line" ]; then
        
        local firewall_tag_id=$(sed -n "1,${fw_line}p" "$FIREWALL_CONF" | grep "# wg-autoconf firewall start id" | tail -1 | sed 's/.*id //g')
        
        if [ -n "$firewall_tag_id" ]; then
            debug_write "[REMOVE] Found firewall tag id: $firewall_tag_id"
            remove_tagged_block "$FIREWALL_CONF" "firewall" "$firewall_tag_id"
        fi
    fi


    # 6. CLEANUP ROUTING TABLES (if any)
    debug_write "[REMOVE] Cleaning up routing tables for $iface"
    
    local route_tables=$(grep "_vpn_${iface}_" /etc/iproute2/rt_tables 2>/dev/null | awk '{print $2}')
    for table in $route_tables; do
        
        debug_write "[REMOVE] Removing routing table: $table"
        
        del_routing_table "$table"
        
        del_ip_rules_by_table "$table"
    done


    # 7. DETERMINE IF BACKUPS SHOULD BE RESTORED
    local should_restore_backups=0
    local remaining_ifaces=$(get_all_wg_interfaces)
    local remaining_count=0
    
    for remaining_iface in $remaining_ifaces; do
        if [ "$remaining_iface" != "$iface" ]; then
            remaining_count=$((remaining_count + 1))
        fi
    done
    
    debug_write "[REMOVE] Remaining WireGuard interfaces after removal: $remaining_count"
    
    # DEBUG!
    # TODO: Restore backups only if:
    #           1. No other WireGuard interfaces remain
    #           2. Or its nuke mode
    if [ "$remaining_count" -eq 0 ] || [ "$silent" = "silent" ]; then
        
        should_restore_backups=1
    
        debug_write "[REMOVE] Will restore backups (last interface or nuke mode)"
    
    else
    
        debug_write "[REMOVE] NOT restoring backups ($remaining_count other interfaces exist)"
    
    fi


    # 8. RESTORE BACKUPS
    local restore_result=0
    local restore_silent=""
    
    [ "$silent" = "silent" ] && restore_silent="silent"
    
    if [ "$should_restore_backups" -eq 1 ]; then
        
        debug_write "[REMOVE] Restoring backups..."
        
        if restore_backups "" "$restore_silent"; then
            
            debug_write "[REMOVE] Backups restored successfully"
            
            [ "$silent" != "silent" ] && verbose success "Configuration files restored from backup"
            
            restore_result=1
        
        else
            
            debug_write "[REMOVE WARNING] Backup restoration had issues"
            
            if [ "$silent" != "silent" ]; then
            
                warning "No valid backups found or restoration had issues"
            
            fi
            
            restore_result=0
        fi
    
    else
        
        debug_write "[REMOVE] Skipping backup restoration (other interfaces exist)"
        cleanup_backup_files ""
    
    fi


    # 9. COMMITS -> UCI & RELOADS
    debug_write "[REMOVE] Committing UCI changes"
    verbose log "Applying changes..."

    uci commit network 2>/dev/null && debug_write "[REMOVE] network committed"
    uci commit dhcp 2>/dev/null && debug_write "[REMOVE] dhcp committed"
    uci commit firewall 2>/dev/null && debug_write "[REMOVE] firewall committed"
    
    /etc/init.d/network reload 2>/dev/null && debug_write "[REMOVE] network reloaded"
    /etc/init.d/firewall reload 2>/dev/null && debug_write "[REMOVE] firewall reloaded"


    # 10. CLEANUP BACKUP FILES (IF RESTORED)
    if [ $restore_result -eq 1 ]; then
        
        debug_write "[REMOVE] Cleaning up restored backup files"
        
        local removed_backups=0
        local kept_backups=0
        
        for config_file in $BACKUP_PATHS; do
            
            local backup_file="${config_file}.BACKUP_PRE_WIREGUARD"
            
            [ ! -f "$backup_file" ] && continue
            
            if validate_backup "$backup_file" 2>/dev/null; then
                
                if rm -f "$backup_file" 2>/dev/null; then
                    
                    removed_backups=$((removed_backups + 1))
                    
                    debug_write "[REMOVE] Removed valid backup: $(basename "$backup_file")"
               
               
                else
                    
                    debug_write "[REMOVE WARNING] Failed to remove backup: $(basename "$backup_file")"
                    
                    kept_backups=$((kept_backups + 1))
                
                fi
            
            else
                
                debug_write "[REMOVE] Keeping corrupted backup for diagnosis: $(basename "$backup_file")"
                
                kept_backups=$((kept_backups + 1))
            
            fi
        done
        
        debug_write "[REMOVE] Backup cleanup: removed=$removed_backups, kept=$kept_backups"
    
    fi


    # 11. REMOVE INTERFACE FROM STATE
    if [ -n "$iface_id" ]; then
        
        debug_write "[REMOVE] Removing interface from state: ID_$iface_id"
        
        if state_remove_iface "$iface_id"; then
            
            debug_write "[REMOVE] State updated successfully"
        
        
        else
            
            
            debug_write "[REMOVE WARNING] Failed to update state for ID_$iface_id"
            
            if [ "$silent" != "silent" ]; then
            
                echo -e "${RED}[ERROR]${NC} wg-autoconf state malfunction"
            
                warning "Post-operation manual checks are required"
            
                warning "  - Run ${YELLOW}wg-autoconf nuke${NC} for full cleanup"
            
            fi
        fi
    fi


    # 12. D0NE!
    debug_write "[REMOVE] Completed: restore_result=$restore_result, remaining_ifaces=$remaining_count"
    
    if [ "$silent" != "silent" ]; then
        verbose success "$iface removed successfully!"
        
        if [ "$should_restore_backups" -eq 1 ] && [ $restore_result -eq 1 ]; then
            verbose echo -e "${GREEN}Configuration restored from backups${NC}"
        elif [ "$should_restore_backups" -eq 0 ]; then
            log "${YELLOW}Backups preserved (other interfaces exist)${NC}"
        fi
    fi
    
    return 0
}


#####################################################################
# ███████╗████████╗ █████╗ ████████╗██╗   ██╗███████╗
# ██╔════╝╚══██╔══╝██╔══██╗╚══██╔══╝██║   ██║██╔════╝
# ███████╗   ██║   ███████║   ██║   ██║   ██║███████╗
# ╚════██║   ██║   ██╔══██║   ██║   ██║   ██║╚════██║
# ███████║   ██║   ██║  ██║   ██║   ╚██████╔╝███████║
# ╚══════╝   ╚═╝   ╚═╝  ╚═╝   ╚═╝    ╚═════╝ ╚══════╝
#####################################################################
#####################################################################
# WG-AUTOCONF SHOW STATUS
#####################################################################
show_status() {

    local filter_iface="$1"
    

    # 0) UNCONDITIONAL PRE-CHECKS

    # upgrade_avoid_garbage, moved to init
    state_init 2>/dev/null
    check_bins 2>/dev/null
    

    # 1. GET ALL INTERFACES

    local all_interfaces=""
    
    # 1.1 UCI
    local uci_ifaces=$(get_all_wg_interfaces)
    
    # 1.2 WG
    local active_ifaces=""
    if [ "$CAP_WG" = "1" ]; then
        
        active_ifaces=$(wg show interfaces 2>/dev/null)
    
    # 1.3   FALLBACK IP LINK SHOW
    else

        active_ifaces=$(ip link show | grep -o 'wg[^:@]*' | sort -u)
    
    fi

    # 2. MERGE THEN SORT
    all_interfaces=$(echo "$uci_ifaces $active_ifaces" | tr ' ' '\n' | sort -u)
    
    # 2.1 NO IFACES
    if [ -z "$all_interfaces" ]; then
        
        log "No WireGuard interfaces found!"
        exit 0
    
    fi
    

    # 3. RESULTS
    echo ""
    ui_lines 59 "${YELLOW}WireGuard Status${NC}"
    echo ""
    

    # 3. PROCESS EACH INTERFACE
    for iface in $all_interfaces; do
        
        [ -n "$filter_iface" ] && [ "$iface" != "$filter_iface" ] && continue
        
        local status_tags=""
        local details=""

    
        # 3.1 CHECK UCI CONFIGURATION (CREATED/ORPHAN)
    
        if uci get "network.$iface" >/dev/null 2>&1; then
            
            status_tags="${status_tags}${GREEN}CREATED${NC}"
            
            # 3.1.1 FROM UCI
            local address=$(uci get "network.$iface.addresses" 2>/dev/null || echo -e "${RED}N/A${NC}")
            local endpoint_host=$(uci get "network.${iface}_peer.endpoint_host" 2>/dev/null)
            local endpoint_port=$(uci get "network.${iface}_peer.endpoint_port" 2>/dev/null)
            local peer_pubkey=$(uci get "network.${iface}_peer.public_key" 2>/dev/null | cut -c1-15)
            
            details="  ${YELLOW}Local:      ${GREEN}$address${NC}\n"
            [ -n "$endpoint_host" ] && details="${details}  ${YELLOW}Endpoint:   ${GREEN}${endpoint_host}:${endpoint_port:-51820}${NC}\n"
            [ -n "$peer_pubkey" ] && details="${details}  ${YELLOW}Peer:       ${GREEN}$peer_pubkey...${NC}\n"
        
        
        else
            
            debug_write "[INFO] Found ORPHANED configs: $iface"    
        
            status_tags="${status_tags}${RED}ORPHANED${NC}"
            details="  ${YELLOW}Status:   ${RED}Active interface without UCI configuration${NC}\n"
        fi

    
        # 3.2 CHECK LINK STATUS (UP/DOWN)
        if ip link show "$iface" >/dev/null 2>&1; then
            
            status_tags="${status_tags}, ${GREEN}UP${NC}"
            
        
            # 3.3 FROM WG
            if [ "$CAP_WG" = "1" ]; then
                
                local peer_info=$(wg show "$iface" 2>/dev/null)
                local endpoint=$(echo "$peer_info" | grep "endpoint:" | head -1 | sed 's/endpoint: //')
                local handshake=$(echo "$peer_info" | grep "latest handshake:" | head -1 | sed 's/latest handshake: //')
                local transfer=$(echo "$peer_info" | grep "transfer:" | head -1 | sed 's/transfer: //')
                
                [ -n "$endpoint" ] && [ -z "$endpoint_host" ] && details="${details}  ${YELLOW}Endpoint: ${GREEN}$endpoint${NC}\n"
                [ -n "$handshake" ] && details="${details}  ${YELLOW}Last HS:  ${GREEN}$handshake${NC}\n"
                [ -n "$transfer" ] && details="${details}  ${YELLOW}Transfer: ${GREEN}$transfer${NC}\n"
            
            else
                
                details="${details}  ${YELLOW}WG stats:${NC} ${RED}not available (install wireguard-tools)${NC}\n"
            
            fi
        
        else
            
            status_tags="${status_tags}, ${RED}DOWN${NC}"
            
            details="${details}  ${YELLOW}Status:     Interface configured but not active${NC}\n"
        
        fi
        
    
        # 3.4 CHECK ROUTING TABLES (ROUTED)
        local rt_tables=$(grep "_vpn_${iface}_" /etc/iproute2/rt_tables 2>/dev/null | awk '{print $2}')
        
        if [ -n "$rt_tables" ]; then
            
            status_tags="${status_tags}, ${YELLOW}ROUTED${NC}"
            details="${details}  ${YELLOW}Routes:${NC}     "
            
            for table in $rt_tables; do
                local lan_iface=$(echo "$table" | sed "s/_vpn_${iface}_//")
                details="${details}$lan_iface "
            done
            
            details="${GREEN}${details} ${BLUE}(via ${rt_tables%% *})${NC}\n"
        fi

    
        # 3.5 CHECK BACKUP VALIDITY
        local backup_status=""
        local backup_count=0
        local valid_count=0
        
        for config in network dhcp firewall; do
            
            local backup_file="/etc/config/${config}.BACKUP_PRE_WIREGUARD"
            
            if [ -f "$backup_file" ]; then
                
                backup_count=$((backup_count + 1))
                
                if validate_backup "$backup_file" 2>/dev/null; then
                    
                    valid_count=$((valid_count + 1))
                
                fi
            fi
        done
        
        if [ $backup_count -gt 0 ]; then
            
            if [ $valid_count -eq $backup_count ]; then
                
                backup_status="${GREEN}Valid${NC}"
            
            elif [ $valid_count -eq 0 ]; then
                
                debug_write "[INFO] Found CORRUPTED backups for $iface"
                backup_status="${RED}Corrupted${NC}"
            
            else
                
                debug_write "[INFO] Partial backups for $iface"
                backup_status="${YELLOW}Partial${NC}"
            fi
            
            details="${details}  ${YELLOW}Backups:${NC}    $backup_status"
            
            [ $backup_count -eq 3 ] && details="${details} ${BLUE}(network, dhcp, firewall)${NC}"    
            details="${details}\n"
        fi

    
        # 3.6 OUTPUT FOR THIS INTERFACE
        if [ "$VERBOSE" = "1" ]; then
            echo ""
            echo -e "  ${YELLOW}Interface details:${NC}"
            echo -e "$details" | sed 's/^/    /'
        fi
        
        ui_lines 39 "${BLUE}$iface${NC} (${status_tags})"
        printf "$details"
        echo ""
    
    done
    
    ui_lines 60
    exit 0
}


#####################################################################
# ██████╗  █████╗  ██████╗██╗  ██╗██╗   ██╗██████╗ ███████╗
# ██╔══██╗██╔══██╗██╔════╝██║ ██╔╝██║   ██║██╔══██╗██╔════╝
# ██████╔╝███████║██║     █████╔╝ ██║   ██║██████╔╝███████╗
# ██╔══██╗██╔══██║██║     ██╔═██╗ ██║   ██║██╔═══╝ ╚════██║
# ██████╔╝██║  ██║╚██████╗██║  ██╗╚██████╔╝██║     ███████║
# ╚═════╝ ╚═╝  ╚═╝ ╚═════╝╚═╝  ╚═╝ ╚═════╝ ╚═╝     ╚══════╝
#####################################################################

#####################################################################
# TAG HANDLER -> Backup config files
backup_config_file() {

    local file="$1"
    local backup_file="${file}.BACKUP_PRE_WIREGUARD"
    
    debug_write "[BACKUP] Starting backup for: $file"
    
    
    
    # 1.1 IF EXIST EXIT
    if [ -f "$backup_file" ] && validate_backup "$backup_file" 2>/dev/null; then
        
        debug_write "[BACKUP] Valid backup already exists: $backup_file"
        return 0
    fi
    
    # 1.2 IF NATIVE EXISTS
    if [ ! -f "$file" ]; then
        debug_write "[BACKUP ERROR] Source file not found: $file"
        return 1
    fi
    
    # 1.3 IF NATIVE CHOWN IS OK / HAS PROPER DATA
    # DEBUG!
    #           Room for proper data validations, not only a "readable" file by chowns
    if [ ! -r "$file" ]; then
        
        debug_write "[BACKUP ERROR] Cannot read file: $file"
        return 1
    
    fi
    


    # 2.1   READ/CHOWN ATTEMPT
    local content=""
    if ! content=$(cat "$file" 2>/dev/null); then
        
        debug_write "[BACKUP ERROR] Failed to read content: $file"
        return 1
    
    fi
    
    # 2.2   HAS DATA ATTEMPT
    if [ -z "$content" ]; then
        debug_write "[BACKUP WARNING] Empty file: $file"
        # return 1
    fi
    

    # 2.3   CHECKSUM CONTENT ATTEMPT
    local checksum=""
    if command -v sha256sum >/dev/null 2>&1; then
        
        checksum=$(echo "$content" | sha256sum | cut -d' ' -f1)
    
    else
       
        # DEBUG!
        # TODO: sha256 is an openwrt CORE package (...AFAIK), 
        #       but a better and valid fallback .... (is) needed (?)
        checksum=$(echo "$content" | md5sum | cut -d' ' -f1)
        debug_write "[BACKUP] Using md5sum fallback for checksum"
    
    fi
    
    local tag="# WG_AUTOCONF_BACKUP_${VERSION}_$(date +%s)"
    
    debug_write "[BACKUP] Creating backup with checksum: ${checksum:0:16}..."
    


    # ADD TAG 1 OPERS 
    local temp_backup="${backup_file}.tmp.$$"
    local backup_ok=0

    # (sub-coment): best array method, 
    {
        echo "$tag"
        echo "$content"
        echo "# WG_AUTOCONF_CHECKSUM: $checksum"
    } > "$temp_backup" 2>/dev/null
    

    # IF DONE
    if [ $? -eq 0 ] && [ -f "$temp_backup" ] && [ -s "$temp_backup" ]; then
        
        
        # TMP FILE CHECKSUM VALID OK
        local temp_checksum=$(sed '1d; $d' "$temp_backup" | sha256sum 2>/dev/null | cut -d' ' -f1)
        if [ "$temp_checksum" = "$checksum" ]; then
            
            if mv "$temp_backup" "$backup_file" 2>/dev/null; then
                
                backup_ok=1
                debug_write "[BACKUP] Created atomic backup: $backup_file"
            
            else
                debug_write "[BACKUP ERROR] Failed to replace backup file"
            fi
        else
            debug_write "[BACKUP ERROR] Checksum mismatch in temp file"
        fi
    else
        debug_write "[BACKUP ERROR] Failed to write temp backup"
    fi
    


    # D0ne, CLEANUPS!
    [ -f "$temp_backup" ] && rm -f "$temp_backup" 2>/dev/null
    # D0ne, VALIDATE BACKUPS
    if [ $backup_ok -eq 1 ]; then

        # VALIDATE BACKUP
        if validate_backup "$backup_file" 2>/dev/null; then
            
            debug_write "[BACKUP] Backup validated: $backup_file"
            verbose success "Backed up $(basename "$file")"
            return 0
        
        else
            
            debug_write "[BACKUP ERROR] New backup failed validation for $backup_file:"
            debug_write ""
            debug cat /etc/config/$backup_file
            debug_write ""

            # DEBUG!
            # TODO:     To be decided: Discard invalid backup or keep it?
            #            Deleting for now to avoid corruption at clean/nuke!
            rm -f "$backup_file" 2>/dev/null
            return 1
        fi
    
    else
        
        debug_write "[BACKUP ERROR] Failed to create backup: $file"
        return 1
    
    fi
}
#####################################################################
# TAG HANDLER -> Validate backup integrity (MEJORADO)
#####################################################################
validate_backup() {

    local backup_file="$1"
    
    debug_write "[BACKUP VALIDATE] Validating: $backup_file"
    
    # 1.1 FILE VALIDATIONS
    if [ ! -f "$backup_file" ]; then
        debug_write "[BACKUP VALIDATE ERROR] File not found"
        return 1
    fi
    
    if [ ! -s "$backup_file" ]; then
        debug_write "[BACKUP VALIDATE ERROR] File empty"
        return 1
    fi
    
    # 1.2 LINE CH4ECJS (>3 = FAILS)
    local line_count=$(wc -l < "$backup_file" 2>/dev/null)
    if [ -z "$line_count" ] || [ "$line_count" -lt 3 ]; then
        
        debug_write "[BACKUP VALIDATE ERROR] Invalid format, less than 3 lines"
        
        return 1
    
    fi

    # 1.3 TAG VERIF
    if ! head -1 "$backup_file" | grep -q "WG_AUTOCONF_BACKUP"; then
        debug_write "[BACKUP VALIDATE ERROR] Missing backup tag"
        return 1
    fi

    # 2. CHECKSUM VERIFS
    local stored_sum=""
    stored_sum=$(tail -10 "$backup_file" | grep "WG_AUTOCONF_CHECKSUM:" | tail -1 | grep -o '[0-9a-f]\{32,\}')
    
    if [ -z "$stored_sum" ]; then
        stored_sum=$(tail -1 "$backup_file" | grep -o '[0-9a-f]\{32,\}')
    fi
    
    if [ -z "$stored_sum" ]; then
        
        debug_write "[BACKUP VALIDATE ERROR] No checksum found"
        watning "No checksum found on $backup_file!"
        return 1
    fi
    
    debug_write "[BACKUP VALIDATE] Stored checksum: ${stored_sum:0:16}..."

    # 3. Compute actual checksum
    local total_lines=$line_count
    local computed_sum=""
    
    if [ $((total_lines - 2)) -le 0 ]; then
        
        debug_write "[BACKUP VALIDATE ERROR] No content to checksum"
        return 1
    
    fi
    
    if command -v sha256sum >/dev/null 2>&1; then
        computed_sum=$(head -n $((total_lines - 1)) "$backup_file" | tail -n +2 | sha256sum | cut -d' ' -f1)
    elif command -v md5sum >/dev/null 2>&1; then
        computed_sum=$(head -n $((total_lines - 1)) "$backup_file" | tail -n +2 | md5sum | cut -d' ' -f1)
        debug_write "[BACKUP VALIDATE] Using md5sum fallback"
    else
        debug_write "[BACKUP VALIDATE ERROR] No checksum tool available"
        return 1
    fi

    if [ -z "$computed_sum" ]; then
        debug_write "[BACKUP VALIDATE ERROR] Failed to compute checksum"
        return 1
    fi
    
    debug_write "[BACKUP VALIDATE] Computed checksum: ${computed_sum:0:16}..."

    # 4. Compare checksums
    if [ "$stored_sum" = "$computed_sum" ]; then
        debug_write "[BACKUP VALIDATE] Backup valid"
        return 0
    else
        debug_write "[BACKUP VALIDATE] CHECKSUM MISMATCH"
        debug_write "   Stored:   $stored_sum"
        debug_write "   Computed: $computed_sum"
        return 1
    fi
}
#####################################################################
# TAG HANDLER -> Show backup files
show_backups() {
    
    log "Available backup files:"
    echo ""
    
    local backup_found=0
    
    for path in $BACKUP_PATHS; do

        local backup_file="${path}.BACKUP_PRE_WIREGUARD"
        
        if [ -f "$backup_file" ]; then
            
            backup_found=1
            
            local backup_size=$(ls -lh "$backup_file" | awk '{print $5}')
            local backup_date=$(ls -l "$backup_file" | awk '{print $6" "$7" "$8}')
            local backup_tag=$(head -1 "$backup_file" | sed 's/^# //')
            
            if validate_backup "$backup_file"; then
            
                success "${YELLOW}$(basename $path) ${GREEN}[VALID]${NC}"
            
            else
            
                debug_write "[BACKUPS SHOW] Found a corrupted backup file: $path"

                warning "${YELLOW}$(basename $path) ${RED}[CORRUPTED]${NC}"
            
            fi
            
            echo -e "      ${YELLOW}Path: ${GREEN}$backup_file${NC}"
            echo -e "      ${YELLOW}Tag:  ${GREEN}$backup_tag${NC}"
            echo -e "      ${YELLOW}Size: ${GREEN}$backup_size${NC} | ${YELLOW}Date: ${GREEN}$backup_date${NC}"
            echo ""
        fi
    done
    
    if [ $backup_found -eq 0 ]; then
        
        warning "No backup files found!"
        
        return 1
    
    fi
    
    return 0
}
#####################################################################
# TAG HANDLER -> Restore backup files
restore_backups() {


    local file_to_restore="$1"
    local silent="${2:-}"
    
    debug_write "[RESTORE] Starting restore operation"
    [ "$silent" != "silent" ] && verbose log "Restoring backup files..."
    
    local restore_count=0
    local skip_count=0
    local corrupt_count=0
    local error_count=0
    
    for path in $BACKUP_PATHS; do
        local config_name=$(basename "$path")
        local backup_file="${path}.BACKUP_PRE_WIREGUARD"
        
        debug_write "[RESTORE] Processing: $config_name"
        
        
        
        [ -n "$file_to_restore" ] && [ "$config_name" != "$file_to_restore" ] && continue
        
        if [ ! -f "$backup_file" ]; then
            
            debug_write "[RESTORE] Backup not found: $backup_file"
            
            [ "$silent" != "silent" ] && warning "Backup not found for $config_name"
            
            skip_count=$((skip_count + 1))
            
            continue
        fi
        
        # VALIDATING ................
        if ! validate_backup "$backup_file"; then
            
            debug_write "[RESTORE] Backup CORRUPTED: $backup_file"
            
            corrupt_count=$((corrupt_count + 1))
            
            if [ "$silent" != "silent" ]; then
            
                error "Backup CORRUPTED for $config_name!"
            
            else
            
  
                debug_write "[RESTORE SILENT] Corrupted backup skipped: $config_name"
            
            fi
            
        
            continue
        # .... NEVER, NEVER, NEVER RESTORE CORRUPTEF FILES!
        
        fi
        


        # IF OK
        local temp_restore="${ATOMIC_PATHS}/${config_name}.restore.$$"
        local restore_ok=0
        
        debug_write "[RESTORE] Restoring $config_name atomically..."
        

        if sed '1d; $d' "$backup_file" > "$temp_restore" 2>/dev/null; then

            
            if [ ! -s "$temp_restore" ]; then
                
                debug_write "[RESTORE WARNING] Restored content empty for $config_name"

            fi
            

            if mv "$temp_restore" "$path" 2>/dev/null; then
             
                restore_ok=1
                debug_write "[RESTORE] Atomically restored: $config_name"
            
            else
              
                debug_write "[RESTORE ERROR] Failed to replace $config_name"
                error_count=$((error_count + 1))
           
            fi
        
        
        else
            
            debug_write "[RESTORE ERROR] Failed to extract content from backup"
            error_count=$((error_count + 1))
        fi
        

        [ -f "$temp_restore" ] && rm -f "$temp_restore" 2>/dev/null
        
        if [ $restore_ok -eq 1 ]; then
            
            restore_count=$((restore_count + 1))
            
            [ "$silent" != "silent" ] && verbose success "Restored $config_name from backup"
            
            debug_write "[RESTORE] Successfully restored: $config_name"
        
        
        else
            
            [ "$silent" != "silent" ] && warning "Failed to restore $config_name"
            
            skip_count=$((skip_count + 1))
        
        fi
    done
    
    # COMMITS
    if [ $restore_count -gt 0 ]; then
        debug_write "[RESTORE] Committing UCI changes..."
        uci commit network 2>/dev/null && debug_write "[RESTORE] network committed"
        uci commit dhcp 2>/dev/null && debug_write "[RESTORE] dhcp committed"
        uci commit firewall 2>/dev/null && debug_write "[RESTORE] firewall committed"
        /etc/init.d/firewall reload 2>/dev/null && debug_write "[RESTORE INIT.D] firewall reloaded"
        
        [ "$silent" != "silent" ] && verbose success "$restore_count file(s) restored successfully"
        debug_write "[RESTORE] Completed: restored=$restore_count, corrupted=$corrupt_count, errors=$error_count, skipped=$skip_count"
        return 0
    
    
    else

        debug_write "[RESTORE] No files restored: corrupted=$corrupt_count, errors=$error_count, skipped=$skip_count"
        verbose error "No files restored: corrupted=$corrupt_count, errors=$error_count, skipped=$skip_count"
        
        if [ "$silent" != "silent" ]; then
            
            if [ $corrupt_count -gt 0 ]; then
            
                error "No files restored: $corrupt_count backup(s) corrupted!"
            
            else
            
                warning "No files were restored"
            
            fi
        fi
        
        return 1
    fi
}

diagnose_backup_issue() {
    
    local config="$1"
    local backup="${config}.BACKUP_PRE_WIREGUARD"
    
    if [ ! -f "$backup" ]; then
        
        warning  "No backup found for $(basename "$config")"
        return
    
    fi
    
    echo ""
    ui_lines 79 "${YELLOW}Diagnosing backup: ${GREEN}$(basename "$backup")${NC}"
    echo ""
    
    echo -e "  ${YELLOW}1. File structure:${NC}"
    echo -e "     Total lines:  ${GREEN}$(wc -l < "$backup")${NC}"
    echo -e "     Line 1 (tag): ${GREEN}$(head -1 "$backup")${NC}"
    echo -e "     Last line:    ${GREEN}$(tail -1 "$backup")${NC}"
    echo ""
    
    local stored_sum=$(tail -1 "$backup" | grep -o '[0-9a-f]\{64\}')
    echo -e "  ${YELLOW}2. Stored checksum: ${BLUE}$stored_sum${NC}"
    echo ""
    local total_lines=$(wc -l < "$backup")
    local computed_sum=$(head -n -1 "$backup" | tail -n +2 | sha256sum | cut -d' ' -f1)
    echo -e "  ${YELLOW}3. Real checksum:${NC}   ${BLUE}$computed_sum${NC}"
    # echo ""
    
    if [ "$stored_sum" = "$computed_sum" ]; then
        
        echo ""
        ui_lines 79 "Backup is ${GREEN}VALID${NC}"
    
    else
        
        echo ""
        warning "   Backup is ${RED}CORRUPTED${NC}!"
        echo ""
        
       
        echo -e "  ${YELLOW}4. Content analysis:${NC}"
        local content=$(head -n -1 "$backup" | tail -n +2)
        echo -e "   Content lines: ${GREEN}$(echo "$content" | wc -l)${NC}"
        echo -e "   Content bytes: ${GREEN}$(echo "$content" | wc -c)${NC}"
        echo ""
        
        if [ -f "$config" ]; then
            
            local current_sum=$(cat "$config" | sha256sum | cut -d' ' -f1)
            
            echo -e "  ${YELLOW}5. Current file checksum:${NC} $current_sum"
            
            if [ "$current_sum" = "$stored_sum" ]; then
                
                success "Current file matches backup checksum"
            
            else
            
                debug_write "[BACKUPS DIAG] Found CORRUPTED backup: $backup !"

                echo ""
                warning "Current file ${RED}DIFFERS${NC} from backup!"
                verbose echo ""
                verbose log "Original backup file have been modified unexpectedly! "
                verbose echo -e "  ${YELLOW}Did you edit a backup file?${NC}"
                verbose echo -e "  This should ${YELLOW}NOT${NC} have happened. Please review now each "
                verbose echo -e "  configuration (network, firewall, dhcp) to ensure system integrity!"
                verbose echo ""
                verbose echo -e "  If you make changes, remember to ${YELLOW}COMMIT${NC} them by running:"
                verbose echo -e "   ${YELLOW}uci commit network${NC}, ${YELLOW}uci commit dhcp${NC}, or ${YELLOW}uci commit firewall${NC}"
                verbose echo ""
                verbose ui_lines 80
            fi
        fi
    fi
    echo ""
}


#####################################################################
# TAG HANDLER -> Cleanup backup files (CORREGIDO TYPO)
#####################################################################
cleanup_backup_files() {

    local force="${1:-}"
    
    debug_write "[BACKUP CLEANUP] Starting backup cleanup"
    [ "$force" != "force" ] && verbose log "Cleaning up backup files..."
    
    local removed_count=0
    local kept_count=0
    local error_count=0
    
    # 1. IFACE VERIF
    local active_ifaces=""
    local has_active_ifaces=0
    
    if [ "$force" != "force" ]; then
        
        active_ifaces=$(get_all_wg_interfaces)
        
        if [ -n "$active_ifaces" ]; then
            
            has_active_ifaces=1
            debug_write "[BACKUP CLEANUP] Active WireGuard interfaces found: $active_ifaces"
            [ "$force" != "force" ] && verbose warning "Active WireGuard interfaces detected, keeping backups"
        
        else
            debug_write "[BACKUP CLEANUP] No active WireGuard interfaces found"
        fi
    fi
    
    for path in $BACKUP_PATHS; do
        
        local backup_file="${path}.BACKUP_PRE_WIREGUARD"
        
        if [ ! -f "$backup_file" ]; then
            continue
        fi
        
        debug_write "[BACKUP CLEANUP] Processing: $(basename "$backup_file")"
        
        
        # 2. MODE SELECT
        local should_remove=0
        
        if [ "$force" = "force" ]; then
            
            # 2.1   NUKE (force), deletem all
            should_remove=1
            debug_write "[BACKUP CLEANUP] Force removal (nuke mode)"
        
        

        # 2.2 IFACE VERIFY
        elif [ $has_active_ifaces -eq 0 ]; then
            
            # 2.2.1   NO IFACES -> Validate and remove
            if validate_backup "$backup_file" 2>/dev/null; then
                
                # 2.2.2 VALID, DELETE
                should_remove=1
                debug_write "[BACKUP CLEANUP] Valid backup, removing (no active interfaces)"
            
            else
                
                # 2.2.2.1 CORRUPTED, RETAIN
                
                should_remove=0
                
                debug_write "[BACKUP CLEANUP] Corrupted backup, keeping for diagnosis"
                
                kept_count=$((kept_count + 1))
            fi
        


        else
            # 2.3   ANY OTHER IFACE EXIST -> RETAIN!
            should_remove=0
            
            debug_write "[BACKUP CLEANUP] Keeping backup (active interfaces exist)"
            kept_count=$((kept_count + 1))
            
            continue
        fi
        
        
        
        # 3. PROCESS REMOVAL
        if [ $should_remove -eq 1 ]; then
            
            if rm -f "$backup_file" 2>/dev/null; then
                
                removed_count=$((removed_count + 1))
                
                debug_write "[BACKUP CLEANUP] Removed: $(basename "$backup_file")"
            
            
            else
                
                error_count=$((error_count + 1))
                debug_write "[BACKUP CLEANUP ERROR] Failed to remove: $backup_file"
            
            fi
        fi
    done
    
    debug_write "[BACKUP CLEANUP] Completed: removed=$removed_count, kept=$kept_count, errors=$error_count, has_active_ifaces=$has_active_ifaces"
    



    # D0ne!
    if [ $error_count -eq 0 ]; then
        if [ "$force" != "force" ] && [ $removed_count -gt 0 ]; then
            verbose success "Removed $removed_count backup file(s)"
        fi
        
        if [ $kept_count -gt 0 ]; then
            if [ $has_active_ifaces -eq 1 ]; then
                [ "$force" != "force" ] && verbose log "Kept $kept_count backup(s) (active interfaces exist)"
            else
                [ "$force" != "force" ] && warning "Kept $kept_count corrupted backup(s) for diagnosis"
            fi
        fi
        
        # NUKE (force) DO NOT RETAIN
        if [ "$force" = "force" ] && [ $removed_count -eq 0 ] && [ $kept_count -eq 0 ]; then
            
            debug_write "[BACKUP CLEANUP] No backups found to clean"
            
            [ "$force" != "force" ] && verbose log "No backup files to clean"
        
        fi
        
        return 0
    
    
    
    else
        
        [ "$force" != "force" ] && warning "Backup cleanup completed with $error_count error(s)"
        return 1
    
    fi
}

#####################################################################
#
#  ██████╗██╗     ███████╗ █████╗ ███╗   ██╗██╗   ██╗██████╗
# ██╔════╝██║     ██╔════╝██╔══██╗████╗  ██║██║   ██║██╔══██╗
# ██║     ██║     █████╗  ███████║██╔██╗ ██║██║   ██║██████╔╝
# ██║     ██║     ██╔══╝  ██╔══██║██║╚██╗██║██║   ██║██╔═══╝
# ╚██████╗███████╗███████╗██║  ██║██║ ╚████║╚██████╔╝██║
#  ╚═════╝╚══════╝╚══════╝╚═╝  ╚═╝╚═╝  ╚═══╝ ╚═════╝ ╚═╝
#
#####################################################################

#####################################################################
# WG-AUTOCONF CLEANUP
#####################################################################
cleanup() {
    
    local mode="$1"
    local target_iface="$2"
    local silent="${3:-}"


    # 1. VALIDATE MODE
    if [ -z "$mode" ] || ! echo "$mode" | grep -qE "^(single|interactive|nuke)$"; then
        error "cleanup: Invalid mode '$mode' (use: ${YELLOW}clean${NC} <iface> | ${YELLOW}clean${NC} | ${RED}nuke{NC} )"
        return 1
    fi


    # 2. UNCONDITIONAL INITS
    state_init
    check_bins

    debug_write "[CLEANUP] Starting with mode=$mode, target_iface=$target_iface"





    # 3. "DISCOVERY" -> FIND WHAT NEEDS CLEANING
    local interfaces=""
    local all_tables=""
    local all_nft_chains=""
    local interactive=0


    # 3.1 INTERFACE DISCOVERY
    local uci_ifaces=$(get_all_wg_interfaces)
    local kernel_ifaces=$(ip link show 2>/dev/null | grep -o 'wg[^:@]*' | sort -u)
    
    debug_write "[CLEANUP] UCI interfaces: $uci_ifaces"
    debug_write "[CLEANUP] Kernel interfaces: $kernel_ifaces"
    
    # 3.2 ROUTING TABLE DISCOVERY
    local wg_tables=$(grep -E '^[0-9]+[[:space:]]+wg_' /etc/iproute2/rt_tables 2>/dev/null | awk '{print $2}')
    local vpn_tables=$(grep -E '^[0-9]+[[:space:]]+_vpn_' /etc/iproute2/rt_tables 2>/dev/null | awk '{print $2}')
    
    debug_write "[CLEANUP] WG tables: $wg_tables"
    debug_write "[CLEANUP] VPN tables: $vpn_tables"
    
    # 3.3 NFTABLES CHAIN DISCOVERY
    if [ "$CAP_NFTABLES" = "1" ]; then
        
        all_nft_chains=$(nft list table inet fw4 2>/dev/null | grep -o 'chain [a-zA-Z0-9_]*_wg_[a-zA-Z0-9_]*' | sed 's/chain //' | sort -u)
        
        debug_write "[CLEANUP] NFT WG chains: $all_nft_chains"
    
    fi






    # 4.   CASES BY MODES
    case "$mode" in


        # 4.1 SINGLE MODE
        single)
            if [ -z "$target_iface" ]; then
                error "cleanup: Interface name required for 'single' mode"
                return 1
            fi

            validate_iface_name "$target_iface"

            # CHECK BOOOOOT UCI + KERNEL
            if ! iface_exists "$target_iface" && ! ip link show "$target_iface" >/dev/null 2>&1; then
                error "cleanup: $target_iface does not exist anywhere!"
                return 1
            fi

            interfaces="$target_iface"
            interactive=1
            debug_write "[CLEANUP SINGLE] Processing single interface: $target_iface"
            ;;


        # 4.2 INTERACTIVE MODE
        interactive)

            local all_ifaces=$(echo "$uci_ifaces $kernel_ifaces" | tr ' ' '\n' | sort -u)

            if [ -z "$all_ifaces" ]; then
                warning "No WireGuard interfaces found"
                return 0
            fi

            echo ""
            log "Available WireGuard interfaces:"
            echo ""

            local count=0
            for iface in $all_ifaces; do
                count=$((count + 1))
                local addr=$(uci get "network.$iface.addresses" 2>/dev/null || echo "N/A")
                local status=""
                ip link show "$iface" >/dev/null 2>&1 && status="(active)" || status="(inactive)"
                echo "  $count) $iface $status [$addr]"
            done

            echo ""
            printf "  ${YELLOW}Choose an interface${NC} (or press Enter to cancel): "
            read -r selection

            if [ -z "$selection" ]; then
                log "Cleanup cancelled"
                return 0
            fi
            
            count=0
            for iface in $all_ifaces; do
                count=$((count + 1))
                if [ "$count" = "$selection" ]; then
                    interfaces="$iface"
                    break
                fi
            done

            if [ -z "$interfaces" ]; then
                warning "Invalid selection"
                return 1
            fi

            interactive=1
            debug_write "[CLEANUP INTERACTIVE] Selected interface: $interfaces"
            ;;


        # 4.3 NUKE MODE
        nuke)

            # 4.3.1 COMBINE-SORT ALL IFACES (UCI + kernel)
            interfaces=$(echo "$uci_ifaces $kernel_ifaces" | tr ' ' '\n' | sort -u)
            
            # 4.3.2 COMBINE-SORT ALL ROUTING TABLES
            all_tables=$(echo "$wg_tables $vpn_tables" | tr ' ' '\n' | sort -u)
            
            interactive=0
            silent="silent"
            
            debug_write "[NUKE] Interfaces to process: $interfaces"
            debug_write "[NUKE] Tables to clean: $all_tables"
            debug_write "[NUKE] NFT chains to clean: $all_nft_chains"
            ;;
    esac





    # 5. PROCESS EACH INTERFACE (CLEANUP PER INTERFACE)
    local processed_count=0
    local error_count=0

    for iface in $interfaces; do
        
        # 5.1 CONFIRMATION FOR NON-NUKE IF NEEDED
        if [ "$silent" != "silent" ] && [ "$interactive" -eq 1 ]; then
            
            debug_write "[CLEANUP] Starting cleanup for $iface"
            log "Cleaning up $iface..."
            echo ""
            
            local addr=$(uci get "network.$iface.addresses" 2>/dev/null || echo "N/A")
            local ep=$(uci get "network.${iface}_peer.endpoint_host" 2>/dev/null || echo "N/A")

            echo ""
            ui_lines 49 " ${GREEN}$iface${NC}"
            echo "  Address: $addr"
            echo "  Endpoint: $ep"
            ui_lines 50
            echo ""

            printf "${YELLOW}Proceed with cleanup? (${GREEN}y${YELLOW}/${RED}N${YELLOW}):${NC} "
            read -r confirm

            case "$confirm" in
                y|Y|yes|YES|Yes|okidoki|OKIDOKI|Okidoki|OkiDoki)
                    ;;
                *)
                    log "Cleanup cancelled for $iface"
                    continue
                    ;;
            esac
            echo ""
        fi

    
        # 5.2 CLEANUP ROUTES --> By finding ALL VPN tables for this interface
        local iface_vpn_tables=$(grep "_vpn_${iface}_" /etc/iproute2/rt_tables 2>/dev/null | awk '{print $2}')
        
        for table in $iface_vpn_tables; do

            # 5.2.1  GET LAN IFACE from table name
            # DEBUG!
            # TODO:  Test/stage stressfully "s/^_vpn_${iface}_//", if fails, fix with _${lan iface}
            local lan_iface=$(echo "$table" | sed "s/^_vpn_${iface}_//")
            
            if [ -n "$lan_iface" ] && [ "$lan_iface" != "$table" ]; then
                
                if [ "$silent" != "silent" ]; then
                    
                    verbose log "Unsetting routes for $iface <-> $lan_iface..."
                
                fi
                
                # HEADACHE!
                # 5.2.2     UNSET_LAN
                if unset_lan_routes "$iface" "$lan_iface" >/dev/null 2>&1; then
                    
                    debug_write "[CLEANUP] Routes unset: $iface <-> $lan_iface"
                
                # 5.2.3 ELSE DEL RT_ + IP RULES BY TABLE
                else
                    
                    debug_write "[CLEANUP] Failed to unset routes via unset_lan_routes, manual cleanup"
                    
                    del_routing_table "$table"
                    del_ip_rules_by_table "$table"
                fi

                # DEBUG! HEADACHE!
                # MATCH THIS EXACT ORDER -> PREVENTS ORPHANED STATES, RULES, TABLES
            fi
        done

    

        # 5.3   FORCE DEACTIVATE INTERFACE FOR NUKE
        if [ "$mode" = "nuke" ] || uci get "network.$iface" >/dev/null 2>&1; then
            
            if [ "$silent" != "silent" ]; then
                
                verbose log "Deactivating interface..."
            
            fi
            
            if deactivate_interface "$iface" >/dev/null 2>&1; then
                
                if [ "$silent" != "silent" ]; then
            
                    verbose success "Interface down: $iface"
            
                fi
                
                debug_write "[CLEANUP] Interface down: $iface"
            
            else
                
                if [ "$silent" != "silent" ]; then
            
                    verbose log "Failed to deactivate $iface (may already be down)"
            
                fi
                
                debug_write "[CLEANUP] deactivate_interface failed for $iface"
            fi
        
        else
            
            debug_write "[CLEANUP] Interface $iface not in UCI, skipping down"
        fi

       
        if [ "$silent" != "silent" ]; then
            
            echo ""
        
        fi

    
        
        # 5.4 REMOVE INTERFACE CONFIGURATION (UCI, tags, state)
        local remove_silent_mode="$silent"
        
        if [ "$mode" = "nuke" ]; then
            
            remove_silent_mode="silent"
        
        fi


        # HEADACHE!
        # 5.4.1 FORCE REMOVAL, EVEN IF NOT IN UCI -> fIXES cleanup orphaned state!
        if remove_wireguard "$iface" "$remove_silent_mode"; then
            
            if [ "$silent" != "silent" ]; then
                
                verbose success "Interface removed: $iface"
            
            fi
            
            processed_count=$((processed_count + 1))
            debug_write "[CLEANUP] Interface removed: $iface"
        
        else
            
            error_count=$((error_count + 1))
            
            if [ "$silent" != "silent" ]; then
                
                warning "Failed to remove $iface"
            
            fi
            
            debug_write "[CLEANUP] remove_wireguard failed for $iface"
        
        fi

        
        if [ "$silent" != "silent" ]; then
            
            echo ""
        
        fi
   
    done


    # HEADACHE!
    # 6. NUKE-ONLY FORCE REMOVALS ->GLOBAL CLEANUP OF ANY ORPHANED RULE-TABLE-FILE-ETC    
    if [ "$mode" = "nuke" ]; then
        

        debug_write "[NUKE] Performing global orphaned artifacts cleanup"


        # 6.1 CLEANY ANY wg* TABLES ORPHANED EVEN PREV. LOOPS
        for table in $wg_tables; do
            
            if grep -q "[[:space:]]$table$" /etc/iproute2/rt_tables 2>/dev/null; then
            
                debug_write "[NUKE] Removing orphaned wg table: $table"
            
                del_routing_table "$table"
                del_ip_rules_by_table "$table"
            
            fi
        
        done


        # 6.2   CLEANY ANY _vpn_* TABLES ORPHANED EVEN PREV. LOOPS
        for table in $vpn_tables; do
            
            if grep -q "[[:space:]]$table$" /etc/iproute2/rt_tables 2>/dev/null; then
            
                debug_write "[NUKE] Removing orphaned vpn table: $table"
            
                del_routing_table "$table"
                del_ip_rules_by_table "$table"
            fi
        
        done


        # 6.3 CLEANY ANY ORPHANED NFT CHAINS
        if [ "$CAP_NFTABLES" = "1" ]; then
            
            for chain in $all_nft_chains; do
                
                if nft list chain inet fw4 "$chain" >/dev/null 2>&1; then
                
                    debug_write "[NUKE] Removing orphaned NFT chain: $chain"
                
                    nft delete chain inet fw4 "$chain" 2>/dev/null
                fi
            
            done
        fi




        # 6.4 CLEANUP ORPHANED ROUTING TABLES (by ID)
        debug_write "[NUKE] Looking for orphaned routing tables by ID"
        
        # 6.4.1 GET ALL IDs FROM IP ROUTE
        local all_table_ids=$(ip route show table all 2>/dev/null | \
                              grep -E 'table [0-9]+' | \
                              sed 's/.*table \([0-9]\+\).*/\1/' | \
                              sort -u)
        

        for tid in $all_table_ids; do
            
            
            # 6.4.2 THIS ID IS FROM A VALID TABLE (wg_* | _vpn_*) ?
            local table_name=$(grep "^$tid[[:space:]]" /etc/iproute2/rt_tables 2>/dev/null | awk '{print $2}')
            
            # 6.4.3 IF NOT, ORPHANED, THEN CLEAN
            if [ -z "$table_name" ] || ! echo "$table_name" | grep -E '^(wg|_vpn_)' >/dev/null; then
                
                debug_write "[NUKE] Found orphaned routing table ID $tid (name: $table_name)"
                
                ip route flush table "$tid" 2>/dev/null
                
                debug_write "[NUKE] Flushed orphaned table $tid"
            fi
        
        done


        # 6.5 CLEANUP ORPHANED IP RULES ( WITH NO TABLES)
        # AS KERNEL DOES, FOR ORPHANEDS, IT PARSES IFACE TO ADDRES / IFACE TO PRIOR
        debug_write "[NUKE] Looking for orphaned IP rules"
        
        ip rule show | grep "lookup [0-9]\+" | while read rule; do
            
            local priority=$(echo "$rule" | awk '{print $1}' | sed 's/://')
            local table_id=$(echo "$rule" | grep -o 'lookup [0-9]\+' | awk '{print $2}')
            
            # 6.5.1 IF MATCH (NO ROUTES), IT'S GARBAGE, THEN DEL
            ip rule del priority "$priority" 2>/dev/null
        
            debug_write "[NUKE] Removed orphaned rule priority $priority (table $table_id)"
        
        done

        # 6.6 STATE RESET
        # DEBUG!
        # TODO:     Count how many time states are reset in NUKE mode, prevent more cycles than required
        state_reset
        debug_write "[NUKE] State reset complete"
    fi




    # 7. D0nE!
    debug_write "[CLEANUP] Completed: mode=$mode, processed=$processed_count, errors=$error_count"

    if [ $error_count -eq 0 ]; then
        
        if [ "$silent" != "silent" ]; then
            echo ""
            success "Cleanup completed successfully!"
            verbose log "All cleanup operations completed."
        fi
        return 0
    
    else
        debug_write "[CLEANUP] Errors ($error_count) found:"
        debug_write ""
        debug cat /usr/libexec/wg-autoconf/states
        debug_write ""
        debug ip link show | grep wg
        debug_write ""
        debug cat /etc/iproute2/rt_tables
        debug_write ""
    
        if [ "$silent" != "silent" ]; then
            echo ""
            warning "Cleanup completed with $error_count error(s)"
        fi
        return 1
    fi
}

#####################################################################
#
# ██████╗  ██████╗ ██╗   ██╗████████╗███████╗███████╗
# ██╔══██╗██╔═══██╗██║   ██║╚══██╔══╝██╔════╝██╔════╝
# ██████╔╝██║   ██║██║   ██║   ██║   █████╗  ███████╗
# ██╔══██╗██║   ██║██║   ██║   ██║   ██╔══╝  ╚════██║
# ██║  ██║╚██████╔╝╚██████╔╝   ██║   ███████╗███████║
# ╚═╝  ╚═╝ ╚═════╝  ╚═════╝    ╚═╝   ╚══════╝╚══════╝
#
#####################################################################

#####################################################################
# WG-AUTOCONF ROUTES SHOW
#####################################################################
show_routes() {

    local filter_wg_iface="$1"

    log "WireGuard routes:"
    echo ""

    
    # 1. VALIDATE ROUTING TABLES VIA RT_TABLE
    if [ ! -f /etc/iproute2/rt_tables ]; then

        error "/etc/iproute2/rt_tables not found"

    fi

    
    # 2. DISPLAY ROUTES BASED ON FILTERING CRITERIA
    if [ -n "$filter_wg_iface" ]; then


        
        # 2a. FILTERED MODE: SHOW ROUTES FOR SPECIFIC IFACE
        log "Routes for $filter_wg_iface:"
        echo ""

        # Find all routing tables associated with the specified iface
        grep "_vpn_${filter_wg_iface}" /etc/iproute2/rt_tables 2>/dev/null | while read -r line; do

            # GET TABLES
            local table_id=$(echo "$line" | awk '{print $1}')
            local table_name=$(echo "$line" | awk '{print $2}')

            # EXTRACT LAN IFACE NAME FROM TABLE
            local lan_iface=$(echo "$table_name" | sed "s/_vpn_${filter_wg_iface}//g")

            # TABLE SECTION HEADER
            echo "$lan_iface:"
            echo "  Table: $table_name (ID: $table_id)"

            # SHOW RULES FOR THIS TABLE
            ip rule show | grep "lookup $table_name" | sed 's/^/  Rule: /'

            # SHOW ALL ROUTES
            ip route show table "$table_name" 2>/dev/null | while read -r route; do

                echo "  Route: $route"
            done || echo "  (no routes found)"

            echo ""
        done

    else
        
        # 2b. UNFILTERED MODE: SHOW ALL WIREGUARD ROUTES
        log "All routes:"
        echo ""

        # Find all VPN routing tables WITH "_vpn_" pattern
        grep "_vpn_" /etc/iproute2/rt_tables 2>/dev/null | while read -r line; do

            # GET TABLES
            local table_id=$(echo "$line" | awk '{print $1}')
            local table_name=$(echo "$line" | awk '{print $2}')

            # TABLE SECTION HEADER
            echo "$table_name (ID: $table_id):"

            # SHOW RULES FOR THIS TABLE
            ip rule show | grep "lookup $table_name" | sed 's/^/  Rule: /'

            # SHOW ALL ROUTES
            ip route show table "$table_name" 2>/dev/null | while read -r route; do

                echo "  Route: $route"

            done || echo "  (no routes)"

            echo ""
        done
    fi

    
    # 3. HANDLE EMPTY STATE WHEN NO ROUTES ARE CONFIGURED
    # CHECK PREOVIOUS VPN TABLES
    [ -z "$(grep '_vpn_' /etc/iproute2/rt_tables 2>/dev/null)" ] && warning "No WireGuard routes configured"
}


#####################################################################
# WG-AUTOCONF SET_LAN_ROUTES
#####################################################################
set_lan_routes() {

    local wg_iface="$1"
    local lan_iface="$2"


    # 0) UNCONDITIONAL PRE-CHECKS
    # upgrade_avoid_garbage, moved to init


    # 1. VALIDATIONS
    [ -z "$wg_iface" ] && error "WireGuard interface name required!"
    [ -z "$lan_iface" ] && error "LAN interface name required!"
    
    # 1.1 Check if WG interface exists in UCI
    if ! uci get "network.$wg_iface" >/dev/null 2>&1; then
        error "SRC: $wg_iface does not exist in network config!"
    fi
    
    # 1.2 Check if LAN interface exists in UCI
    if ! uci get "network.$lan_iface" >/dev/null 2>&1; then
        error "DEST:  $lan_iface does not exist in network config!"
    fi
    
    validate_iface_name "$wg_iface"


    # 2. PRE-CHECKS
    state_init
    check_bins
    
    local wg_id=$(state_get_id "$wg_iface" 2>/dev/null)
    local wg_id_found=$?


    # 3. GATHER NETWORK INFORMATION
    log "Setting up routes for $lan_iface through $wg_iface..."
    echo ""
    
    local lan_ip=""
    local lan_netmask=""
    local wg_ip=""
    
    # 3.1 Get LAN IP
    lan_ip=$(uci get "network.$lan_iface.ipaddr" 2>/dev/null)
    
    if [ -z "$lan_ip" ]; then
        lan_ip=$(ip -4 addr show "$lan_iface" 2>/dev/null | grep inet | awk '{print $2}' | cut -d/ -f1 | head -1)
    fi
    
    if [ -z "$lan_ip" ]; then
        error "Could not determine IP address for $lan_iface!"
    fi

    # 3.2 Get WireGuard IP (from UCI)
    wg_ip=$(uci get "network.$wg_iface.addresses" 2>/dev/null | cut -d/ -f1)
    
    # 3.3 Get LAN netmask
    lan_netmask=$(uci get "network.$lan_iface.netmask" 2>/dev/null)
    
    if [ -z "$lan_netmask" ]; then
        local lan_cidr=$(ip -4 addr show "$lan_iface" 2>/dev/null | grep inet | awk '{print $2}' | cut -d/ -f2 | head -1)
        
        if [ -n "$lan_cidr" ]; then
            case "$lan_cidr" in
                24) lan_netmask="255.255.255.0" ;;
                23) lan_netmask="255.255.254.0" ;;
                22) lan_netmask="255.255.252.0" ;;
                16) lan_netmask="255.255.0.0" ;;
                8)  lan_netmask="255.0.0.0" ;;
                *)  lan_netmask="255.255.255.0" ;;
            esac
        fi
    fi
    
    # 3.4 Calculate subnet
    local cidr=$(netmask_to_cidr "${lan_netmask:-255.255.255.0}")
    
    if [ -z "$lan_netmask" ]; then
        warning "Netmask not found for $lan_iface, assuming /$cidr"
    fi

    local subnet=""
    if [ "$cidr" = "24" ]; then
        subnet="${lan_ip%.*}.0/$cidr"
    elif [ "$cidr" = "16" ]; then
        subnet="${lan_ip%.*.*}.0.0/$cidr"
    elif [ "$cidr" = "8" ]; then
        subnet="${lan_ip%%.*}.0.0.0/$cidr"
    else
        subnet="$(ip_to_network "$lan_ip" "$cidr")/$cidr"
    fi
    
    verbose log "LAN subnet: $subnet"
    verbose log "Router LAN IP: $lan_ip"
    verbose log "WireGuard IP: $wg_ip"


    # 4. ROUTING TABLE SETUP
    local table_name="_vpn_${wg_iface}_${lan_iface}"

    # 4.1 Ensure rt_tables file is healthy
    rt_tables_health

    # 4.2 Check if LAN interface is already routed to another WG interface
    if [ -f /etc/iproute2/rt_tables ]; then
        
        local existing_tables=$(grep "_vpn_.*_${lan_iface}$" /etc/iproute2/rt_tables 2>/dev/null)

        if [ -n "$existing_tables" ]; then
            local same_wg_table=$(echo "$existing_tables" | grep "^[0-9]\+ _vpn_${wg_iface}_${lan_iface}$")
        
            if [ -z "$same_wg_table" ]; then
                debug_write "[ROUTES SET] Denied overwriting/re-routing an already in-use iface ($lan_iface)"
                error "'$lan_iface' is already routed to another WireGuard interface! Please use another destination interface"
                verbose log "To view all the updated routes, run '${GREEN}wg-autoconf status${NC}', or check '${YELLOW}/etc/iproute2/rt_tables${NC}'."
            fi
        fi
    fi


    # 5. ADD ROUTING TABLE
    add_routing_table "$table_name" "150"


    # 6. DELETE OLD RULES
    ip rule del from "$subnet" lookup "$table_name" 2>/dev/null
    ip rule del from "$subnet" to "$subnet" lookup main 2>/dev/null
    ip rule del to "$subnet" lookup "$table_name" 2>/dev/null
    ip rule del from "$wg_ip" lookup "$table_name" 2>/dev/null
    ip route flush table "$table_name" 2>/dev/null




    # HEADACHE!     Another critical headache starts here!
    # 7. ADD IP RULES (WITH DYNAMIC PRIORITIES)
    verbose log "Adding routing rules with dynamic priorities..."

    # 7.0 GET TABLE ID FOR DYNAMIC PRIORITIES
    local table_id=$(grep "[[:space:]]$table_name$" /etc/iproute2/rt_tables 2>/dev/null | awk '{print $1}')
    
    if [ -z "$table_id" ]; then
        warning "Could not determine table ID for $table_name, using fallback priorities"
        table_id=150  # fallback
    fi

    # 7.1 Calculate base priority from table_id
    # Using table_id * 10 to leave room for 10 rules per table
    local prio_base=$((table_id * 10))
    local prio_local=$((prio_base))
    local prio_main=$((prio_base + 1))
    local prio_return=$((prio_base + 3))
    
    debug_write "[ROUTES] Using priorities: local=$prio_local, main=$prio_main, return=$prio_return (base=$prio_base)"

    # 7.2 Local traffic rule (within subnet)
    add_ip_rule "from $subnet to $subnet lookup main" "$prio_local"
    
    # 7.3 Main rule for subnet (outbound traffic)
    add_ip_rule "from $subnet lookup $table_name" "$prio_main"
    
    # 7.4 Return rule for responses (critical)
    add_ip_rule "to $subnet lookup $table_name" "$prio_return"





    # 8. ADD ROUTES TO TABLE
    verbose log "Adding routes to table $table_name..."
    
    # 8.1 Local subnet route
    if ! ip route add "$subnet" dev "$lan_iface" table "$table_name" 2>/dev/null; then
        warning "Failed to add local route for $subnet"
    else
        debug_write "[ROUTES] Added route: $subnet dev $lan_iface table $table_name"
    fi

    # 8.2 Default route via WG
    if ip link show "$wg_iface" >/dev/null 2>&1; then
        
        if ! ip route add default dev "$wg_iface" table "$table_name" 2>/dev/null; then
        
            warning "Failed to add default route via $wg_iface"
        
        else
        
            debug_write "[ROUTES] Added route: default dev $wg_iface table $table_name"
            
            # Verify route exists
            if ip route show table "$table_name" | grep -q "default dev $wg_iface"; then
        
                debug_write "[ROUTES] Default route verified in table $table_name"
        
            else
        
                warning "Default route not properly added to table $table_name"
        
            fi
        fi
    else
        
        warning "$wg_iface is not active! Routes may not work until interface is up."
    
    fi


    # 9. DEBUG VERIFICATION
    debug_write "[ROUTES] Final ip rules:"
    debug ip rule show | grep -E "($subnet|$wg_ip|$table_name)" || true

    debug_write "[ROUTES] Final table $table_name contents:"
    debug ip route show table "$table_name" || true


    # 10. FIREWALL RULES 
    verbose log "Adding firewall forwarding rules to UCI..."
    
    # 10.1 Find firewall line for WG interface
    local fw_line=$(grep -n "option name[[:space:]]*'$wg_iface'" "$FIREWALL_CONF" 2>/dev/null | head -1 | cut -d: -f1)
    
    if [ -z "$fw_line" ]; then
        
        warning "Could not find firewall configuration for $wg_iface"
    
    else
        
        # 10.2 Find tag ID (search backwards from fw_line)
        local fw_tag_id=""
        local line_num=0
        
        while IFS= read -r line || [ -n "$line" ]; do
        
            line_num=$((line_num + 1))
            
            if [ $line_num -ge $fw_line ]; then
        
                break
        
            fi
            
        
            if echo "$line" | grep -q "# wg-autoconf firewall start id "; then
        
                fw_tag_id=$(echo "$line" | sed 's/.*id //g')
        
            fi
        
        done < "$FIREWALL_CONF"
        
        if [ -z "$fw_tag_id" ]; then
        
            warning "Firewall tag not found for $wg_iface"
        
        else
        
            # 10.3 Find end tag line
            local fw_end_line=$(grep -n "# wg-autoconf firewall end id $fw_tag_id" "$FIREWALL_CONF" 2>/dev/null | head -1 | cut -d: -f1)
            
            if [ -z "$fw_end_line" ]; then
        
                warning "Cannot find firewall block end for $wg_iface"
        
            else
        
                # 10.4 Check if rules already exist
                local rules_exist=0
                local in_block=0
                
                while IFS= read -r line || [ -n "$line" ]; do
        
                    if echo "$line" | grep -q "# wg-autoconf firewall start id $fw_tag_id"; then
        
                        in_block=1
                        continue
        
                    fi
                    
                    if echo "$line" | grep -q "# wg-autoconf firewall end id $fw_tag_id"; then
        
                        break
                    fi
                    
                    if [ $in_block -eq 1 ]; then
        
                        if echo "$line" | grep -q "config forwarding"; then
        
                            # GET ENTIRE FORWARDING BLOCK
                            local has_src_lan=0
                            local has_dest_wg=0
                            local has_src_wg=0
                            local has_dest_lan=0
                            
                            # Read next lines to get src and dest
                            while IFS= read -r subline || [ -n "$subline" ]; do
                                if echo "$subline" | grep -q "option src '$lan_iface'"; then
                                    has_src_lan=1
                                fi
                                if echo "$subline" | grep -q "option dest '$wg_iface'"; then
                                    has_dest_wg=1
                                fi
                                if echo "$subline" | grep -q "option src '$wg_iface'"; then
                                    has_src_wg=1
                                fi
                                if echo "$subline" | grep -q "option dest '$lan_iface'"; then
                                    has_dest_lan=1
                                fi
                                
                                # Check if block ends
                                if [ -z "$subline" ] || echo "$subline" | grep -q "^[[:space:]]*config[[:space:]]"; then
                                    break
                                fi
                            done
                            
                            if [ $has_src_lan -eq 1 ] && [ $has_dest_wg -eq 1 ]; then
                                rules_exist=1
                                break
                            fi
                            if [ $has_src_wg -eq 1 ] && [ $has_dest_lan -eq 1 ]; then
                                rules_exist=1
                                break
                            fi
                        fi
                    fi
                done < "$FIREWALL_CONF"
                
                # 10.5 Add rules if they don't exist
                if [ $rules_exist -eq 0 ]; then
                    
                    # Create backup
                    local fw_backup="${FIREWALL_CONF}.backup.$$"
                    cp "$FIREWALL_CONF" "$fw_backup" 2>/dev/null
                    
                    # Insert rules before end tag
                    sed -i "${fw_end_line}i\\
\\
config forwarding\\
    option src '$lan_iface'\\
    option dest '$wg_iface'\\
\\
config forwarding\\
    option src '$wg_iface'\\
    option dest '$lan_iface'\\
\\
" "$FIREWALL_CONF"
                    
                    # Verify insertion
                    if grep -q "option src '$lan_iface'" "$FIREWALL_CONF" 2>/dev/null && \
                       grep -q "option dest '$wg_iface'" "$FIREWALL_CONF" 2>/dev/null; then
                            verbose success "Firewall forwarding rules added to UCI"
                    else
                        # Restore backup on failure
                        mv "$fw_backup" "$FIREWALL_CONF" 2>/dev/null
                        warning "Failed to add firewall rules to UCI"
                    fi
                    
                    rm -f "$fw_backup" 2>/dev/null
                else
                    warning "Forwarding rules already exist in UCI for $lan_iface <--> $wg_iface"
                fi
            fi
        fi
    fi


    # 11. COMMIT-RELOAD
    # DEBUG! NFT NEEDS TO RECREATE RULES-CHAINS
    uci commit firewall 2>/dev/null
    /etc/init.d/firewall reload 2>/dev/null
    sleep 1

    debug_write "[ROUTES] Firewall reloaded, chains should now exist"



    # 12. NFTABLES RULES 
    verbose log "Adding nftables forwarding rules (post-reload)..."

    if command -v nft >/dev/null 2>&1; then
        
        # 12.1 Add forward from LAN to WG (redundante, pero seguro)
        nft add rule inet fw4 forward_${lan_iface} jump accept_to_${wg_iface} 2>/dev/null
        debug_write "[NFTABLES] Ensured forward rule: forward_${lan_iface} -> accept_to_${wg_iface}"
        
        # 12.2 Add forward from WG to LAN
        nft add rule inet fw4 forward_${wg_iface} jump accept_to_${lan_iface} 2>/dev/null
        debug_write "[NFTABLES] Ensured forward rule: forward_${wg_iface} -> accept_to_${lan_iface}"
        
    
        # 12.3 ADD TO RULE accept_to_WG
    
        # 12.3.1 IF EXISTS
        if nft list chain inet fw4 accept_to_${wg_iface} 2>/dev/null | grep -q "oifname \"$wg_iface\" accept"; then
            
            debug_write "[NFTABLES] Rule already exists in accept_to_${wg_iface}"
        
        else
            
            # 12.3.2    ADD VIA NFT
            if nft add rule inet fw4 accept_to_${wg_iface} oifname "${wg_iface}" accept 2>/dev/null; then
            
                debug_write "[NFTABLES] Added rule to accept_to_${wg_iface}"
            
            else
                
                # 12.3.3    ADD VIA NFT MODE 2
                debug_write "[NFTABLES] First attempt failed, trying alternative format..."
                
                if nft add rule inet fw4 accept_to_${wg_iface} meta oifname "${wg_iface}" accept 2>/dev/null; then
                
                    debug_write "[NFTABLES] Added rule (alternative format) to accept_to_${wg_iface}"
                
                else
                
                    warning "Failed to add accept rule to accept_to_${wg_iface}"
                    debug_write "[NFTABLES ERROR] Could not add rule to accept_to_${wg_iface}"
                
                fi
            fi
        fi
        
    
        # 12.4  NFT CHAIN accept_to_*
        if nft list chain inet fw4 accept_to_${lan_iface} 2>/dev/null | grep -q "oifname \"$lan_iface\" accept"; then
            
            debug_write "[NFTABLES] Rule already exists in accept_to_${lan_iface}"
        
        else
            
            nft add rule inet fw4 accept_to_${lan_iface} oifname "${lan_iface}" accept 2>/dev/null
            
            debug_write "[NFTABLES] Added rule to accept_to_${lan_iface}"
        
        fi
        


        debug_write "[NFTABLES] Final verification:"
        debug_write "  accept_to_${wg_iface}: $(nft list chain inet fw4 accept_to_${wg_iface} 2>/dev/null | grep -c oifname || echo 'empty') rules"
        debug_write "  accept_to_${lan_iface}: $(nft list chain inet fw4 accept_to_${lan_iface} 2>/dev/null | grep -c oifname || echo 'empty') rules"
    fi




    # 13. VERIFY MASQUERADE IN NFTABLES
    if command -v nft >/dev/null 2>&1; then
        
        if nft list chain inet fw4 srcnat_${wg_iface} >/dev/null 2>&1; then
        
            debug_write "[ROUTES] Masquerade rule exists for $wg_iface"
        
        else
       
            debug_write "[ROUTES] Masquerade chain srcnat_${wg_iface} not found, but zone has masq=1"
       
        fi
    fi


    # 14. STATES
    if [ $wg_id_found -eq 0 ] && [ -n "$wg_id" ]; then
        
        state_write "ID_${wg_id}_IS_RT_TABLES_IN_USE" "1" 2>/dev/null
    
    fi




    # 15. D0ne!
    verbose echo ""
    verbose log "Route configuration summary:"
    verbose echo "  Table: $table_name (ID: $table_id)"
    verbose echo "  LAN Subnet: $subnet"
    verbose echo "  WireGuard IP: $wg_ip"
    verbose echo "  Via Interface: $wg_iface"
    verbose echo "  Rule priorities: $prio_local (local), $prio_main (subnet out), $prio_return (return)"
    verbose echo ""


    # 16. CONNECITTIVYU TEST
    verbose log "Testing connectivity from router via WG IP..."
    
    if ping -c 1 -W 1 -I "$wg_ip" 8.8.8.8 >/dev/null 2>&1; then
    
        verbose success "Router connectivity via $wg_ip OK (WG)"
    
    else
    
        verbose warning "Router connectivity via $wg_ip may have issues (PING failed)"
    
    fi

    success "Routes configured successfully!"
    
    return 0
}

#####################################################################
# WG-AUTOCONF UNSET_LAN_ROUTES
#####################################################################
unset_lan_routes() {

    local wg_iface="$1"
    local lan_iface="$2"


    # 1) UNCONDITIONAL PRE-CHECKS
    upgrade_avoid_garbage
    rt_tables_health

    [ -z "$wg_iface" ] && error "WireGuard interface name required!"
    [ -z "$lan_iface" ] && error "LAN interface name required!"

    state_init
    check_bins


    # 2. GET IDs AND INFO

    local wg_id=$(state_get_id "$wg_iface" 2>/dev/null)
    local wg_id_found=$?

    local subnet=""
    local table_name="_vpn_${wg_iface}_${lan_iface}"
    local wg_ip=""


    # 2.1 IF TABLE EXIST -> by NAME
    if ! grep "[[:space:]]$table_name$" /etc/iproute2/rt_tables 2>/dev/null; then
        
        debug_write "[ROUTES UNSET] Attempt to remove non-existent rt_tables | From: $wg_iface, To: $lan_iface"
        debug_write ""
        
        debug cat $DEFAULT_TABLES | grep _vpn_
        
        warning  "No routes configured for $wg_iface <-> $lan_iface (table '$table_name' not found!)"
    
    fi   

    log "Removing routes for $lan_iface (via $wg_iface)..."
    


    # 3. GET WG IP
    wg_ip=$(uci get "network.$wg_iface.addresses" 2>/dev/null | cut -d/ -f1)


    # 4. DETERMINE SUBNET
    local lan_ip=""
    local lan_netmask=""
    
    lan_ip=$(uci get "network.$lan_iface.ipaddr" 2>/dev/null)
    lan_netmask=$(uci get "network.$lan_iface.netmask" 2>/dev/null)
    
    if [ -z "$lan_ip" ]; then
        
        lan_ip=$(ip -4 addr show "$lan_iface" 2>/dev/null | grep inet | awk '{print $2}' | cut -d/ -f1 | head -1)
    
    fi
    
    if [ -z "$lan_ip" ]; then
    
        warning "Could not determine IP address for $lan_iface!"
    
    fi
    


    # 4.1 NETMASK to CIDR
    # DEBUG! PENDING REFACTORISE USING HELPER!
    if [ -z "$lan_netmask" ]; then

        local lan_cidr=$(ip -4 addr show "$lan_iface" 2>/dev/null | grep inet | awk '{print $2}' | cut -d/ -f2 | head -1)
        
        if [ -n "$lan_cidr" ]; then
            case "$lan_cidr" in
                24) lan_netmask="255.255.255.0" ;;
                23) lan_netmask="255.255.254.0" ;;
                22) lan_netmask="255.255.252.0" ;;
                16) lan_netmask="255.255.0.0" ;;
                8)  lan_netmask="255.0.0.0" ;;
                *)  lan_netmask="255.255.255.0" ;;
            esac
        fi
    fi
    

    # 4.2 GET SUBNET
    local cidr=$(netmask_to_cidr "${lan_netmask:-255.255.255.0}")
    
    if [ "$cidr" = "24" ]; then
        subnet="${lan_ip%.*}.0/$cidr"
    elif [ "$cidr" = "16" ]; then
        subnet="${lan_ip%.*.*}.0.0/$cidr"
    elif [ "$cidr" = "8" ]; then
        subnet="${lan_ip%%.*}.0.0.0/$cidr"
    else
        subnet="$(ip_to_network "$lan_ip" "$cidr")/$cidr"
    fi
    
    verbose log "Route table: $table_name"
    verbose log "Subnet: $subnet"
    verbose log "WireGuard IP: $wg_ip"





    # 5. REMOVE IP RULES
    debug_write "[ROUTES UNSET] Removing IP rules..."
    
    # 5.1 Get table ID for dynamic priority calculation
    local table_id=$(grep "[[:space:]]$table_name$" /etc/iproute2/rt_tables 2>/dev/null | awk '{print $1}')
    
    if [ -n "$table_id" ]; then
        local prio_base=$((table_id * 10))
        local prio_local=$((prio_base))
        local prio_main=$((prio_base + 1))
        local prio_return=$((prio_base + 3))
        
        # 5.2 Remove by specific priorities (más preciso)
        ip rule del priority "$prio_local" 2>/dev/null
        debug_write "[ROUTES UNSET] Removed local rule priority $prio_local"
        
        ip rule del priority "$prio_main" 2>/dev/null
        debug_write "[ROUTES UNSET] Removed main rule priority $prio_main"
        
        ip rule del priority "$prio_return" 2>/dev/null
        debug_write "[ROUTES UNSET] Removed return rule priority $prio_return"
    fi
    
    # 5.3 Fallback: remove by content
    ip rule del from "$subnet" to "$subnet" lookup main 2>/dev/null
    debug_write "[ROUTES UNSET] Removed local rule: from $subnet to $subnet lookup main"
    
    ip rule del from "$subnet" lookup "$table_name" 2>/dev/null
    debug_write "[ROUTES UNSET] Removed main rule: from $subnet lookup $table_name"
    
    if [ -n "$wg_ip" ]; then
        
        ip rule del from "$wg_ip" lookup "$table_name" 2>/dev/null
        
        debug_write "[ROUTES UNSET] Removed WG IP rule: from $wg_ip lookup $table_name"
    
    fi
    
    ip rule del to "$subnet" lookup "$table_name" 2>/dev/null
    debug_write "[ROUTES UNSET] Removed return rule: to $subnet lookup $table_name"
    
    ip rule del lookup "$table_name" 2>/dev/null
    debug_write "[ROUTES UNSET] Removed any remaining rules with table $table_name"







    # 6. FLUSH ROUTING TABLE
    ip route flush table "$table_name" 2>/dev/null
    debug_write "[ROUTES UNSET] Flushed table $table_name"




    # 7. REMOVE NFTABLES RULES
    debug_write "[ROUTES UNSET] Removing nftables rules..."
    
    if [ "$CAP_NFTABLES" = "1" ]; then
        
        # 7.1 Remove forward from LAN to WG
        if nft list chain inet fw4 forward_${lan_iface} 2>/dev/null | grep -q "jump accept_to_${wg_iface}"; then
            nft delete rule inet fw4 forward_${lan_iface} jump accept_to_${wg_iface} 2>/dev/null
            debug_write "[NFTABLES] Removed forward rule: forward_${lan_iface} -> accept_to_${wg_iface}"
        fi
        
        # 7.2 Remove forward from WG to LAN
        if nft list chain inet fw4 forward_${wg_iface} 2>/dev/null | grep -q "jump accept_to_${lan_iface}"; then
            nft delete rule inet fw4 forward_${wg_iface} jump accept_to_${lan_iface} 2>/dev/null
            debug_write "[NFTABLES] Removed forward rule: forward_${wg_iface} -> accept_to_${lan_iface}"
        fi
        
        # 7.3 Remove accept rule from accept_to_WG
        if nft list chain inet fw4 accept_to_${wg_iface} 2>/dev/null | grep -q "oifname \"$wg_iface\" accept"; then
            nft delete rule inet fw4 accept_to_${wg_iface} oifname "$wg_iface" accept 2>/dev/null
            debug_write "[NFTABLES] Removed accept rule from accept_to_${wg_iface}"
        fi
        
        # Note: accept_to_lan4 chain is kept (may be used by other interfaces)
    fi


    # 8. REMOVE FIREWALL RULES FROM UCI
    debug_write "[ROUTES UNSET] Removing firewall rules from UCI..."
    debug_write "[ROUTES UNSET] Looking for rules: $lan_iface <-> $wg_iface"

    if [ ! -f "$FIREWALL_CONF" ]; then
        
        debug_write "[ROUTES UNSET WARNING] Firewall config not found: $FIREWALL_CONF"
    
    else
        
        # Find firewall tag ID block
        local fw_line=$(grep -n "option name[[:space:]]*['\"]$wg_iface['\"]" "$FIREWALL_CONF" 2>/dev/null | head -1 | cut -d: -f1)
        
        if [ -n "$fw_line" ]; then

            # Get start tag ID
            local fw_tag_id=$(sed -n "1,${fw_line}p" "$FIREWALL_CONF" | grep "# wg-autoconf firewall start id" | tail -1 | sed 's/.*id //g')
            
            if [ -n "$fw_tag_id" ]; then
                
                debug_write "[ROUTES UNSET] Found firewall block with tag id: $fw_tag_id"
                
                # File operations with awk
                local fw_backup="${FIREWALL_CONF}.backup.$$"
                cp "$FIREWALL_CONF" "$fw_backup" 2>/dev/null
                
                awk -v tag_id="$fw_tag_id" -v lan="$lan_iface" -v wg="$wg_iface" '

                    /# wg-autoconf firewall start id/ && $NF == tag_id {
                        in_tag = 1
                        print
                        next
                    }
                    
                    /# wg-autoconf firewall end id/ && in_tag {
                        in_tag = 0
                        print
                        next
                    }
                    
                    in_tag && /^[[:space:]]*config[[:space:]]+forwarding/ {
                        line1 = $0
                        
                        if ((getline line2) > 0) {
                            if ((getline line3) > 0) {
                                src_has_option = (line2 ~ /option[[:space:]]+src/)
                                dest_has_option = (line3 ~ /option[[:space:]]+dest/)
                                
                                if (src_has_option && dest_has_option) {
                                    split(line2, src_parts, "'\''")
                                    split(line3, dest_parts, "'\''")
                                    
                                    src_val = ""
                                    dest_val = ""
                                    
                                    if (length(src_parts) >= 3) {
                                        src_val = src_parts[2]
                                    }
                                    
                                    if (length(dest_parts) >= 3) {
                                        dest_val = dest_parts[2]
                                    }
                                    
                                    if ((src_val == lan && dest_val == wg) || 
                                        (src_val == wg && dest_val == lan)) {
                                        next
                                    }
                                }
                                
                                print line1
                                print line2
                                print line3
                                next
                            }
                        }
                        print line1
                        next
                    }
                    
                    { print }
                ' "$FIREWALL_CONF" > "${FIREWALL_CONF}.tmp.$$" 2>&1
                
                # Verify and replace
                if [ -f "${FIREWALL_CONF}.tmp.$$" ] && [ -s "${FIREWALL_CONF}.tmp.$$" ]; then
                    
                    local rules_before=$(grep -c "option src.*['\"]${lan_iface}['\"]" "$FIREWALL_CONF" 2>/dev/null)
                    local rules_after=$(grep -c "option src.*['\"]${lan_iface}['\"]" "${FIREWALL_CONF}.tmp.$$" 2>/dev/null)
                    
                    debug_write "[ROUTES UNSET] Rules before: $rules_before, after: $rules_after"
                    
                    if [ "$rules_before" -gt "$rules_after" ]; then
                        
                        if mv "${FIREWALL_CONF}.tmp.$$" "$FIREWALL_CONF" 2>/dev/null; then
                            debug_write "[ROUTES UNSET] Firewall rules removed successfully"
                            verbose success "Firewall forwarding rules removed from UCI"
                        else
                            debug_write "[ROUTES UNSET ERROR] Failed to replace firewall config"
                            mv "$fw_backup" "$FIREWALL_CONF" 2>/dev/null
                            warning "Failed to update firewall configuration"
                        fi
                    else
                        debug_write "[ROUTES UNSET] No matching firewall rules found to remove"
                        rm -f "${FIREWALL_CONF}.tmp.$$" 2>/dev/null
                    fi
                else
                    debug_write "[ROUTES UNSET ERROR] Temp file creation failed"
                    warning "Failed to process firewall configuration"
                fi
                
                rm -f "$fw_backup" "${FIREWALL_CONF}.tmp.$$" 2>/dev/null
            
            else
                debug_write "[ROUTES UNSET] No firewall tag found for $wg_iface"
            fi
        else
            debug_write "[ROUTES UNSET] No firewall configuration found for $wg_iface"
        fi
    fi





    # 9. REMOVE FROM RT_TABLES
    del_routing_table "$table_name"




    # 10. CHECK REMAINING TABLES FOR THIS WG IFACE
    local remaining_tables=0
    
    if [ -f /etc/iproute2/rt_tables ]; then
    
        remaining_tables=$(grep "_vpn_${wg_iface}_" /etc/iproute2/rt_tables 2>/dev/null | wc -l)
    
    fi
    
    if ! echo "$remaining_tables" | grep -qE '^[0-9]+$'; then
    
        remaining_tables=0
    
    fi
    
    debug_write "[ROUTES UNSET] After deletion: $remaining_tables table(s) remain for $wg_iface"





    # 11. COMMITS/RELOAD
    uci commit firewall 2>/dev/null
    /etc/init.d/firewall reload 2>/dev/null
    debug_write "[ROUTES UNSET] Firewall committed and reloaded"


    # 12. STATES
    if [ $wg_id_found -eq 0 ] && [ -n "$wg_id" ]; then
        
        if [ "$remaining_tables" -eq 0 ]; then
            
            state_write "ID_${wg_id}_IS_RT_TABLES_IN_USE" "0" 2>/dev/null
            debug_write "[ROUTES UNSET] No more tables for $wg_iface, setting IS_RT_TABLES_IN_USE=0"
        
        else
            
            state_write "ID_${wg_id}_IS_RT_TABLES_IN_USE" "1" 2>/dev/null
            debug_write "[ROUTES UNSET] $remaining_tables table(s) remain for $wg_iface, keeping IS_RT_TABLES_IN_USE=1"
        
        fi
    fi




    # 13. VERIFY CLEANUP
    debug_write "[ROUTES UNSET] Verification - IP rules after cleanup:"
    debug ip rule show | grep -E "($subnet|$wg_ip|$table_name)" || true
    
    debug_write "[ROUTES UNSET] Verification - Table $table_name after cleanup:"
    debug ip route show table "$table_name" 2>/dev/null || echo "Table $table_name does not exist"





    # 14. EXTRA CLEANUP: Remove any orphaned rules that might reference this table
    debug_write "[ROUTES UNSET] Extra cleanup: removing any orphaned rules for $table_name"
    local orphan_rules=$(ip rule show | grep "lookup $table_name" | awk '{print $1}' | sed 's/://')
    for prio in $orphan_rules; do
        ip rule del priority "$prio" 2>/dev/null
        debug_write "[ROUTES UNSET] Removed orphaned rule priority $prio"
    done




    # 15. D0NE
    echo ""
    success "$lan_iface routes (via $wg_iface) successfully removed!"
    debug_write "[ROUTES UNSET] Completed successfully"

    return 0
}
