#####################################################################
# SERVER FUNCTIONS
#####################################################################
# DEBUG r7
# As for 1.0.0 rel, server options are DISABLED by default (still working on  them)
server_create() {
    

    # 0. PRE--CHECKS ROOM, PENDING

    # 1. START
    log "Creating new WireGuard server..."
    read -p "Server name: " server_name
    [ -z "$server_name" ] && error "Server name required"
    
    if state_server_find_by_name "$server_name" >/dev/null 2>&1; then
        
        error "Server '$server_name' already exists!"
    
    fi
    
    printf "Subnet [10.99.0.0/24]: " && read -r  subnet
    # subnet="${subnet:-10.99.0.0/24}"
    
    printf "DNS [${subnet%.*}.1]: " &&  read -r  dns
    dns="${dns:-${subnet%.*}.1}"
    
    printf "Listen port [51820]: " && read -r  port
    port="${port:-51820}"
    
    # DEBUG!
    # TODO: Move to validate_ FUNCS
    if ! echo "$port" | grep -qE '^[0-9]+$' || [ "$port" -lt 1 ] || [ "$port" -gt 65535 ]; then
        
        error "Invalid port: $port"
    
    fi
    
    printf "Server endpoint (hostname/IP) [E.g. XX.XXX.X.XX]: " && read -r  endpoint
    

    verbose log "Creating keypairs"
    local keypair=$(config_generate_server)
    local privkey="${keypair%|*}"
    local pubkey="${keypair#*|}"
    
    local server_id=$(state_server_create "$server_name" "$subnet" "$dns" "$privkey" "$pubkey" "$port")
    [ -z "$server_id" ] && error "Failed to create server in state"
    
    # STATE DATA ADD
    state_write "SERVER_${server_id}_ENDPOINT" "$endpoint"
    


    # 3. CREATE SERVER IFACE
    uci_create_server_interface "$server_name" "$privkey" "$subnet" "$port" || error "Failed to create UCI interface"
    
    fw_create_server_zone "$server_name" "$port" "$subnet" || error "Failed to create firewall zone"
    
    # 4. CREATING SERVER CONF
    server_generate_client_template "$server_name" "$server_id" "$endpoint"
    
    # 5. COMMITS
    uci commit network 2>/dev/null
    uci commit firewall 2>/dev/null
    /etc/init.d/network reload 2>/dev/null
    # 5.1 COMMITS NFT CHAIN PRESERVERS!!! :D
    fw_reload_with_wg_detection
    

    # D0NE
    success "Server '$server_name' created successfully!"
    echo ""
    echo "Server Public Key: $pubkey"
    echo "Subnet: $subnet"
    echo "DNS: $dns"
    echo "Listen Port: $port"
    echo "Endpoint: $endpoint"
    echo ""
    echo "Client template saved to: /usr/libexec/wg-autoconf/configs/server_${server_name}/README.txt"
    echo ""
    echo "Ready to add users with: wg-autoconf server add $server_name <username>"
}

server_add_user() {
    
    local server_name="$1"
    local user_name="$2"

    [ -z "$server_name" ] && error "Server name required"
    [ -z "$user_name" ] && error "User name required"

    local server_id=$(state_server_find_by_name "$server_name")
    [ -z "$server_id" ] && error "Server '$server_name' not found"

    local existing_users=$(state_server_list_users "$server_id" 2>/dev/null | grep ":$user_name$")
    [ -n "$existing_users" ] && error "User '$user_name' already exists in server '$server_name'"

    local next_ip=$(state_server_get_next_ip "$server_id")
    [ -z "$next_ip" ] && error "Cannot allocate IP for user"

    local keypair=$(config_generate_user)
    local user_privkey="${keypair%|*}"
    local user_pubkey="${keypair#*|}"

    local server_pubkey=$(state_read "SERVER_${server_id}_PUBKEY")
    local server_dns=$(state_read "SERVER_${server_id}_DNS")
    local endpoint=$(state_read "SERVER_${server_id}_NAME")
    local port=$(state_read "SERVER_${server_id}_LISTEN_PORT")

    state_server_add_user "$server_id" "$user_name" "$next_ip" "$user_pubkey" "$user_privkey" || \
    
        error "Failed to add user to state"

    uci_add_peer_to_server "$server_name" "$user_name" "$user_pubkey" "$next_ip" || \
    
        error "Failed to add peer to UCI"

    
    # WG SET (SERVER'S) USER
    wg set "wg_server_${server_name}" peer "$user_pubkey" allowed-ips "${next_ip}/32" 2>/dev/null
    debug_write "[WG SET] Added peer directly: $user_pubkey"

    local subnet=$(state_read "SERVER_${server_id}_SUBNET")
    config_save_user "$server_name" "$user_name" "$user_privkey" "$server_pubkey" "$next_ip" "${subnet%/*}.1" "$server_dns" "$endpoint" "$port" || \
        error "Failed to save user config"


    # COMMITS
    uci commit network 2>/dev/null
    /etc/init.d/network reload 2>/dev/null



    # D0nE!
    success "User '$user_name' added to server '$server_name'"
    echo ""
    echo "User IP: $next_ip"
    echo "Config file: /usr/libexec/wg-autoconf/configs/server_${server_name}/${user_name}.conf"
    echo ""
    echo "Config ready to export to device."
}

server_revoke_user() {
    
    local server_name="$1"
    local user_name="$2"

    [ -z "$server_name" ] && error "Server name required"
    [ -z "$user_name" ] && error "User name required"

    local server_id=$(state_server_find_by_name "$server_name")
    [ -z "$server_id" ] && error "Server '$server_name' not found"

    local user_index=""
    local user_list=$(state_server_list_users "$server_id" 2>/dev/null)
    
    for line in $user_list; do
    
        local idx=$(echo "$line" | cut -d: -f1)
        local uname=$(echo "$line" | cut -d: -f2)
    
        if [ "$uname" = "$user_name" ]; then
    
            user_index="$idx"
    
            # continue
            break
    
        fi
    
    done

    [ -z "$user_index" ] && error "User '$user_name' not found in server '$server_name'"

    printf "Are you sure you want to revoke user '$user_name'? (${GREEN}Y${NC}/${RED}n${NC}): " && read -r confirm
    case "$confirm" in
        y|Y|yes|YES|Yes|okidoki|OKIDOKI|Okidoki|OkiDoki)
            ;;
        *)
            error "Revocation cancelled!"
            exit 0
            ;;
    esac

    state_server_revoke_user "$server_id" "$user_index" || error "Failed to revoke user from state"

    uci_remove_peer_from_server "$server_name" "$user_name" || error "Failed to remove peer from UCI"

    config_revoke_user "$server_name" "$user_name"

    uci commit network 2>/dev/null
    /etc/init.d/network reload 2>/dev/null

    success "User '$user_name' revoked from server '$server_name'"
}

server_remove() {
    
    local server_name="$1"

    [ -z "$server_name" ] && error "Server name required"

    local server_id=$(state_server_find_by_name "$server_name")
    [ -z "$server_id" ] && error "Server '$server_name' not found"


    printf "Are you sure you want to remove server '$server_name' completely? (${GREEN}Y${NC}/${RED}n${NC}): " && read -r confirm
    case "$confirm" in
        y|Y|yes|YES|Yes|okidoki|OKIDOKI|Okidoki|OkiDoki)
            ;;
        *)
            error "Removal cancelled"
            exit 0
            ;;
    esac

    log "Revoking all users..."

    local user_list=$(state_server_list_users "$server_id" 2>/dev/null)
    
    for line in $user_list; do
        
        local idx=$(echo "$line" | cut -d: -f1)
        local uname=$(echo "$line" | cut -d: -f2)
        
        debug_write "[SERVER REMOVE] Auto-revoking user: $uname"
        
        state_server_revoke_user "$server_id" "$idx" 2>/dev/null
        
        uci_remove_peer_from_server "$server_name" "$uname" 2>/dev/null
        
        config_revoke_user "$server_name" "$uname" 2>/dev/null
    
    done

    log "Removing firewall rules..."
    fw_remove_server_zone "$server_name"

    log "Removing network interface..."
    uci_remove_server_interface "$server_name"

    log "Removing from state..."
    state_server_delete "$server_id"

    rm -rf "/usr/libexec/wg-autoconf/configs/server_${server_name}" 2>/dev/null

    uci commit network 2>/dev/null
    uci commit firewall 2>/dev/null
    
    /etc/init.d/network reload 2>/dev/null
    fw_reload_with_wg_detection

    success "Server '$server_name' completely removed"
}

server_list() {

    log "Active WireGuard Servers"
    echo ""

    local server_count=$(grep -c "^SERVER_.*_NAME=" "$STATE_FILE" 2>/dev/null)
    [ "$server_count" -eq 0 ] && { warning "No servers found"; return 0; }

    grep "^SERVER_.*_NAME=" "$STATE_FILE" | cut -d_ -f2 | sort -u | while read server_id; do
        
        local server_name=$(state_read "SERVER_${server_id}_NAME")
        local subnet=$(state_read "SERVER_${server_id}_SUBNET")
        local user_count=$(state_read "SERVER_${server_id}_USER_COUNT")
        
        echo -e "${BOLD}${YELLOW}Server: ${NB}${GREEN}$server_name${NC}"
        echo "  ${BLUE}Subnet: ${GREEN}$subnet${NC}"
        echo "  ${BLUE}Users: ${GREEN}$user_count${NC}"
        
        local users=$(state_server_list_users "$server_id" 2>/dev/null)
        
        for line in $users; do
            
            local idx=$(echo "$line" | cut -d: -f1)
            local uname=$(echo "$line" | cut -d: -f2)
            local user_ip=$(state_read "SERVER_${server_id}_USER_${idx}_IP")
            
            echo "    - $uname ($user_ip)"
        done
        
        echo ""
    
    done
}

server_stats() {

    local server_name="$1"

    [ -z "$server_name" ] && error "Server name required"

    local server_id=$(state_server_find_by_name "$server_name")
    [ -z "$server_id" ] && error "Server '$server_name' not found"

    local iface="wg_server_${server_name}"

    log "Server Statistics: $server_name"
    echo ""

    wg show "$iface" 2>/dev/null || warning "Interface not active"

    echo ""
    ui_lines 79 "User Details:"
    
    local users=$(state_server_list_users "$server_id" 2>/dev/null)
    
    for line in $users; do
        
        local idx=$(echo "$line" | cut -d: -f1)
        local uname=$(echo "$line" | cut -d: -f2)
        local user_ip=$(state_read "SERVER_${server_id}_USER_${idx}_IP")
        local last_hs=$(state_read "SERVER_${server_id}_USER_${idx}_LAST_HS")
        local bytes_rx=$(state_read "SERVER_${server_id}_USER_${idx}_BYTES_RX")
        local bytes_tx=$(state_read "SERVER_${server_id}_USER_${idx}_BYTES_TX")
        
        echo "  $uname ($user_ip)"
        echo "    Last HS: $last_hs"
        echo -e "    ${YELLOW}RX${NC}: ${GREEN}$bytes_rx${NC} bytes | ${YELLOW}TX${NC}: ${GREEN}$bytes_tx${NC} bytes"
    done
}


config_save_user() {

    local server_name="$1"
    local user_name="$2"
    local user_privkey="$3"
    local server_pubkey="$4"
    local user_ip="$5"
    local server_ip="$6"
    local server_dns="$7"
    local endpoint="$8"
    local port="$9"

    if [ -z "$server_name" ] || [ -z "$user_name" ] || [ -z "$user_privkey" ]; then
        return 1
    fi

    local config_dir="/usr/libexec/wg-autoconf/configs/server_${server_name}"
    mkdir -p "$config_dir" 2>/dev/null

    local config_file="${config_dir}/${user_name}.conf"


    # DEBUG! r7
    # ALLOWED IPS NEED A SOLUTION...Hardcoding is OK but ... in which scenarios an user will need to short/narrow the AIPs range?
    cat > "$config_file" <<EOF
# wg-autoconf $VERSION Client .conf
# wg-autoconf - Server: $server_name
# wg-autoconf - User: $user_name
# wg-autoconf - Generated: $(date)
[Interface]
PrivateKey = $user_privkey
Address = ${user_ip}/32
DNS = $server_dns
[Peer]
PublicKey = $server_pubkey
Endpoint = ${endpoint}:${port}
AllowedIPs = 0.0.0.0/0, ::/0
PersistentKeepalive = 25
EOF

    chmod 600 "$config_file"
    debug_write "[CONFIG] Saved user config: $config_file"
    
    success "Config generated for user '$user_name'"
    echo ""
    ui_lines 9 "Config Preview"
    cat "$config_file"
    ui_lines 10
    
    return 0
}
server_generate_client_template() {

    local server_name="$1"
    local server_id="$2"
    local endpoint="$3"

    local server_pubkey=$(state_read "SERVER_${server_id}_PUBKEY")
    local port=$(state_read "SERVER_${server_id}_LISTEN_PORT")
    local server_dns=$(state_read "SERVER_${server_id}_DNS")
    local subnet=$(state_read "SERVER_${server_id}_SUBNET")

    local template_file="/usr/libexec/wg-autoconf/configs/server_${server_name}/README-${server_name}.md"
    
    mkdir -p "$(dirname "$template_file")" 2>/dev/null


    # DEBUG! r7
    # ALLOWED IPS NEED A SOLUTION...Hardcoding is OK but ... in which scenarios an user will need to short/narrow the AIPs range?
    echo "# WireGuard Server: $server_name" > "$template_file"
    echo "#" >> "$template_file"
    echo "# - SERVER INFORMATION:" >> "$template_file"
    echo "#     Public Key: $server_pubkey" >> "$template_file"
    echo "#     Endpoint: ${endpoint}:${port}" >> "$template_file"
    echo "#     Subnet: $subnet" >> "$template_file"
    echo "#     DNS: $server_dns" >> "$template_file"
    echo "#" >> "$template_file"
    echo "# - ADDING USERS:" >> "$template_file"
    echo "#   Command: wg-autoconf server add $server_name <username>" >> "$template_file"
    echo "#   This will auto-generate a complete .conf file for the user" >> "$template_file"
    echo "#" >> "$template_file"
    echo "# - CONFIG FILES:" >> "$template_file"
    echo "#   Each user config is saved in: ${server_name}/<username>.conf" >> "$template_file"
    echo "#" >> "$template_file"
    echo "# - IMPORTING IN WIREGUARD APP:" >> "$template_file"
    echo "#    1. Download the .conf file from this directory" >> "$template_file"
    echo "#    2. Open WireGuard app on your device" >> "$template_file"
    echo "#    3. Click (+) button" >> "$template_file"
    echo "#    4. Select \"Create from file\"" >> "$template_file"
    echo "#    5. Choose the .conf file" >> "$template_file"
    echo "#    6. Connect!" >> "$template_file"
    echo "#" >> "$template_file"
    echo "# CLIENT TEMPLATE (if generating manually):" >> "$template_file"
    echo "#" >> "$template_file"
    echo "[Interface]" >> "$template_file"
    echo "PrivateKey = <user_private_key>" >> "$template_file"
    echo "Address = <assigned_ip>/32" >> "$template_file"
    echo "DNS = $server_dns" >> "$template_file"
    echo "[Peer]" >> "$template_file"
    echo "PublicKey = $server_pubkey" >> "$template_file"
    echo "Endpoint = ${endpoint}:${port}" >> "$template_file"
    echo "AllowedIPs = 0.0.0.0/0, ::/0" >> "$template_file"
    echo "PersistentKeepalive = 25" >> "$template_file"

    chmod 644 "$template_file"
    debug_write "[CONFIG] Generated README: $template_file"
}
#####################################################################
# SERVER HANDLER 
#####################################################################
server_handler() {
    
    local action="$1"
    local arg2="$2"
    local arg3="$3"
    
    case "$action" in
        create)
            server_create
            ;;
        add)
            if [ -z "$arg2" ] || [ -z "$arg3" ]; then
                show_header
                exit 1
            fi
            server_add_user "$arg2" "$arg3"
            ;;
        revoke)
            if [ -z "$arg2" ] || [ -z "$arg3" ]; then
                show_header
                exit 1
            fi
            server_revoke_user "$arg2" "$arg3"
            ;;
        remove)
            if [ -z "$arg2" ]; then
                show_header
                exit 1
            fi
            server_remove "$arg2"
            ;;
        list)
            server_list
            ;;
        stats)
            if [ -z "$arg2" ]; then
                show_header
                exit 1
            fi
            server_stats "$arg2"
            ;;
        *)
            show_header
            exit 1
            ;;
    esac
}


#####################################################################
# SERVER CONFIG GENERATION
#####################################################################
config_generate_keypair() {
    
    local privkey=$(wg genkey)
    local pubkey=$(echo "$privkey" | wg pubkey)
    
    echo "${privkey}|${pubkey}"
}

config_generate_server() {
    
    local keypair=$(config_generate_keypair)
    
    echo "$keypair"
}

config_generate_user() {
    
    local keypair=$(config_generate_keypair)
    
    echo "$keypair"
}

config_save_user() {
    
    local server_name="$1"
    local user_name="$2"
    local user_privkey="$3"
    local server_pubkey="$4"
    local user_ip="$5"
    local server_ip="$6"
    local server_dns="$7"
    local endpoint="$8"
    local port="$9"

    if [ -z "$server_name" ] || [ -z "$user_name" ] || [ -z "$user_privkey" ]; then
        return 1
    fi

    local config_dir="/usr/libexec/wg-autoconf/configs/server_${server_name}"
    
    mkdir -p "$config_dir" 2>/dev/null

    local config_file="${config_dir}/${user_name}.conf"

    cat > "$config_file" <<EOF
[Interface]
PrivateKey = $user_privkey
Address = ${user_ip}/32
DNS = $server_dns

[Peer]
PublicKey = $server_pubkey
Endpoint = ${endpoint}:${port}
AllowedIPs = 0.0.0.0/0, ::/0
PersistentKeepalive = 25
EOF

    chmod 600 "$config_file"
    debug_write "[CONFIG] Saved user config: $config_file"
    return 0
}

config_revoke_user() {
    
    local server_name="$1"
    local user_name="$2"

    if [ -z "$server_name" ] || [ -z "$user_name" ]; then
    
        return 1
    
    fi

    local config_file="/usr/libexec/wg-autoconf/configs/server_${server_name}/${user_name}.conf"
    
    rm -f "$config_file" 2>/dev/null

    
    debug_write "[CONFIG] Revoked user config: $config_file"
    
    return 0

}


#####################################################################
# FIREWALL SERVER FUNCS
#####################################################################

fw_create_server_zone() {
    
    local server_name="$1"
    local port="$2"
    local subnet="$3"

    if [ -z "$server_name" ] || [ -z "$port" ]; then
    
        return 1
    
    fi

    local iface="wg_server_${server_name}"
    local zone_name="zone_server_${server_name}"

    # 2 VIA UCI
    uci set firewall.${zone_name}=zone
    uci set firewall.${zone_name}.name="$iface"
    uci set firewall.${zone_name}.network="$iface"
    uci set firewall.${zone_name}.input='ACCEPT'
    uci set firewall.${zone_name}.output='ACCEPT'
    uci set firewall.${zone_name}.forward='ACCEPT'
    uci set firewall.${zone_name}.masq='1'

    uci set firewall.allow_${iface}=rule
    uci set firewall.allow_${iface}.name="Allow-WireGuard-${server_name}"
    uci set firewall.allow_${iface}.src='wan'
    uci set firewall.allow_${iface}.dest_port="$port"
    uci set firewall.allow_${iface}.proto='udp'
    uci set firewall.allow_${iface}.target='ACCEPT'

    uci set firewall.fwd_${iface}_to_wan=forwarding
    uci set firewall.fwd_${iface}_to_wan.src="$iface"
    uci set firewall.fwd_${iface}_to_wan.dest='wan'

    debug_write "[FIREWALL] Created zone: $zone_name for $iface"
    
    return 0
}

fw_remove_server_zone() {
    
    local server_name="$1"

    if [ -z "$server_name" ]; then
    
        return 1
    
    fi

    local iface="wg_server_${server_name}"
    local zone_name="zone_server_${server_name}"


    uci delete firewall.${zone_name} 2>/dev/null
    uci delete firewall.allow_${iface} 2>/dev/null
    uci delete firewall.fwd_${iface}_to_wan 2>/dev/null

    debug_write "[FIREWALL] Removed zone: $zone_name"

    return 0
}

fw_reload_with_wg_detection() {
    
    debug_write "[FIREWALL] Reloading with WG detection"
    
    /etc/init.d/firewall reload 2>/dev/null
    sleep 2

    local all_wg_interfaces=$(grep "^[0-9]\+ wg" /etc/iproute2/rt_tables 2>/dev/null | awk '{print $2}')
    
    all_wg_interfaces="$all_wg_interfaces $(ip link show | grep '^[0-9]*:.*wg' | awk '{print $2}' | sed 's/:$//')"

    for wg_iface in $all_wg_interfaces; do
        
        if nft add rule inet fw4 "accept_from_$wg_iface" counter accept 2>/dev/null; then
        
            debug_write "[FIREWALL] Re-added accept_from_$wg_iface"
        
        fi
        
        if nft add rule inet fw4 "accept_to_$wg_iface" counter accept 2>/dev/null; then
        
            debug_write "[FIREWALL] Re-added accept_to_$wg_iface"
        
        fi
        
        if nft add rule inet fw4 srcnat oifname "$wg_iface" jump "srcnat_${wg_iface}" 2>/dev/null; then
        
            debug_write "[FIREWALL] Re-added srcnat jump for $wg_iface"
        
        fi
    done

    return 0
}

#####################################################################
# UCI   SERVER FUNCTIONS
#####################################################################
# DEBUG!
# TODO:     Refactorise ALL onto SETUP/MANUAL functions/validations/cases (adding a new case.... the "server" case!)
uci_create_server_interface() {
    
    local server_name="$1"
    local privkey="$2"
    local subnet="$3"
    local port="$4"

    if [ -z "$server_name" ] || [ -z "$privkey" ]; then
        return 1
    fi

    local iface="wg_server_${server_name}"

    uci set network.$iface=interface
    uci set network.$iface.proto='wireguard'
    uci set network.$iface.private_key="$privkey"
    uci set network.$iface.addresses="${subnet%/*}.1/${subnet##*/}"
    uci set network.$iface.listen_port="$port"

    debug_write "[UCI] Created interface: $iface"
    return 0
}

uci_add_peer_to_server() {
    
    local server_name="$1"
    local user_name="$2"
    local user_pubkey="$3"
    local user_ip="$4"

    if [ -z "$server_name" ] || [ -z "$user_name" ] || [ -z "$user_pubkey" ]; then
    
        return 1
    
    fi

    local iface="wg_server_${server_name}"
    local peer_section="${iface}_${user_name}"

    uci set network.${peer_section}=wireguard_${iface}
    uci set network.${peer_section}.public_key="$user_pubkey"
    uci set network.${peer_section}.allowed_ips="${user_ip}/32"

    debug_write "[UCI] Added peer: $peer_section"
    return 0
}

uci_remove_peer_from_server() {
    
    local server_name="$1"
    local user_name="$2"

    if [ -z "$server_name" ] || [ -z "$user_name" ]; then
   
        return 1
   
    fi

    local iface="wg_server_${server_name}"
    local peer_section="${iface}_${user_name}"

    uci delete network.${peer_section} 2>/dev/null

    debug_write "[UCI] Removed peer: $peer_section"
   
    return 0
}

uci_remove_server_interface() {
   
    local server_name="$1"

    if [ -z "$server_name" ]; then
   
        return 1
   
    fi

    local iface="wg_server_${server_name}"

   
    uci show network | grep "^network.${iface}_" | cut -d. -f2 | while read peer_section; do
   
        uci delete "network.$peer_section" 2>/dev/null
   
    done

    uci delete network.$iface 2>/dev/null

    debug_write "[UCI] Removed interface: $iface"
    return 0
}


#####################################################################
# ███████╗████████╗ █████╗ ████████╗██╗   ██╗███████╗
# ██╔════╝╚══██╔══╝██╔══██╗╚══██╔══╝██║   ██║██╔════╝
# ███████╗   ██║   ███████║   ██║   ██║   ██║███████╗
# ╚════██║   ██║   ██╔══██║   ██║   ██║   ██║╚════██║
# ███████║   ██║   ██║  ██║   ██║   ╚██████╔╝███████║
# ╚══════╝   ╚═╝   ╚═╝  ╚═╝   ╚═╝    ╚═════╝ ╚══════╝
#####################################################################
#####################################################################
# WG-AUTOCONF SHOW STATUS
#####################################################################
show_status() {

    local filter_iface="$1"
    

    # 0) UNCONDITIONAL PRE-CHECKS

    # upgrade_avoid_garbage, moved to init
    state_init 2>/dev/null
    check_bins 2>/dev/null
    

    # 1. GET ALL INTERFACES

    local all_interfaces=""
    
    # 1.1 UCI
    local uci_ifaces=$(get_all_wg_interfaces)
    
    # 1.2 WG
    local active_ifaces=""
    if [ "$CAP_WG" = "1" ]; then
        
        active_ifaces=$(wg show interfaces 2>/dev/null)
    
    # 1.3   FALLBACK IP LINK SHOW
    else

        active_ifaces=$(ip link show | grep -o 'wg[^:@]*' | sort -u)
    
    fi

    # 2. MERGE THEN SORT
    all_interfaces=$(echo "$uci_ifaces $active_ifaces" | tr ' ' '\n' | sort -u)
    
    # 2.1 NO IFACES
    if [ -z "$all_interfaces" ]; then
        
        log "No WireGuard interfaces found!"
        exit 0
    
    fi
    

    # 3. RESULTS
    echo ""
    ui_lines 59 "${YELLOW}WireGuard Status${NC}"
    echo ""
    

    # 3. PROCESS EACH INTERFACE
    for iface in $all_interfaces; do
        
        [ -n "$filter_iface" ] && [ "$iface" != "$filter_iface" ] && continue
        
        local status_tags=""
        local details=""

    
        # 3.1 CHECK UCI CONFIGURATION (CREATED/ORPHAN)
    
        if uci get "network.$iface" >/dev/null 2>&1; then
            
            status_tags="${status_tags}${GREEN}CREATED${NC}"
            
            # 3.1.1 FROM UCI
            local address=$(uci get "network.$iface.addresses" 2>/dev/null || echo -e "${RED}N/A${NC}")
            local endpoint_host=$(uci get "network.${iface}_peer.endpoint_host" 2>/dev/null)
            local endpoint_port=$(uci get "network.${iface}_peer.endpoint_port" 2>/dev/null)
            local peer_pubkey=$(uci get "network.${iface}_peer.public_key" 2>/dev/null | cut -c1-15)
            
            details="  ${YELLOW}Local:      ${GREEN}$address${NC}\n"
            [ -n "$endpoint_host" ] && details="${details}  ${YELLOW}Endpoint:   ${GREEN}${endpoint_host}:${endpoint_port:-51820}${NC}\n"
            [ -n "$peer_pubkey" ] && details="${details}  ${YELLOW}Peer:       ${GREEN}$peer_pubkey...${NC}\n"
        
        
        else
            
            debug_write "[INFO] Found ORPHANED configs: $iface"    
        
            status_tags="${status_tags}${RED}ORPHANED${NC}"
            details="  ${YELLOW}Status:   ${RED}Active interface without UCI configuration${NC}\n"
        fi

    
        # 3.2 CHECK LINK STATUS (UP/DOWN)
        if ip link show "$iface" >/dev/null 2>&1; then
            
            status_tags="${status_tags}, ${GREEN}UP${NC}"
            
        
            # 3.3 FROM WG
            if [ "$CAP_WG" = "1" ]; then
                
                local peer_info=$(wg show "$iface" 2>/dev/null)
                local endpoint=$(echo "$peer_info" | grep "endpoint:" | head -1 | sed 's/endpoint: //')
                local handshake=$(echo "$peer_info" | grep "latest handshake:" | head -1 | sed 's/latest handshake: //')
                local transfer=$(echo "$peer_info" | grep "transfer:" | head -1 | sed 's/transfer: //')
                
                [ -n "$endpoint" ] && [ -z "$endpoint_host" ] && details="${details}  ${YELLOW}Endpoint: ${GREEN}$endpoint${NC}\n"
                [ -n "$handshake" ] && details="${details}  ${YELLOW}Last HS:  ${GREEN}$handshake${NC}\n"
                [ -n "$transfer" ] && details="${details}  ${YELLOW}Transfer: ${GREEN}$transfer${NC}\n"
            
            else
                
                details="${details}  ${YELLOW}WG stats:${NC} ${RED}not available (install wireguard-tools)${NC}\n"
            
            fi
        
        else
            
            status_tags="${status_tags}, ${RED}DOWN${NC}"
            
            details="${details}  ${YELLOW}Status:     Interface configured but not active${NC}\n"
        
        fi
        
    
        # 3.4 CHECK ROUTING TABLES (ROUTED)
        local rt_tables=$(grep "_vpn_${iface}_" /etc/iproute2/rt_tables 2>/dev/null | awk '{print $2}')
        
        if [ -n "$rt_tables" ]; then
            
            status_tags="${status_tags}, ${YELLOW}ROUTED${NC}"
            details="${details}  ${YELLOW}Routes:${NC}     "
            
            for table in $rt_tables; do
                local lan_iface=$(echo "$table" | sed "s/_vpn_${iface}_//")
                details="${details}$lan_iface "
            done
            
            details="${GREEN}${details} ${BLUE}(via ${rt_tables%% *})${NC}\n"
        fi

    
        # 3.5 CHECK BACKUP VALIDITY
        local backup_status=""
        local backup_count=0
        local valid_count=0
        
        for config in network dhcp firewall; do
            
            local backup_file="/etc/config/${config}.BACKUP_PRE_WIREGUARD"
            
            if [ -f "$backup_file" ]; then
                
                backup_count=$((backup_count + 1))
                
                if validate_backup "$backup_file" 2>/dev/null; then
                    
                    valid_count=$((valid_count + 1))
                
                fi
            fi
        done
        
        if [ $backup_count -gt 0 ]; then
            
            if [ $valid_count -eq $backup_count ]; then
                
                backup_status="${GREEN}Valid${NC}"
            
            elif [ $valid_count -eq 0 ]; then
                
                debug_write "[INFO] Found CORRUPTED backups for $iface"
                backup_status="${RED}Corrupted${NC}"
            
            else
                
                debug_write "[INFO] Partial backups for $iface"
                backup_status="${YELLOW}Partial${NC}"
            fi
            
            details="${details}  ${YELLOW}Backups:${NC}    $backup_status"
            
            [ $backup_count -eq 3 ] && details="${details} ${BLUE}(network, dhcp, firewall)${NC}"    
            details="${details}\n"
        fi

    
        # 3.6 OUTPUT FOR THIS INTERFACE
        if [ "$VERBOSE" = "1" ]; then
            echo ""
            echo -e "  ${YELLOW}Interface details:${NC}"
            echo -e "$details" | sed 's/^/    /'
        fi
        
        ui_lines 39 "${BLUE}$iface${NC} (${status_tags})"
        printf "$details"
        echo ""
    
    done
    
    ui_lines 60
    exit 0
}


#####################################################################
# ██████╗  █████╗  ██████╗██╗  ██╗██╗   ██╗██████╗ ███████╗
# ██╔══██╗██╔══██╗██╔════╝██║ ██╔╝██║   ██║██╔══██╗██╔════╝
# ██████╔╝███████║██║     █████╔╝ ██║   ██║██████╔╝███████╗
# ██╔══██╗██╔══██║██║     ██╔═██╗ ██║   ██║██╔═══╝ ╚════██║
# ██████╔╝██║  ██║╚██████╗██║  ██╗╚██████╔╝██║     ███████║
# ╚═════╝ ╚═╝  ╚═╝ ╚═════╝╚═╝  ╚═╝ ╚═════╝ ╚═╝     ╚══════╝
#####################################################################

#####################################################################
# TAG HANDLER -> Backup config files
backup_config_file() {

    local file="$1"
    local backup_file="${file}.BACKUP_PRE_WIREGUARD"
    
    debug_write "[BACKUP] Starting backup for: $file"
    
    
    
    # 1.1 IF EXIST EXIT
    if [ -f "$backup_file" ] && validate_backup "$backup_file" 2>/dev/null; then
        
        debug_write "[BACKUP] Valid backup already exists: $backup_file"
        return 0
    fi
    
    # 1.2 IF NATIVE EXISTS
    if [ ! -f "$file" ]; then
        debug_write "[BACKUP ERROR] Source file not found: $file"
        return 1
    fi
    
    # 1.3 IF NATIVE CHOWN IS OK / HAS PROPER DATA
    # DEBUG!
    #           Room for proper data validations, not only a "readable" file by chowns
    if [ ! -r "$file" ]; then
        
        debug_write "[BACKUP ERROR] Cannot read file: $file"
        return 1
    
    fi
    


    # 2.1   READ/CHOWN ATTEMPT
    local content=""
    if ! content=$(cat "$file" 2>/dev/null); then
        
        debug_write "[BACKUP ERROR] Failed to read content: $file"
        return 1
    
    fi
    
    # 2.2   HAS DATA ATTEMPT
    if [ -z "$content" ]; then
        debug_write "[BACKUP WARNING] Empty file: $file"
        # return 1
    fi
    

    # 2.3   CHECKSUM CONTENT ATTEMPT
    local checksum=""
    if command -v sha256sum >/dev/null 2>&1; then
        
        checksum=$(echo "$content" | sha256sum | cut -d' ' -f1)
    
    else
       
        # DEBUG!
        # TODO: sha256 is an openwrt CORE package (...AFAIK), 
        #       but a better and valid fallback .... (is) needed (?)
        checksum=$(echo "$content" | md5sum | cut -d' ' -f1)
        debug_write "[BACKUP] Using md5sum fallback for checksum"
    
    fi
    
    local tag="# WG_AUTOCONF_BACKUP_${VERSION}_$(date +%s)"
    
    debug_write "[BACKUP] Creating backup with checksum: ${checksum:0:16}..."
    


    # ADD TAG 1 OPERS 
    local temp_backup="${backup_file}.tmp.$$"
    local backup_ok=0

    # (sub-coment): best array method, 
    {
        echo "$tag"
        echo "$content"
        echo "# WG_AUTOCONF_CHECKSUM: $checksum"
    } > "$temp_backup" 2>/dev/null
    

    # IF D0NE!
    if [ $? -eq 0 ] && [ -f "$temp_backup" ] && [ -s "$temp_backup" ]; then
        
        
        # TMP FILE CHECKSUM VALID OK
        local temp_checksum=$(sed '1d; $d' "$temp_backup" | sha256sum 2>/dev/null | cut -d' ' -f1)
        if [ "$temp_checksum" = "$checksum" ]; then
            
            if mv "$temp_backup" "$backup_file" 2>/dev/null; then
                
                backup_ok=1
                debug_write "[BACKUP] Created atomic backup: $backup_file"
            
            else
                debug_write "[BACKUP ERROR] Failed to replace backup file"
            fi
        else
            debug_write "[BACKUP ERROR] Checksum mismatch in temp file"
        fi
    else
        debug_write "[BACKUP ERROR] Failed to write temp backup"
    fi
    


    # D0ne, CLEANUPS!
    [ -f "$temp_backup" ] && rm -f "$temp_backup" 2>/dev/null
    # D0ne, VALIDATE BACKUPS
    if [ $backup_ok -eq 1 ]; then

        # VALIDATE BACKUP
        if validate_backup "$backup_file" 2>/dev/null; then
            
            debug_write "[BACKUP] Backup validated: $backup_file"
            verbose success "Backed up $(basename "$file")"
            return 0
        
        else
            
            debug_write "[BACKUP ERROR] New backup failed validation for $backup_file:"
            debug_write ""
            debug cat /etc/config/$backup_file
            debug_write ""

            # DEBUG!
            # TODO:     To be decided: Discard invalid backup or keep it?
            #            Deleting for now to avoid corruption at clean/nuke!
            rm -f "$backup_file" 2>/dev/null
            return 1
        fi
    
    else
        
        debug_write "[BACKUP ERROR] Failed to create backup: $file"
        return 1
    
    fi
}
#####################################################################
# TAG HANDLER -> Validate backup integrity (MEJORADO)
#####################################################################
validate_backup() {

    local backup_file="$1"
    
    debug_write "[BACKUP VALIDATE] Validating: $backup_file"
    
    # 1.1 FILE VALIDATIONS
    if [ ! -f "$backup_file" ]; then
        debug_write "[BACKUP VALIDATE ERROR] File not found"
        return 1
    fi
    
    if [ ! -s "$backup_file" ]; then
        debug_write "[BACKUP VALIDATE ERROR] File empty"
        return 1
    fi
    
    # 1.2 LINE CH4ECJS (>3 = FAILS)
    local line_count=$(wc -l < "$backup_file" 2>/dev/null)
    if [ -z "$line_count" ] || [ "$line_count" -lt 3 ]; then
        
        debug_write "[BACKUP VALIDATE ERROR] Invalid format, less than 3 lines"
        
        return 1
    
    fi

    # 1.3 TAG VERIF
    if ! head -1 "$backup_file" | grep -q "WG_AUTOCONF_BACKUP"; then
        debug_write "[BACKUP VALIDATE ERROR] Missing backup tag"
        return 1
    fi

    # 2. CHECKSUM VERIFS
    local stored_sum=""
    stored_sum=$(tail -10 "$backup_file" | grep "WG_AUTOCONF_CHECKSUM:" | tail -1 | grep -o '[0-9a-f]\{32,\}')
    
    if [ -z "$stored_sum" ]; then
        stored_sum=$(tail -1 "$backup_file" | grep -o '[0-9a-f]\{32,\}')
    fi
    
    if [ -z "$stored_sum" ]; then
        
        debug_write "[BACKUP VALIDATE ERROR] No checksum found"
        watning "No checksum found on $backup_file!"
        return 1
    fi
    
    debug_write "[BACKUP VALIDATE] Stored checksum: ${stored_sum:0:16}..."

    # 3. Compute actual checksum
    local total_lines=$line_count
    local computed_sum=""
    
    if [ $((total_lines - 2)) -le 0 ]; then
        
        debug_write "[BACKUP VALIDATE ERROR] No content to checksum"
        return 1
    
    fi
    
    if command -v sha256sum >/dev/null 2>&1; then
        computed_sum=$(head -n $((total_lines - 1)) "$backup_file" | tail -n +2 | sha256sum | cut -d' ' -f1)
    elif command -v md5sum >/dev/null 2>&1; then
        computed_sum=$(head -n $((total_lines - 1)) "$backup_file" | tail -n +2 | md5sum | cut -d' ' -f1)
        debug_write "[BACKUP VALIDATE] Using md5sum fallback"
    else
        debug_write "[BACKUP VALIDATE ERROR] No checksum tool available"
        return 1
    fi

    if [ -z "$computed_sum" ]; then
        debug_write "[BACKUP VALIDATE ERROR] Failed to compute checksum"
        return 1
    fi
    
    debug_write "[BACKUP VALIDATE] Computed checksum: ${computed_sum:0:16}..."

    # 4. Compare checksums
    if [ "$stored_sum" = "$computed_sum" ]; then
        debug_write "[BACKUP VALIDATE] Backup valid"
        return 0
    else
        debug_write "[BACKUP VALIDATE] CHECKSUM MISMATCH"
        debug_write "   Stored:   $stored_sum"
        debug_write "   Computed: $computed_sum"
        return 1
    fi
}
#####################################################################
# TAG HANDLER -> Show backup files
show_backups() {
    
    log "Available backup files:"
    echo ""
    
    local backup_found=0
    
    for path in $BACKUP_PATHS; do

        local backup_file="${path}.BACKUP_PRE_WIREGUARD"
        
        if [ -f "$backup_file" ]; then
            
            backup_found=1
            
            local backup_size=$(ls -lh "$backup_file" | awk '{print $5}')
            local backup_date=$(ls -l "$backup_file" | awk '{print $6" "$7" "$8}')
            local backup_tag=$(head -1 "$backup_file" | sed 's/^# //')
            
            if validate_backup "$backup_file"; then
            
                success "${YELLOW}$(basename $path) ${GREEN}[VALID]${NC}"
            
            else
            
                debug_write "[BACKUPS SHOW] Found a corrupted backup file: $path"

                warning "${YELLOW}$(basename $path) ${RED}[CORRUPTED]${NC}"
            
            fi
            
            echo -e "      ${YELLOW}Path: ${GREEN}$backup_file${NC}"
            echo -e "      ${YELLOW}Tag:  ${GREEN}$backup_tag${NC}"
            echo -e "      ${YELLOW}Size: ${GREEN}$backup_size${NC} | ${YELLOW}Date: ${GREEN}$backup_date${NC}"
            echo ""
        fi
    done
    
    if [ $backup_found -eq 0 ]; then
        
        warning "No backup files found!"
        
        return 1
    
    fi
    
    return 0
}
#####################################################################
# TAG HANDLER -> Restore backup files
restore_backups() {


    local file_to_restore="$1"
    local silent="${2:-}"
    
    debug_write "[RESTORE] Starting restore operation"
    [ "$silent" != "silent" ] && verbose log "Restoring backup files..."
    
    local restore_count=0
    local skip_count=0
    local corrupt_count=0
    local error_count=0
    
    for path in $BACKUP_PATHS; do
        local config_name=$(basename "$path")
        local backup_file="${path}.BACKUP_PRE_WIREGUARD"
        
        debug_write "[RESTORE] Processing: $config_name"
        
        
        
        [ -n "$file_to_restore" ] && [ "$config_name" != "$file_to_restore" ] && continue
        
        if [ ! -f "$backup_file" ]; then
            
            debug_write "[RESTORE] Backup not found: $backup_file"
            
            [ "$silent" != "silent" ] && warning "Backup not found for $config_name"
            
            skip_count=$((skip_count + 1))
            
            continue
        fi
        
        # VALIDATING ................
        if ! validate_backup "$backup_file"; then
            
            debug_write "[RESTORE] Backup CORRUPTED: $backup_file"
            
            corrupt_count=$((corrupt_count + 1))
            
            if [ "$silent" != "silent" ]; then
            
                error "Backup CORRUPTED for $config_name!"
            
            else
            
  
                debug_write "[RESTORE SILENT] Corrupted backup skipped: $config_name"
            
            fi
            
        
            continue
        # .... NEVER, NEVER, NEVER RESTORE CORRUPTEF FILES!
        
        fi
        


        # IF OK
        local temp_restore="${ATOMIC_PATHS}/${config_name}.restore.$$"
        local restore_ok=0
        
        debug_write "[RESTORE] Restoring $config_name atomically..."
        

        if sed '1d; $d' "$backup_file" > "$temp_restore" 2>/dev/null; then

            
            if [ ! -s "$temp_restore" ]; then
                
                debug_write "[RESTORE WARNING] Restored content empty for $config_name"

            fi
            

            if mv "$temp_restore" "$path" 2>/dev/null; then
             
                restore_ok=1
                debug_write "[RESTORE] Atomically restored: $config_name"
            
            else
              
                debug_write "[RESTORE ERROR] Failed to replace $config_name"
                error_count=$((error_count + 1))
           
            fi
        
        
        else
            
            debug_write "[RESTORE ERROR] Failed to extract content from backup"
            error_count=$((error_count + 1))
        fi
        

        [ -f "$temp_restore" ] && rm -f "$temp_restore" 2>/dev/null
        
        if [ $restore_ok -eq 1 ]; then
            
            restore_count=$((restore_count + 1))
            
            [ "$silent" != "silent" ] && verbose success "Restored $config_name from backup"
            
            debug_write "[RESTORE] Successfully restored: $config_name"
        
        
        else
            
            [ "$silent" != "silent" ] && warning "Failed to restore $config_name"
            
            skip_count=$((skip_count + 1))
        
        fi
    done
    
    # COMMITS
    if [ $restore_count -gt 0 ]; then
        debug_write "[RESTORE] Committing UCI changes..."
        uci commit network 2>/dev/null && debug_write "[RESTORE] network committed"
        uci commit dhcp 2>/dev/null && debug_write "[RESTORE] dhcp committed"
        uci commit firewall 2>/dev/null && debug_write "[RESTORE] firewall committed"
        /etc/init.d/firewall reload 2>/dev/null && debug_write "[RESTORE INIT.D] firewall reloaded"
        
        [ "$silent" != "silent" ] && verbose success "$restore_count file(s) restored successfully"
        debug_write "[RESTORE] Completed: restored=$restore_count, corrupted=$corrupt_count, errors=$error_count, skipped=$skip_count"
        return 0
    
    
    else

        debug_write "[RESTORE] No files restored: corrupted=$corrupt_count, errors=$error_count, skipped=$skip_count"
        verbose error "No files restored: corrupted=$corrupt_count, errors=$error_count, skipped=$skip_count"
        
        if [ "$silent" != "silent" ]; then
            
            if [ $corrupt_count -gt 0 ]; then
            
                error "No files restored: $corrupt_count backup(s) corrupted!"
            
            else
            
                warning "No files were restored"
            
            fi
        fi
        
        return 1
    fi
}

diagnose_backup_issue() {
    
    local config="$1"
    local backup="${config}.BACKUP_PRE_WIREGUARD"
    
    if [ ! -f "$backup" ]; then
        
        warning  "No backup found for $(basename "$config")"
        return
    
    fi
    
    echo ""
    ui_lines 79 "${YELLOW}Diagnosing backup: ${GREEN}$(basename "$backup")${NC}"
    echo ""
    
    echo -e "  ${YELLOW}1. File structure:${NC}"
    echo -e "     Total lines:  ${GREEN}$(wc -l < "$backup")${NC}"
    echo -e "     Line 1 (tag): ${GREEN}$(head -1 "$backup")${NC}"
    echo -e "     Last line:    ${GREEN}$(tail -1 "$backup")${NC}"
    echo ""
    
    local stored_sum=$(tail -1 "$backup" | grep -o '[0-9a-f]\{64\}')
    echo -e "  ${YELLOW}2. Stored checksum: ${BLUE}$stored_sum${NC}"
    echo ""
    local total_lines=$(wc -l < "$backup")
    local computed_sum=$(head -n -1 "$backup" | tail -n +2 | sha256sum | cut -d' ' -f1)
    echo -e "  ${YELLOW}3. Real checksum:${NC}   ${BLUE}$computed_sum${NC}"
    # echo ""
    
    if [ "$stored_sum" = "$computed_sum" ]; then
        
        echo ""
        ui_lines 79 "Backup is ${GREEN}VALID${NC}"
    
    else
        
        echo ""
        warning "   Backup is ${RED}CORRUPTED${NC}!"
        echo ""
        
       
        echo -e "  ${YELLOW}4. Content analysis:${NC}"
        local content=$(head -n -1 "$backup" | tail -n +2)
        echo -e "   Content lines: ${GREEN}$(echo "$content" | wc -l)${NC}"
        echo -e "   Content bytes: ${GREEN}$(echo "$content" | wc -c)${NC}"
        echo ""
        
        if [ -f "$config" ]; then
            
            local current_sum=$(cat "$config" | sha256sum | cut -d' ' -f1)
            
            echo -e "  ${YELLOW}5. Current file checksum:${NC} $current_sum"
            
            if [ "$current_sum" = "$stored_sum" ]; then
                
                success "Current file matches backup checksum"
            
            else
            
                debug_write "[BACKUPS DIAG] Found CORRUPTED backup: $backup !"

                echo ""
                warning "Current file ${RED}DIFFERS${NC} from backup!"
                verbose echo ""
                verbose log "Original backup file have been modified unexpectedly! "
                verbose echo -e "  ${YELLOW}Did you edit a backup file?${NC}"
                verbose echo -e "  This should ${YELLOW}NOT${NC} have happened. Please review now each "
                verbose echo -e "  configuration (network, firewall, dhcp) to ensure system integrity!"
                verbose echo ""
                verbose echo -e "  If you make changes, remember to ${YELLOW}COMMIT${NC} them by running:"
                verbose echo -e "   ${YELLOW}uci commit network${NC}, ${YELLOW}uci commit dhcp${NC}, or ${YELLOW}uci commit firewall${NC}"
                verbose echo ""
                verbose ui_lines 80
            fi
        fi
    fi
    echo ""
}


#####################################################################
# TAG HANDLER -> Cleanup backup files (CORREGIDO TYPO)
#####################################################################
cleanup_backup_files() {

    local force="${1:-}"
    
    debug_write "[BACKUP CLEANUP] Starting backup cleanup"
    [ "$force" != "force" ] && verbose log "Cleaning up backup files..."
    
    local removed_count=0
    local kept_count=0
    local error_count=0
    
    # 1. IFACE VERIF
    local active_ifaces=""
    local has_active_ifaces=0
    
    if [ "$force" != "force" ]; then
        
        active_ifaces=$(get_all_wg_interfaces)
        
        if [ -n "$active_ifaces" ]; then
            
            has_active_ifaces=1
            debug_write "[BACKUP CLEANUP] Active WireGuard interfaces found: $active_ifaces"
            [ "$force" != "force" ] && verbose warning "Active WireGuard interfaces detected, keeping backups"
        
        else
            debug_write "[BACKUP CLEANUP] No active WireGuard interfaces found"
        fi
    fi
    
    for path in $BACKUP_PATHS; do
        
        local backup_file="${path}.BACKUP_PRE_WIREGUARD"
        
        if [ ! -f "$backup_file" ]; then
            continue
        fi
        
        debug_write "[BACKUP CLEANUP] Processing: $(basename "$backup_file")"
        
        
        # 2. MODE SELECT
        local should_remove=0
        
        if [ "$force" = "force" ]; then
            
            # 2.1   NUKE (force), deletem all
            should_remove=1
            debug_write "[BACKUP CLEANUP] Force removal (nuke mode)"
        
        

        # 2.2 IFACE VERIFY
        elif [ $has_active_ifaces -eq 0 ]; then
            
            # 2.2.1   NO IFACES -> Validate and remove
            if validate_backup "$backup_file" 2>/dev/null; then
                
                # 2.2.2 VALID, DELETE
                should_remove=1
                debug_write "[BACKUP CLEANUP] Valid backup, removing (no active interfaces)"
            
            else
                
                # 2.2.2.1 CORRUPTED, RETAIN
                
                should_remove=0
                
                debug_write "[BACKUP CLEANUP] Corrupted backup, keeping for diagnosis"
                
                kept_count=$((kept_count + 1))
            fi
        


        else
            # 2.3   ANY OTHER IFACE EXIST -> RETAIN!
            should_remove=0
            
            debug_write "[BACKUP CLEANUP] Keeping backup (active interfaces exist)"
            kept_count=$((kept_count + 1))
            
            continue
        fi
        
        
        
        # 3. PROCESS REMOVAL
        if [ $should_remove -eq 1 ]; then
            
            if rm -f "$backup_file" 2>/dev/null; then
                
                removed_count=$((removed_count + 1))
                
                debug_write "[BACKUP CLEANUP] Removed: $(basename "$backup_file")"
            
            
            else
                
                error_count=$((error_count + 1))
                debug_write "[BACKUP CLEANUP ERROR] Failed to remove: $backup_file"
            
            fi
        fi
    done
    
    debug_write "[BACKUP CLEANUP] Completed: removed=$removed_count, kept=$kept_count, errors=$error_count, has_active_ifaces=$has_active_ifaces"
    



    # D0ne!
    if [ $error_count -eq 0 ]; then
        if [ "$force" != "force" ] && [ $removed_count -gt 0 ]; then
            verbose success "Removed $removed_count backup file(s)"
        fi
        
        if [ $kept_count -gt 0 ]; then
            if [ $has_active_ifaces -eq 1 ]; then
                [ "$force" != "force" ] && verbose log "Kept $kept_count backup(s) (active interfaces exist)"
            else
                [ "$force" != "force" ] && warning "Kept $kept_count corrupted backup(s) for diagnosis"
            fi
        fi
        
        # NUKE (force) DO NOT RETAIN
        if [ "$force" = "force" ] && [ $removed_count -eq 0 ] && [ $kept_count -eq 0 ]; then
            
            debug_write "[BACKUP CLEANUP] No backups found to clean"
            
            [ "$force" != "force" ] && verbose log "No backup files to clean"
        
        fi
        
        return 0
    
    
    
    else
        
        [ "$force" != "force" ] && warning "Backup cleanup completed with $error_count error(s)"
        return 1
    
    fi
}

#####################################################################
#
#  ██████╗██╗     ███████╗ █████╗ ███╗   ██╗██╗   ██╗██████╗
# ██╔════╝██║     ██╔════╝██╔══██╗████╗  ██║██║   ██║██╔══██╗
# ██║     ██║     █████╗  ███████║██╔██╗ ██║██║   ██║██████╔╝
# ██║     ██║     ██╔══╝  ██╔══██║██║╚██╗██║██║   ██║██╔═══╝
# ╚██████╗███████╗███████╗██║  ██║██║ ╚████║╚██████╔╝██║
#  ╚═════╝╚══════╝╚══════╝╚═╝  ╚═╝╚═╝  ╚═══╝ ╚═════╝ ╚═╝
#
#####################################################################

#####################################################################
# WG-AUTOCONF CLEANUP
#####################################################################
cleanup() {
    
    local mode="$1"
    local target_iface="$2"
    local silent="${3:-}"


    # 1. VALIDATE MODE
    if [ -z "$mode" ] || ! echo "$mode" | grep -qE "^(single|interactive|nuke)$"; then
        error "cleanup: Invalid mode '$mode' (use: ${YELLOW}clean${NC} <iface> | ${YELLOW}clean${NC} | ${RED}nuke{NC} )"
        return 1
    fi


    # 2. UNCONDITIONAL INITS
    state_init
    check_bins

    debug_write "[CLEANUP] Starting with mode=$mode, target_iface=$target_iface"





    # 3. "DISCOVERY" -> FIND WHAT NEEDS CLEANING
    local interfaces=""
    local all_tables=""
    local all_nft_chains=""
    local interactive=0


    # 3.1 INTERFACE DISCOVERY
    local uci_ifaces=$(get_all_wg_interfaces)
    local kernel_ifaces=$(ip link show 2>/dev/null | grep -o 'wg[^:@]*' | sort -u)
    
    debug_write "[CLEANUP] UCI interfaces: $uci_ifaces"
    debug_write "[CLEANUP] Kernel interfaces: $kernel_ifaces"
    
    # 3.2 ROUTING TABLE DISCOVERY
    local wg_tables=$(grep -E '^[0-9]+[[:space:]]+wg' /etc/iproute2/rt_tables 2>/dev/null | awk '{print $2}')
    local vpn_tables=$(grep -E '^[0-9]+[[:space:]]+_vpn_' /etc/iproute2/rt_tables 2>/dev/null | awk '{print $2}')

    debug_write "[CLEANUP] WG tables: $wg_tables"
    debug_write "[CLEANUP] VPN tables: $vpn_tables"
    
    # 3.3 NFTABLES CHAIN DISCOVERY
    if [ "$CAP_NFTABLES" = "1" ]; then
        
        all_nft_chains=$(nft list table inet fw4 2>/dev/null | grep -o 'chain [a-zA-Z0-9_]*_wg[a-zA-Z0-9_]*' | sed 's/chain //' | sort -u)
        
        debug_write "[CLEANUP] NFT WG chains: $all_nft_chains"
    
    fi






    # 4.   CASES BY MODES
    case "$mode" in


        # 4.1 SINGLE MODE
        single)
            if [ -z "$target_iface" ]; then
                error "cleanup: Interface name required for 'single' mode"
                return 1
            fi

            validate_iface_name "$target_iface"

            # CHECK BOOOOOT UCI + KERNEL
            if ! iface_collision "$target_iface" && ! ip link show "$target_iface" >/dev/null 2>&1; then
                error "cleanup: $target_iface does not exist anywhere!"
                return 1
            fi

            interfaces="$target_iface"
            interactive=1
            debug_write "[CLEANUP SINGLE] Processing single interface: $target_iface"
            ;;


        # 4.2 INTERACTIVE MODE
        interactive)

            local all_ifaces=$(echo "$uci_ifaces $kernel_ifaces" | tr ' ' '\n' | sort -u)

            if [ -z "$all_ifaces" ]; then
                warning "No WireGuard interfaces found"
                return 0
            fi

            echo ""
            log "Available WireGuard interfaces:"
            echo ""

            local count=0
            for iface in $all_ifaces; do
                count=$((count + 1))
                local addr=$(uci get "network.$iface.addresses" 2>/dev/null || echo "N/A")
                local status=""
                ip link show "$iface" >/dev/null 2>&1 && status="(active)" || status="(inactive)"
                echo "  $count) $iface $status [$addr]"
            done

            echo ""
            printf "  ${YELLOW}Choose an interface${NC} (or press Enter to cancel): "
            read -r selection

            if [ -z "$selection" ]; then
                log "Cleanup cancelled"
                return 0
            fi
            
            count=0
            for iface in $all_ifaces; do
                count=$((count + 1))
                if [ "$count" = "$selection" ]; then
                    interfaces="$iface"
                    break
                fi
            done

            if [ -z "$interfaces" ]; then
                warning "Invalid selection"
                return 1
            fi

            interactive=1
            debug_write "[CLEANUP INTERACTIVE] Selected interface: $interfaces"
            ;;


        # 4.3 NUKE MODE
        nuke)

            # 4.3.1 COMBINE-SORT ALL IFACES (UCI + kernel)
            interfaces=$(echo "$uci_ifaces $kernel_ifaces" | tr ' ' '\n' | sort -u)
            
            # 4.3.2 COMBINE-SORT ALL ROUTING TABLES
            all_tables=$(echo "$wg_tables $vpn_tables" | tr ' ' '\n' | sort -u)
            
            interactive=0
            silent="silent"
            
            debug_write "[NUKE] Interfaces to process: $interfaces"
            debug_write "[NUKE] Tables to clean: $all_tables"
            debug_write "[NUKE] NFT chains to clean: $all_nft_chains"
            ;;
    esac





    # 5. PROCESS EACH INTERFACE/CLEANUP PER INTERFACE)
    local processed_count=0
    local error_count=0

    for iface in $interfaces; do
        
        # 5.1 CONFIRMATION FOR NON-NUKE IF NEEDED
        if [ "$silent" != "silent" ] && [ "$interactive" -eq 1 ]; then
            
            debug_write "[CLEANUP] Starting cleanup for $iface"
            log "Cleaning up $iface..."
            echo ""
            
            local addr=$(uci get "network.$iface.addresses" 2>/dev/null || echo "N/A")
            local ep=$(uci get "network.${iface}_peer.endpoint_host" 2>/dev/null || echo "N/A")

            echo ""
            ui_lines 49 " ${GREEN}$iface${NC}"
            echo "  Address: $addr"
            echo "  Endpoint: $ep"
            ui_lines 50
            echo ""

            printf "${YELLOW}Proceed with cleanup? (${GREEN}y${YELLOW}/${RED}N${YELLOW}):${NC} "
            read -r confirm

            case "$confirm" in
                y|Y|yes|YES|Yes|okidoki|OKIDOKI|Okidoki|OkiDoki)
                    ;;
                *)
                    log "Cleanup cancelled for $iface"
                    continue
                    ;;
            esac
            echo ""
        fi

    
        # 5.2 CLEANUP ROUTES --> By finding ALL VPN tables for this interface
        local iface_vpn_tables=$(grep "_vpn_${iface}_" /etc/iproute2/rt_tables 2>/dev/null | awk '{print $2}')
        
        for table in $iface_vpn_tables; do

            # 5.2.1  GET LAN IFACE from table name
            # DEBUG!
            # TODO:  Test/stage stressfully "s/^_vpn_${iface}_//", if fails, fix with _${lan iface}
            local lan_iface=$(echo "$table" | sed "s/^_vpn_${iface}_//")
            
            if [ -n "$lan_iface" ] && [ "$lan_iface" != "$table" ]; then
                
                if [ "$silent" != "silent" ]; then
                    
                    verbose log "Unsetting routes for $iface <-> $lan_iface..."
                
                fi
                
                # HEADACHE!
                # 5.2.2     UNSET_LAN
                if unset_lan_routes "$iface" "$lan_iface" >/dev/null 2>&1; then
                    
                    debug_write "[CLEANUP] Routes unset: $iface <-> $lan_iface"
                
                # 5.2.3 ELSE DEL RT_ + IP RULES BY TABLE
                else
                    
                    debug_write "[CLEANUP] Failed to unset routes via unset_lan_routes, manual cleanup"
                    
                    del_routing_table "$table"
                    del_ip_rules_by_table "$table"
                fi

                # DEBUG! HEADACHE!
                # MATCH THIS EXACT ORDER -> PREVENTS ORPHANED STATES, RULES, TABLES
            fi
        done

    
        # 5.3   DEACTIVATE INTERFACE
        
        #  5.3.1 NUKE? deactivate_interface callback $force=true 
        if [ "$mode" = "nuke" ]; then
            
            if [ "$silent" != "silent" ]; then
                
                verbose log "Deactivating interface (force mode)..."
            
            fi
            
            if deactivate_interface "$iface" "force" >/dev/null 2>&1; then
                
                if [ "$silent" != "silent" ]; then
                    
                    verbose success "Interface down: $iface"
                
                fi
                
                debug_write "[CLEANUP] Interface down: $iface (force)"
            
            else
                
                if [ "$silent" != "silent" ]; then
                
                    verbose log "Failed to deactivate $iface (may already be down)"
                
                fi
                
                debug_write "[CLEANUP] deactivate_interface failed for $iface (force)"
            
            fi
        


        # 5.3.2 NO NUKE? ALWAYS CHECKS UCI
        elif uci get "network.$iface" >/dev/null 2>&1; then
            
            if [ "$silent" != "silent" ]; then
                
                verbose log "Deactivating interface..."
            
            fi
            
            if deactivate_interface "$iface" >/dev/null 2>&1; then
                
                if [ "$silent" != "silent" ]; then
                    
                    verbose success "Interface down: $iface"
                
                fi
                
                debug_write "[CLEANUP] Interface down: $iface"
            
            
            else
                
                if [ "$silent" != "silent" ]; then
                
                    verbose log "Failed to deactivate $iface (may already be down)"
                
                fi
                
                debug_write "[CLEANUP] deactivate_interface failed for $iface"
            
            fi
        
        
        else
            
            debug_write "[CLEANUP] Interface $iface not in UCI, skipping down"
        
        fi
    


    
        
        # 5.4 REMOVE INTERFACE CONFIGURATION (UCI, tags, state)
        local remove_silent_mode="$silent"
        
        if [ "$mode" = "nuke" ]; then
            
            remove_silent_mode="silent"
        
        fi


        # HEADACHE!
        # 5.4.1 FORCE REMOVAL, EVEN IF NOT IN UCI -> fIXES cleanup orphaned state!
        if remove_wireguard "$iface" "$remove_silent_mode"; then
            
            if [ "$silent" != "silent" ]; then
                
                verbose success "Interface removed: $iface"
            
            fi
            
            processed_count=$((processed_count + 1))
            debug_write "[CLEANUP] Interface removed: $iface"
        
        else
            
            error_count=$((error_count + 1))
            
            if [ "$silent" != "silent" ]; then
                
                warning "Failed to remove $iface"
            
            fi
            
            debug_write "[CLEANUP] remove_wireguard failed for $iface"
        
        fi

        
        if [ "$silent" != "silent" ]; then
            
            echo ""
        
        fi
   
    done


    # HEADACHE!
    # 6. NUKE-ONLY FORCE REMOVALS ->GLOBAL CLEANUP OF ANY ORPHANED RULE-TABLE-FILE-ETC    
    if [ "$mode" = "nuke" ]; then
        

        debug_write "[NUKE] Performing global orphaned artifacts cleanup"


        # 6.1 CLEANY ANY wg* TABLES ORPHANED EVEN PREV. LOOPS
        for table in $wg_tables; do
            
            if grep -q "[[:space:]]$table$" /etc/iproute2/rt_tables 2>/dev/null; then
            
                debug_write "[NUKE] Removing orphaned wg table: $table"
            
                del_routing_table "$table"
                del_ip_rules_by_table "$table"
            
            fi
        
        done


        # 6.2   CLEANY ANY _vpn_* TABLES ORPHANED EVEN PREV. LOOPS
        for table in $vpn_tables; do
            
            if grep -q "[[:space:]]$table$" /etc/iproute2/rt_tables 2>/dev/null; then
            
                debug_write "[NUKE] Removing orphaned vpn table: $table"
            
                del_routing_table "$table"
                del_ip_rules_by_table "$table"
            fi
        
        done


        # 6.3 CLEANY ANY ORPHANED NFT CHAINS
        if [ "$CAP_NFTABLES" = "1" ]; then
            
            for chain in $all_nft_chains; do
            
                if nft list chain inet fw4 "$chain" >/dev/null 2>&1; then
                    debug_write "[NUKE] Removing orphaned NFT chain: $chain"
                    nft delete chain inet fw4 "$chain" 2>/dev/null
                fi
            done
        fi

        # 6.5  CLEAN NFT.D's
        debug_write "[NUKE] Removing all wg-autoconf NFT include files"

        # 6.5.1 BY NAME
        find /usr/share/nftables.d/ -name "*-wg-*.nft" -exec rm -f {} \; 2>/dev/null
        find /usr/share/nftables.d/ -name "96-block-ipv*.nft" -exec rm -f {} \; 2>/dev/null
        find /usr/share/nftables.d/ -name "96-allow-ipv*.nft" -exec rm -f {} \; 2>/dev/null
        find /usr/share/nftables.d/ -name "95-vpn-*.nft" -exec rm -f {} \; 2>/dev/null
        find /usr/share/nftables.d/ -name "91-wg-*.nft" -exec rm -f {} \; 2>/dev/null

        # 6.5.2 BY CONTENT ("wg-autoconf")
        grep -l "wg-autoconf" /usr/share/nftables.d/**/9*.nft 2>/dev/null | while read -r file; do
            rm -f "$file"
            debug_write "[NUKE] Removed NFT file (by content): $file"
        done

        debug_write "[NUKE] NFT include files cleaned up"



        # 6.5.3  CLEANUP ORPHANED ROUTING TABLES (by ID)

        # 6.4 CLEANUP ORPHANED ROUTING TABLES (by ID)
        debug_write "[NUKE] Looking for orphaned routing tables by ID"
        
        # 6.4.1 GET ALL IDs FROM IP ROUTE
        local all_table_ids=$(ip route show table all 2>/dev/null | \
                              grep -E 'table [0-9]+' | \
                              sed 's/.*table \([0-9]\+\).*/\1/' | \
                              sort -u)
        

        for tid in $all_table_ids; do
            
            
            # 6.4.2 THIS ID IS FROM A VALID TABLE (wg_* | _vpn_*) ?
            local table_name=$(grep "^$tid[[:space:]]" /etc/iproute2/rt_tables 2>/dev/null | awk '{print $2}')
            
            # 6.4.3 IF NOT, ORPHANED, THEN CLEAN
            if [ -z "$table_name" ] || ! echo "$table_name" | grep -E '^(wg|_vpn_)' >/dev/null; then
                
                debug_write "[NUKE] Found orphaned routing table ID $tid (name: $table_name)"
                
                ip route flush table "$tid" 2>/dev/null
                
                debug_write "[NUKE] Flushed orphaned table $tid"
            fi


            # 6.4.4 CLEANUP ORPHANED TABLES BY RT_TABLES ENTRY (even if empty)
            debug_write "[NUKE] Cleaning up any remaining wg* entries in rt_tables"
            
            local remaining_wg_tables=$(grep -E '^[0-9]+[[:space:]]+wg' /etc/iproute2/rt_tables 2>/dev/null | awk '{print $2}')
            
            for table in $remaining_wg_tables; do
                debug_write "[NUKE] Force removing orphaned wg table: $table"
                del_routing_table "$table"
                del_ip_rules_by_table "$table"
            done
        
        done


        # 6.5 CLEANUP ORPHANED IP RULES ( WITH NO TABLES)
        # AS KERNEL DOES, FOR ORPHANEDS, IT PARSES IFACE TO ADDRES / IFACE TO PRIOR
        debug_write "[NUKE] Looking for orphaned IP rules"

        local existing_tables=$(cat /etc/iproute2/rt_tables 2>/dev/null | grep -E '^[0-9]+' | awk '{print $1}')
        
        ip rule show | grep "lookup [0-9]\+" | while read rule; do

            local priority=$(echo "$rule" | awk '{print $1}' | sed 's/://')
            local table_id=$(echo "$rule" | grep -o 'lookup [0-9]\+' | awk '{print $2}')
            
            # 6.5.1 IF MATCH (NO ROUTES), IT'S GARBAGE, THEN DEL
            if ! echo "$existing_tables" | grep -q "^$table_id$"; then
                
                ip rule del priority "$priority" 2>/dev/null
                debug_write "[NUKE] Removed orphaned rule priority $priority (table $table_id)"
            
            fi        
        done

        # 6.6 FORCE REMOVE ANY REMAINING WG INTERFACES
        debug_write "[NUKE] Force removing any remaining WireGuard interfaces"
        
        local remaining_ifaces=$(ip link show | grep -o 'wg[^:@]*' | sort -u)
        
        for riface in $remaining_ifaces; do
            
            debug_write "[NUKE] Force removing interface: $riface"
            
            # 6.6.1 Try normal delete
            ip link delete "$riface" 2>/dev/null
            
            
            # 6.6.2 If still exists, try with more force
            if ip link show "$riface" >/dev/null 2>&1; then
            
                debug_write "[NUKE] Interface $riface still exists, forcing down first"
            
                ip link set "$riface" down 2>/dev/null
                ip link delete "$riface" 2>/dev/null
            
            fi
            
            
            # 6.6.3 Final check
            if ip link show "$riface" >/dev/null 2>&1; then
            
                debug_write "[NUKE CRITICAL] Cannot remove interface $riface"
            
            fi
        
        done



        # 6.7 STATE RESET
        # DEBUG!
        # TODO:     Count how many time states are reset in NUKE mode, prevent more cycles than required
        state_reset
        debug_write "[NUKE] State reset complete"
    fi




    # 7. D0nE!
    debug_write "[CLEANUP] Completed: mode=$mode, processed=$processed_count, errors=$error_count"

    if [ $error_count -eq 0 ]; then
        
        if [ "$silent" != "silent" ]; then
            echo ""
            success "Cleanup completed successfully!"
            verbose log "All cleanup operations completed."
        fi
        return 0
    
    else
        debug_write "[CLEANUP] Errors ($error_count) found:"
        debug_write ""
        debug cat /usr/libexec/wg-autoconf/states
        debug_write ""
        debug ip link show | grep wg
        debug_write ""
        debug cat /etc/iproute2/rt_tables
        debug_write ""
    
        if [ "$silent" != "silent" ]; then
            echo ""
            warning "Cleanup completed with $error_count error(s)"
        fi
        return 1
    fi
}

