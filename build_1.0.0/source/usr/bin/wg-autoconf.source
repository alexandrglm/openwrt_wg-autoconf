    echo -e " ${YELLOW}backups show${NC}                     ${ITALIC}- List available backups${NI}"
    echo -e " ${YELLOW}backups restore${NC} ${GREEN}<file>${NC}           ${ITALIC}- Restore backup files${NI}"
    echo ""
    echo -e " ${YELLOW}upgrade${NC}                          ${ITALIC}- Upgrade wg-autoconf safely${NI}"
    echo ""

    echo -e "${RED}${BOLD}${UNDERLINE}Cleanup Operations:${NU}${NB}${NC}"
    echo -e " ${YELLOW}clean${NC}                            ${ITALIC}- Clean WG configs, Interactive mode${NI}"
    echo -e " ${YELLOW}clean${NC} ${GREEN}<wg iface>${NC}                 ${ITALIC}- Clean specific interface${NI}"
