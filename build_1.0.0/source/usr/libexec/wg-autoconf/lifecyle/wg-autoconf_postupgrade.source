#!/bin/ash
# 1.0.0-r1 post_upgrade() lifecycle methods
VERSION="1.0.0-r1"

mkdir -p /etc/wireguard/
touch /etc/wireguard/put_conf_files_here

mkdir /usr/libexec/wg-autoconf/atomics
cat << 'EOF' > /usr/libexec/wg-autoconf/states
IS_INSTALLED=1
IS_FIRST_EXEC=1
IS_PREV_TO_UPGRADE=0
IS_UPGRADED=1
EOF

echo "AND THEN, THIS IS A POST-UPGRADE CONFIRMATION!"

chmod +x /etc/init.d/wg-autoconf_boot_cleanup
sleep 1
/etc/init.d/wg-autoconf_boot_cleanup enable 2>/dev/null
# /etc/init.d/wg-autoconf_boot_cleanup start 2>/dev/null
echo "[wg-autoconf $VERSION] Succesfully installed!"
exit 0
