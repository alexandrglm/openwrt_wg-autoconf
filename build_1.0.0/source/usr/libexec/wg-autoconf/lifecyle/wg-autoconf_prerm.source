#!/bin/ash
# 1.0.0-r1 pre_deinstall() lifecycle method

cleanup_success=0

# 1)    PRE_DEINSTALL NUKE
if [ -x /usr/bin/wg-autoconf ]; then
    
    if /usr/bin/wg-autoconf nuke 2>/dev/null; then
        
        echo "[wg-autoconf] Full deinstalling NUKE successful!" > /dev/kmsg
        echo -e "\033[1;32m[OK]\033[0m Ensuring a clean state prior to uninstallation via wg-autoconf nuke ..."
        cleanup_success=1
    
    else

        echo "[wg-autoconf] Deinstall NUKE failed, using fallback emergency cleanup" > /dev/kmsg
        echo -e "\033[1;33m[WARNING]\033[0m Ensuring a clean state prior to uninstallation manually (wg-autoconf nuke failed!) ..."
        cleanup_success=0
    fi

else

    echo "[wg-autoconf] wg-autoconf binary not found, using fallback cleanup" > /dev/kmsg
    echo -e "\033[1;33m[WARNING]\033[0m Ensuring a clean state prior to uninstallation manually (wg-autoconf bin not found!) ..."
    cleanup_success=0

fi

# 2)    PRE_DEINSTALL EMERGENCY CLEANUP
if [ $cleanup_success -eq 0 ]; then


    echo "[wg-autoconf] Starting fallback emergency cleanup" > /dev/kmsg
    # echo -e "\033[1;34m[wg-autoconf]\033[0m Starting fallback cleanup..."

    # 2.1   IFACES CLEANUP
    for iface in $(ip link show 2>/dev/null | grep -oE "wg[0-9a-zA-Z_-]*" | sort -u); do
        
        if ip link show "$iface" 2>/dev/null | grep -q "state DOWN"; then
        
            ip link delete "$iface" 2>/dev/null && \
        
                echo "[wg-autoconf] Removed interface: $iface" > /dev/kmsg
        
        else
        
            echo "[wg-autoconf] Skipping active interface: $iface" > /dev/kmsg
        
        fi


    done

    # 2.2 UCI SETS CLEANUP
    uci show network 2>/dev/null | grep "network\.wg[^=]*=interface" | \
    cut -d. -f2 | cut -d= -f1 | while read -r iface; do
        uci delete "network.$iface" 2>/dev/null
        uci delete "network.${iface}_peer" 2>/dev/null 2>/dev/null
        echo "[wg-autoconf] Removed UCI config for: $iface" > /dev/kmsg
    done

    # 2.3 RT_TABLES CLEANUP)
    grep -E "^[0-9]+\s+[^_]+_vpn_wg[^_]+" /etc/iproute2/rt_tables 2>/dev/null | while read -r line; do
        table_name=$(echo "$line" | awk '{print $2}')
        

        lan_iface=$(echo "$table_name" | sed 's/\(.*\)_vpn_wg.*/\1/')
        
        if [ -n "$lan_iface" ]; then

            lan_ip=$(uci get "network.$lan_iface.ipaddr" 2>/dev/null || \
                    ip -4 addr show "$lan_iface" 2>/dev/null | grep inet | awk '{print $2}' | cut -d/ -f1 | head -1)
            
            if [ -n "$lan_ip" ] && echo "$lan_ip" | grep -q '\.'; then
                subnet="${lan_ip%.*}.0/24"
                
                ip rule del from "$subnet" lookup "$table_name" 2>/dev/null
                ip rule del from "$subnet" to "$subnet" lookup main 2>/dev/null
                ip route flush table "$table_name" 2>/dev/null
                
                echo "[wg-autoconf] Cleaned routing for table: $table_name (LAN: $lan_iface)" > /dev/kmsg
            fi
            
            sed -i "/^[0-9]\+[[:space:]]\+${table_name}$/d" /etc/iproute2/rt_tables 2>/dev/null
        fi
    done


    # 2.4   BACKUP FILES
    for backup in /etc/config/*.BACKUP_PRE_WIREGUARD; do
        [ -f "$backup" ] || continue
        
        original="${backup%.BACKUP_PRE_WIREGUARD}"
        config_name=$(basename "$original")
        

        if head -1 "$backup" | grep -q "WG_AUTOCONF_BACKUP"; then

            if sed '1d; $d' "$backup" > "$original" 2>/dev/null; then
                
                rm -f "$backup" 2>/dev/null
                
                echo "[wg-autoconf] Restored backup for: $config_name" > /dev/kmsg
                echo -e "\033[1;32m[OK]\033[0m Restored backup: $config_name"
            
            else
                
                echo "[wg-autoconf] Failed to restore backup for: $config_name" > /dev/kmsg
                echo -e "\033[1;33m[WARNING]\033[0m Failed to restore backup: $config_name"
            
            fi
        
        
        else
            
            echo "[wg-autoconf] Skipping invalid backup (missing tag): $(basename "$backup")" > /dev/kmsg
            echo -e "\033[1;33m[WARNING]\033[0m Skipping invalid backup: $(basename "$backup")"
        
        fi
    done


    # 2.5 COMMITS
    uci commit network 2>/dev/null
    uci commit dhcp 2>/dev/null
    uci commit firewall 2>/dev/null

    /etc/init.d/firewall reload 2>/dev/null && \
        echo "[wg-autoconf] Firewall reloaded" > /dev/kmsg

    echo "[wg-autoconf] Emergency deinstalling cleanup successful!" > /dev/kmsg
    echo -e "\033[1;32m[OK]\033[0m Emergency cleanup completed"

fi


echo "[wg-autoconf] Cleaning up remaining files" > /dev/kmsg
echo -e "\033[1;34m[wg-autoconf]\033[0m Cleaning up files..."

/etc/init.d/wg-autoconf_boot_cleanup stop 2>/dev/null
/etc/init.d/wg-autoconf_boot_cleanup disable 2>/dev/null

rm -rf /tmp/wg-backup 2>/dev/null
rm -rf /etc/wireguard/put_conf_files_here 2>/dev/null
rm -rf /usr/libexec/wg-autoconf/ 2>/dev/null

echo "[wg-autoconf] Pre-deinstall cleanup completed" > /dev/kmsg
echo -e "\033[1;32m[OK]\033[0m Pre-deinstall cleanup finished"

exit 0
